{
  "name": "bbc-quote-mcp-server",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "verify:release-c": "node --test test/*.test.js",
    "deploy": "npm run verify:release-c && wrangler deploy",
    "deploy:contour": "npm run verify:release-c && wrangler deploy -c wrangler.contour.jsonc",
    "dry-run:contour": "npm run verify:release-c && wrangler deploy --dry-run -c wrangler.contour.jsonc",
    "dev": "wrangler dev",
    "dev:contour": "wrangler dev -c wrangler.contour.jsonc",
    "format": "oxfmt --write .",
    "lint:fix": "oxlint --fix",
    "test": "node --test test/*.test.js",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "0.17.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "oxfmt": "0.56.0",
    "oxlint": "1.77.0",
    "typescript": "6.0.3",
    "wrangler": "4.120.0"
  }
}
