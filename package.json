{
  "name": "bbc-quote-mcp-server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:contour": "wrangler deploy -c wrangler.contour.jsonc",
    "dry-run:contour": "wrangler deploy --dry-run -c wrangler.contour.jsonc",
    "dev": "wrangler dev",
    "dev:contour": "wrangler dev -c wrangler.contour.jsonc",
    "format": "oxfmt --write .",
    "lint:fix": "oxlint --fix",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "agents": "^0.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "6.0.3",
    "wrangler": "^4.105.0"
  }
}
