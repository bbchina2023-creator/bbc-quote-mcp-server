{
  "name": "bbc-quote-mcp-server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "oxfmt --write .",
    "lint:fix": "oxlint --fix",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "build:production": "node scripts/build-production.mjs",
    "type-check:production": "npm run build:production && tsc --noEmit -p tsconfig.production.json"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.8.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "0.17.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "oxfmt": "0.56.0",
    "oxlint": "1.78.0",
    "typescript": "6.0.3",
    "wrangler": "4.120.1"
  }
}
