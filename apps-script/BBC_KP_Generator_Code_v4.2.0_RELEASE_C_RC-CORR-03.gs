/** Release A Phase 5 — lineage/readiness gate and immutable persistence services. */
const BBC_RELEASE_A_PHASE5 = Object.freeze({phase:'LINEAGE_SNAPSHOT_PERSISTENCE'});

function bbcReleaseAFieldMetaIndex_(canonical) {
  var map=new Map();(canonical.fieldMeta||[]).forEach(function(m){map.set(String(m.entityType||'')+'|'+String(m.entityId||'')+'|'+String(m.fieldCode||''),m);});return map;
}

function bbcReleaseAFieldState_(canonical, entityType, entityId, fieldCode) {
  var meta = bbcReleaseAFieldMetaIndex_(canonical).get(String(entityType || '') + '|' + String(entityId || '') + '|' + String(fieldCode || ''));
  return String(meta && meta.state || '');
}

function bbcReleaseAResolvedDisplayValue_(canonical, entityType, entityId, fieldCode, value) {
  if (bbcReleaseAFieldState_(canonical, entityType, entityId, fieldCode) === 'NOT_APPLICABLE') return 'NOT_APPLICABLE';
  return value;
}

function validateReleaseALineageCoverage_(canonical) {
  var issues = [], meta = bbcReleaseAFieldMetaIndex_(canonical);
  var evidenceMap = new Map((canonical.lineage || []).map(function(e) { return [String(e.evidenceId || ''), e]; }));
  var decisionMap = new Map((canonical.managerDecisions || []).map(function(d) { return [String(d.decisionId || ''), d]; }));
  var rules = new Set((canonical.ruleBindings || []).map(function(r) { return String(r.ruleId || '') + '@' + String(r.ruleVersion || r.version || ''); }));
  var confirmedStates = new Set(['CONFIRMED_BY_SOURCE','CONFIRMED_BY_MANAGER','CONFIRMED_BY_RULE','CONFIRMED_BY_VERIFIED_CALCULATION','NOT_APPLICABLE','CONFIRMED_ZERO']);

  function validateEvidence(ref, key) {
    var e = evidenceMap.get(String(ref));
    if (!e) { issues.push(bbcReleaseAIssue_('LINEAGE_REF_UNKNOWN', key, 'Unknown evidence ref ' + ref)); return; }
    ['sourceType','sourceRole','authorityClass','capturedAt'].forEach(function(field) {
      if (!String(e[field] || '').trim()) issues.push(bbcReleaseAIssue_('LINEAGE_EVIDENCE_INCOMPLETE', key, 'Evidence ' + ref + ' lacks ' + field + '.'));
    });
    if (!String(e.sourceFileId || '').trim() && !String(e.sourceFileName || '').trim()) issues.push(bbcReleaseAIssue_('LINEAGE_SOURCE_FILE_MISSING', key, 'Evidence ' + ref + ' requires sourceFileId or sourceFileName.'));
    ['sourceSheet','sourceRange','sourceFormula','ruleId','ruleVersion'].forEach(function(field) {
      if (!Object.prototype.hasOwnProperty.call(e, field)) issues.push(bbcReleaseAIssue_('LINEAGE_EVIDENCE_FIELD_MISSING', key, 'Evidence ' + ref + ' must explicitly carry ' + field + ' (null is allowed when not applicable).'));
    });
    if (e.capturedAt && !Number.isFinite(new Date(e.capturedAt).getTime())) issues.push(bbcReleaseAIssue_('LINEAGE_CAPTURED_AT', key, 'Evidence ' + ref + ' has invalid capturedAt.'));
  }

  function requireMeta(entityType, entityId, fieldCode) {
    var key = entityType + '|' + String(entityId || '') + '|' + fieldCode, m = meta.get(key);
    if (!m) { issues.push(bbcReleaseAIssue_('LINEAGE_META_MISSING', key, 'Quote/calculation-critical field has no fieldMeta.')); return; }
    if (!confirmedStates.has(String(m.state || ''))) { issues.push(bbcReleaseAIssue_('LINEAGE_STATE_UNRESOLVED', key, 'Critical field is not confirmed/resolved.')); return; }
    (m.lineageRefs || []).forEach(function(ref) { validateEvidence(ref, key); });
    (m.decisionRefs || []).forEach(function(ref) { if (!decisionMap.has(String(ref))) issues.push(bbcReleaseAIssue_('DECISION_REF_UNKNOWN', key, 'Unknown decision ref ' + ref)); });
    (m.ruleRefs || []).forEach(function(ref) { if (!rules.has(String(ref))) issues.push(bbcReleaseAIssue_('RULE_REF_UNKNOWN', key, 'Unknown rule binding ' + ref)); });
    if (String(m.state) === 'CONFIRMED_BY_MANAGER' && !(m.decisionRefs || []).length) issues.push(bbcReleaseAIssue_('MANAGER_DECISION_REQUIRED', key, 'CONFIRMED_BY_MANAGER requires decision reference.'));
    if (String(m.state) === 'CONFIRMED_BY_RULE' && !(m.ruleRefs || []).length) issues.push(bbcReleaseAIssue_('RULE_BINDING_REQUIRED', key, 'CONFIRMED_BY_RULE requires rule binding reference.'));
    if (!((m.lineageRefs || []).length || (m.decisionRefs || []).length || (m.ruleRefs || []).length)) issues.push(bbcReleaseAIssue_('LINEAGE_AUTHORITY_EMPTY', key, 'Critical field has no authority reference.'));
  }

  ['client','manager','scheme','quoteCurrency','validityDays','incoterms','chinaRoute','borderCrossing','destinationCity','transportMode','deliveryDays','productionDays'].forEach(function(fieldCode) {
    requireMeta('DEAL', canonical.dealId, fieldCode);
  });
  (canonical.items || []).forEach(function(item) {
    ['name','quantity','quantityUnit','priceCurrency','batchAmount','importVatRate','dutyMethod','dutyRate'].forEach(function(f) { requireMeta('ITEM', item.itemId, f); });
    if (['EUR_PER_KG','USD_PER_KG'].indexOf(String(item.dutyMethod || '').toUpperCase()) >= 0) requireMeta('ITEM', item.itemId, item.grossWeightKg != null ? 'grossWeightKg' : 'netWeightKg');
  });
  (canonical.expenses || []).filter(function(e) { return e && e.includeInCalculation === true; }).forEach(function(e) { ['amount','currency','calculationBucket'].forEach(function(f) { requireMeta('EXPENSE', e.expenseId, f); }); });
  (canonical.rates || []).filter(function(r) { return r && r.confirmed === true; }).forEach(function(r) { requireMeta('RATE', r.rateId, 'value'); });

  function checkRefs(refs, path) { (refs || []).forEach(function(ref) { validateEvidence(ref, path); }); }
  (canonical.paymentSchedules || []).forEach(function(ps, pi) {
    checkRefs(ps.lineageRefs, 'paymentSchedules[' + pi + ']');
    (ps.schemes || []).forEach(function(sc, si) {
      checkRefs(sc.lineageRefs, 'paymentSchedules[' + pi + '].schemes[' + si + ']');
      (sc.stages || []).forEach(function(st, ti) {
        checkRefs(st.lineageRefs, 'paymentSchedules[' + pi + '].schemes[' + si + '].stages[' + ti + ']');
        (st.allocations || []).forEach(function(a, ai) { checkRefs(a.lineageRefs, 'paymentSchedules[' + pi + '].schemes[' + si + '].stages[' + ti + '].allocations[' + ai + ']'); });
      });
    });
  });
  return bbcReleaseAValidationResult_(issues);
}

function validateCanonicalRuleBindingsAgainstRegistry_(canonical, ruleRegistry) {
  var issues = [];
  var active = new Map((ruleRegistry && ruleRegistry.rules || []).filter(function(rule) { return rule && rule.status === 'ACTIVE'; }).map(function(rule) { return [String(rule.ruleId || ''), rule]; }));
  (canonical.ruleBindings || []).forEach(function(binding, index) {
    var path = 'ruleBindings[' + index + ']', ruleId = String(binding.ruleId || ''), version = String(binding.ruleVersion || binding.version || '');
    var registryRule = active.get(ruleId);
    if (!registryRule) { issues.push(bbcReleaseAIssue_('RULE_BINDING_NOT_ACTIVE', path, 'Rule binding does not reference an ACTIVE registry rule: ' + ruleId)); return; }
    if (String(registryRule.version || '') !== version) issues.push(bbcReleaseAIssue_('RULE_BINDING_VERSION_MISMATCH', path, 'Rule binding version does not match active registry version for ' + ruleId + '.'));
    var fields=Array.isArray(binding.fieldCodes)?binding.fieldCodes:[],schemes=Array.isArray(binding.schemeCodes)?binding.schemeCodes:[],dealScheme=String(canonical&&canonical.deal&&canonical.deal.scheme||'');
    if(!fields.length)issues.push(bbcReleaseAIssue_('RULE_BINDING_FIELDS_REQUIRED',path+'.fieldCodes','Explicit field applicability is required.'));
    if(!schemes.length)issues.push(bbcReleaseAIssue_('RULE_BINDING_SCHEMES_REQUIRED',path+'.schemeCodes','Explicit scheme applicability is required.'));
    fields.forEach(function(fieldCode){if((registryRule.appliesToFieldCodes||[]).indexOf(fieldCode)<0)issues.push(bbcReleaseAIssue_('RULE_BINDING_FIELD_NOT_ALLOWED',path+'.fieldCodes','Rule '+ruleId+' is not registered for '+fieldCode+'.'));});
    if(schemes.indexOf(dealScheme)<0)issues.push(bbcReleaseAIssue_('RULE_BINDING_WRONG_SCHEME',path+'.schemeCodes','Rule binding does not include current deal scheme '+dealScheme+'.'));
    schemes.forEach(function(scheme){if((registryRule.appliesToSchemes||[]).indexOf(scheme)<0)issues.push(bbcReleaseAIssue_('RULE_BINDING_SCHEME_NOT_ALLOWED',path+'.schemeCodes','Rule '+ruleId+' is not registered for scheme '+scheme+'.'));});
    if(fields.indexOf('commission.percent')>=0&&registryRule.productionEligible!==true)issues.push(bbcReleaseAIssue_('RULE_BINDING_NOT_PRODUCTION_ELIGIBLE',path,'Commission authority must be production-eligible.'));
  });
  return bbcReleaseAValidationResult_(issues);
}

function validateCanonicalDealForCalculation_(canonical, ruleRegistry) {
  var issues = [];
  validateCanonicalDealV1Object_(canonical).issues.forEach(function(x) { issues.push(x); });
  if (['VALIDATED','CONFIRMED'].indexOf(String(canonical && canonical.status || '')) < 0) issues.push(bbcReleaseAIssue_('CANONICAL_STATUS_NOT_CALCULABLE', 'status', 'Only VALIDATED or CONFIRMED Canonical Deal may be calculated.'));
  validateReleaseALineageCoverage_(canonical).issues.forEach(function(x) { issues.push(x); });
  validateCanonicalRuleBindingsAgainstRegistry_(canonical, ruleRegistry).issues.forEach(function(x) { issues.push(x); });
  try { bbcReleaseAResolveCalculationRules_(ruleRegistry, 'PRODUCTION', canonical); } catch (e) { issues.push(bbcReleaseAIssue_('RULE_AUTHORITY_BLOCK', 'ruleBindings', String(e && e.message || e))); }
  return bbcReleaseAValidationResult_(issues);
}

function validateCanonicalDealForQuote_(canonical, ruleRegistry) {
  var issues = [];
  validateCanonicalDealForCalculation_(canonical, ruleRegistry).issues.forEach(function(x) { issues.push(x); });
  var deal = canonical && canonical.deal || {}, logistics = deal.logistics || {};
  var fieldMetaIndex = bbcReleaseAFieldMetaIndex_(canonical || {});
  function requiredText(value, path, entityType, entityId, fieldCode, allowNotApplicable) {
    var text = String(value == null ? '' : value).trim();
    var meta = fieldMetaIndex.get(String(entityType || '') + '|' + String(entityId || '') + '|' + String(fieldCode || ''));
    if (allowNotApplicable && String(meta && meta.state || '') === 'NOT_APPLICABLE') return;
    if (!text || aiIsPlaceholder_(text)) issues.push(bbcReleaseAIssue_('QUOTE_FIELD_REQUIRED', path, 'Quote-critical field is unresolved.'));
  }
  requiredText(deal.client, 'deal.client');
  requiredText(deal.manager, 'deal.manager');
  requiredText(deal.scheme, 'deal.scheme');
  var currency = String(deal.quoteCurrency || '').trim().toUpperCase();
  if (['RUB','CNY'].indexOf(currency) < 0) issues.push(bbcReleaseAIssue_('QUOTE_CURRENCY_REQUIRED', 'deal.quoteCurrency', 'quoteCurrency must explicitly be RUB or CNY.'));
