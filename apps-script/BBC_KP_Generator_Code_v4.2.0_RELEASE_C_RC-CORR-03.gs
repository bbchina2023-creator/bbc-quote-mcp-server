function validateDev015RenderedTotals_(quoteSheet, result, context) {
  const expectedRub = roundMoney_(Number(result.totalRub || 0));
  const expectedCny = roundMoney_(Number(result.totalCny || 0));
  const sectionRows = [22, 28, 35, 36, 51];
  const summaryRows = [56, 57, 58, 59];
  const sumColumn = (rows, column) => roundMoney_(rows.reduce(
    (sum, row) => sum + Number(quoteSheet.getRange(row, column).getValue() || 0),
    0
  ));
  const sectionRub = sumColumn(sectionRows, 6);
  const sectionCny = sumColumn(sectionRows, 5);
  const summaryRub = sumColumn(summaryRows, 6);
  const summaryCny = sumColumn(summaryRows, 5);
  const displayedRub = roundMoney_(Number(quoteSheet.getRange('F60').getValue() || 0));
  const displayedCny = roundMoney_(Number(quoteSheet.getRange('E60').getValue() || 0));
  const paymentRub = context ? roundMoney_(sumNumbers_(
    quoteSheet.getRange('F65:F73').getValues().flat().map(value => Number(value || 0))
  )) : expectedRub;
  const paymentCny = context ? roundMoney_(sumNumbers_(
    quoteSheet.getRange('E65:E73').getValues().flat().map(value => Number(value || 0))
  )) : expectedCny;

  const failures = [];
  if (Math.abs(sectionRub - expectedRub) > 0.01) failures.push(`сумма разделов ${sectionRub} RUB`);
  if (Math.abs(summaryRub - expectedRub) > 0.01) failures.push(`сумма итоговых групп ${summaryRub} RUB`);
  if (Math.abs(displayedRub - expectedRub) > 0.01) failures.push(`итог КП ${displayedRub} RUB`);
  if (Math.abs(sectionCny - expectedCny) > 0.01) failures.push(`сумма разделов ${sectionCny} CNY`);
  if (Math.abs(summaryCny - expectedCny) > 0.01) failures.push(`сумма итоговых групп ${summaryCny} CNY`);
  if (Math.abs(displayedCny - expectedCny) > 0.01) failures.push(`итог КП ${displayedCny} CNY`);
  if (Math.abs(paymentRub - expectedRub) > 0.01) failures.push(`график платежей ${paymentRub} RUB`);
  if (Math.abs(paymentCny - expectedCny) > 0.01) failures.push(`график платежей ${paymentCny} CNY`);
  if (failures.length) {
    throw new Error(
      'Контроль DEV-015.4 не пройден: ' + failures.join('; ') +
      `. Проверенный итог: ${expectedRub} RUB / ${expectedCny} CNY.`
    );
  }

  if (context) {
    const protectedFields = [
      ['менеджер', 'F7'], ['срок производства', 'B11'],
      ['срок доставки', 'B12'], ['маршрут', 'B13'],
      ['погранпереход', 'B14'], ['Incoterms', 'D14'], ['тип транспорта', 'B15']
    ];
    const lost = protectedFields.filter(entry => {
      const value = quoteSheet.getRange(entry[1]).getDisplayValue();
      return aiIsPlaceholder_(value) || /^\s*согласуется\s*$/i.test(String(value || ''));
    }).map(entry => entry[0]);
    if (lost.length) {
      throw new Error(`Контроль полноты клиентского КП не пройден: ${lost.join(', ')}.`);
    }
  }
}


