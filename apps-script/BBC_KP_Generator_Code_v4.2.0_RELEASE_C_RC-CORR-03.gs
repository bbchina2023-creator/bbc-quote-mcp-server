  const out = {canonical:null,payments:[],rules:null,decisions:[],snapshot:null};
  out.canonical = bbcReleaseAIdempotentStoreWrite_(spreadsheet.getSheetByName(BBC_RELEASE_A_PHASE4.stores.canonical),defs.canonical,{canonical_id:canonical.canonicalId,deal_id:canonical.dealId,revision:canonical.revision,status:canonical.status,canonical_hash:snapshot.canonicalHash,payload_json:bbcReleaseAStableStringify_(canonical),created_at:created,created_by:canonical.createdBy||BBC_DOCUMENT_CONTOUR.createdBy},['canonical_id','revision']);
