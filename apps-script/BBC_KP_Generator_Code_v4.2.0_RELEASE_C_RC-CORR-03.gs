function hardenExistingDictionaries_(spreadsheet) {
  const vat = spreadsheet.getSheetByName(BBC_MVP.sheets.vat);
  if (vat && vat.getLastRow() > 1) {
    const range = vat.getRange(2, 1, vat.getLastRow() - 1, 11);
    const rows = range.getValues();
    let changed = false;
    rows.forEach(row => {
      const hasConfirmedScope = String(row[4] || '').trim() !== '';
      const needsConfirmation = /подтвержден/i.test(
        `${row[8] || ''} ${row[10] || ''}`
      );
      if (!hasConfirmedScope && needsConfirmation && row[9] === true) {
        row[8] = 'Требует подтверждения';
        row[9] = false;
        changed = true;
      }
    });
    if (changed) range.setValues(rows);
  }

  const duties = spreadsheet.getSheetByName(BBC_MVP.sheets.duties);
  if (duties && duties.getLastRow() > 1) {
    const range = duties.getRange(2, 1, duties.getLastRow() - 1, 13);
    const rows = range.getValues();
    let changed = false;
    rows.forEach(row => {
      if (String(row[4]).trim().toUpperCase() !== 'MAX_OF_METHODS') return;
      row[11] = false;
      row[12] = mergeSystemComment_(
        row[12],
        'Отключено v2.5.0: метод пошлины должен выбираться по правилу, а не по максимуму'
      );
      changed = true;
    });
    if (changed) range.setValues(rows);
  }
}

