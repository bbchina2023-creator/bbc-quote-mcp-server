  var existing=(canonical.allocations||[]).map(bbcReleaseADeepClone_);
  var byExpense=new Map();
  existing.forEach(function(a){if(!byExpense.has(String(a.expenseId)))byExpense.set(String(a.expenseId),[]);byExpense.get(String(a.expenseId)).push(a);});
  if(items.length<=1) return {allocations:existing,generated:[],validation:{ok:true,issues:[]}};
  var itemBases=items.map(function(item){
    var converted=convertMoneyForCalculation_(Number(item.batchAmount),String(item.priceCurrency||'').toUpperCase(),rateBook.selected);
    if(converted.error||!(Number(converted.amountRub)>=0))throw new Error('Release A cannot determine allocation base for '+item.itemId+': '+(converted.error||'missing batch value'));
    return {item:item,rub:Number(converted.amountRub),cny:Number(converted.amountCny)};
  });
  var totalBaseRub=sumNumbers_(itemBases.map(function(x){return x.rub;}));
  if(!(totalBaseRub>0))throw new Error('Release A allocation base is zero.');
  var generated=[];
  (canonical.expenses||[]).filter(function(e){return e&&e.includeInCalculation===true&&!e.itemId;}).forEach(function(expense){
    var rows=byExpense.get(String(expense.expenseId))||[];
    if(rows.length){
      var coveredItems=new Set(rows.map(function(row){return String(row.itemId||'');}));
      if(coveredItems.size!==items.length)throw new Error('Release A explicit allocations do not cover every item for expense '+expense.expenseId+'.');
      var converted=convertMoneyForCalculation_(Number(expense.amount),String(expense.currency||'').toUpperCase(),rateBook.selected);
      if(converted.error)throw new Error('Release A cannot validate allocation for '+expense.expenseId+': '+converted.error);
      var rub=sumNumbers_(rows.map(function(a){return Number(a.amountRub||0);}));
      var cny=sumNumbers_(rows.map(function(a){return Number(a.amountCny||0);}));
      var tol=options.tolerance==null?0.00001:Number(options.tolerance);
      if(Math.abs(rub-Number(converted.amountRub))>tol||Math.abs(cny-Number(converted.amountCny))>tol)throw new Error('Release A explicit allocations do not reconcile expense '+expense.expenseId+'.');
      return;
    }
    if(String(expense.allocationMethod||'').toUpperCase()!=='GOODS_VALUE_SHARE') throw new Error('Release A multi-item expense '+expense.expenseId+' requires explicit allocations or GOODS_VALUE_SHARE.');
    var converted=convertMoneyForCalculation_(Number(expense.amount),String(expense.currency||'').toUpperCase(),rateBook.selected);
    if(converted.error)throw new Error('Release A cannot allocate '+expense.expenseId+': '+converted.error);
    var usedRub=0,usedCny=0;
    itemBases.forEach(function(base,index){
      var last=index===itemBases.length-1;
      var share=base.rub/totalBaseRub;
      var amountRub=last?roundTo_(Number(converted.amountRub)-usedRub,8):roundTo_(Number(converted.amountRub)*share,8);
      var amountCny=last?roundTo_(Number(converted.amountCny)-usedCny,8):roundTo_(Number(converted.amountCny)*share,8);
      usedRub=roundTo_(usedRub+amountRub,8);usedCny=roundTo_(usedCny+amountCny,8);
      var a={allocationId:stableId_('ALLOC_RELEASE_A',[canonical.dealId,expense.expenseId,base.item.itemId,'GOODS_VALUE_SHARE']),expenseId:expense.expenseId,itemId:base.item.itemId,method:'GOODS_VALUE_SHARE',basis:String(roundTo_(base.rub,8)),share:roundTo_(share,12),amountCny:amountCny,amountRub:amountRub,manualAdjustment:false};
      generated.push(a);existing.push(a);
    });
  });
  return {allocations:existing,generated:generated,validation:{ok:true,issues:[]}};
}

function buildItemExpenseMapReleaseA_(model, items, expenses) {
  var map=new Map(items.map(function(item){return [item.id,[]];}));
  if(items.length===1){map.set(items[0].id,expenses.slice());return map;}
  var allocationByExpense=new Map();
  (model.normalizedAllocations||[]).forEach(function(a){
    if(!allocationByExpense.has(String(a.expenseId)))allocationByExpense.set(String(a.expenseId),[]);
    allocationByExpense.get(String(a.expenseId)).push(a);
  });
  expenses.forEach(function(expense){
    if(expense.itemId&&map.has(expense.itemId)){map.get(expense.itemId).push(expense);return;}
    (allocationByExpense.get(String(expense.id))||[]).forEach(function(a){if(map.has(String(a.itemId)))map.get(String(a.itemId)).push(Object.assign({},expense,{amountCny:a.amountCny,amountRub:a.amountRub,allocated:true}));});
  });
  return map;
}

function calculateItemLevelModelReleaseA_(model, convertedItems, convertedExpenses) {
  const partnerDutyRub = sumNumbers_(
    convertedExpenses
      .filter(expense => expense.bucket === 'customsDuty' && expense.amountRub !== null)
      .map(expense => expense.amountRub)
  );
  const partnerVatRub = sumNumbers_(
    convertedExpenses
      .filter(expense => expense.bucket === 'vat' && expense.amountRub !== null)
      .map(expense => expense.amountRub)
  );
  const internationalRub = sumNumbers_(
    convertedExpenses
      .filter(expense => expense.bucket === 'internationalLogistics' && expense.amountRub !== null)
      .map(expense => expense.amountRub)
  );

  const rows = [];
  const errors = [];
  const warnings = [];
  const itemCount = convertedItems.length;

  convertedItems.forEach(convertedItem => {
    const item = (model.normalizedItems || []).find(
      candidate => String(candidate.itemId) === String(convertedItem.id)
    );
    if (!item) {
      errors.push({
        itemId: convertedItem.id,
        field: 'Товар',
        message: 'Нормализованная товарная запись не найдена.'
      });
      return;
    }

    const allocatedInternationalRub = itemCount === 1
      ? internationalRub
      : (sumAllocatedExpenseBucketForItem_(
          model, convertedExpenses, 'internationalLogistics', item.itemId, 'rub'
        ) || 0);

    const goodsRub = convertedItem.amountRub;
    const allocatedChinaDeliveryRub = itemCount === 1
      ? sumNumbers_((convertedExpenses || []).filter(expense => expense.bucket === 'chinaDelivery').map(expense => Number(expense.amountRub || 0)))
      : (sumAllocatedExpenseBucketForItem_(model, convertedExpenses, 'chinaDelivery', item.itemId, 'rub') || 0);
    const customsBaseRub = goodsRub === null
      ? null
      : roundTo_(goodsRub + allocatedChinaDeliveryRub + allocatedInternationalRub, 8);

    const allocatedDutyRub = itemCount > 1
      ? sumAllocatedExpenseBucketForItem_(model, convertedExpenses, 'customsDuty', item.itemId, 'rub')
      : null;
    const allocatedVatRub = itemCount > 1
      ? sumAllocatedExpenseBucketForItem_(model, convertedExpenses, 'vat', item.itemId, 'rub')
      : null;
    const partnerDutyForItem = itemCount === 1 && partnerDutyRub !== null
      ? roundTo_(partnerDutyRub, 8)
      : allocatedDutyRub;
    const partnerVatForItem = itemCount === 1 && partnerVatRub !== null
      ? roundTo_(partnerVatRub, 8)
      : allocatedVatRub;

    let dutyRub = null;
    const dutyWeightKg = item.grossWeightKg || item.netWeightKg || null;
    let dutyError = '';
    let dutyComment = '';
    let method = String(item.dutyMethod || '').trim().toUpperCase();

    /*
     * DEV-009:
     * Когда партнёр передал подтверждённую итоговую сумму пошлины, но не раскрыл
     * метод, базу или ставку, эта сумма принимается как PARTNER_TOTAL.
     * Правило безопасно только для одной агрегированной товарной записи.
     */
    const usePartnerDutyTotal =
      partnerDutyForItem !== null &&
      partnerDutyForItem >= 0 &&
      (!item.dutyMethodConfirmed || !method);

    if (usePartnerDutyTotal) {
      method = itemCount > 1 ? 'PARTNER_TOTAL_ALLOCATED' : 'PARTNER_TOTAL';
      dutyRub = partnerDutyForItem;
      dutyComment =
        itemCount > 1
          ? 'Подтверждённая итоговая сумма пошлины партнёра распределена между товарами пропорционально стоимости партий.'
          : 'Использована подтверждённая итоговая сумма пошлины партнёра; детальная формула в исходном файле отсутствует.';
    } else if (!item.dutyMethodConfirmed) {
      dutyError = 'Метод пошлины не подтвержден.';
    } else if (method === 'PERCENT') {
      if (customsBaseRub === null) {
        dutyError = 'Не рассчитана таможенная база.';
      } else if (!(item.dutyRate >= 0)) {
        dutyError = 'Не указана процентная ставка пошлины.';
      } else {
        const rate = item.dutyRate > 1 ? item.dutyRate / 100 : item.dutyRate;
        dutyRub = roundTo_(customsBaseRub * rate, 8);
      }
    } else if (['EUR_PER_KG', 'USD_PER_KG'].includes(method)) {
      const rateCurrency = method.substring(0, 3);
      const fx = model.rateBook.selected.get(`${rateCurrency}_RUB_RATE`);
      if (!(dutyWeightKg > 0)) {
        dutyError = 'Для пошлины за кг отсутствует подтвержденный вес товара.';
      } else if (!(item.dutyRate >= 0)) {
        dutyError = 'Не указана ставка пошлины за кг.';
      } else if (!fx) {
        dutyError = `Нет подтвержденного курса ${rateCurrency}/RUB для расчета пошлины.`;
      } else {
        dutyRub = roundTo_(dutyWeightKg * item.dutyRate * fx, 8);
      }
    } else if (['FIXED', 'PARTNER_TOTAL'].includes(method)) {
      dutyRub = partnerDutyForItem;
      if (dutyRub === null) {
        dutyError = 'Фиксированная пошлина не привязана к товарной позиции.';
      }
    } else {
      dutyError = `Неподдерживаемый метод пошлины: ${method || 'не указан'}.`;
    }

    if (dutyError) {
      errors.push({
        itemId: item.itemId,
        field: 'Таможенная пошлина',
        message: dutyError
      });
    }

    let importVatRub = null;
    let importVatBaseRub = null;
    let vatError = '';
    let vatComment = '';
    let vatBlockedByDuty = false;

    /*
     * DEV-009:
     * Подтверждённая итоговая сумма импортного НДС партнёра принимается без
     * требования одной ставки, когда в партии применены смешанные ставки либо
     * партнёр не раскрыл детальную формулу. Для нескольких товаров необходима
     * явная привязка суммы НДС к каждой позиции.
     */
    const usePartnerVatTotal =
      partnerVatForItem !== null &&
      partnerVatForItem >= 0 &&
      (!item.importVatConfirmed || !(item.importVatRate >= 0));

    if (usePartnerVatTotal) {
      importVatRub = partnerVatForItem;
      vatComment =
        itemCount > 1
          ? 'Подтверждённая итоговая сумма импортного НДС партнёра распределена между товарами пропорционально стоимости партий; ставки не выдумываются.'
          : 'Использована подтверждённая итоговая сумма импортного НДС партнёра; допускаются смешанные ставки по товарным группам.';
    } else if (!item.importVatConfirmed) {
      vatError = 'Ставка импортного НДС не подтверждена.';
    } else if (!(item.importVatRate >= 0)) {
      vatError = 'Не указана ставка импортного НДС.';
    } else if (customsBaseRub === null) {
      vatError = 'НДС не рассчитан: отсутствует таможенная база.';
    } else if (dutyRub === null) {
      vatBlockedByDuty = true;
    } else {
      const vatRate = item.importVatRate > 1 ? item.importVatRate / 100 : item.importVatRate;
      importVatBaseRub = roundTo_(customsBaseRub + dutyRub, 8);
      importVatRub = roundTo_(importVatBaseRub * vatRate, 8);
    }

    if (vatError) {
      errors.push({
        itemId: item.itemId,
        field: 'Импортный НДС',
        message: vatError
      });
    }

    const dutyDelta = dutyRub !== null && partnerDutyForItem !== null
      ? roundTo_(dutyRub - partnerDutyForItem, 8)
      : null;
    const vatDelta = importVatRub !== null && partnerVatForItem !== null
      ? roundTo_(importVatRub - partnerVatForItem, 8)
      : null;
    const vatRateRecalculationTrace = {explained:false, source:'RELEASE_A_PURE_CORE'};

    rows.push({
      calculationId: stableId_('LINE_CALC', [model.dealId, item.itemId]),
      dealId: model.dealId,
      itemId: item.itemId,
      date: model.calculatedAt,
      goodsMode: item.priceType || 'PARTNER_TOTAL',
      goodsRub,
      internationalRub: allocatedInternationalRub,
      customsBaseRub,
      dutyMethod: method,
      dutyWeightKg,
      dutyRate: item.dutyRate,
      dutyCurrency: item.dutyCurrency,
      dutyRub,
      partnerDutyRub: partnerDutyForItem,
      dutyDelta,
      importVatRate: item.importVatRate,
      importVatBaseRub,
      importVatRub,
      partnerVatRub: partnerVatForItem,
      vatDelta,
      vatRateRecalculationTrace,
      status: dutyError || vatError || vatBlockedByDuty ? 'ERROR' : 'CALCULATED',
      comment: [
        dutyComment,
        vatComment,
        dutyError,
        vatError,
        vatBlockedByDuty ? 'НДС не рассчитан вследствие ошибки расчета пошлины.' : ''
      ].filter(Boolean).join(' ')
    });
  });

  return {rows, errors, warnings};
}

function calculateDealModelReleaseA_(model) {
  const conversionErrors = [];

  const convertedItems = (model.normalizedItems || []).map(item => {
    const amount = Number(item.batchValue);
    const currency = String(item.priceCurrency || '').trim().toUpperCase();
    const converted = convertMoneyForCalculation_(amount, currency, model.rateBook.selected);
    if (converted.error) conversionErrors.push({entity:item.itemId,field:'Стоимость партии',error:converted.error});
    return {id:String(item.itemId),row:null,amount:amount,currency:currency,amountCny:converted.amountCny,amountRub:converted.amountRub,quantity:Number(item.quantity)};
  });

  const allConvertedExpenses = (model.normalizedExpenses || []).filter(function(expense){return expense.includeInternal===true;}).map(expense => {
    const amount = Number(expense.amount);
    const currency = String(expense.currency || '').trim().toUpperCase();
    const converted = convertMoneyForCalculation_(amount, currency, model.rateBook.selected);
    if (converted.error) conversionErrors.push({entity:expense.expenseId,field:'Сумма расхода',error:converted.error});
    if (BBC_RELEASE_A.expenseBuckets.indexOf(String(expense.calculationBucket || '')) < 0) conversionErrors.push({entity:expense.expenseId,field:'calculationBucket',error:'Unknown canonical calculation bucket.'});
    return {id:String(expense.expenseId),row:null,amount:amount,currency:currency,amountCny:converted.amountCny,amountRub:converted.amountRub,bucket:String(expense.calculationBucket || ''),itemId:String(expense.itemId || '')};
  });

  const itemLineCalculation = calculateItemLevelModelReleaseA_(
    model,
    convertedItems,
    allConvertedExpenses
  );
  const decisionApplication = {applications: [], errors: []};

  /*
   * Ранее вручную внесённая комиссия BBC исключается,
   * чтобы новая рассчитанная комиссия не учитывалась второй раз.
   */
  // DEV-016.40: партнёрские строки пошлины/НДС — evidence, а не финальная
  // калькуляция BBC. В итог включаются детерминированно рассчитанные значения.
  const convertedExpensesBeforeCommission = allConvertedExpenses.filter(
    expense => !['bbcCommission', 'customsDuty', 'vat'].includes(expense.bucket)
  );
  const calculatedDutyRub = sumNumbers_((itemLineCalculation.rows || []).map(row => Number(row.dutyRub || 0)));
  const calculatedVatRub = sumNumbers_((itemLineCalculation.rows || []).map(row => Number(row.importVatRub || 0)));
  const cnyRubForCustoms = model.rateBook.selected.get('CNY_RUB_RATE') || 0;
  [
    ['customsDuty', 'Таможенная пошлина BBC', calculatedDutyRub],
    ['vat', 'Импортный НДС BBC', calculatedVatRub]
  ].forEach(spec => {
    const rub = roundTo_(spec[2], 8);
    convertedExpensesBeforeCommission.push({
      id: stableId_('EXP_CALCULATED_' + spec[0].toUpperCase(), [model.dealId]),
      row: [], amount: rub, currency: 'RUB',
      amountCny: cnyRubForCustoms > 0 ? roundTo_(rub / cnyRubForCustoms, 8) : null,
      amountRub: rub, bucket: spec[0], itemId: '', calculated: true,
      article: spec[1]
    });
  });

  // Approved benchmark: export declaration is a separate 1 000 CNY expense,
  // configurable in Settings and inserted only when a source row is absent.
  const hasExplicitExportSupport = convertedExpensesBeforeCommission.some(expense => expense.bucket === 'exportSupport');
  if (!hasExplicitExportSupport) {
    const exportDeclarationCny = Number(model.releaseA.resolvedRules.exportDeclarationCny);
    if (!(exportDeclarationCny >= 0)) throw new Error('Release A requires explicit exportSupport expense or production-eligible export declaration rule.');
    const exportRub = cnyRubForCustoms > 0 ? roundTo_(exportDeclarationCny * cnyRubForCustoms, 8) : null;
    convertedExpensesBeforeCommission.push({
      id: stableId_('EXP_EXPORT_DECLARATION', [model.dealId]), row: [],
      amount: exportDeclarationCny, currency: 'CNY', amountCny: exportDeclarationCny,
      amountRub: exportRub, bucket: 'exportSupport', itemId: '', calculated: true,
      article: 'Расход на экспортную декларацию'
    });
  }

  const preCommissionSummary = calculateMoneySummary_(convertedItems, convertedExpensesBeforeCommission);
  const chinaDeliveryRubForCommission = sumNumbers_(convertedExpensesBeforeCommission.filter(expense => expense.bucket === 'chinaDelivery').map(expense => Number(expense.amountRub || 0)));
  preCommissionSummary.commissionBaseRub = roundTo_(preCommissionSummary.goodsRub + chinaDeliveryRubForCommission, 8);

  const commissionCalculation = calculateBbcCommissionReleaseA_(
    model.commissionInput,
    preCommissionSummary,
    model.rateBook.selected
  );

  if (commissionCalculation.error) {
    conversionErrors.push({
      entity: model.dealId,
      field: 'Комиссия BBC',
      error: commissionCalculation.error
    });
  }

  const calculatedCommissionExpense = {
    id: stableId_('EXP_BBC_COMMISSION', [model.dealId]),
    row: [
      stableId_('EXP_BBC_COMMISSION', [model.dealId]),
      model.dealId,
      '',
      '',
      'Комиссия BBC',
      'Комиссия BBC',
      commissionCalculation.amountRub,
      'RUB'
    ],
    amount: commissionCalculation.amountRub,
    currency: 'RUB',
    amountCny: commissionCalculation.amountCny,
    amountRub: commissionCalculation.amountRub,
    bucket: 'bbcCommission',
    itemId: '',
    calculated: true
  };

  const convertedExpenses = convertedExpensesBeforeCommission.slice();

  if (
    commissionCalculation.amountRub !== 0 ||
    commissionCalculation.amountCny !== 0 ||
    String(model.commissionInput.type || '').toUpperCase() === 'ZERO'
  ) {
    convertedExpenses.push(calculatedCommissionExpense);
  }

  // DEV-016.40: bank-payment engine is part of the deterministic deal total.
  // Rates are settings-driven; benchmark defaults are 3% for supplier payments
  // and 2% for the incoming BBC-service payment.
  const cnyRubBank = model.rateBook.selected.get('CNY_RUB_RATE') || 0;
  const goodsInvoiceCny = roundTo_(preCommissionSummary.commissionBaseRub / cnyRubBank, 8);
  const exportSupportCny = sumNumbers_(convertedExpenses.filter(expense => expense.bucket === 'exportSupport').map(expense => Number(expense.amountCny || 0)));
  const hasSupplierBankFact = convertedExpenses.some(expense => expense.bucket === 'supplierBankFees');
  const hasIncomingBankFact = convertedExpenses.some(expense => expense.bucket === 'incomingBankFees');
  if (!hasSupplierBankFact && model.releaseA.resolvedRules.supplierBankPercent !== null) {
    const supplierBankPercent = Number(model.releaseA.resolvedRules.supplierBankPercent) / 100;
    if (!(supplierBankPercent >= 0)) throw new Error('Release A requires explicit supplierBankFees expense or production-eligible bank rule.');
    const supplierBankCny = roundTo_(goodsInvoiceCny * supplierBankPercent, 8);
    convertedExpenses.push({id:stableId_('EXP_SUPPLIERBANKFEES',[model.dealId]),row:[],amount:supplierBankCny,currency:'CNY',amountCny:supplierBankCny,amountRub:cnyRubBank>0?roundTo_(supplierBankCny*cnyRubBank,8):null,bucket:'supplierBankFees',itemId:'',calculated:true,article:'Банковские комиссии за оплату поставщику'});
  }
  if (!hasIncomingBankFact && model.releaseA.resolvedRules.incomingBankPercent !== null) {
    const incomingServicePercent = Number(model.releaseA.resolvedRules.incomingBankPercent) / 100;
    if (!(incomingServicePercent >= 0)) throw new Error('Release A requires explicit incomingBankFees expense or production-eligible bank rule.');
    const incomingBankCny = roundTo_((Number(commissionCalculation.amountCny || 0) + exportSupportCny) * incomingServicePercent, 8);
    convertedExpenses.push({id:stableId_('EXP_INCOMINGBANKFEES',[model.dealId]),row:[],amount:incomingBankCny,currency:'CNY',amountCny:incomingBankCny,amountRub:cnyRubBank>0?roundTo_(incomingBankCny*cnyRubBank,8):null,bucket:'incomingBankFees',itemId:'',calculated:true,article:'Банковские комиссии за входящий платеж'});
  }

  const summary = calculateMoneySummary_(convertedItems, convertedExpenses);

  const bucketTotals = emptyExpenseBuckets_();

  convertedExpenses.forEach(expense => {
    if (expense.amountCny === null || expense.amountRub === null) return;

    bucketTotals[expense.bucket].cny += expense.amountCny;
    bucketTotals[expense.bucket].rub += expense.amountRub;
  });

  Object.keys(bucketTotals).forEach(key => {
    bucketTotals[key].cny = roundTo_(bucketTotals[key].cny, 8);
    bucketTotals[key].rub = roundTo_(bucketTotals[key].rub, 8);
  });

  /*
   * Рассчитанная комиссия BBC является расходом всей сделки,
   * поэтому не распределяется между товарами автоматически.
   */
  const itemExpenseMap = buildItemExpenseMapReleaseA_(
    model,
    convertedItems,
    convertedExpensesBeforeCommission
  );

  return Object.assign(summary, {
    convertedItems,
    convertedExpenses,
    originalConvertedExpenses: allConvertedExpenses,
    itemLineCalculation,
    decisionApplication,
    bucketTotals,
    itemExpenseMap,
    conversionErrors,
    commissionCalculation,
    preCommissionSummary,
    cnyRub: model.rateBook.selected.get('CNY_RUB_RATE') || null,
    usdRub: model.rateBook.selected.get('USD_RUB_RATE') || null,
    eurRub: model.rateBook.selected.get('EUR_RUB_RATE') || null
  });
}

function calculateReleaseAPureCandidate_(canonical, ruleRegistry, options) {
  options=options||{};
  var plan=prepareReleaseAAllocations_(canonical,ruleRegistry,options);
  var prepared=bbcReleaseADeepClone_(canonical);
  prepared.allocations=plan.allocations;
  var model=buildReleaseACalculationModelFromCanonical_(prepared,ruleRegistry,options);
  var result=calculateDealModelReleaseA_(model);
  return {canonical:prepared,allocationPlan:plan,model:model,result:result};
}

function isSnapshotV2Applicable_(snapshot, canonical, ruleRegistry) {
  var reasons=[];
  if(!snapshot||String(snapshot.snapshotVersion||'')!=='2.0')reasons.push('SNAPSHOT_VERSION');
  if(!canonical||String(snapshot.dealId||'')!==String(canonical&&canonical.dealId||''))reasons.push('DEAL_ID');
  if(snapshot&&canonical&&String(snapshot.canonicalHash||'')!==bbcReleaseASha256Hex_(canonical))reasons.push('CANONICAL_HASH');
  if(snapshot&&canonical&&String(snapshot.paymentHash||'')!==bbcReleaseASha256Hex_(canonical.paymentSchedules||[]))reasons.push('PAYMENT_HASH');
  if(snapshot&&ruleRegistry&&String(snapshot.ruleSetHash||'')!==bbcReleaseASha256Hex_(ruleRegistry))reasons.push('RULE_SET_HASH');
  if(snapshot&&snapshot.immutable!==true)reasons.push('IMMUTABLE_FLAG');
  if(snapshot&&String(snapshot.status||'')!=='VERIFIED')reasons.push('STATUS');
  return {ok:reasons.length===0,reasons:reasons};
}

function runReleaseAPhase3UnitTests_() {
  var results=[];
