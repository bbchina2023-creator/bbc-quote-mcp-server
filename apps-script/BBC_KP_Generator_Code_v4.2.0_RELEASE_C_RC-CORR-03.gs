/**
 * Подготовка текста для сопоставления.
 */
function normalizeRecognitionText_(value) {
  return String(value || '')
    .toLowerCase()
    .replace(/ё/g, 'е')
    .replace(/\u00a0/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}


/**
 * Запись результатов распознавания.
 */
function writeRecognizedFields_(spreadsheet, rows) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.recognized);
  replaceImportRowsPreservingReview_(sheet, rows, 2, 22, 23);

  if (sheet.getLastRow() > 1) {
    const validation = SpreadsheetApp
      .newDataValidation()
      .requireValueInList(
        [
          'Требует проверки',
          'Подтверждено',
          'Исправлено',
          'Не применять'
        ],
        true
      )
      .setAllowInvalid(false)
      .build();

    sheet
      .getRange(2, 22, sheet.getLastRow() - 1, 1)
      .setDataValidation(validation);
  }

  if (!sheet.getFilter()) {
    sheet
      .getRange(
        1,
        1,
        Math.max(sheet.getLastRow(), 2),
        23
      )
      .createFilter();
  }

  sheet.autoResizeColumns(1, 23);

  for (
    let column = 1;
    column <= 23;
    column++
  ) {
    const width = sheet.getColumnWidth(column);

    if (width < 110) {
      sheet.setColumnWidth(column, 110);
    }

    if (width > 320) {
      sheet.setColumnWidth(column, 320);
    }
  }
}

function replaceImportRowsPreservingReview_(
  sheet, newRows, importIdColumn, statusColumn, commentColumn
) {
  if (!newRows || newRows.length === 0) return;
  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  try {
  const importId = String(newRows[0][importIdColumn - 1]);
  const width = newRows[0].length;
  const existing = sheet.getLastRow() > 1
    ? sheet.getRange(2, 1, sheet.getLastRow() - 1, width).getValues()
    : [];
  const reviews = new Map();
  const kept = [];
  existing.forEach(row => {
    if (String(row[importIdColumn - 1]) === importId) {
      reviews.set(String(row[0]), [
        row[statusColumn - 1], row[commentColumn - 1]
      ]);
    } else {
      kept.push(row);
    }
  });
  newRows.forEach(row => {
    const review = reviews.get(String(row[0]));
    if (review) {
      row[statusColumn - 1] = review[0];
      row[commentColumn - 1] = review[1];
    }
  });
  if (sheet.getLastRow() > 1) {
    sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getMaxColumns())
      .clearContent();
  }
  appendRows_(sheet, kept.concat(newRows));
  } finally {
    lock.releaseLock();
  }
}
/**
 * BBC КП Generator — связывание распознанных заголовков
 * с соседними значениями.
 *
 * Ищет значение:
 * 1. справа от заголовка;
 * 2. ниже заголовка;
 * 3. в ближайших ячейках той же строки;
 * 4. в ближайших ячейках следующей строки.
 */

function linkRecognizedFieldsToValues() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();

  const recognizedSheet =
    spreadsheet.getSheetByName(BBC_MVP.sheets.recognized);

  const cellsSheet =
    spreadsheet.getSheetByName(BBC_MVP.sheets.importCells);

  if (!recognizedSheet || !cellsSheet) {
    SpreadsheetApp.getUi().alert(
      'Не найдены листы «Распознанные поля» или «Импорт — ячейки».'
    );
    return;
  }

  const recognizedLastRow =
    recognizedSheet.getLastRow();

  const cellsLastRow =
    cellsSheet.getLastRow();

  if (recognizedLastRow < 2 || cellsLastRow < 2) {
    SpreadsheetApp.getUi().alert(
      'Недостаточно данных для связывания значений.'
    );
    return;
  }

  const importId = promptImportId_('Связывание значений');
  if (!importId) return;

  const allRecognizedRows = recognizedSheet
    .getRange(
      2,
      1,
      recognizedLastRow - 1,
      23
    )
    .getValues()
    .filter(row => String(row[1]) === importId);

  const recognizedRows = allRecognizedRows
    .filter(row => String(row[12]) === 'Да');

  const cellRows = cellsSheet
    .getRange(
      2,
      1,
      cellsLastRow - 1,
      15
    )
    .getValues()
    .filter(row => String(row[0]) === importId);

  if (recognizedRows.length === 0 || cellRows.length === 0) {
    SpreadsheetApp.getUi().alert(`Для import_id ${importId} недостаточно данных.`);
    return;
  }

  const cellIndex = buildCellIndex_(cellRows);

  const resultRows = recognizedRows.map(row => {
    const recognitionId = row[0];
    const dealId = row[2];
    const sourceFileId = row[3];
    const sourceFile = row[4];
    const sheetName = row[5];
    const rowNumber = Number(row[6]);
    const columnNumber = Number(row[7]);
    const labelCell = row[8];
    const labelValue = row[9];
    const cellRole = row[11];
    const linkEligibility = row[12];
    const fieldGroup = row[13];
    const fieldCode = row[14];
    const fieldName = row[15];
    const expectedType = row[16];
    const currency = row[17];
    const unit = row[18];
    const confidence = row[19];

    const linked = findLinkedValue_(
      cellIndex,
      sourceFileId,
      sheetName,
      rowNumber,
      columnNumber,
      fieldCode,
      expectedType
    );

    return [
      stableId_('LNK', [recognitionId]),
      recognitionId,
      importId,
      dealId,
      sourceFileId,
      sourceFile,
      sheetName,
      labelCell,
      labelValue,
      cellRole,
      linkEligibility,
      fieldGroup,
      fieldCode,
      fieldName,
      expectedType,
      linked.valueCell,
      linked.displayValue,
      linked.rawValue,
      normalizeLinkedValue_(linked, fieldCode, expectedType),
      safeSpreadsheetText_(linked.formula),
      linked.detectedType,
      linked.detectedCurrency || currency,
      linked.detectedUnit || unit,
      linked.direction,
      linked.distance,
      linked.confidence || confidence,
      linked.status,
      linked.reason,
      'Требует проверки',
      ''
    ];
  });

  writeLinkedFields_(spreadsheet, resultRows);

  const linkedCount = resultRows.filter(
    row => row[15] !== ''
  ).length;

  const notFoundCount =
    resultRows.length - linkedCount;

  SpreadsheetApp.getUi().alert(
    'Связывание показателей завершено.\n\n' +
    `Всего распознанных полей: ${allRecognizedRows.length}\n` +
    `Допущено к связыванию: ${resultRows.length}\n` +
    `Исключено других ролей: ${allRecognizedRows.length - resultRows.length}\n` +
    `Найдено значений: ${linkedCount}\n` +
    `Значение не найдено: ${notFoundCount}\n\n` +
    'Результат записан на лист:\n' +
    '«Связанные показатели»'
  );

  writeLog_(
    'USER',
      'LINK_RECOGNIZED_VALUES',
      recognizedRows[0][2],
    `Связано значений: ${linkedCount}; ` +
    `не найдено: ${notFoundCount}`
  );
}


/**
 * Индексирует все импортированные ячейки.
 */
function buildCellIndex_(rows) {
  const index = {};

  rows.forEach(row => {
    const sourceFileId = row[2];
    const sheetName = row[4];
    const rowNumber = Number(row[5]);
    const columnNumber = Number(row[6]);

    const key = buildCellKey_(
      sourceFileId,
      sheetName,
      rowNumber,
      columnNumber
    );

    index[key] = {
      sourceFileId,
      sheetName,
      rowNumber,
      columnNumber,
      cellAddress: row[7],
      rawValue: row[8],
      displayValue: row[9],
      formula: row[10],
      numberFormat: row[11],
      detectedType: row[12],
      detectedCurrency: row[13],
      detectedUnit: row[14]
    };
  });

  return index;
}


/**
 * Ищет наиболее вероятное значение рядом с заголовком.
 */

function findLinkedValue_(
  index,
  sourceFileId,
  sheetName,
  rowNumber,
  columnNumber,
  fieldCode,
  expectedType
) {
  // DEV-009 v3.5.5: направления поиска задаются по типу поля.
  // Это исключает ложные связи с соседними заголовками, курсами,
  // строками платёжного графика и суммами в CNY вместо RUB.
  const sameRowRight = [
    {
      rowOffset: 0,
      columnOffset: 1,
      direction: 'Справа',
      distance: 1,
      priority: 130
    }
  ];

  const belowSameColumn = [
    {
      rowOffset: 1,
      columnOffset: 0,
      direction: 'Снизу',
      distance: 1,
      priority: 130
    }
  ];

  // DEV-016.18: в таблицах юнит-экономики заголовок количества находится
  // над значением (D4 → D5), тогда как в основных расчётных формах значение
  // количества находится справа от заголовка (A17 → B17, A10 → B10).
  const isUnitEconomicsSheet = /юнит[\s\-–—]*экономик/i.test(
    String(sheetName || '')
  );

  const fieldCandidates = {
    CLIENT_NAME: sameRowRight,
    DEAL_NUMBER: sameRowRight,
    ROUTE: sameRowRight,
    BORDER_CROSSING: sameRowRight,
    DELIVERY_TERMS: sameRowRight,
    ITEM_NAME: belowSameColumn,
    ARTICLE: sameRowRight,
    TN_VED: sameRowRight,
    QUANTITY: isUnitEconomicsSheet ? belowSameColumn : sameRowRight,
    TOTAL_WEIGHT: sameRowRight,
    VOLUME: sameRowRight,
    VEHICLE_TYPE: sameRowRight,
    USD_RUB_RATE: sameRowRight,
    CNY_RUB_RATE: sameRowRight
  };

  let candidates = fieldCandidates[fieldCode]
    ? fieldCandidates[fieldCode].map(candidate => ({ ...candidate }))
    : [];

  // Сертификация в КП Грихно: B38 → F38.
  if (fieldCode === 'CERTIFICATION') {
    candidates = [{
      rowOffset: 0,
      columnOffset: 4,
      direction: 'Сумма RUB в той же строке',
      distance: 4,
      priority: 170
    }];
  }

  // Общий итог в КП Грихно: A42 → F47.
  if (fieldCode === 'GRAND_TOTAL') {
    candidates = [{
      rowOffset: 5,
      columnOffset: 5,
      direction: 'ИТОГО ПО СДЕЛКЕ — сумма RUB',
      distance: 10,
      priority: 180
    }];
  }

  if (candidates.length === 0) {
    return {
      valueCell: '',
      displayValue: '',
      rawValue: '',
      formula: '',
      detectedType: '',
      detectedCurrency: '',
      detectedUnit: '',
      direction: '',
      distance: '',
      confidence: 'Низкая',
      status: 'Не найдено',
      reason: 'Поле не относится к безопасным скалярным показателям'
    };
  }

  const found = [];

  candidates.forEach(candidate => {
    const targetRow = rowNumber + candidate.rowOffset;
    const targetColumn = columnNumber + candidate.columnOffset;
    const key = buildCellKey_(
      sourceFileId,
      sheetName,
      targetRow,
      targetColumn
    );
    const cell = index[key];

    if (!cell) return;
    if (!isUsableLinkedValue_(cell, fieldCode, expectedType)) return;

    found.push({
      ...cell,
      direction: candidate.direction,
      distance: candidate.distance,
      priority:
        candidate.priority +
        getValueQualityScore_(cell, fieldCode, expectedType)
    });
  });

  if (found.length === 0) {
    return {
      valueCell: '',
      displayValue: '',
      rawValue: '',
      formula: '',
      detectedType: '',
      detectedCurrency: '',
      detectedUnit: '',
      direction: '',
      distance: '',
      confidence: 'Низкая',
      status: 'Не найдено',
      reason: 'В разрешённой позиции подходящее значение не найдено'
    };
  }

  found.sort((first, second) => second.priority - first.priority);
  const best = found[0];

  return {
    valueCell: best.cellAddress,
    displayValue: best.displayValue,
    rawValue: best.rawValue,
    formula: best.formula,
    detectedType: best.detectedType,
    detectedCurrency: best.detectedCurrency,
    detectedUnit: best.detectedUnit,
    direction: best.direction,
    distance: best.distance,
    confidence:
      best.priority >= 150
        ? 'Высокая'
        : best.priority >= 110
          ? 'Средняя'
          : 'Низкая',
    status: 'Найдено',
    reason:
      `Значение найдено: ${best.direction}; ` +
      `ячейка ${best.cellAddress}`
  };
}


/**
 * Проверяет, может ли ячейка быть значением показателя.
 */
function isUsableLinkedValue_(cell, fieldCode, expectedType) {
  const hasDisplayValue =
    cell.displayValue !== '' &&
    cell.displayValue !== null &&
    typeof cell.displayValue !== 'undefined';

  const hasRawValue =
    cell.rawValue !== '' &&
    cell.rawValue !== null &&
    typeof cell.rawValue !== 'undefined';

  const displayValue = hasDisplayValue
    ? String(cell.displayValue).trim()
    : '';

  const rawValue = hasRawValue
    ? String(cell.rawValue).trim()
    : '';

  // DEV-009: числовой ноль является полноценным значением.
  // Нельзя использовать `value || ''`, поскольку 0 ошибочно превращается
  // в пустую строку и отбрасывается как отсутствие данных.
  if (!hasDisplayValue && !hasRawValue && !cell.formula) {
    return false;
  }

  const normalized =
    normalizeRecognitionText_(displayValue || rawValue);

  if (!normalized) {
    return false;
  }

  const obviousLabels = [
    /^(итого|всего|товар|расходы|услуги)$/,
    /^(наименование|описание|показатель)$/,
    /^(стоимость|сумма|цена|курс)$/,
    /^(доставка|логистика|страховка)$/,
    /^(пошлина|ндс|комиссия)$/
  ];

  if (
    obviousLabels.some(
      pattern => pattern.test(normalized)
    )
  ) {
    return false;
  }

  if (
    /:$/.test(displayValue) ||
    /^(маршрут|пункт|условия|наименование|описание|код|тип|вес|объем|количество|артикул|клиент|заказчик|покупатель)(?:\s|:)/
      .test(normalized)
  ) {
    const labelClassification = classifyImportedCell_(
      `${normalized} ${normalized}`,
      cell.detectedType,
      cell.detectedCurrency,
      cell.detectedUnit
    );
    if (labelClassification.fieldCode) return false;
  }

  const numericExpected = expectedType === 'Число';
  const numericSource = hasRawValue
    ? cell.rawValue
    : cell.displayValue;
  const numericValue = parseFlexibleNumber_(numericSource);
  if (numericExpected && numericValue === null) return false;

  if (/^(—|-|нет|не указано|n\/a)$/i.test(displayValue)) {
    return false;
  }

  if (fieldCode === 'TN_VED') {
    const codes = displayValue.match(/\d{4,14}/g) || [];
    if (codes.length === 0) return false;
  }

  if (
    fieldCode === 'ITEM_NAME' &&
    /(плат[её]ж|перевозк|товар\s*\+\s*услуг|итого|группа)/i.test(displayValue)
  ) {
    return false;
  }

  const textFields = [
    'CLIENT_NAME', 'DEAL_NUMBER', 'ROUTE', 'DELIVERY_TERMS',
    'ITEM_NAME', 'ARTICLE', 'TN_VED'
  ];
  if (textFields.includes(fieldCode) && numericValue !== null && fieldCode !== 'TN_VED') {
    return false;
  }

  return true;
}


/**
 * Дополнительная оценка качества найденного значения.
 */
function getValueQualityScore_(cell, fieldCode, expectedType) {
  let score = 0;

  if (cell.formula) {
    score += 30;
  }

  if (cell.detectedType === 'Число') {
    score += 25;
  }

  if (cell.detectedType === 'Процент') {
    score += 25;
  }

  if (cell.detectedCurrency) {
    score += 15;
  }

  if (cell.detectedUnit) {
    score += 10;
  }

  const text =
    String(
      cell.displayValue === null ||
      typeof cell.displayValue === 'undefined'
        ? ''
        : cell.displayValue
    ).trim();

  if (
    /^[+-]?\d[\d\s.,]*$/.test(text)
  ) {
    score += 20;
  }

  if (
    /^[+-]?\d[\d\s.,]*\s*(руб|₽|cny|rmb|usd|eur|¥|\$|€)$/i
      .test(text)
  ) {
    score += 30;
  }

  if (expectedType === 'Число') {
    const numericSource =
      cell.rawValue !== '' &&
      cell.rawValue !== null &&
      typeof cell.rawValue !== 'undefined'
        ? cell.rawValue
        : cell.displayValue;
    score += parseFlexibleNumber_(numericSource) !== null
      ? 40 : -100;
  }

  if (fieldCode === 'TN_VED') {
    const digits = text.replace(/\D/g, '');
    score += digits.length >= 4 && digits.length <= 14 ? 45 : -100;
  }

  return score;
}

function parseFlexibleNumber_(value) {
  if (typeof value === 'number' && Number.isFinite(value)) return value;
  let text = String(value == null ? '' : value).trim();
  if (!text) return null;
  text = text
    .replace(/[\s\u00a0]/g, '')
    .replace(/[%₽$€¥]/g, '')
    .replace(/(?:RUB|USD|EUR|CNY|RMB|РУБ|ЮАН)/gi, '');
  if (/^-?\d{1,3}(?:[.,]\d{3})+(?:[.,]\d+)?$/.test(text)) {
    const lastComma = text.lastIndexOf(',');
    const lastDot = text.lastIndexOf('.');
    const decimal = Math.max(lastComma, lastDot);
    const fractionLength = text.length - decimal - 1;
    if (fractionLength === 3 && (text.match(/[.,]/g) || []).length === 1) {
      text = text.replace(/[.,]/g, '');
    } else {
      const fraction = text.slice(decimal + 1);
      text = text.slice(0, decimal).replace(/[.,]/g, '') + '.' + fraction;
    }
  } else {
    text = text.replace(',', '.');
  }
  if (!/^-?\d+(?:\.\d+)?$/.test(text)) return null;
  const number = Number(text);
  return Number.isFinite(number) ? number : null;
}

function normalizeLinkedValue_(linked, fieldCode, expectedType) {
  if (!linked || linked.status !== 'Найдено') return '';
  const display = String(linked.displayValue == null ? '' : linked.displayValue)
    .trim();
  if (fieldCode === 'TN_VED') {
    return display.replace(/[\s\u00a0-]/g, '');
  }
  if (expectedType === 'Число') {
    const number = parseFlexibleNumber_(
      linked.rawValue == null || linked.rawValue === ''
        ? linked.displayValue
        : linked.rawValue
    );
    return number === null ? '' : number;
  }
  return display || linked.rawValue;
}


/**
 * Формирует ключ ячейки.
 */
function buildCellKey_(
  sourceFile,
  sheetName,
  rowNumber,
  columnNumber
) {
  return [
    sourceFile,
    sheetName,
    rowNumber,
    columnNumber
  ].join('|||');
}


/**
 * Создаёт лист связанных показателей.
 */
function writeLinkedFields_(
  spreadsheet,
  rows
) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.linked);
  replaceImportRowsPreservingReview_(sheet, rows, 3, 29, 30);

  preserveNormalizedTextValues_(sheet, rows);

  if (sheet.getLastRow() > 1) {
    const validation =
      SpreadsheetApp
        .newDataValidation()
        .requireValueInList(
          [
            'Требует проверки',
            'Подтверждено',
            'Исправлено',
            'Не применять'
          ],
          true
        )
        .setAllowInvalid(false)
        .build();

    sheet
      .getRange(
        2,
        29,
        sheet.getLastRow() - 1,
        1
      )
      .setDataValidation(validation);
  }

  if (!sheet.getFilter()) {
    sheet
      .getRange(
        1,
        1,
        Math.max(sheet.getLastRow(), 2),
        30
      )
      .createFilter();
  }

  sheet.autoResizeColumns(
    1,
    30
  );

  for (
    let column = 1;
    column <= 30;
    column++
  ) {
    const width =
      sheet.getColumnWidth(column);

    if (width < 110) {
      sheet.setColumnWidth(
        column,
        110
      );
    }

    if (width > 320) {
      sheet.setColumnWidth(
        column,
        320
      );
    }
  }
}

function preserveNormalizedTextValues_(sheet, rows) {
  if (!rows || rows.length === 0 || sheet.getLastRow() < 2) return;
  const textByLinkId = new Map();
  rows.forEach(row => {
    if (row[12] === 'TN_VED' && row[18] !== '') {
      textByLinkId.set(String(row[0]), String(row[18]));
    }
  });
  if (textByLinkId.size === 0) return;
  const linkIds = sheet
    .getRange(2, 1, sheet.getLastRow() - 1, 1)
    .getDisplayValues();
  linkIds.forEach((row, index) => {
    const normalized = textByLinkId.get(String(row[0]));
    if (normalized === undefined) return;
    sheet.getRange(index + 2, 19)
      .setNumberFormat('@')
      .setValue(normalized);
  });
}

function recognizeImportedTableRows() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const cellsSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.importCells);
  const targetSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.tableRows);
  if (!cellsSheet || !targetSheet || cellsSheet.getLastRow() < 2) {
    SpreadsheetApp.getUi().alert(
      'Нет данных импорта или не создан лист «Распознанные строки».'
    );
    return;
  }

  const importId = promptImportId_('Распознавание строк таблиц');
  if (!importId) return;

  const cellRows = cellsSheet
    .getRange(2, 1, cellsSheet.getLastRow() - 1, 15)
    .getValues()
    .filter(row => String(row[0]) === importId);

  if (cellRows.length === 0) {
    SpreadsheetApp.getUi().alert(`Для import_id ${importId} ячейки не найдены.`);
    return;
  }

  const groups = buildImportedRowGroups_(cellRows);
  const currencyColumnsBySheet = buildImportedCurrencyColumnMap_(groups);
  const rows = [];
  const sectionBySheet = new Map();

  groups.forEach(group => {
    const orderedCells = [...group.cells.entries()]
      .sort((left, right) => left[0] - right[0]);

    const sectionCell = orderedCells.find(([, cell]) =>
      detectImportedSection_(cell.displayValue || cell.rawValue)
    );
    const hasNumericCell = orderedCells.some(([, cell]) =>
      parseFlexibleNumber_(
        cell.rawValue == null || cell.rawValue === ''
          ? cell.displayValue
          : cell.rawValue
      ) !== null
    );

    if (sectionCell && !hasNumericCell) {
      sectionBySheet.set(
        group.sheetKey,
        detectImportedSection_(sectionCell[1].displayValue || sectionCell[1].rawValue)
      );
      return;
    }

    let labelCell = null;
    let result = null;
    orderedCells.some(([, cell]) => {
      const candidate = classifyImportedTableRow_(cell.displayValue || cell.rawValue);
      if (!candidate.fieldCode) return false;
      labelCell = cell;
      result = candidate;
      return true;
    });

    if (!labelCell || !result) return;

    const amountSelection = selectImportedTableAmount_(
      group,
      labelCell,
      currencyColumnsBySheet.get(group.sheetKey) || new Map()
    );
    if (!amountSelection) return;

    rows.push(buildRecognizedTableRow_(
      group,
      sectionBySheet.get(group.sheetKey) || '',
      labelCell,
      amountSelection.amountCell,
      amountSelection.currencyCell,
      amountSelection.currency,
      amountSelection.amount,
      result
    ));
  });

  detectImportedRates_(groups).forEach(rate => rows.push(rate));
  writeRecognizedTableRows_(spreadsheet, rows);

  const expenses = rows.filter(row => row[20] === 'Расход').length;
  const controls = rows.filter(row => row[20] === 'Контроль').length;
  const rates = rows.filter(row => row[20] === 'Курс валют').length;
  const items = rows.filter(row => row[20] === 'Товар').length;

  SpreadsheetApp.getUi().alert(
    'Распознавание строк таблиц завершено.\n\n' +
    `Всего строк: ${rows.length}\n` +
    `Расходов: ${expenses}\n` +
    `Товарных значений: ${items}\n` +
    `Курсов валют: ${rates}\n` +
    `Контрольных итогов: ${controls}\n\n` +
    'Проверьте лист «Распознанные строки» и установите статусы.'
  );

  writeLog_(
    'USER', 'RECOGNIZE_IMPORTED_TABLE_ROWS', cellRows[0][1],
    `Распознано строк таблиц: ${rows.length}`
  );
}

function buildImportedRowGroups_(rows) {
  const groups = new Map();
  rows.forEach(row => {
    const key = [row[2], row[4], Number(row[5])].join('|||');
    if (!groups.has(key)) {
      groups.set(key, {
        importId: row[0],
        dealId: row[1],
        sourceFileId: row[2],
        sourceFile: row[3],
        sheetName: row[4],
        rowNumber: Number(row[5]),
        sheetKey: [row[2], row[4]].join('|||'),
        cells: new Map()
      });
    }
    groups.get(key).cells.set(Number(row[6]), {
      cellAddress: row[7],
      rowNumber: Number(row[5]),
      columnNumber: Number(row[6]),
      rawValue: row[8],
      displayValue: row[9],
      formula: row[10],
      numberFormat: row[11],
      detectedType: row[12],
      detectedCurrency: row[13],
      detectedUnit: row[14]
    });
  });
  return [...groups.values()].sort((left, right) =>
    left.sheetName.localeCompare(right.sheetName) || left.rowNumber - right.rowNumber
  );
}

/**
 * Определяет валютное назначение столбцов по заголовкам вида
 * «Сумма RUB», «Сумма CNY», а также по самостоятельным обозначениям валют.
 * Это сохраняет старый формат A/B/C и поддерживает клиентские КП B/E/F.
 */
function buildImportedCurrencyColumnMap_(groups) {
  const result = new Map();
  groups.forEach(group => {
    if (!result.has(group.sheetKey)) result.set(group.sheetKey, new Map());
    const columnMap = result.get(group.sheetKey);
    group.cells.forEach((cell, column) => {
      const text = normalizeRecognitionText_(cell.displayValue || cell.rawValue);
      let currency = '';
      if (/сумм.*(?:rub|руб|₽)|(?:rub|руб|₽).*сумм/.test(text)) currency = 'RUB';
      else if (/сумм.*(?:cny|rmb|юан|¥)|(?:cny|rmb|юан|¥).*сумм/.test(text)) currency = 'CNY';
      else if (/сумм.*(?:usd|доллар|\$)|(?:usd|доллар|\$).*сумм/.test(text)) currency = 'USD';
      else if (/сумм.*(?:eur|евро|€)|(?:eur|евро|€).*сумм/.test(text)) currency = 'EUR';
      else currency = normalizeCurrencyCode_(cell.displayValue || cell.rawValue);
      if (currency) columnMap.set(column, currency);
    });
  });
  return result;
}

function selectImportedTableAmount_(group, labelCell, currencyColumns) {
  const numericCandidates = [];

  group.cells.forEach((cell, column) => {
    if (column <= Number(labelCell.columnNumber || 0)) return;
    const sourceValue = cell.rawValue == null || cell.rawValue === ''
      ? cell.displayValue
      : cell.rawValue;
    const amount = parseFlexibleNumber_(sourceValue);
    if (amount === null) return;

    let currency = currencyColumns.get(column) ||
      normalizeCurrencyCode_(cell.detectedCurrency) ||
      detectCurrency_(cell.displayValue);

    const nextCell = group.cells.get(column + 1);
    if (!currency && nextCell) {
      currency = normalizeCurrencyCode_(nextCell.displayValue || nextCell.rawValue);
    }

    numericCandidates.push({
      column,
      amount,
      amountCell: cell,
      currency,
      currencyCell: nextCell && normalizeCurrencyCode_(nextCell.displayValue || nextCell.rawValue)
        ? nextCell
        : {
            cellAddress: cell.cellAddress,
            displayValue: currency,
            rawValue: currency
          }
    });
  });

  if (!numericCandidates.length) return null;

  const currencyPriority = {RUB: 400, CNY: 300, USD: 200, EUR: 100};
  numericCandidates.forEach(candidate => {
    candidate.priority = currencyPriority[candidate.currency] || 0;
    if (candidate.currency) candidate.priority += 50;
    if (candidate.amountCell.detectedType === 'Число') candidate.priority += 20;
    candidate.priority -= candidate.column;
  });

  numericCandidates.sort((left, right) => right.priority - left.priority);
  const best = numericCandidates[0];
  if (!best.currency) return null;

  return best;
}

function detectImportedSection_(label) {
  const text = normalizeRecognitionText_(label);
  if (/расход.*(перевоз|логист|достав)/.test(text)) return 'Логистика';
  if (/расход.*(то|импорт|тамож)/.test(text)) return 'Импорт и таможня';
  if (/оплат.*товар|расчет.*сделк/.test(text)) return 'Оплата товара и услуги';
  return '';
}

function normalizeCurrencyCode_(value) {
  const text = normalizeRecognitionText_(value)
    .replace(/[.\s]/g, '');
  if (/^(руб|рубль|рубля|рублей|rub|₽)$/.test(text)) return 'RUB';
  if (/^(cny|rmb|юан|юань|юаней|¥)$/.test(text)) return 'CNY';
  if (/^(usd|дол|доллар|долларов|\$)$/.test(text)) return 'USD';
  if (/^(eur|евро|€)$/.test(text)) return 'EUR';
  return '';
}

function classifyImportedTableRow_(label) {
  const text = normalizeRecognitionText_(label);
  const rules = [
    ['COMPOSITE_EXPENSE', 'Таможня', 'Составная статья расходов', 'Контроль', 'Нет', /доставк.*таможенн.*оформ/],
    ['TOTAL_LOGISTICS', 'Итоги', 'Итого логистика', 'Контроль', 'Нет', /итого.*(перевоз|логист|достав)/],
    ['TOTAL_GOODS_PAYMENT', 'Итоги', 'Итого товар и услуги', 'Контроль', 'Нет', /итого.*(?:оплат.*товар|товар.*услуг)/],
    ['TOTAL_IMPORT', 'Итоги', 'Итого импорт', 'Контроль', 'Нет', /итого.*(?:то\s*(?:\(|:|$)|импорт|тамож)/],
    ['GRAND_TOTAL', 'Итоги', 'Общий итог расходов', 'Контроль', 'Нет', /всего.*расход|общий.*итог|итого.*сделк/],
    ['CUSTOMS_DELIVERY', 'Импорт и таможня', 'Доставка от СВХ до склада клиента', 'Расход', 'Да', /доставк.*от.*свх.*склад.*клиент/],
    ['RUSSIA_DELIVERY', 'Логистика', 'Доставка по России', 'Расход', 'Да', /забайкальск.*москв|доставк.*по.*росси|доставк.*до.*свх.*рф/],
    ['INTERNATIONAL_LOGISTICS', 'Логистика', 'Международная логистика', 'Расход', 'Да', /фрахт|международн.*логист|доставк.*до.*границ/],
    ['CUSTOMS_DUTY', 'Таможня', 'Таможенная пошлина', 'Расход', 'Да', /пошлин/],
    ['VAT', 'Таможня', 'НДС', 'Расход', 'Да', /(?:^|\s)ндс(?:\s|\d|%|$)/],
    ['CUSTOMS_FEE', 'Таможня', 'Таможенный сбор', 'Расход', 'Да', /таможенн.*сбор/],
    ['BROKER', 'Таможня', 'Услуги таможенного брокера', 'Расход', 'Да', /брокер/],
    ['TEMPORARY_STORAGE', 'Таможня', 'СВХ', 'Расход', 'Да', /свх|временн.*хранен/],
    ['CERTIFICATION', 'Дополнительные расходы', 'Сертификация или декларация', 'Расход', 'Да', /сертифик|деклараци.*соответств/],
    ['MARKING', 'Дополнительные расходы', 'Маркировка', 'Расход', 'Да', /маркиров|честн.*знак/],
    ['TOTAL_PRODUCT_VALUE', 'Товар', 'Стоимость товарной партии', 'Товар', 'Да', /стоимость.*товар/],
    ['PARTNER_AGENT_REMUNERATION', 'Комиссии', 'Документооборот перевозчика / импортёра', 'Расход', 'Да', /агентск.*вознагражден/],
    ['PARTNER_FINANCIAL_SERVICES', 'Комиссии', 'Финансовые услуги импортёра', 'Расход', 'Да', /финансов.*услуг/],
    ['ADDITIONAL_EXPENSE', 'Дополнительные расходы', 'Экспортный документооборот и банковские услуги', 'Расход', 'Да', /экспорт.*(?:документооборот|деклараци|банк)/],
    ['PARTNER_COMMISSION', 'Комиссии', 'Комиссия партнёра', 'Расход', 'Да', /комисси.*партн/],
    ['ADDITIONAL_EXPENSE', 'Дополнительные расходы', 'Дополнительные расходы', 'Расход', 'Да', /дополнительн.*расход|прочи.*расход/],
    ['INSURANCE', 'Дополнительные расходы', 'Страхование', 'Расход', 'Да', /страхов/]
  ];
  for (const rule of rules) {
    if (rule[5].test(text)) {
      return {
        fieldCode: rule[0],
        group: rule[1],
        fieldName: rule[2],
        recordType: rule[3],
        eligibility: rule[4],
        confidence: rule[3] === 'Контроль' ? 'Средняя' : 'Высокая',
        reason: `Строка таблицы распознана по статье: ${rule[2]}`
      };
    }
  }
  return {fieldCode: ''};
}

function buildRecognizedTableRow_(
  group, section, labelCell, amountCell, currencyCell, currency, amount, result
) {
  return [
    stableId_('ROW', [group.importId, group.sheetName, group.rowNumber, result.fieldCode]),
    group.importId, group.dealId, group.sourceFileId, group.sourceFile,
    group.sheetName, group.rowNumber, section, labelCell.cellAddress,
    labelCell.displayValue, amountCell.cellAddress, amountCell.displayValue,
    amountCell.rawValue, amount, safeSpreadsheetText_(amountCell.formula),
    currencyCell.cellAddress, currency, result.group, result.fieldCode,
    result.fieldName, result.recordType, result.eligibility, result.confidence,
    result.reason, 'Требует проверки', ''
  ];
}

function detectImportedRates_(groups) {
  const result = [];
  const seen = new Set();

  const pushRate = (group, marker, currencyCell, amountCell, amount, fieldCode, fieldName, confidence) => {
    if (!(Number(amount) > 0)) return;
    const key = [group.importId, group.sheetName, fieldCode].join('|||');
    if (seen.has(key)) return;
    seen.add(key);
    result.push(buildRateRecognitionRow_(
      group, marker, currencyCell, amountCell, Number(amount), fieldCode, fieldName, confidence || 'Высокая'
    ));
  };

  // Generic explicit labels: «Курс USD», «курс CNY», etc.
  groups.forEach(group => {
    const cells = [...group.cells.entries()].sort((left, right) => left[0] - right[0]);
    cells.forEach(([column, cell]) => {
      const text = normalizeRecognitionText_(cell.displayValue || cell.rawValue);
      const match = text.match(/курс\s*(cny|rmb|юан|usd|доллар|eur|евро)/);
      if (!match) return;

      let fieldCode = '';
      let fieldName = '';
      if (/cny|rmb|юан/.test(match[1])) {
        fieldCode = 'CNY_RUB_RATE';
        fieldName = 'Курс CNY/RUB';
      } else if (/usd|доллар/.test(match[1])) {
        fieldCode = 'USD_RUB_RATE';
        fieldName = 'Курс USD/RUB';
      } else if (/eur|евро/.test(match[1])) {
        fieldCode = 'EUR_RUB_RATE';
        fieldName = 'Курс EUR/RUB';
      }
      if (!fieldCode) return;

      let amountCell = null;
      for (let offset = 1; offset <= 3; offset++) {
        const candidate = group.cells.get(column + offset);
        if (!candidate) continue;
        const amount = parseFlexibleNumber_(
          candidate.rawValue == null || candidate.rawValue === ''
            ? candidate.displayValue
            : candidate.rawValue
        );
        if (amount !== null && amount > 0) {
          amountCell = candidate;
          break;
        }
      }
      if (!amountCell) return;

      const amount = parseFlexibleNumber_(
        amountCell.rawValue == null || amountCell.rawValue === ''
          ? amountCell.displayValue
          : amountCell.rawValue
      );
      pushRate(
        group, cell,
        {cellAddress: amountCell.cellAddress, displayValue: 'RUB'},
        amountCell, amount, fieldCode, fieldName, 'Высокая'
      );
    });
  });

  // DEV-016.55: VED-partner source uses a compact rate row rather than explicit
  // «Курс USD» / «Курс CNY» labels. Current topology is source-backed:
  // C13 «Расчетный курс», E13=USD/RUB, G13 «юань», H13=CNY/RUB; A49 also states
  // «1 дол= 83 руб.» and therefore corroborates the otherwise unlabeled E13 value.
  const bySheet = new Map();
  (groups || []).forEach(group => {
    const key = [group.importId, group.sourceFileId, group.sheetName].join('|||');
    if (!bySheet.has(key)) bySheet.set(key, []);
    bySheet.get(key).push(group);
  });

  bySheet.forEach(sheetGroups => {
    sheetGroups.sort((a, b) => a.rowNumber - b.rowNumber);
    let inlineUsd = null;
    let inlineCny = null;
    sheetGroups.forEach(group => {
      group.cells.forEach(cell => {
        const rawText = String(cell.displayValue == null || cell.displayValue === '' ? cell.rawValue || '' : cell.displayValue);
        const usdMatch = rawText.match(/1\s*(?:дол(?:лар)?|usd|\$)\s*=\s*([0-9]+(?:[.,][0-9]+)?)\s*руб/i);
        if (usdMatch) inlineUsd = parseFlexibleNumber_(usdMatch[1]);
        const cnyMatch = rawText.match(/1\s*(?:юан(?:ь|я|ей)?|cny|rmb|¥)\s*(?:=|-)\s*([0-9]+(?:[.,][0-9]+)?)\s*руб/i);
        if (cnyMatch) inlineCny = parseFlexibleNumber_(cnyMatch[1]);
      });
    });

    sheetGroups.forEach(group => {
      let rateMarker = null;
      group.cells.forEach(cell => {
        if (/расч[её]тный\s+курс/i.test(normalizeRecognitionText_(cell.displayValue || cell.rawValue))) {
          rateMarker = cell;
        }
      });
      if (!rateMarker) return;

      const ordered = [...group.cells.entries()].sort((a, b) => a[0] - b[0]);
      let cnyMarkerEntry = null;
      ordered.forEach(entry => {
        const text = normalizeRecognitionText_(entry[1].displayValue || entry[1].rawValue);
        if (/^(?:юан|юань|cny|rmb|¥)$/.test(text)) cnyMarkerEntry = entry;
      });

      if (cnyMarkerEntry) {
        const cnyAmountCell = group.cells.get(cnyMarkerEntry[0] + 1);
        const cnyAmount = cnyAmountCell ? parseFlexibleNumber_(
          cnyAmountCell.rawValue == null || cnyAmountCell.rawValue === ''
            ? cnyAmountCell.displayValue
            : cnyAmountCell.rawValue
        ) : null;
        if (cnyAmount > 0 && (!inlineCny || Math.abs(cnyAmount - inlineCny) < 0.00000001)) {
          pushRate(
            group, rateMarker, cnyMarkerEntry[1], cnyAmountCell, cnyAmount,
            'CNY_RUB_RATE', 'Курс CNY/RUB', 'Высокая'
          );
        }
      }

      if (inlineUsd > 0) {
        let usdAmountCell = null;
        ordered.forEach(([column, cell]) => {
          if (usdAmountCell) return;
          if (cnyMarkerEntry && column >= cnyMarkerEntry[0]) return;
          const value = parseFlexibleNumber_(
            cell.rawValue == null || cell.rawValue === '' ? cell.displayValue : cell.rawValue
          );
          if (value > 0 && Math.abs(value - inlineUsd) < 0.00000001) usdAmountCell = cell;
        });
        if (usdAmountCell) {
          pushRate(
            group, rateMarker,
            {cellAddress: usdAmountCell.cellAddress, displayValue: 'RUB'},
            usdAmountCell, inlineUsd, 'USD_RUB_RATE', 'Курс USD/RUB', 'Высокая'
          );
        }
      }
    });
  });

  return result;
}

function buildRateRecognitionRow_(
  group, marker, currencyCell, amountCell, amount, fieldCode, fieldName, confidence
) {
  return [
    stableId_('ROW', [group.importId, group.sheetName, group.rowNumber, fieldCode]),
    group.importId, group.dealId, group.sourceFileId, group.sourceFile,
    group.sheetName, group.rowNumber, 'Расчётные курсы', marker.cellAddress,
    fieldName, amountCell.cellAddress, amountCell.displayValue,
    amountCell.rawValue, amount, safeSpreadsheetText_(amountCell.formula),
    currencyCell.cellAddress, fieldCode.replace('_RATE', '').replace('_', '/'),
    'Курсы валют', fieldCode, fieldName, 'Курс валют', 'Да', confidence,
    `Курс определён по строке «${marker.displayValue}»: ${amountCell.cellAddress}`,
    'Требует проверки', ''
  ];
}


function writeRecognizedTableRows_(spreadsheet, rows) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.tableRows);
  if (!rows || rows.length === 0) return;
  replaceImportRowsPreservingReview_(sheet, rows, 2, 25, 26);
  if (sheet.getLastRow() > 1) {
    const validation = SpreadsheetApp.newDataValidation()
      .requireValueInList(
        ['Требует проверки', 'Подтверждено', 'Исправлено', 'Не применять'], true
      )
      .setAllowInvalid(false)
      .build();
    sheet.getRange(2, 25, sheet.getLastRow() - 1, 1)
      .setDataValidation(validation);
  }
  refreshSheetFilter_(sheet, 26);
  sheet.autoResizeColumns(1, 26);
  for (let column = 1; column <= 26; column++) {
    const width = sheet.getColumnWidth(column);
    if (width < 110) sheet.setColumnWidth(column, 110);
    if (width > 320) sheet.setColumnWidth(column, 320);
  }
}

function applyVerifiedImportedData() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const linkedSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.linked);
  const tableSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.tableRows);
  if (!linkedSheet || !tableSheet) {
    SpreadsheetApp.getUi().alert(
      'Не найдены листы «Связанные показатели» или «Распознанные строки».'
    );
    return;
  }
  const importId = promptImportId_('Перенос подтвержденных данных');
  if (!importId) return;
  const linkedRows = linkedSheet.getLastRow() > 1
    ? linkedSheet.getRange(2, 1, linkedSheet.getLastRow() - 1, 30)
      .getValues().filter(row => String(row[2]) === importId)
    : [];
  const tableRows = tableSheet.getLastRow() > 1
    ? tableSheet.getRange(2, 1, tableSheet.getLastRow() - 1, 26)
      .getValues().filter(row => String(row[1]) === importId)
    : [];
  if (linkedRows.length === 0 || tableRows.length === 0) {
    SpreadsheetApp.getUi().alert(
      'Для выбранного import_id сначала выполните команды 3 и 4.'
    );
    return;
  }
  const finalStatuses = new Set(['Подтверждено', 'Исправлено', 'Не применять']);
  const pendingLinked = linkedRows.filter(row =>
    row[10] === 'Да' && !finalStatuses.has(String(row[28]))
  );
  const pendingTable = tableRows.filter(row =>
    row[21] === 'Да' && !finalStatuses.has(String(row[24]))
  );
  if (pendingLinked.length || pendingTable.length) {
    SpreadsheetApp.getUi().alert(
      'Перенос остановлен: не завершена ручная проверка.\n\n' +
      `Связанных показателей без решения: ${pendingLinked.length}\n` +
      `Строк таблиц без решения: ${pendingTable.length}\n\n` +
      'Установите «Подтверждено», «Исправлено» или «Не применять».'
    );
    return;
  }
  const approvedStatuses = new Set(['Подтверждено', 'Исправлено']);
  const approvedLinked = linkedRows.filter(row => approvedStatuses.has(String(row[28])));
  const approvedTable = tableRows.filter(row =>
    row[21] === 'Да' && approvedStatuses.has(String(row[24]))
  );
  const spreadsheetErrors = findApprovedSpreadsheetErrors_(
    approvedLinked, approvedTable
  );
  if (spreadsheetErrors.length) {
    SpreadsheetApp.getUi().alert(
      'Перенос остановлен: в подтверждённых данных обнаружены ошибки Excel.\n\n' +
      spreadsheetErrors.slice(0, 20).map(issue => `• ${issue}`).join('\n') +
      (spreadsheetErrors.length > 20
        ? `\n• …и ещё ${spreadsheetErrors.length - 20}`
        : '') +
      '\n\nИсправьте источник либо установите «Не применять».'
    );
    return;
  }
  const invalidLinked = approvedLinked.filter(row =>
    row[14] === 'Число' && parseFlexibleNumber_(row[18]) === null
  );
  const invalidTable = approvedTable.filter(row =>
    parseFlexibleNumber_(row[13]) === null
  );
  if (invalidLinked.length || invalidTable.length) {
    SpreadsheetApp.getUi().alert(
      'Перенос остановлен: подтверждены некорректные числовые значения.\n\n' +
      `Связанные показатели: ${invalidLinked.length}\n` +
      `Строки таблиц: ${invalidTable.length}`
    );
    return;
  }
  if (approvedLinked.length + approvedTable.length === 0) {
    SpreadsheetApp.getUi().alert('Нет подтверждённых данных для переноса.');
    return;
  }
  const dealIds = new Set(
    approvedLinked.map(row => String(row[3]))
      .concat(approvedTable.map(row => String(row[2])))
      .filter(Boolean)
  );
  if (dealIds.size !== 1) {
    SpreadsheetApp.getUi().alert(
      'Перенос остановлен: данные относятся не к одной сделке.'
    );
    return;
  }
  const dealId = [...dealIds][0];
  if (!dealExists_(dealId)) {
    SpreadsheetApp.getUi().alert(`Сделка ${dealId} не найдена.`);
    return;
  }
  const conversionIssues = validateExpenseConversionInputs_(
    spreadsheet, approvedTable, dealId
  );
  if (conversionIssues.length) {
    SpreadsheetApp.getUi().alert(
      'Перенос остановлен: расходы нельзя корректно пересчитать.\n\n' +
      conversionIssues.map(issue => `• ${issue}`).join('\n') + '\n\n' +
      `Подтвердите положительные курсы для сделки ${dealId} и повторите перенос.`
    );
    return;
  }
  const importRecord = getImportRecord_(spreadsheet, importId);
  const scalar = buildApprovedScalarMap_(approvedLinked);
  const scalarMeta = buildApprovedScalarMetaMap_(approvedLinked);
  const writePlan = buildVerifiedWritePlan_(
    spreadsheet, dealId, importId, scalar, approvedTable
  );
  writeVerifiedWritePlan_(spreadsheet, writePlan, 'PREVIEW');
  const confirmation = SpreadsheetApp.getUi().alert(
    'Предварительный план переноса',
    formatVerifiedWritePlanForUi_(writePlan) +
      '\n\nПлан записан на лист «' + BBC_MVP.sheets.writebackPlans + '».\n' +
      'Продолжить только после проверки плана?',
    SpreadsheetApp.getUi().ButtonSet.YES_NO
  );
  if (confirmation !== SpreadsheetApp.getUi().Button.YES) {
    writeVerifiedWritePlan_(spreadsheet, writePlan, 'CANCELLED');
    return;
  }
  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  let itemCount = 0;
  let expenseCount = 0;
  let backup = null;
  let snapshots = [];
  try {
    backup = createPreWritebackBackup_(spreadsheet, writePlan.planId);
    snapshots = snapshotWritebackSheets_(spreadsheet, writePlan.planId);
    applyVerifiedDealData_(
      spreadsheet, dealId, scalar, scalarMeta, importRecord, importId
    );
    itemCount = applyVerifiedItemData_(
      spreadsheet, dealId, importId, scalar, scalarMeta, approvedTable
    );
    expenseCount = applyVerifiedExpenseData_(
      spreadsheet, dealId, importId, approvedTable
    );
    const verification = verifyVerifiedWriteback_(spreadsheet, writePlan);
    if (!verification.ok) {
      throw new Error(
        'Post-write verification failed: ' + verification.issues.join('; ')
      );
    }
    writePlan.actualItemCount = itemCount;
    writePlan.actualExpenseCount = expenseCount;
    writePlan.backupId = backup.id;
    writePlan.backupUrl = backup.url;
    writePlan.checksum = verification.checksum;
    writeVerifiedWritePlan_(spreadsheet, writePlan, 'VERIFIED');
    discardWritebackSnapshots_(spreadsheet, snapshots);
  } catch (error) {
    let rollbackMessage = '';
    try {
      restoreWritebackSheets_(spreadsheet, snapshots);
      rollbackMessage = 'Изменения целевых листов восстановлены из временных снимков.';
    } catch (rollbackError) {
      rollbackMessage = 'Автоматический откат не завершён: ' + String(rollbackError);
    }
    writePlan.backupId = backup && backup.id || '';
    writePlan.backupUrl = backup && backup.url || '';
    writePlan.error = String(error && error.stack || error);
    writeVerifiedWritePlan_(spreadsheet, writePlan, 'ROLLED_BACK');
    writeLog_(
      'SYSTEM', 'APPLY_VERIFIED_IMPORTED_DATA_ROLLBACK', dealId,
      `plan_id ${writePlan.planId}; ${rollbackMessage}; backup ${writePlan.backupUrl || 'n/a'}`
    );
    SpreadsheetApp.getUi().alert(
      'Перенос отменён из-за ошибки.\n\n' + rollbackMessage + '\n\n' +
      `Резервная копия: ${writePlan.backupUrl || 'не создана'}\n\n` +
      String(error)
    );
    return;
  } finally {
    lock.releaseLock();
  }
  SpreadsheetApp.getUi().alert(
    'Подтверждённые данные перенесены.\n\n' +
    `Сделка обновлена: ${dealId}\n` +
    `Товарных записей: ${itemCount}\n` +
    `Расходов создано или обновлено: ${expenseCount}\n\n` +
    'Post-write verification: PASS.\n' +
    `Резервная копия: ${writePlan.backupUrl}\n` +
    'Статус сделки установлен «Требует проверки».'
  );
  writeLog_(
    'USER', 'APPLY_VERIFIED_IMPORTED_DATA', dealId,
    `plan_id ${writePlan.planId}; import_id ${importId}; ` +
    `товаров: ${itemCount}; расходов: ${expenseCount}; checksum: ${writePlan.checksum}`
  );
}

function isSpreadsheetErrorToken_(value) {
  const text = String(value == null ? '' : value)
    .replace(/\u00a0/g, ' ').trim().toUpperCase();
  return /^(?:#ERROR!|#REF!|#N\/?A!?|#VALUE!|#DIV\/0!|#NAME\?|#NUM!|#NULL!|#SPILL!|#CALC!|#FIELD!|#CONNECT!|#BLOCKED!)$/.test(text);
}

function findApprovedSpreadsheetErrors_(approvedLinked, approvedTable) {
  const issues = [];
  approvedLinked.forEach(row => {
    row.forEach((value, column) => {
      if (!isSpreadsheetErrorToken_(value)) return;
      issues.push(
        `Связанный показатель ${row[0] || row[12] || '?'}; ` +
        `поле ${row[12] || '?'}; колонка ${column + 1}: ${value}`
      );
    });
  });
  approvedTable.forEach(row => {
    row.forEach((value, column) => {
      if (!isSpreadsheetErrorToken_(value)) return;
      issues.push(
        `Распознанная строка ${row[0] || '?'}; ` +
        `статья ${row[9] || '?'}; колонка ${column + 1}: ${value}`
      );
    });
  });
  return issues;
}

function buildVerifiedWritePlan_(
  spreadsheet, dealId, importId, scalar, approvedTable
) {
  const multiItems = extractMultiItemOrderTable_(spreadsheet, importId, dealId);
  let expectedItemIds = [];
  if (multiItems.length) {
    expectedItemIds = multiItems.map(item =>
      stableId_('ITM', [dealId, String(item.itemNumber)])
    );
  } else {
    const itemTableRow = approvedTable.find(
      row => row[18] === 'TOTAL_PRODUCT_VALUE'
    );
    const hasItemData = [
      'ITEM_NAME', 'ARTICLE', 'TN_VED', 'QUANTITY', 'TOTAL_PRODUCT_VALUE',
      'GROSS_WEIGHT', 'NET_WEIGHT', 'TOTAL_WEIGHT', 'VOLUME', 'PACKAGE_COUNT'
    ].some(code => scalar.has(code)) || Boolean(itemTableRow);
    if (hasItemData) expectedItemIds = [stableId_('ITM', [dealId, '1'])];
  }

  const expenseRows = approvedTable.filter(row => row[20] === 'Расход');
  const expectedExpenseIds = expenseRows.map(source => stableId_('EXP', [
    dealId, source[18], source[9], source[7]
  ]));
  const staleItemIds = listStaleImportedItemIds_(
    spreadsheet.getSheetByName(BBC_MVP.sheets.items),
    dealId,
    expectedItemIds
  );
  const now = new Date();
  return {
    planId: stableId_('WBK', [
      dealId, importId, now.getTime(), BBC_MVP.version
    ]),
    createdAt: now,
    codeVersion: BBC_MVP.version,
    dealId,
    importId,
    scalarFields: [...scalar.keys()].sort(),
    expectedItemIds,
    expectedExpenseIds,
    staleItemIds,
    expectedItemCount: expectedItemIds.length,
    expectedExpenseCount: expectedExpenseIds.length
  };
}

function listStaleImportedItemIds_(sheet, dealId, currentItemIds) {
  if (!sheet || sheet.getLastRow() < 2) return [];
  const ids = new Set(currentItemIds.map(String));
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, 42).getValues()
    .filter(row =>
      String(row[1]) === String(dealId) &&
      !ids.has(String(row[0] || '')) &&
      /^import_id:/i.test(String(row[23] || '')) &&
      isConfirmedStatus_(row[24])
    )
    .map(row => String(row[0]));
}

function formatVerifiedWritePlanForUi_(plan) {
  return [
    `Plan ID: ${plan.planId}`,
    `Сделка: ${plan.dealId}`,
    `Импорт: ${plan.importId}`,
    `Поля сделки: ${plan.scalarFields.length}`,
    `Товары к созданию/обновлению: ${plan.expectedItemCount}`,
    `Расходы к созданию/обновлению: ${plan.expectedExpenseCount}`,
    `Устаревшие товары к деактивации: ${plan.staleItemIds.length}`,
    'Физическое удаление строк: 0'
  ].join('\n');
}

function writeVerifiedWritePlan_(spreadsheet, plan, status) {
  const sheet = getOrCreateSheet_(spreadsheet, BBC_MVP.sheets.writebackPlans);
  const headers = [
    'Created_At', 'Plan_ID', 'Status', 'Code_Version', 'Deal_ID', 'Import_ID',
    'Scalar_Fields', 'Expected_Item_Count', 'Expected_Item_IDs',
    'Expected_Expense_Count', 'Expected_Expense_IDs', 'Stale_Item_IDs',
    'Actual_Item_Count', 'Actual_Expense_Count', 'Checksum', 'Backup_ID',
    'Backup_URL', 'Error'
  ];
  if (sheet.getLastRow() === 0) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.getRange(1, 1, 1, headers.length)
      .setBackground('#17365D').setFontColor('#FFFFFF').setFontWeight('bold');
    sheet.setFrozenRows(1);
  }
  appendRows_(sheet, [[
    new Date(), plan.planId, status, plan.codeVersion, plan.dealId, plan.importId,
    plan.scalarFields.join(', '), plan.expectedItemCount,
    plan.expectedItemIds.join(', '), plan.expectedExpenseCount,
    plan.expectedExpenseIds.join(', '), plan.staleItemIds.join(', '),
    plan.actualItemCount == null ? '' : plan.actualItemCount,
    plan.actualExpenseCount == null ? '' : plan.actualExpenseCount,
    plan.checksum || '', plan.backupId || '', plan.backupUrl || '',
    plan.error || ''
  ]]);
}

function previewVerifiedImportedData() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const importId = promptImportId_('Предварительный план переноса');
  if (!importId) return;
  const linkedSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.linked);
  const tableSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.tableRows);
  const linkedRows = linkedSheet && linkedSheet.getLastRow() > 1
    ? linkedSheet.getRange(2, 1, linkedSheet.getLastRow() - 1, 30)
      .getValues().filter(row => String(row[2]) === importId)
    : [];
  const tableRows = tableSheet && tableSheet.getLastRow() > 1
    ? tableSheet.getRange(2, 1, tableSheet.getLastRow() - 1, 26)
      .getValues().filter(row => String(row[1]) === importId)
    : [];
  const approvedStatuses = new Set(['Подтверждено', 'Исправлено']);
  const approvedLinked = linkedRows.filter(
    row => approvedStatuses.has(String(row[28]))
  );
  const approvedTable = tableRows.filter(
    row => row[21] === 'Да' && approvedStatuses.has(String(row[24]))
  );
  const dealIds = new Set(
    approvedLinked.map(row => String(row[3]))
      .concat(approvedTable.map(row => String(row[2]))).filter(Boolean)
  );
  if (dealIds.size !== 1) {
    SpreadsheetApp.getUi().alert(
      'Нельзя построить план: подтверждённые строки отсутствуют или относятся к нескольким сделкам.'
    );
    return;
  }
  const errors = findApprovedSpreadsheetErrors_(approvedLinked, approvedTable);
  if (errors.length) {
    SpreadsheetApp.getUi().alert(
      'План заблокирован ошибками Excel:\n\n' + errors.join('\n')
    );
    return;
  }
  const scalar = buildApprovedScalarMap_(approvedLinked);
  const plan = buildVerifiedWritePlan_(
    spreadsheet, [...dealIds][0], importId, scalar, approvedTable
  );
  writeVerifiedWritePlan_(spreadsheet, plan, 'PREVIEW_ONLY');
  SpreadsheetApp.getUi().alert(formatVerifiedWritePlanForUi_(plan));
}

function createPreWritebackBackup_(spreadsheet, planId) {
  const source = DriveApp.getFileById(spreadsheet.getId());
  const stamp = Utilities.formatDate(
    new Date(), spreadsheet.getSpreadsheetTimeZone(), 'yyyyMMdd-HHmmss'
  );
  const name = `${spreadsheet.getName()} — PRE-WRITEBACK ${planId} ${stamp}`;
  const parents = source.getParents();
  const copy = parents.hasNext()
    ? source.makeCopy(name, parents.next())
    : source.makeCopy(name);
  return {
    id: copy.getId(),
    url: `https://docs.google.com/spreadsheets/d/${copy.getId()}/edit`,
    name
  };
}

function snapshotWritebackSheets_(spreadsheet, planId) {
  const suffix = String(planId).replace(/[^A-Za-z0-9_-]/g, '').slice(-18);
  return [BBC_MVP.sheets.deals, BBC_MVP.sheets.items, BBC_MVP.sheets.expenses]
    .map((name, index) => {
      const source = spreadsheet.getSheetByName(name);
      if (!source) throw new Error(`Не найден целевой лист «${name}».`);
      const copy = source.copyTo(spreadsheet);
      copy.setName(`__WBK_${index}_${suffix}`).hideSheet();
      return {originalName: name, backupName: copy.getName()};
    });
}

function restoreWritebackSheets_(spreadsheet, snapshots) {
  (snapshots || []).forEach(snapshot => {
    const original = spreadsheet.getSheetByName(snapshot.originalName);
    const backup = spreadsheet.getSheetByName(snapshot.backupName);
    if (!original || !backup) {
      throw new Error(`Не найден снимок листа ${snapshot.originalName}.`);
    }
    const rows = backup.getMaxRows();
    const columns = backup.getMaxColumns();
    if (original.getMaxRows() < rows) {
      original.insertRowsAfter(original.getMaxRows(), rows - original.getMaxRows());
    }
    if (original.getMaxColumns() < columns) {
      original.insertColumnsAfter(
        original.getMaxColumns(), columns - original.getMaxColumns()
      );
    }
    original.getDataRange().clearContent();
    backup.getRange(1, 1, rows, columns)
      .copyTo(original.getRange(1, 1, rows, columns));
  });
  discardWritebackSnapshots_(spreadsheet, snapshots);
}

function discardWritebackSnapshots_(spreadsheet, snapshots) {
  (snapshots || []).forEach(snapshot => {
    const sheet = spreadsheet.getSheetByName(snapshot.backupName);
    if (sheet) spreadsheet.deleteSheet(sheet);
  });
}

function verifyVerifiedWriteback_(spreadsheet, plan) {
  const issues = [];
  const itemSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.items);
  const expenseSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.expenses);
  const itemRows = itemSheet && itemSheet.getLastRow() > 1
    ? itemSheet.getRange(2, 1, itemSheet.getLastRow() - 1, 42).getValues()
      .filter(row => String(row[1]) === String(plan.dealId))
    : [];
  const expenseRows = expenseSheet && expenseSheet.getLastRow() > 1
    ? expenseSheet.getRange(2, 1, expenseSheet.getLastRow() - 1, 32).getValues()
      .filter(row => String(row[1]) === String(plan.dealId))
    : [];
  const itemById = new Map(itemRows.map(row => [String(row[0]), row]));
  const expenseById = new Map(expenseRows.map(row => [String(row[0]), row]));
  plan.expectedItemIds.forEach(id => {
    const row = itemById.get(String(id));
    if (!row) issues.push(`не создан товар ${id}`);
    else if (!isConfirmedStatus_(row[24])) {
      issues.push(`товар ${id} не подтверждён`);
    }
  });
  plan.expectedExpenseIds.forEach(id => {
    const row = expenseById.get(String(id));
    if (!row) issues.push(`не создан расход ${id}`);
    else if (!isTruthy_(row[16]) || !isConfirmedStatus_(row[18])) {
      issues.push(`расход ${id} не активен или не подтверждён`);
    }
  });
  plan.staleItemIds.forEach(id => {
    const row = itemById.get(String(id));
    if (row && isConfirmedStatus_(row[24])) {
      issues.push(`устаревший товар ${id} остался подтверждённым`);
    }
  });
  itemRows.concat(expenseRows).forEach(row => {
    if (row.some(isSpreadsheetErrorToken_)) {
      issues.push(`error token в целевой строке ${row[0] || '?'}`);
    }
  });
  const checksum = stableId_('WBKCHK', [
    plan.planId,
    plan.expectedItemIds.slice().sort().join('|'),
    plan.expectedExpenseIds.slice().sort().join('|'),
    itemRows.filter(row => isConfirmedStatus_(row[24])).length,
    expenseRows.filter(row => isTruthy_(row[16]) && isConfirmedStatus_(row[18])).length
  ]);
  return {ok: issues.length === 0, issues, checksum};
}

function getImportRecord_(spreadsheet, importId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.imports);
  if (!sheet || sheet.getLastRow() < 2) return null;
  const rowNumber = findRowByValue_(sheet, 1, importId);
  return rowNumber ? sheet.getRange(rowNumber, 1, 1, 14).getValues()[0] : null;
}

function buildApprovedScalarMap_(rows) {
  const map = new Map();
  rows.forEach(row => {
    const fieldCode = String(row[12]);
    let value = row[18] !== '' ? row[18] : row[16];
    if (row[14] === 'Число') {
      value = parseFlexibleNumber_(value);
    }
    if (!map.has(fieldCode) && value !== '') map.set(fieldCode, value);
  });
  return map;
}

function buildApprovedScalarMetaMap_(rows) {
  const map = new Map();
  rows.forEach(row => {
    const fieldCode = String(row[12]);
    if (!fieldCode || map.has(fieldCode)) return;
    const normalized = row[18] !== '' ? row[18] : row[16];
    map.set(fieldCode, {
      sourceFile: safeSpreadsheetText_(row[5]),
      sourceSheet: safeSpreadsheetText_(row[6]),
      sourceCell: safeSpreadsheetText_(row[15]),
      sourceType: row[19] ? 'FORMULA' : 'IMPORTED_VALUE',
      formula: safeSpreadsheetText_(row[19]),
      detectedCurrency: safeSpreadsheetText_(row[21]),
      detectedUnit: safeSpreadsheetText_(row[22]),
      confidence: safeSpreadsheetText_(row[25]),
      managerComment: safeSpreadsheetText_(row[29]),
      valueStatus: deriveCanonicalValueStatus_(normalized)
    });
  });
  return map;
}

function deriveCanonicalValueStatus_(value) {
  if (value === '' || value === null || value === undefined) return 'UNKNOWN';
  const numeric = parseFlexibleNumber_(value);
  if (numeric !== null && numeric === 0) return 'CONFIRMED_ZERO';
  return 'VALUE';
}

function buildManagerConfirmationId_(importId) {
  return stableId_('MGR', [importId, 'APPLY_VERIFIED']);
}

function applyVerifiedDealData_(
  spreadsheet, dealId, scalar, scalarMeta, importRecord, importId
) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.deals);
  const rowNumber = findRowByValue_(sheet, 1, dealId);
  if (!rowNumber) throw new Error(`Сделка ${dealId} не найдена.`);
  const row = sheet.getRange(rowNumber, 1, 1, 36).getValues()[0];
  while (row.length < 36) row.push('');
  if (scalar.has('CLIENT_NAME')) {
    row[3] = safeSpreadsheetText_(scalar.get('CLIENT_NAME'));
  }
  if (importRecord) {
    row[6] = importRecord[5] || row[6];
    row[7] = importRecord[6] || row[7];
  }
  if (scalar.has('DELIVERY_TERMS')) {
    // DEV-016.54: DELIVERY_TERMS is Incoterms evidence, not the deal role scheme.
    row[29] = safeSpreadsheetText_(scalar.get('DELIVERY_TERMS'));
  }
  const route = scalar.get('ROUTE');
  const border = scalar.get('BORDER_CROSSING');
  if (route || border) {
    row[9] = safeSpreadsheetText_(
      [route, border ? `погранпереход: ${border}` : '']
        .filter(Boolean).join('; ')
    );
    if (border) row[31] = safeSpreadsheetText_(border);
  }
  row[10] = 'Требует проверки';
  row[16] = new Date();
  row[22] = 'PARTIAL';
  row[23] = buildManagerConfirmationId_(importId);
  row[24] = new Date();
  row[25] = BBC_MVP.version;
  row[26] = mergeSystemComment_(
    row[26],
    `DEV-002: подтверждённые данные перенесены из import_id ${importId}`
  );
  sheet.getRange(rowNumber, 1, 1, 36).setValues([row]);
}

function getImportCellsByImportId_(spreadsheet, importId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.importCells);
  if (!sheet || sheet.getLastRow() < 2) return [];
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, 15).getValues()
    .filter(row => String(row[0]) === String(importId));
}

function normalizeImportedSheetName_(value) {
  return normalizeRecognitionText_(value).replace(/\s+/g, ' ').trim();
}

function parseOrderTableNumber_(value, options) {
  if (value === '' || value === null || value === undefined) return null;
  const text = String(value).replace(/\u00a0/g, ' ').trim();
  const settings = options || {};

  if (settings.preferTotal) {
    const totalMatch = text.match(/(?:итого|total)\s*[:=]?\s*([\d\s.,]+)/i);
    if (totalMatch) {
      const parsedTotal = parseFlexibleNumber_(totalMatch[1]);
      if (parsedTotal !== null) return parsedTotal;
    }
  }

  if (text.includes('=')) {
    const tail = text.split('=').pop();
    const parsedTail = parseFlexibleNumber_(tail);
    if (parsedTail !== null) return parsedTail;
  }

  return parseFlexibleNumber_(value);
}

function buildImportedCellLookup_(rows) {
  const lookup = new Map();
  rows.forEach(row => {
    const sheetName = String(row[4] || '');
    const rowNumber = Number(row[5]);
    const columnNumber = Number(row[6]);
    const key = [normalizeImportedSheetName_(sheetName), rowNumber, columnNumber]
      .join('|||');
    lookup.set(key, {
      importId: row[0],
      dealId: row[1],
      sourceFileId: row[2],
      sourceFile: row[3],
      sheetName,
      rowNumber,
      columnNumber,
      cellAddress: row[7],
      rawValue: row[8],
      displayValue: row[9],
      formula: row[10],
      numberFormat: row[11],
      detectedType: row[12],
      detectedCurrency: row[13],
      detectedUnit: row[14]
    });
  });
  return lookup;
}

function readImportedCell_(lookup, sheetName, rowNumber, columnNumber) {
  return lookup.get([
    normalizeImportedSheetName_(sheetName),
    Number(rowNumber),
    Number(columnNumber)
  ].join('|||')) || null;
}

function importedCellValue_(cell) {
  if (!cell) return '';
  return cell.rawValue !== '' && cell.rawValue !== null &&
    cell.rawValue !== undefined
    ? cell.rawValue
    : cell.displayValue;
}

function getImportCellsByDealId_(spreadsheet, dealId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.importCells);
  if (!sheet || sheet.getLastRow() < 2) return [];
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, 15).getValues()
    .filter(row => String(row[1]) === String(dealId));
}


function structuredItemHeaderField_(value) {
  const text = normalizeRecognitionText_(value);
  if (!text) return '';
  if (/^(?:\u043f\u043e\u0440\u044f\u0434\u043a\u043e\u0432\u044b\u0439 \u043d\u043e\u043c\u0435\u0440|\u5e8f\u53f7)/i.test(text)) return 'itemNumber';
  if (/(?:\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0442\u043e\u0432\u0430\u0440\u0430|\u4ea7\u54c1\u540d\u79f0)/i.test(text)) return 'name';
  if (/(?:\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e.*\u8ba2\u5355\u6570\u91cf|\u8ba2\u5355\u6570\u91cf)/i.test(text)) return 'quantity';
  if (/(?:\u0430\u0440\u0442\u0438\u043a\u0443\u043b.*\u5de5\u5382\u8d27\u53f7|\u5de5\u5382\u8d27\u53f7)/i.test(text)) return 'article';
  if (/(?:\u043a\u043e\u0434 \u0442\u043d \u0432\u044d\u0434|\u6d77\u5173\u7f16\u7801)/i.test(text)) return 'hsCode';
  if (/(?:\u0441\u0440\u043e\u043a \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430|\u751f\u4ea7\u5468\u671f)/i.test(text)) return 'productionDays';
  if (/(?:\u0446\u0435\u043d\u0430 \u0437\u0430 \u0448\u0442\u0443\u043a\u0443 \u0431\u0435\u0437 vat|\u4e0d\u542b\u589e\u503c\u7a0e\u5355\u4ef7)/i.test(text)) return 'priceExVat';
  if (/(?:\u0441\u0442\u0430\u0432\u043a\u0430 vat|\u589e\u503c\u7a0e\u7387)/i.test(text)) return 'chinaVatRate';
  if (/(?:\u0446\u0435\u043d\u0430 \u0437\u0430 \u0448\u0442\u0443\u043a\u0443 \u0441 vat|\u542b\u589e\u503c\u7a0e\u5355\u4ef7)/i.test(text)) return 'priceIncVat';
  if (/(?:\u0446\u0435\u043d\u0430 \u0437\u0430 \u043f\u0430\u0440\u0442\u0438\u044e \u0431\u0435\u0437 vat|\u4e0d\u542b\u589e\u503c\u7a0e\u6574\u6279\u4ef7\u683c)/i.test(text)) return 'batchExVat';
  if (/(?:\u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043b\u043e\u0433\u0438\u0441\u0442\u0438\u043a\u0438 \u0432\u043d\u0443\u0442\u0440\u0438 \u043a\u0438\u0442\u0430\u044f|\u56fd\u5185\u7269\u6d41\u8d39)/i.test(text)) return 'chinaDelivery';
  if (/(?:\u0446\u0435\u043d\u0430 \u0437\u0430 \u043f\u0430\u0440\u0442\u0438\u044e \u0441 vat|\u542b\u589e\u503c\u7a0e\u6574\u6279\u4ef7\u683c)/i.test(text)) return 'batchIncVat';
  if (/(?:\u0441\u0443\u043c\u043c\u0430 \u043f\u043e \u0438\u043d\u0432\u043e\u0439\u0441\u0443|\u8ba2\u5355\u53d1\u7968\u91d1\u989d)/i.test(text)) return 'invoiceAmount';
  if (/(?:\u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u043b\u0438 \u0442\u043e\u0432\u0430\u0440 \u043f\u043e\u0434 \u0432\u043e\u0437\u0432\u0440\u0430\u0442 vat|\u662f\u5426\u7b26\u5408\u9000\u589e\u503c\u7a0e)/i.test(text)) return 'vatRefundStatus';
  if (/(?:\u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439 \u043f\u043e vat|\u589e\u503c\u7a0e\u5907\u6ce8)/i.test(text)) return 'vatComment';
  if (/(?:\u043f\u043e\u0441\u0442\u0430\u0432\u0449\u0438\u043a.*\u540d\u79f0|\u4f9b\u5e94\u5546\/\u5de5\u5382\u540d\u79f0)/i.test(text)) return 'supplier';
  return '';
}

function structuredRowsBySheet_(rows) {
  const groups = new Map();
  (rows || []).forEach(row => {
    const sheetName = String(row[4] || '');
    const key = normalizeImportedSheetName_(sheetName);
    if (!key) return;
    if (!groups.has(key)) groups.set(key, {sheetName, rows: []});
    groups.get(key).rows.push(row);
  });
  return groups;
}

function structuredRowCells_(rows) {
  const map = new Map();
  (rows || []).forEach(row => {
    const rowNumber = Number(row[5]);
    if (!map.has(rowNumber)) map.set(rowNumber, []);
    map.get(rowNumber).push(row);
  });
  return map;
}

function structuredCellObject_(row) {
  if (!row) return null;
  return {
    importId: row[0],
    dealId: row[1],
    sourceFileId: row[2],
    sourceFile: row[3],
    sheetName: row[4],
    rowNumber: Number(row[5]),
    columnNumber: Number(row[6]),
    cellAddress: row[7],
    rawValue: row[8],
    displayValue: row[9],
    formula: row[10],
    numberFormat: row[11],
    detectedType: row[12],
    detectedCurrency: row[13],
    detectedUnit: row[14]
  };
}

function structuredValue_(row) {
  return importedCellValue_(structuredCellObject_(row));
}

function findStructuredDetailValue_(groups, itemNumber, labelPattern) {
  const target = new RegExp('(?:^|\\s)'+String(itemNumber)+'(?:\\s|$)');
  for (const group of groups.values()) {
    const sheetText = normalizeRecognitionText_(group.sheetName);
    if (!/\u0442\u043e\u0432\u0430\u0440/.test(sheetText) || !target.test(sheetText)) continue;
    const byRow = structuredRowCells_(group.rows);
    for (const cells of byRow.values()) {
      const sorted = cells.slice().sort((a, b) => Number(a[6]) - Number(b[6]));
      for (let index = 0; index < sorted.length; index++) {
        const label = normalizeRecognitionText_(structuredValue_(sorted[index]));
        if (!labelPattern.test(label)) continue;
        const labelColumn = Number(sorted[index][6]);
        const right = sorted.find(cell => Number(cell[6]) === labelColumn + 1);
        if (!right) continue;
        return {
          value: structuredValue_(right),
          sourceFile: right[3],
          sourceSheet: right[4],
          sourceCell: right[7]
        };
      }
    }
  }
  return null;
}

function extractStructuredCurrentDealItemsFromRows_(rows) {
  if (!rows || !rows.length) return [];
  const groups = structuredRowsBySheet_(rows);
  const candidates = [];

  for (const group of groups.values()) {
    const byRow = structuredRowCells_(group.rows);
    const rowNumbers = [...byRow.keys()].sort((a, b) => a - b);
    let header = null;

    for (const rowNumber of rowNumbers) {
      const fieldColumns = {};
      (byRow.get(rowNumber) || []).forEach(cell => {
        const field = structuredItemHeaderField_(structuredValue_(cell));
        if (field && !(field in fieldColumns)) fieldColumns[field] = Number(cell[6]);
      });
      const required = ['name', 'quantity', 'article', 'invoiceAmount'];
      const score = Object.keys(fieldColumns).length;
      if (required.every(field => field in fieldColumns) && score >= 7) {
        header = {rowNumber, fieldColumns, score};
        break;
      }
    }
    if (!header) continue;

    const getCell = (cells, field) => {
      const column = header.fieldColumns[field];
      if (!column) return null;
      return cells.find(cell => Number(cell[6]) === Number(column)) || null;
    };

    const items = [];
    for (const rowNumber of rowNumbers.filter(value => value > header.rowNumber)) {
      const cells = byRow.get(rowNumber) || [];
      const nameCell = getCell(cells, 'name');
      const quantityCell = getCell(cells, 'quantity');
      const articleCell = getCell(cells, 'article');
      const invoiceCell = getCell(cells, 'invoiceAmount');
      const name = String(structuredValue_(nameCell) || '').trim();
      const quantity = parseOrderTableNumber_(structuredValue_(quantityCell));
      const invoiceAmount = parseOrderTableNumber_(structuredValue_(invoiceCell));
      if (!name || !(quantity > 0) || !(invoiceAmount > 0)) continue;

      const serialCell = getCell(cells, 'itemNumber');
      const serial = parseOrderTableNumber_(structuredValue_(serialCell));
      const itemNumber = serial > 0 ? Math.round(serial) : items.length + 1;
      const article = String(structuredValue_(articleCell) || '').trim();
      const sourceFile = String((nameCell || quantityCell || invoiceCell || [])[3] || '');
      const sourceImportId = String((nameCell || quantityCell || invoiceCell || [])[0] || '');
      const sourceFileId = String((nameCell || quantityCell || invoiceCell || [])[2] || '');
      const sourceCells = [];
      [nameCell, quantityCell, articleCell, invoiceCell].forEach(cell => {
        if (cell && cell[7]) sourceCells.push(String(cell[7]));
      });

      const item = {
        itemNumber,
        name,
        article,
        quantity,
        unit: '\u0448\u0442',
        hsCode: String(structuredValue_(getCell(cells, 'hsCode')) || '').trim(),
        productionDays: parseOrderTableNumber_(structuredValue_(getCell(cells, 'productionDays'))),
        priceExVat: parseOrderTableNumber_(structuredValue_(getCell(cells, 'priceExVat'))),
        chinaVatRate: parseOrderTableNumber_(structuredValue_(getCell(cells, 'chinaVatRate'))),
        priceIncVat: parseOrderTableNumber_(structuredValue_(getCell(cells, 'priceIncVat'))),
        batchExVat: parseOrderTableNumber_(structuredValue_(getCell(cells, 'batchExVat'))),
        chinaDelivery: parseOrderTableNumber_(structuredValue_(getCell(cells, 'chinaDelivery'))),
        batchIncVat: parseOrderTableNumber_(structuredValue_(getCell(cells, 'batchIncVat'))),
        invoiceAmount,
        unitPrice: invoiceAmount / quantity,
        vatRefundStatus: String(structuredValue_(getCell(cells, 'vatRefundStatus')) || '').trim(),
        vatComment: String(structuredValue_(getCell(cells, 'vatComment')) || '').trim(),
        supplier: String(structuredValue_(getCell(cells, 'supplier')) || '').trim(),
        packages: null,
        grossWeight: null,
        volume: null,
        sourceImportId,
        sourceFileId,
        sourceFile,
        sourceSheet: group.sheetName,
        sourceCell: [...new Set(sourceCells)].join(', '),
        sourceType: invoiceCell && invoiceCell[10] ? 'FORMULA' : 'IMPORTED_VALUE'
      };

      const packages = findStructuredDetailValue_(groups, itemNumber, /\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043d\u044b\u0445 \u0443\u043f\u0430\u043a\u043e\u0432\u043e\u043a \u0432 \u043f\u0430\u0440\u0442\u0438\u0438/i);
      const gross = findStructuredDetailValue_(groups, itemNumber, /\u043e\u0431\u0449\u0438\u0439 \u0432\u0435\u0441 \u0431\u0440\u0443\u0442\u0442\u043e \u043f\u0430\u0440\u0442\u0438\u0438/i);
      const volume = findStructuredDetailValue_(groups, itemNumber, /\u043e\u0431\u0449\u0438\u0439 \u043e\u0431\u044a\u0435\u043c \u043f\u0430\u0440\u0442\u0438\u0438/i);
      if (packages) item.packages = parseOrderTableNumber_(packages.value);
      if (gross) item.grossWeight = parseOrderTableNumber_(gross.value);
      if (volume) item.volume = parseOrderTableNumber_(volume.value);
      [packages, gross, volume].filter(Boolean).forEach(meta => {
        if (meta.sourceCell) item.sourceCell += (item.sourceCell ? '; ' : '') + String(meta.sourceSheet || '') + '!' + String(meta.sourceCell);
      });
      items.push(item);
    }

    if (items.length >= 2) candidates.push({items, score: header.score});
  }

  if (!candidates.length) return [];
  candidates.sort((left, right) => {
    if (right.items.length !== left.items.length) return right.items.length - left.items.length;
    return right.score - left.score;
  });
  return candidates[0].items;
}

function parsePercentFromStructuredLabel_(value, prefixPattern) {
  const text = normalizeRecognitionText_(value);
  const match = text.match(prefixPattern);
  if (!match) return null;
  const numeric = parseFlexibleNumber_(match[1]);
  return numeric !== null && numeric >= 0 ? numeric : null;
}

function extractStructuredDealCustomsProfileFromRows_(rows) {
  const groups = structuredRowsBySheet_(rows || []);
  const hsCodes = [];
  const dutyRates = [];
  const vatRates = [];
  const evidence = [];

  for (const group of groups.values()) {
    const byRow = structuredRowCells_(group.rows);
    for (const cells of byRow.values()) {
      const sorted = cells.slice().sort((a, b) => Number(a[6]) - Number(b[6]));
      sorted.forEach((cell, index) => {
        const value = String(structuredValue_(cell) || '').trim();
        const normalized = normalizeRecognitionText_(value);
        const next = sorted.find(candidate => Number(candidate[6]) === Number(cell[6]) + 1);
        if (/^\u043a\u043e\u0434 \u0442\u043d \u0432\u044d\u0434(?:\s|$)/i.test(normalized) && next) {
          const code = String(structuredValue_(next) || '').replace(/\.0+$/, '').trim();
          if (/^\d{8,12}$/.test(code)) {
            hsCodes.push(code);
            evidence.push({kind:'HS', value:code, sourceFile:next[3], sourceSheet:next[4], sourceCell:next[7]});
          }
        }
        const duty = parsePercentFromStructuredLabel_(value, /^\u043f\u043e\u0448\u043b\u0438\u043d\u0430\s*([\d.,]+)\s*%?/i);
        if (duty !== null) {
          dutyRates.push(duty);
          evidence.push({kind:'DUTY', value:duty, sourceFile:cell[3], sourceSheet:cell[4], sourceCell:cell[7]});
        }
        const vat = parsePercentFromStructuredLabel_(value, /^\u043d\u0434\u0441\s*([\d.,]+)\s*%?/i);
        if (vat !== null) {
          vatRates.push(vat);
          evidence.push({kind:'VAT', value:vat, sourceFile:cell[3], sourceSheet:cell[4], sourceCell:cell[7]});
        }
      });
    }
  }

  const unique = values => [...new Set(values.map(value => String(value)))];
  const uniqueHs = unique(hsCodes);
  const uniqueDuty = unique(dutyRates);
  const uniqueVat = unique(vatRates);
  return {
    hsCode: uniqueHs.length === 1 ? uniqueHs[0] : '',
    dutyMethod: uniqueDuty.length === 1 ? 'PERCENT' : '',
    dutyRate: uniqueDuty.length === 1 ? Number(uniqueDuty[0]) : null,
    importVatRate: uniqueVat.length === 1 ? Number(uniqueVat[0]) : null,
    evidence
  };
}


function normalizeStructuredPaymentPercent_(value) {
  const numeric = parseFlexibleNumber_(value);
  if (numeric === null || numeric < 0) return null;
  const normalized = numeric > 1 ? numeric / 100 : numeric;
  return normalized >= 0 && normalized <= 1 ? normalized : null;
}

function extractStructuredPaymentSplitProfileFromRows_(rows, dealScheme) {
  const groups = structuredRowsBySheet_(rows || []);
  const candidates = [];
  const schemeText = normalizeRecognitionText_(dealScheme || '');
  const wantsClientImporter = /клиент.*импорт|импорт.*клиент/.test(schemeText);
  const wantsContractorImporter = /подрядчик.*импорт|импорт.*подрядчик/.test(schemeText);

  for (const group of groups.values()) {
    const byRow = structuredRowCells_(group.rows);
    const rowNumbers = [...byRow.keys()].sort((a, b) => Number(a) - Number(b));

    // DEV-016.57: current export source stores several alternative payment schemes on
    // the same sheet. A generic "Разбивка по платежам" row is usable only together
    // with its nearby scheme label. Preserve per-item columns rather than collapsing
    // them into one global split.
    rowNumbers.forEach(rowNumber => {
      const cells = (byRow.get(rowNumber) || []).slice().sort((a, b) => Number(a[6]) - Number(b[6]));
      const rowText = cells.map(cell => String(structuredValue_(cell) || '').trim()).filter(Boolean).join(' | ');
      if (!/разбивка по платежам/i.test(rowText)) return;

      const contextRows = rowNumbers.filter(value => Number(value) < Number(rowNumber) && Number(value) >= Number(rowNumber) - 3);
      const contextText = normalizeRecognitionText_(contextRows.map(value =>
        (byRow.get(value) || []).slice().sort((a,b)=>Number(a[6])-Number(b[6]))
          .map(cell => String(structuredValue_(cell) || '').trim()).filter(Boolean).join(' | ')
      ).join(' | '));

      let score = 0;
      if (wantsClientImporter && /клиент.*импорт|импорт.*клиент/.test(contextText)) score += 100;
      if (wantsContractorImporter && /подрядчик.*импорт|импорт.*подрядчик/.test(contextText)) score += 100;
      if (wantsClientImporter && /подрядчик.*импорт|импорт.*подрядчик/.test(contextText)) score -= 100;
      if (wantsContractorImporter && /клиент.*импорт|импорт.*клиент/.test(contextText)) score -= 100;
      if (/схема\s*1/.test(contextText)) score += wantsClientImporter ? 20 : 0;
      if (/схема\s*2/.test(contextText)) score += wantsContractorImporter ? 20 : 0;

      const itemSplits = {};
      const evidence = [];
      let itemNumber = 0;
      cells.forEach(cell => {
        const col = Number(cell[6]);
        if (col <= 2) return;
        const value = String(structuredValue_(cell) || '').trim();
        const split = parseQuotePaymentSplit_(value);
        if (!split) return;
        itemNumber += 1;
        const display = `${formatManagerNumber_(split.firstPct * 100, 4)}/${formatManagerNumber_(split.secondPct * 100, 4)}`;
        itemSplits[itemNumber] = display;
        evidence.push({
          itemNumber,
          display,
          sourceFile: String(cell[3] || ''),
          sourceSheet: String(cell[4] || group.sheetName || ''),
          sourceCell: String(cell[7] || '')
        });
      });
      if (Object.keys(itemSplits).length) {
        candidates.push({score, itemSplits, evidence, contextText, sourceSheet:String(group.sheetName || '')});
      }
    });

    // Legacy structured controls remain supported for sources that expose a single
    // explicit split type instead of a per-item payment row.
    let splitType = '';
    let splitTypeSource = null;
    let manualFirst = null;
    let manualSecond = null;
    let directFirst = null;
    let directSecond = null;
    let percentSource = null;
    for (const cells of byRow.values()) {
      const sorted = cells.slice().sort((a, b) => Number(a[6]) - Number(b[6]));
      sorted.forEach(cell => {
        const label = normalizeRecognitionText_(structuredValue_(cell));
        const next = sorted.find(candidate => Number(candidate[6]) === Number(cell[6]) + 1);
        if (!next) return;
        const nextValue = structuredValue_(next);
        if (/тип разбивки товара/.test(label)) { splitType = String(nextValue || '').trim(); splitTypeSource = next; return; }
        if (/ручной\s*%\s*1-й\s*плат[её]ж/.test(label)) { manualFirst = normalizeStructuredPaymentPercent_(nextValue); if (manualFirst !== null) percentSource = next; return; }
        if (/ручной\s*%\s*2-й\s*плат[её]ж/.test(label)) { manualSecond = normalizeStructuredPaymentPercent_(nextValue); if (manualSecond !== null) percentSource = next; return; }
        if (/^1-я часть за товар/.test(label)) { directFirst = normalizeStructuredPaymentPercent_(nextValue); if (directFirst !== null) percentSource = next; return; }
        if (/^2-я часть товара/.test(label)) { directSecond = normalizeStructuredPaymentPercent_(nextValue); if (directSecond !== null) percentSource = next; }
      });
    }
    let first = null, second = null;
    const normalizedType = normalizeRecognitionText_(splitType).replace(/\s+/g, '');
    if (/30\/70/.test(normalizedType)) { first = 0.3; second = 0.7; }
    else if (/50\/50/.test(normalizedType)) { first = 0.5; second = 0.5; }
    else if (/^100(?:\/0)?$/.test(normalizedType)) { first = 1; second = 0; }
    else if (/ручн/.test(normalizedType) && manualFirst !== null && manualSecond !== null) { first = manualFirst; second = manualSecond; }
    else if (directFirst !== null && directSecond !== null) { first = directFirst; second = directSecond; }
    if (first !== null && second !== null && Math.abs(first + second - 1) <= 0.000001) {
      const source = percentSource || splitTypeSource;
      const display = `${formatManagerNumber_(first * 100, 4)}/${formatManagerNumber_(second * 100, 4)}`;
      candidates.push({score:10, itemSplits:{}, display, firstPct:first, secondPct:second, evidence:[{
        display,
        sourceFile: source ? String(source[3] || '') : '',
        sourceSheet: source ? String(source[4] || group.sheetName || '') : String(group.sheetName || ''),
        sourceCell: source ? String(source[7] || '') : ''
      }]});
    }
  }

  if (!candidates.length) return {status:'MISSING', firstPct:null, secondPct:null, display:'', itemSplits:{}, evidence:[]};
  candidates.sort((a,b) => Number(b.score || 0) - Number(a.score || 0));
  const bestScore = Number(candidates[0].score || 0);
  const best = candidates.filter(item => Number(item.score || 0) === bestScore);
  const signatures = [...new Set(best.map(item => JSON.stringify(item.itemSplits || {}) + '|' + String(item.display || '')))];
  if (signatures.length !== 1) return {status:'CONFLICT', firstPct:null, secondPct:null, display:'', itemSplits:{}, evidence:best.flatMap(item=>item.evidence || [])};
  return Object.assign({status:'CONFIRMED'}, best[0]);
}

function extractDirectSourcePaymentSplitProfile_(rows, dealScheme, itemCount) {
  const groups = structuredRowsBySheet_(rows || []);
  const schemeText = normalizeRecognitionText_(dealScheme || '');
  const wantsClientImporter = /клиент.*импорт|импорт.*клиент/.test(schemeText);
  const wantsContractorImporter = /подрядчик.*импорт|импорт.*подрядчик/.test(schemeText);
  const candidates = [];

  for (const group of groups.values()) {
    const byRow = structuredRowCells_(group.rows);
    const rowNumbers = [...byRow.keys()].sort((a,b)=>Number(a)-Number(b));
    rowNumbers.forEach(rowNumber => {
      const cells = (byRow.get(rowNumber) || []).slice().sort((a,b)=>Number(a[6])-Number(b[6]));
      const rowBlob = normalizeRecognitionText_(cells.map(cell => String(structuredValue_(cell) || '')).join(' | '));
      if (!/разбивка по платежам/.test(rowBlob)) return;

      const nearbyRows = rowNumbers.filter(value => Number(value) >= Number(rowNumber) - 5 && Number(value) <= Number(rowNumber));
      const nearbyBlob = normalizeRecognitionText_(nearbyRows.map(value =>
        (byRow.get(value) || []).slice().sort((a,b)=>Number(a[6])-Number(b[6]))
          .map(cell => String(structuredValue_(cell) || '')).join(' | ')
      ).join(' | '));

      let score = 0;
      if (wantsClientImporter && /клиент.*импорт|импорт.*клиент/.test(nearbyBlob)) score += 100;
      if (wantsContractorImporter && /подрядчик.*импорт|импорт.*подрядчик/.test(nearbyBlob)) score += 100;
      if (wantsClientImporter && /подрядчик.*импорт|импорт.*подрядчик/.test(nearbyBlob)) score -= 100;
      if (wantsContractorImporter && /клиент.*импорт|импорт.*клиент/.test(nearbyBlob)) score -= 100;
      if (wantsClientImporter && /схема\s*1/.test(nearbyBlob)) score += 20;
      if (wantsContractorImporter && /схема\s*2/.test(nearbyBlob)) score += 20;

      const itemSplits = {};
      const evidence = [];
      let itemNumber = 0;
      cells.forEach(cell => {
        if (Number(cell[6]) <= 2) return;
        const split = parseQuotePaymentSplit_(structuredValue_(cell));
        if (!split) return;
        itemNumber += 1;
        if (itemCount && itemNumber > Number(itemCount)) return;
        const display = `${formatManagerNumber_(split.firstPct * 100, 4)}/${formatManagerNumber_(split.secondPct * 100, 4)}`;
        itemSplits[itemNumber] = display;
        evidence.push({itemNumber, display, sourceFile:String(cell[3]||''), sourceSheet:String(cell[4]||group.sheetName||''), sourceCell:String(cell[7]||'')});
      });
      if (Object.keys(itemSplits).length) candidates.push({score,itemSplits,evidence,sourceSheet:String(group.sheetName||'')});
    });
  }

  if (!candidates.length) return {status:'MISSING', itemSplits:{}, evidence:[]};
  candidates.sort((a,b)=>Number(b.score||0)-Number(a.score||0));
  const bestScore = Number(candidates[0].score || 0);
  const best = candidates.filter(item => Number(item.score || 0) === bestScore);
  const signatures = [...new Set(best.map(item => JSON.stringify(item.itemSplits || {})))];
  if (signatures.length !== 1) return {status:'CONFLICT', itemSplits:{}, evidence:best.flatMap(item=>item.evidence||[])};
  return Object.assign({status:'CONFIRMED'}, best[0]);
}

function resolveQuoteItemPaymentSplit_(dealPaymentText, itemNumber, sourceProfile) {
  const paymentText = String(dealPaymentText || '');
  const match = paymentText.match(new RegExp(`Товар\\s*${itemNumber}\\s*[—–-]\\s*(\\d+(?:[.,]\\d+)?)\\s*\\/\\s*(\\d+(?:[.,]\\d+)?)`, 'i'));
  if (match) {
    const first = normalizeStructuredPaymentPercent_(match[1]);
    const second = normalizeStructuredPaymentPercent_(match[2]);
    if (first !== null && second !== null && Math.abs(first + second - 1) <= 0.000001) {
      return `${formatManagerNumber_(first * 100, 4)}/${formatManagerNumber_(second * 100, 4)}`;
    }
  }
  if (sourceProfile && sourceProfile.status === 'CONFIRMED') {
    const itemSplit = sourceProfile.itemSplits && sourceProfile.itemSplits[Number(itemNumber)];
    if (itemSplit) return itemSplit;
    if (sourceProfile.display) return sourceProfile.display;
  }
  return '';
}

function parseQuotePaymentSplit_(value) {
  const match = String(value || '').trim().match(/(\d+(?:[.,]\d+)?)\s*\/\s*(\d+(?:[.,]\d+)?)/);
  if (!match) return null;
  const firstPct = normalizeStructuredPaymentPercent_(match[1]);
  const secondPct = normalizeStructuredPaymentPercent_(match[2]);
  if (firstPct === null || secondPct === null || Math.abs(firstPct + secondPct - 1) > 0.000001) return null;
  return {firstPct, secondPct};
}

function buildDeterministicQuotePaymentPlan_(context, result) {
  const buckets = result && result.bucketTotals || emptyExpenseBuckets_();
  const items = context && context.items || [];
  const itemExpenseMap = result && result.itemExpenseMap || new Map();
  let firstGoodsCny = 0;
  let secondGoodsCny = 0;

  items.forEach(item => {
    const split = parseQuotePaymentSplit_(item.paymentSplit);
    if (!split) throw new Error(`Для товара № ${item.number || ''} отсутствует подтвержденная двухэтапная разбивка оплаты.`);
    const itemExpenses = itemExpenseMap.get(String(item.itemId || item.id || '')) || [];
    const chinaCny = sumNumbers_(itemExpenses.filter(expense => expense.bucket === 'chinaDelivery').map(expense => Number(expense.amountCny || 0)));
    const invoiceCny = Number(item.amountCny || 0) + chinaCny;
    firstGoodsCny += invoiceCny * split.firstPct;
    secondGoodsCny += invoiceCny * split.secondPct;
  });

  const goodsPaymentBaseCny = firstGoodsCny + secondGoodsCny;
  const supplierBankCny = Number(buckets.supplierBankFees.cny || 0);
  const supplierBankRub = Number(buckets.supplierBankFees.rub || 0);
  const firstShare = goodsPaymentBaseCny > 0 ? firstGoodsCny / goodsPaymentBaseCny : 0;
  const firstBankCny = supplierBankCny * firstShare;
  const secondBankCny = supplierBankCny - firstBankCny;
  const firstBankRub = supplierBankRub * firstShare;
  const secondBankRub = supplierBankRub - firstBankRub;
  const cnyRub = Number(result.cnyRub || 0);
  const rubFromCny = value => cnyRub > 0 ? value * cnyRub : 0;

  const rows = [
    {number:1, amountCny:firstGoodsCny + firstBankCny, amountRub:rubFromCny(firstGoodsCny) + firstBankRub},
    {number:2, amountCny:Number(buckets.bbcCommission.cny || 0) + Number(buckets.exportSupport.cny || 0) + Number(buckets.incomingBankFees.cny || 0), amountRub:Number(buckets.bbcCommission.rub || 0) + Number(buckets.exportSupport.rub || 0) + Number(buckets.incomingBankFees.rub || 0)},
    {number:3, amountCny:secondGoodsCny + secondBankCny, amountRub:rubFromCny(secondGoodsCny) + secondBankRub},
    {number:4, amountCny:0, amountRub:0},
    {number:5, amountCny:Number(buckets.customsDuty.cny || 0) + Number(buckets.vat.cny || 0) + Number(buckets.customsFee.cny || 0), amountRub:Number(buckets.customsDuty.rub || 0) + Number(buckets.vat.rub || 0) + Number(buckets.customsFee.rub || 0)},
    {number:6, amountCny:Number(buckets.internationalLogistics.cny || 0) + Number(buckets.russiaDelivery.cny || 0) + Number(buckets.insurance.cny || 0), amountRub:Number(buckets.internationalLogistics.rub || 0) + Number(buckets.russiaDelivery.rub || 0) + Number(buckets.insurance.rub || 0)},
    {number:7, amountCny:Number(buckets.broker.cny || 0), amountRub:Number(buckets.broker.rub || 0)},
    {number:8, amountCny:Number(buckets.partnerCommission.cny || 0) + Number(buckets.partnerFinancialServices.cny || 0) + Number(buckets.certification.cny || 0) + Number(buckets.marking.cny || 0), amountRub:Number(buckets.partnerCommission.rub || 0) + Number(buckets.partnerFinancialServices.rub || 0) + Number(buckets.certification.rub || 0) + Number(buckets.marking.rub || 0)},
    {number:9, amountCny:Number(buckets.temporaryStorage.cny || 0) + Number(buckets.customsDelivery.cny || 0) + Number(buckets.other.cny || 0), amountRub:Number(buckets.temporaryStorage.rub || 0) + Number(buckets.customsDelivery.rub || 0) + Number(buckets.other.rub || 0)}
  ].map(row => Object.assign(row, {amountCny:roundTo_(row.amountCny, 8), amountRub:roundTo_(row.amountRub, 8)}));

  const totalCny = roundTo_(sumNumbers_(rows.map(row => row.amountCny)), 8);
  const totalRub = roundTo_(sumNumbers_(rows.map(row => row.amountRub)), 8);
  if (Math.abs(totalCny - Number(result.totalCny || 0)) > 0.000001 || Math.abs(totalRub - Number(result.totalRub || 0)) > 0.000001) {
    throw new Error(`Детерминированный график платежей не сходится с итогом сделки: ${totalCny} CNY / ${totalRub} RUB.`);
  }
  return {rows, totalCny, totalRub};
}

function bbcDocumentContourActivePaymentSchedule_(canonical, scheduleType) {
  const schedules = (canonical && canonical.paymentSchedules || []).filter(ps => ps && String(ps.scheduleType || '') === String(scheduleType));
  if (schedules.length !== 1) throw new Error('Expected exactly one ' + scheduleType + ' PaymentSchedule; found ' + schedules.length + '.');
  const schedule = schedules[0];
  const scheme = (schedule.schemes || []).find(item => item && item.active === true && String(item.schemeId || '') === String(schedule.activeSchemeId || ''));
  if (!scheme) throw new Error(scheduleType + ' has no active scheme.');
  return {schedule, scheme, stages:(scheme.stages || []).slice().sort((a,b) => Number(a.order || 0) - Number(b.order || 0))};
}

function buildCanonicalClientPaymentPlan_(canonical, result) {
  const active = bbcDocumentContourActivePaymentSchedule_(canonical, 'CLIENT_PAYMENT');
  const stages = active.stages;
  if (!stages.length) throw new Error('CLIENT_PAYMENT requires at least one stage.');
  if (stages.length > 9) throw new Error('Approved master payment table capacity is 9 stages; received ' + stages.length + '.');
  const currency = String(active.schedule.currency || '').trim().toUpperCase();
  if (['CNY','RUB'].indexOf(currency) < 0) throw new Error('CLIENT_PAYMENT currency must be CNY or RUB.');
  const cnyRub = Number(result.cnyRub || 0);
  if (!(cnyRub > 0)) throw new Error('CLIENT_PAYMENT rendering requires confirmed CNY/RUB rate.');
  const totalCny = Number(result.totalCny || 0), totalRub = Number(result.totalRub || 0);
  const base = currency === 'CNY' ? totalCny : totalRub;
  let percentCount = 0, percentSum = 0;
  const rows = stages.map(function(stage, index) {
    const hasAmount = stage.amount !== null && typeof stage.amount !== 'undefined' && stage.amount !== '';
    const hasPercent = stage.percent !== null && typeof stage.percent !== 'undefined' && stage.percent !== '';
    let nativeAmount;
    if (hasAmount) nativeAmount = Number(stage.amount);
    else if (hasPercent) {
      const pct = Number(stage.percent);
      percentCount += 1; percentSum += pct;
      nativeAmount = base * pct / 100;
    } else throw new Error('CLIENT_PAYMENT stage ' + (index + 1) + ' has neither amount nor percent.');
    if (!Number.isFinite(nativeAmount) || nativeAmount < 0) throw new Error('CLIENT_PAYMENT stage ' + (index + 1) + ' amount is invalid.');
    const amountCny = currency === 'CNY' ? nativeAmount : nativeAmount / cnyRub;
    const amountRub = currency === 'RUB' ? nativeAmount : nativeAmount * cnyRub;
    return {
      number:index + 1,
      label:String(stage.label || ('Payment ' + (index + 1))),
      description:String(stage.dueCondition || ''),
      amountCny:roundTo_(amountCny, 8),
      amountRub:roundTo_(amountRub, 8)
    };
  });
  if (percentCount === stages.length && Math.abs(percentSum - 100) > 0.000001) throw new Error('CLIENT_PAYMENT percentages must total 100%.');
  const sumCny = roundTo_(sumNumbers_(rows.map(row => row.amountCny)), 8);
  const sumRub = roundTo_(sumNumbers_(rows.map(row => row.amountRub)), 8);
  if (Math.abs(sumCny - totalCny) > 0.01 || Math.abs(sumRub - totalRub) > 0.01) throw new Error('CLIENT_PAYMENT does not reconcile to verified deal total.');
  return {rows, totalCny:sumCny, totalRub:sumRub, scheduleId:active.schedule.scheduleId, schemeId:active.scheme.schemeId};
}

function writeCanonicalQuotePaymentPlan_(quoteSheet, context, result) {
  const plan = {rows:(context.paymentRows || []).slice(), totalCny:Number(result.totalCny || 0), totalRub:Number(result.totalRub || 0)};
  if (!plan.rows.length) throw new Error('Snapshot-bound CLIENT_PAYMENT rows are required.');
  quoteSheet.getRange('A65:G73').clearContent();
  plan.rows.forEach(function(row, index) {
    const sheetRow = 65 + index;
    quoteSheet.getRange(sheetRow, 1).setValue(row.label || ('Payment ' + (index + 1)));
    quoteSheet.getRange(sheetRow, 5).setValue(Number(row.amountCny || 0));
    quoteSheet.getRange(sheetRow, 6).setValue(Number(row.amountRub || 0));
    quoteSheet.getRange(sheetRow, 7).setValue(row.description || '');
  });
  quoteSheet.getRange('E74').setValue(plan.totalCny);
  quoteSheet.getRange('F74').setValue(plan.totalRub);
  return plan;
}

function writeDeterministicQuotePaymentPlan_(quoteSheet, context, result) {
  const plan = buildDeterministicQuotePaymentPlan_(context, result);
  const labels = [
    ['1-й платёж — 1-я часть товара', 'Часть 1 стоимости товара + банковская комиссия за оплату поставщику (ам)'],
    ['2-й платёж — вознаграждение компании', 'Вознаграждение компании внешнеторговой сделки'],
    ['3-й платёж — 2-я часть товара + логистика внутри Китая', 'Часть 2 товара + доставка поставщик → склад BBC + банк'],
    ['4-й платёж — 3-я часть товара (если есть)', 'Часть 3 товара (если разбивка 3 части)'],
    ['5-й платёж — таможенные платежи', 'Пошлина + НДС + таможенный сбор'],
    ['6-й платёж — перевозка', 'Перевозка международная и внутри России + страховка'],
    ['7-й платёж — вознаграждение брокера', 'Оплата брокеру'],
    ['8-й платёж — документооборот перевозчика / импортёра + ДС/СС + выпуск ЧЗ', 'Документооборот перевозчика / услуги импортёра'],
    ['9-й платёж — доп. расходы и остаток', 'Хранение на СВХ / проверка на СВХ / Выезд на проверку и др.расходы (если появились)']
  ];
  plan.rows.forEach((row, index) => {
    const sheetRow = 65 + index;
    quoteSheet.getRange(sheetRow, 1).setValue(labels[index][0]);
    quoteSheet.getRange(sheetRow, 5).setValue(row.amountCny);
    quoteSheet.getRange(sheetRow, 6).setValue(row.amountRub);
    quoteSheet.getRange(sheetRow, 7).setValue(labels[index][1]);
  });
  quoteSheet.getRange('E74').setValue(plan.totalCny);
  quoteSheet.getRange('F74').setValue(plan.totalRub);
  return plan;
}

function buildStructuredCanonicalItemRow_(existingRow, dealId, item, customs) {
  const row = Array(42).fill('');
  const itemId = stableId_('ITM', [dealId, String(item.itemNumber)]);
  const hsCode = String(item.hsCode || (customs && customs.hsCode) || '').trim();
  const sourceImportId = String(item.sourceImportId || '');
  const evidence = (customs && customs.evidence || []).map(entry =>
    String(entry.sourceFile || '') + '!' + String(entry.sourceSheet || '') + '!' + String(entry.sourceCell || '')
  ).filter(Boolean);

  row[0] = itemId;
  row[1] = dealId;
  row[2] = item.itemNumber;
  row[3] = safeSpreadsheetText_(item.supplier);
  row[4] = safeSpreadsheetText_(item.name);
  row[5] = safeSpreadsheetText_(item.article);
  row[9] = hsCode;
  row[10] = item.quantity;
  row[11] = item.unit || '\u0448\u0442';
  row[12] = item.unitPrice;
  row[13] = 'CNY';
  row[14] = item.invoiceAmount;
  row[16] = item.grossWeight === null ? '' : item.grossWeight;
  row[17] = item.volume === null ? '' : item.volume;
  row[18] = item.packages === null ? '' : item.packages;
  row[19] = customs && customs.importVatRate !== null ? customs.importVatRate : '';
  row[20] = customs && customs.dutyMethod ? customs.dutyMethod : '';
  row[21] = customs && customs.dutyRate !== null ? customs.dutyRate : '';
  row[23] = sourceImportId ? 'import_id: ' + sourceImportId : '';
  row[24] = '\u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043e';
  row[25] = mergeSystemComment_(
    '',
    'DEV-016.50 structured current-deal item writeback. Primary item source: ' +
    String(item.sourceFile || '') + '!' + String(item.sourceSheet || '') + '!' +
    String(item.sourceCell || '') + (evidence.length ? '; customs evidence: ' + evidence.join('; ') : '')
  );
  row[26] = deriveCanonicalValueStatus_(item.quantity);
  row[27] = 'INC_VAT';
  row[28] = item.priceExVat === null ? '' : item.priceExVat;
  row[29] = item.chinaVatRate === null ? '' : item.chinaVatRate;
  row[30] = item.priceIncVat === null ? '' : item.priceIncVat;
  row[31] = normalizeVatRefundStatus_(item.vatRefundStatus);
  row[33] = Boolean(customs && customs.dutyMethod && customs.dutyRate !== null);
  row[34] = Boolean(customs && customs.importVatRate !== null);
  row[35] = safeSpreadsheetText_(item.sourceFile);
  row[36] = safeSpreadsheetText_(item.sourceSheet);
  row[37] = safeSpreadsheetText_(item.sourceCell);
  row[38] = item.sourceType || 'IMPORTED_VALUE';
  row[39] = stableId_('ITEMKEY', [dealId, item.itemNumber, item.article, item.name, item.quantity]);
  row[40] = deriveCanonicalValueStatus_(item.invoiceAmount);
  row[41] = '';
  return row;
}

function upsertStructuredCurrentDealItems_(spreadsheet, dealId, items, customs) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.items);
  const currentItemIds = [];
  (items || []).forEach(item => {
    const itemId = stableId_('ITM', [dealId, String(item.itemNumber)]);
    currentItemIds.push(itemId);
    const existingRowNumber = findRowByValue_(sheet, 1, itemId);
    const existing = existingRowNumber
      ? sheet.getRange(existingRowNumber, 1, 1, 42).getValues()[0]
      : Array(42).fill('');
    const row = buildStructuredCanonicalItemRow_(existing, dealId, item, customs || {});
    upsertCoreRowById_(sheet, row);
    const targetRow = findRowByValue_(sheet, 1, itemId);
    if (row[9] !== '') sheet.getRange(targetRow, 10).setNumberFormat('@').setValue(String(row[9]));
  });
  removeStaleImportedItems_(sheet, dealId, currentItemIds);
  return currentItemIds.length;
}

function extractStructuredCurrentDealItems_(spreadsheet, importIds, dealId) {
  const candidates = [];
  (importIds || []).forEach(importId => {
    const rows = getImportCellsByImportId_(spreadsheet, importId);
    const items = extractStructuredCurrentDealItemsFromRows_(rows);
    if (items.length) candidates.push(items);
  });
  if (!candidates.length) return {items: [], customs: {}};
  candidates.sort((left, right) => right.length - left.length);
  const customs = extractStructuredDealCustomsProfileFromRows_(
    getImportCellsByDealId_(spreadsheet, dealId)
  );
  return {items: candidates[0], customs};
}

function isMultiItemOrderSheetName_(value) {
  const normalized = normalizeImportedSheetName_(value)
    .replace(/[!！]+$/g, '')
    .trim();
  return normalized === 'заказ';
}

function getDealImportPriority_(spreadsheet, dealId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.imports);
  const priority = new Map();
  if (!sheet || sheet.getLastRow() < 2) return priority;

  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 14).getValues();
  rows.forEach((row, index) => {
    if (String(row[1]) !== String(dealId)) return;
    const importId = String(row[0] || '');
    if (!importId) return;
    const completedAt = row[3] instanceof Date ? row[3].getTime() : 0;
    priority.set(importId, completedAt || index + 1);
  });
  return priority;
}

function extractMultiItemOrderTableFromRows_(rows) {
  if (!rows.length) return [];

  const orderSheetNames = [...new Set(rows.map(row => String(row[4] || '')))]
    .filter(isMultiItemOrderSheetName_);
  if (!orderSheetNames.length) return [];

  const candidates = [];

  orderSheetNames.forEach(sheetName => {
    const sheetRows = rows.filter(row => String(row[4] || '') === sheetName);
    const lookup = buildImportedCellLookup_(sheetRows);
    const productColumns = [];

    sheetRows.forEach(row => {
      if (Number(row[5]) !== 1) return;
      const label = String(row[9] || row[8] || '').trim();
      const match = label.match(/^товар\s*(\d+)$/i);
      if (!match) return;
      productColumns.push({
        columnNumber: Number(row[6]),
        itemNumber: Number(match[1])
      });
    });

    productColumns.sort((left, right) => left.itemNumber - right.itemNumber);
    const items = [];

    productColumns.forEach(product => {
      const column = product.columnNumber;
      const nameCell = readImportedCell_(lookup, sheetName, 3, column);
      const quantityCell = readImportedCell_(lookup, sheetName, 4, column);
      const packagesCell = readImportedCell_(lookup, sheetName, 5, column);
      const grossWeightCell = readImportedCell_(lookup, sheetName, 6, column);
      const volumeCell = readImportedCell_(lookup, sheetName, 7, column);
      const unitPriceCell = readImportedCell_(lookup, sheetName, 8, column);
      const batchValueCell = readImportedCell_(lookup, sheetName, 9, column);
      const vatRefundCell = readImportedCell_(lookup, sheetName, 10, column);

      const name = String(importedCellValue_(nameCell) || '').trim();
      const quantity = parseOrderTableNumber_(
        importedCellValue_(quantityCell), {preferTotal: true}
      );
      const batchValue = parseOrderTableNumber_(
        importedCellValue_(batchValueCell)
      );

      if (!name || quantity === null || batchValue === null) return;

      items.push({
        itemNumber: product.itemNumber,
        name,
        quantity,
        unit: 'шт',
        packages: parseOrderTableNumber_(importedCellValue_(packagesCell)),
        grossWeight: parseOrderTableNumber_(importedCellValue_(grossWeightCell)),
        volume: parseOrderTableNumber_(importedCellValue_(volumeCell)),
        unitPrice: parseOrderTableNumber_(importedCellValue_(unitPriceCell)),
        batchValue,
        vatRefundStatus: String(importedCellValue_(vatRefundCell) || '').trim(),
        sourceImportId: String(nameCell ? nameCell.importId : ''),
        sourceFileId: String(nameCell ? nameCell.sourceFileId : ''),
        sourceFile: nameCell ? nameCell.sourceFile : '',
        sourceSheet: sheetName,
        sourceCell: [
          nameCell && nameCell.cellAddress,
          quantityCell && quantityCell.cellAddress,
          batchValueCell && batchValueCell.cellAddress
        ].filter(Boolean).join(', '),
        sourceType: batchValueCell && batchValueCell.formula
          ? 'FORMULA'
          : 'IMPORTED_VALUE'
      });
    });

    if (items.length >= 2) candidates.push(items);
  });

  if (!candidates.length) return [];
  candidates.sort((left, right) => right.length - left.length);
  return candidates[0];
}

function extractMultiItemOrderTable_(spreadsheet, importId, dealId) {
  // Сначала проверяется выбранный импорт. Это сохраняет прежнее поведение,
  // если расчёт и многотоварный заказ находятся в одном файле.
  const currentRows = getImportCellsByImportId_(spreadsheet, importId);
  const currentItems = extractMultiItemOrderTableFromRows_(currentRows);
  if (currentItems.length) return currentItems;

  // DEV-011: расходы и товарная детализация могут находиться в разных Excel.
  // Поэтому ищем лист «Заказ» во всех импортированных файлах той же сделки.
  const allDealRows = getImportCellsByDealId_(spreadsheet, dealId)
    .filter(row => String(row[0]) !== String(importId));
  if (!allDealRows.length) return [];

  const rowsByImport = new Map();
  allDealRows.forEach(row => {
    const sourceImportId = String(row[0] || '');
    if (!sourceImportId) return;
    if (!rowsByImport.has(sourceImportId)) rowsByImport.set(sourceImportId, []);
    rowsByImport.get(sourceImportId).push(row);
  });

  const priority = getDealImportPriority_(spreadsheet, dealId);
  const importIds = [...rowsByImport.keys()].sort((left, right) =>
    (priority.get(right) || 0) - (priority.get(left) || 0)
  );

  for (const sourceImportId of importIds) {
    const items = extractMultiItemOrderTableFromRows_(
      rowsByImport.get(sourceImportId)
    );
    if (items.length) return items;
  }

  return [];
}

function removeStaleImportedItems_(sheet, dealId, currentItemIds) {
  if (!sheet || sheet.getLastRow() < 2) return;
  const ids = new Set(currentItemIds.map(String));
  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 42).getValues();
  rows.forEach((row, index) => {
    if (String(row[1]) !== String(dealId)) return;
    const itemId = String(row[0] || '');
    const source = String(row[23] || '');
    if (ids.has(itemId)) return;
    if (!/^import_id:/i.test(source)) return;
    if (!isConfirmedStatus_(row[24])) return;
    row[24] = 'Расхождение';
    row[25] = mergeSystemComment_(
      row[25],
      'DEV-016.26: позиция исключена из расчёта при повторном переносе; ' +
      'строка сохранена для аудита и восстановления.'
    );
    row[40] = 'UNKNOWN';
    row[41] = mergeSystemComment_(
      row[41], 'Не подтверждено текущим набором импортированных товаров'
    );
    sheet.getRange(index + 2, 1, 1, 42).setValues([row]);
  });
}

function normalizeVatRefundStatus_(value) {
  const normalized = String(value || '')
    .trim()
    .toUpperCase()
    .replace(/Ё/g, 'Е');

  if (!normalized) return 'UNKNOWN';
  if (['ДА', 'YES', 'Y', 'TRUE', '1'].includes(normalized)) return 'YES';
  if (['НЕТ', 'NO', 'N', 'FALSE', '0'].includes(normalized)) return 'NO';
  if (
    ['НЕ ПРИМЕНЯЕТСЯ', 'НЕПРИМЕНИМО', 'N/A', 'NA', 'NOT_APPLICABLE']
      .includes(normalized)
  ) {
    return 'NOT_APPLICABLE';
  }
  if (['UNKNOWN', 'НЕИЗВЕСТНО', 'НЕ ОПРЕДЕЛЕНО'].includes(normalized)) {
    return 'UNKNOWN';
  }

  return 'UNKNOWN';
}

function classifyMultiItemOrderItem_(name) {
  const sourceName = String(name || '').trim();
  const normalized = sourceName
    .toLowerCase()
    .replace(/ё/g, 'е')
    .replace(/\s+/g, ' ');

  let ageGroup = 'Не определено';
  if (/детск/.test(normalized)) {
    ageGroup = 'Детский';
  } else if (/взросл/.test(normalized)) {
    ageGroup = 'Взрослый';
  }

  let material = '';
  if (/силикон/.test(normalized)) {
    material = 'силиконовая';
  } else if (/тканев|текстил/.test(normalized)) {
    material = 'тканевая';
  }

  let tnVed = '';
  if (material === 'силиконовая') {
    tnVed = '6506910000';
  } else if (material === 'тканевая') {
    tnVed = '6505009000';
  }

  return {ageGroup, material, tnVed};
}

function normalizeMultiItemOrderName_(name, classification) {
  const original = String(name || '')
    .replace(/\r\n?/g, '\n')
    .trim();
  if (!original) return '';

  const compact = original.replace(/\s+/g, ' ').trim();
  const sizeMatch = compact.match(/(?:^|\s)(Размер\s*:\s*[^\n]+)$/i);
  const sizeText = sizeMatch ? sizeMatch[1].trim() : '';
  const lower = compact.toLowerCase().replace(/ё/g, 'е');

  const isSwimCap = /шап(?:очка|ка)/.test(lower);
  const hasKnownAge = classification.ageGroup === 'Детский' ||
    classification.ageGroup === 'Взрослый';

  if (isSwimCap && hasKnownAge && classification.material) {
    const ageWord = classification.ageGroup === 'Детский'
      ? 'детская'
      : 'взрослая';
    const canonical = `Шапочка ${ageWord} ${classification.material} для плавания`;
    return sizeText ? `${canonical}\n${sizeText}` : canonical;
  }

  return compact;
}

function upsertMultiItemOrderTable_(
  spreadsheet, dealId, importId, multiItems
) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.items);
  const currentItemIds = [];

  multiItems.forEach(item => {
    const itemId = stableId_('ITM', [dealId, String(item.itemNumber)]);
    currentItemIds.push(itemId);
    const existingRow = findRowByValue_(sheet, 1, itemId);
    const row = existingRow
      ? sheet.getRange(existingRow, 1, 1, 42).getValues()[0]
      : Array(42).fill('');

    const classification = classifyMultiItemOrderItem_(item.name);
    const normalizedName = normalizeMultiItemOrderName_(
      item.name, classification
    );

    row[0] = itemId;
    row[1] = dealId;
    row[2] = item.itemNumber;
    row[4] = safeSpreadsheetText_(normalizedName);
    row[5] = '';
    row[8] = classification.ageGroup;
    row[9] = classification.tnVed;
    row[10] = item.quantity;
    row[11] = item.unit;
    row[12] = item.unitPrice === null ? '' : item.unitPrice;
    row[13] = 'CNY';
    row[14] = item.batchValue;
    row[15] = '';
    row[16] = item.grossWeight === null ? '' : item.grossWeight;
    row[17] = item.volume === null ? '' : item.volume;
    row[18] = item.packages === null ? '' : item.packages;
    const sourceImportId = item.sourceImportId || importId;
    row[23] = `import_id: ${sourceImportId}`;
    row[24] = 'Подтверждено';
    row[25] = mergeSystemComment_(
      row[25],
      `DEV-011: товарная позиция перенесена из многотоварного листа «Заказ»; ` +
      `источник ${sourceImportId}; возрастная группа ${classification.ageGroup}; ` +
      `ТН ВЭД ${classification.tnVed || 'не определён'}.`
    );
    row[26] = deriveCanonicalValueStatus_(item.quantity);
    row[27] = 'INC_VAT';
    row[28] = '';
    row[29] = '';
    row[30] = item.unitPrice === null ? '' : item.unitPrice;
    row[31] = normalizeVatRefundStatus_(item.vatRefundStatus);
    row[35] = safeSpreadsheetText_(item.sourceFile);
    row[36] = safeSpreadsheetText_(item.sourceSheet);
    row[37] = safeSpreadsheetText_(item.sourceCell);
    row[38] = item.sourceType || 'IMPORTED_VALUE';
    row[39] = stableId_('ITEMKEY', [
      dealId, item.itemNumber, normalizedName, item.quantity
    ]);
    row[40] = deriveCanonicalValueStatus_(item.batchValue);
    row[41] = '';

    upsertCoreRowById_(sheet, row);
  });

  removeStaleImportedItems_(sheet, dealId, currentItemIds);
  return multiItems.length;
}

function applyVerifiedItemData_(
  spreadsheet, dealId, importId, scalar, scalarMeta, approvedTable
) {
  // DEV-011: при наличии листа «Заказ» с колонками «Товар 1...N»
  // создаются самостоятельные позиции. Сводный скалярный товар в этом случае
  // не используется, чтобы не терять многотоварную структуру.
  const multiItems = extractMultiItemOrderTable_(spreadsheet, importId, dealId);
  if (multiItems.length) {
    return upsertMultiItemOrderTable_(
      spreadsheet, dealId, importId, multiItems
    );
  }

  const itemTableRow = approvedTable.find(row => row[18] === 'TOTAL_PRODUCT_VALUE');
  const hasItemData = [
    'ITEM_NAME', 'ARTICLE', 'TN_VED', 'QUANTITY', 'TOTAL_PRODUCT_VALUE',
    'GROSS_WEIGHT', 'NET_WEIGHT', 'TOTAL_WEIGHT', 'VOLUME', 'PACKAGE_COUNT'
  ].some(code => scalar.has(code)) || Boolean(itemTableRow);
  if (!hasItemData) return 0;
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.items);
  const itemId = stableId_('ITM', [dealId, '1']);
  const existingRow = findRowByValue_(sheet, 1, itemId);
  const row = existingRow
    ? sheet.getRange(existingRow, 1, 1, 42).getValues()[0]
    : Array(42).fill('');
  row[0] = itemId;
  row[1] = dealId;
  row[2] = 1;
  if (scalar.has('ITEM_NAME')) row[4] = safeSpreadsheetText_(scalar.get('ITEM_NAME'));
  if (scalar.has('ARTICLE')) row[5] = safeSpreadsheetText_(scalar.get('ARTICLE'));
  if (scalar.has('TN_VED')) row[9] = String(scalar.get('TN_VED'));
  if (scalar.has('QUANTITY')) {
    row[10] = scalar.get('QUANTITY');
    const quantityMeta = scalarMeta.get('QUANTITY') || {};
    if (String(quantityMeta.detectedUnit || '').trim()) {
      row[11] = safeSpreadsheetText_(quantityMeta.detectedUnit);
    }
  }
  if (scalar.has('TOTAL_PRODUCT_VALUE')) row[14] = scalar.get('TOTAL_PRODUCT_VALUE');
  if (itemTableRow) {
    row[14] = itemTableRow[13];
    row[13] = itemTableRow[16];
  }
  if (scalar.has('NET_WEIGHT')) row[15] = scalar.get('NET_WEIGHT');
  if (scalar.has('GROSS_WEIGHT')) row[16] = scalar.get('GROSS_WEIGHT');
  if (!row[16] && scalar.has('TOTAL_WEIGHT')) row[16] = scalar.get('TOTAL_WEIGHT');
  if (scalar.has('VOLUME')) row[17] = scalar.get('VOLUME');
  if (scalar.has('PACKAGE_COUNT')) row[18] = scalar.get('PACKAGE_COUNT');
  row[23] = `import_id: ${importId}`;
  row[24] = 'Подтверждено';
  if (scalar.has('VEHICLE_TYPE')) {
    row[25] = mergeSystemComment_(row[25], `Тип ТС: ${scalar.get('VEHICLE_TYPE')}`);
  }

  row[26] = scalar.has('QUANTITY')
    ? deriveCanonicalValueStatus_(scalar.get('QUANTITY'))
    : 'UNKNOWN';
  row[27] = itemTableRow || scalar.has('TOTAL_PRODUCT_VALUE')
    ? 'PARTNER_TOTAL'
    : 'UNKNOWN';
  const primaryMeta = itemTableRow ? {
    sourceFile: safeSpreadsheetText_(itemTableRow[4]),
    sourceSheet: safeSpreadsheetText_(itemTableRow[5]),
    sourceCell: safeSpreadsheetText_(itemTableRow[10]),
    sourceType: itemTableRow[14] ? 'FORMULA' : 'IMPORTED_VALUE'
  } : (scalarMeta.get('TOTAL_PRODUCT_VALUE') ||
       scalarMeta.get('QUANTITY') ||
       scalarMeta.get('ITEM_NAME') || {});
  row[35] = primaryMeta.sourceFile || '';
  row[36] = primaryMeta.sourceSheet || '';
  row[37] = primaryMeta.sourceCell || '';
  row[38] = primaryMeta.sourceType || 'IMPORTED_VALUE';
  row[39] = stableId_('ITEMKEY', [
    dealId, row[3], row[5], row[9], row[2]
  ]);
  row[40] = deriveCanonicalValueStatus_(row[14] !== '' ? row[14] : row[10]);
  row[41] = row[40] === 'UNKNOWN'
    ? 'Не подтверждены количество или стоимость товарной позиции'
    : '';

  upsertCoreRowById_(sheet, row);
  const targetRow = findRowByValue_(sheet, 1, itemId);
  if (row[9] !== '') {
    sheet.getRange(targetRow, 10).setNumberFormat('@').setValue(String(row[9]));
  }
  return 1;
}

function applyVerifiedExpenseData_(
  spreadsheet, dealId, importId, approvedTable
) {
  const expenseRows = approvedTable.filter(row => row[20] === 'Расход');
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.expenses);
  const rates = buildVerifiedWritebackRateMap_(spreadsheet, dealId);
  const approvedExpenseIds = new Set();
  expenseRows.forEach(source => {
    const amount = parseFlexibleNumber_(source[13]);
    const currency = String(source[16]);
    const converted = convertExpenseAmount_(amount, currency, rates);
    const expenseId = stableId_('EXP', [
      dealId, source[18], source[9], source[7]
    ]);
    approvedExpenseIds.add(expenseId);
    const row = Array(32).fill('');
    row[0] = expenseId;
    row[1] = dealId;
    row[2] = '';
    row[3] = 'Сделка';
    const sourceArticle = safeSpreadsheetText_(source[9]);
    const isCustomsDelivery = /доставк.*от.*свх.*склад.*клиент/i.test(
      normalizeRecognitionText_(sourceArticle)
    );
    row[4] = isCustomsDelivery ? 'Импорт и таможня' : source[17];
    row[5] = isCustomsDelivery
      ? 'Доставка от СВХ до склада клиента'
      : source[19];
    row[6] = amount;
    row[7] = currency;
    row[8] = converted.rateToCny;
    row[9] = converted.rateToRub;
    row[10] = converted.amountCny;
    row[11] = converted.amountRub;
    row[12] = safeSpreadsheetText_(`${source[4]}; import_id: ${importId}`);
    row[13] = safeSpreadsheetText_(source[5]);
    row[14] = `${source[8]}:${source[10]}`;
    row[15] = 'Не распределять';
    row[16] = true;
    row[17] = false;
    row[18] = 'Подтверждено';
    row[19] = mergeSystemComment_(
      '', source[14] ? `Формула источника: ${source[14]}` : ''
    );

    // DEV-002: перенос канонических статусов и происхождения.
    row[20] = deriveCanonicalValueStatus_(amount);
    row[21] = stableId_('EXPKEY', [
      dealId, source[18], source[19], source[7], source[9]
    ]);
    row[22] = 'TRANSFERRED';
    row[23] = '';
    row[24] = '';
    row[25] = '';
    row[26] = safeSpreadsheetText_(source[19]);
    row[27] = '';
    row[28] = 'Не показывать до настройки клиентского отображения';
    row[29] = source[14] ? 'FORMULA' : 'IMPORTED_VALUE';
    row[30] = buildManagerConfirmationId_(importId);
    row[31] = new Date();
    upsertCoreRowById_(sheet, row);
  });
  deactivateObsoleteImportedExpenses_(
    sheet, dealId, importId, approvedExpenseIds
  );
  return expenseRows.length;
}

function collectApprovedRateCandidates_(rows) {
  const candidates = new Map();
  rows.filter(row => row[20] === 'Курс валют').forEach(row => {
    const code = String(row[18] || '').trim().toUpperCase();
    const value = parseFlexibleNumber_(row[13]);
    if (!code || value === null || value <= 0) return;
    if (!candidates.has(code)) candidates.set(code, []);
    candidates.get(code).push({
      value,
      source: `${row[5] || ''}!${row[10] || ''}`
    });
  });
  return candidates;
}

function buildApprovedRateMap_(rows) {
  const map = new Map();
  const candidates = collectApprovedRateCandidates_(rows);
  candidates.forEach((entries, code) => {
    const distinct = [...new Set(
      entries.map(entry => roundTo_(entry.value, 8).toFixed(8))
    )];
    if (distinct.length === 1) map.set(code, Number(distinct[0]));
  });
  return map;
}

function buildVerifiedWritebackRateMap_(spreadsheet, dealId) {
  const rateBook = buildCalculationRateBook_(spreadsheet, [], dealId);
  return new Map(rateBook.selected);
}

function validateExpenseConversionInputs_(spreadsheet, approvedTable, dealId) {
  const expenseRows = approvedTable.filter(row => row[20] === 'Расход');
  if (expenseRows.length === 0) return [];
  const supported = new Set(['RUB', 'CNY', 'USD', 'EUR']);
  const currencies = new Set(
    expenseRows.map(row => String(row[16]).trim().toUpperCase())
  );
  const issues = [];
  [...currencies].filter(currency => !supported.has(currency)).forEach(currency => {
    issues.push(`валюта ${currency || 'не указана'} не поддерживается`);
  });

  const rateBook = buildCalculationRateBook_(spreadsheet, [], dealId);
  rateBook.conflicts.forEach((groups, code) => {
    const details = [...groups.entries()]
      .map(([value, entries]) =>
        `${Number(value)} (${entries.map(entry => entry.source).join(', ')})`
      )
      .join('; ');
    issues.push(`конфликт курса сделки ${dealId} ${code}: ${details}`);
  });

  const rates = new Map(rateBook.selected);
  if ([...currencies].some(currency => supported.has(currency)) &&
      !rates.has('CNY_RUB_RATE')) {
    issues.push(`не подтверждён положительный курс CNY/RUB для сделки ${dealId}`);
  }
  if (currencies.has('USD') && !rates.has('USD_RUB_RATE')) {
    issues.push(`не подтверждён положительный курс USD/RUB для сделки ${dealId}`);
  }
  if (currencies.has('EUR') && !rates.has('EUR_RUB_RATE')) {
    issues.push(`не подтверждён положительный курс EUR/RUB для сделки ${dealId}`);
  }
  return issues;
}

function convertExpenseAmount_(amount, currency, rates) {
  const cnyRub = rates.get('CNY_RUB_RATE');
  const usdRub = rates.get('USD_RUB_RATE');
  const eurRub = rates.get('EUR_RUB_RATE');
  if (currency === 'RUB') {
    return {
      rateToCny: cnyRub ? 1 / cnyRub : '', rateToRub: 1,
      amountCny: cnyRub ? amount / cnyRub : '', amountRub: amount
    };
  }
  if (currency === 'CNY') {
    return {
      rateToCny: 1, rateToRub: cnyRub || '', amountCny: amount,
      amountRub: cnyRub ? amount * cnyRub : ''
    };
  }
  if (currency === 'USD') {
    return {
      rateToCny: cnyRub && usdRub ? usdRub / cnyRub : '',
      rateToRub: usdRub || '',
      amountCny: cnyRub && usdRub ? amount * usdRub / cnyRub : '',
      amountRub: usdRub ? amount * usdRub : ''
    };
  }
  if (currency === 'EUR') {
    return {
      rateToCny: cnyRub && eurRub ? eurRub / cnyRub : '',
      rateToRub: eurRub || '',
      amountCny: cnyRub && eurRub ? amount * eurRub / cnyRub : '',
      amountRub: eurRub ? amount * eurRub : ''
    };
  }
  return {rateToCny: '', rateToRub: '', amountCny: '', amountRub: ''};
}

function deactivateObsoleteImportedExpenses_(
  sheet, dealId, importId, approvedExpenseIds
) {
  if (!sheet || sheet.getLastRow() < 2) return 0;
  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 32).getValues();
  const marker = `import_id: ${importId}`;
  let changed = 0;
  rows.forEach((row, index) => {
    const sameImport = String(row[12]).includes(marker);
    const obsolete = String(row[1]) === String(dealId) &&
      sameImport && !approvedExpenseIds.has(String(row[0]));
    if (!obsolete) return;
    row[16] = false;
    row[18] = 'Расхождение';
    row[19] = mergeSystemComment_(
      row[19], `Исключено при повторном переносе ${marker}`
    );
    row[20] = 'UNKNOWN';
    row[22] = 'EXCLUDED';
    row[23] = `Не подтверждено при повторном переносе ${marker}`;
    row[31] = new Date();
    sheet.getRange(index + 2, 1, 1, 32).setValues([row]);
    changed++;
  });
  return changed;
}

function upsertCoreRowById_(sheet, row) {
  const rowNumber = findRowByValue_(sheet, 1, row[0]);
  if (rowNumber) {
    sheet.getRange(rowNumber, 1, 1, row.length).setValues([row]);
  } else {
    appendRows_(sheet, [row]);
  }
}

function mergeSystemComment_(existing, addition) {
  const parts = [String(existing || '').trim(), String(addition || '').trim()]
    .filter(Boolean);
  return [...new Set(parts)].join('; ');
}


/**
 * Добавляет значение в строгий выпадающий список по заголовку, сохраняя
 * все уже существующие допустимые варианты. Нужен для совместимости с листами,
 * созданными предыдущими версиями структуры MVP.
 */
function ensureAllowedListValueByHeader_(sheet, header, requiredValue) {
  if (!sheet) return;
  const width = Math.max(sheet.getLastColumn(), 1);
  const headers = sheet.getRange(1, 1, 1, width).getDisplayValues()[0];
  const columnIndex = headers.indexOf(header);
  if (columnIndex === -1) {
    throw new Error(`На листе «${sheet.getName()}» отсутствует колонка «${header}».`);
  }

  const target = sheet.getRange(2, columnIndex + 1, Math.max(sheet.getMaxRows() - 1, 1), 1);
  const sampleRule = sheet.getRange(2, columnIndex + 1).getDataValidation();
  let values = [];

  if (sampleRule && sampleRule.getCriteriaType() === SpreadsheetApp.DataValidationCriteria.VALUE_IN_LIST) {
    const criteriaValues = sampleRule.getCriteriaValues();
    if (criteriaValues && Array.isArray(criteriaValues[0])) values = criteriaValues[0].map(String);
  }

  if (!values.includes(String(requiredValue))) values.push(String(requiredValue));
  if (!values.length) values = [String(requiredValue)];

  const rule = SpreadsheetApp.newDataValidation()
    .requireValueInList(values, true)
    .setAllowInvalid(false)
    .build();
  target.setDataValidation(rule);
}


/**
 * DEV-012 — создаёт детерминированное распределение подтверждённых расходов
 * сделки между несколькими товарами пропорционально стоимости товарных партий.
 *
 * Правило не придумывает новые суммы: сумма долей по каждому expense_id строго
 * равна подтверждённой сумме расхода в CNY и RUB. Остаток округления относится
 * на последнюю товарную позицию. Ручные распределения не перезаписываются.
 */
function ensureAutomaticMultiItemAllocations_(spreadsheet, model) {
  const items = (model.normalizedItems || []).filter(item =>
    item.itemId && isConfirmedStatus_(item.raw && item.raw['Уровень достоверности'])
  );
  if (items.length <= 1) return;

  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.allocations);
  if (!sheet) throw new Error('Лист «Распределение расходов» не найден.');

  const headers = readSheetHeaders_(sheet);
  const width = headers.length;
  const index = {};
  headers.forEach((header, i) => { index[header] = i; });

  const required = [
    'allocation_id', 'expense_id', 'deal_id', 'item_id',
    'Способ распределения', 'База распределения', 'Доля',
    'Сумма CNY', 'Сумма RUB', 'Комментарий',
    'Статус распределения', 'Источник правила', 'Дата подтверждения'
  ];
  required.forEach(name => {
    if (!(name in index)) throw new Error(`На листе «Распределение расходов» отсутствует колонка «${name}».`);
  });

  // DEV-012 v3.8.1: текущий лист может сохранять старую строгую
  // проверку данных в колонке «Способ распределения». Перед пакетной записью
  // расширяем именно существующий список допустимых значений, не удаляя
  // прежние варианты и не отключая валидацию.
  ensureAllowedListValueByHeader_(sheet, 'Способ распределения', 'GOODS_VALUE_SHARE');

  const existingRows = readDataRows_(sheet, width);
  const manualExpenseIds = new Set();
  existingRows.forEach(row => {
    if (String(row[index['deal_id']] || '') !== String(model.dealId)) return;
    const source = String(row[index['Источник правила']] || '').trim().toUpperCase();
    if (source && source !== 'AUTO_GOODS_VALUE_SHARE_DEV012') {
      manualExpenseIds.add(String(row[index['expense_id']] || ''));
    }
  });

  const cnyRub = model.rateBook.selected.get('CNY_RUB_RATE');
  if (!(cnyRub > 0)) throw new Error('Нет подтверждённого курса CNY/RUB для распределения расходов.');

  const itemBases = items.map(item => {
    const converted = convertMoneyForCalculation_(item.batchValue, item.priceCurrency, model.rateBook.selected);
    if (converted.error || !(converted.amountRub >= 0)) {
      throw new Error(`Нельзя определить базу распределения для товара ${item.itemId}: ${converted.error || 'нет стоимости партии'}.`);
    }
    return {item, rub: converted.amountRub, cny: converted.amountCny};
  });
  const totalBaseRub = sumNumbers_(itemBases.map(x => x.rub));
  if (!(totalBaseRub > 0)) throw new Error('Общая стоимость товаров равна нулю; распределение расходов невозможно.');

  const expenses = (model.normalizedExpenses || []).filter(expense =>
    expense.expenseId && expense.includeInternal && !expense.itemId &&
    isConfirmedStatus_(expense.raw && expense.raw['Уровень достоверности'])
  );

  const generated = [];
  expenses.forEach(expense => {
    if (manualExpenseIds.has(expense.expenseId)) return;
    const converted = convertMoneyForCalculation_(expense.amount, expense.currency, model.rateBook.selected);
    if (converted.error) {
      throw new Error(`Расход «${expense.name}» нельзя распределить: ${converted.error}.`);
    }

    let usedRub = 0;
    let usedCny = 0;
    itemBases.forEach((base, position) => {
      const last = position === itemBases.length - 1;
      const share = base.rub / totalBaseRub;
      const amountRub = last
        ? roundTo_(converted.amountRub - usedRub, 8)
        : roundTo_(converted.amountRub * share, 8);
      const amountCny = last
        ? roundTo_(converted.amountCny - usedCny, 8)
        : roundTo_(converted.amountCny * share, 8);
      usedRub = roundTo_(usedRub + amountRub, 8);
      usedCny = roundTo_(usedCny + amountCny, 8);

      const row = new Array(width).fill('');
      row[index['allocation_id']] = stableId_('ALLOC', [model.dealId, expense.expenseId, base.item.itemId, 'DEV012']);
      row[index['expense_id']] = expense.expenseId;
      row[index['deal_id']] = model.dealId;
      row[index['item_id']] = base.item.itemId;
      row[index['Способ распределения']] = 'GOODS_VALUE_SHARE';
      row[index['База распределения']] = roundTo_(base.rub, 8);
      row[index['Доля']] = roundTo_(share, 12);
      row[index['Сумма CNY']] = amountCny;
      row[index['Сумма RUB']] = amountRub;
      row[index['Комментарий']] = 'DEV-012: автоматическое распределение пропорционально стоимости товарной партии; остаток округления отнесён на последнюю позицию.';
      row[index['Статус распределения']] = 'CONFIRMED';
      row[index['Источник правила']] = 'AUTO_GOODS_VALUE_SHARE_DEV012';
      row[index['Дата подтверждения']] = new Date();
      generated.push(row);
    });
  });

  const kept = existingRows.filter(row => {
    if (String(row[index['deal_id']] || '') !== String(model.dealId)) return true;
    return String(row[index['Источник правила']] || '').trim().toUpperCase() !== 'AUTO_GOODS_VALUE_SHARE_DEV012';
  });
  const allRows = kept.concat(generated);
  if (sheet.getLastRow() > 1) sheet.getRange(2, 1, sheet.getLastRow() - 1, width).clearContent();
  if (allRows.length) sheet.getRange(2, 1, allRows.length, width).setValues(allRows);
  refreshSheetFilter_(sheet, width);
}

function sumAllocatedExpenseBucketForItem_(model, convertedExpenses, bucket, itemId, field) {
  const expenseIds = new Set(
    convertedExpenses.filter(expense => expense.bucket === bucket).map(expense => String(expense.id))
  );
  const values = (model.normalizedAllocations || [])
    .filter(allocation =>
      String(allocation.itemId) === String(itemId) &&
      expenseIds.has(String(allocation.expenseId))
    )
    .map(allocation => field === 'cny' ? allocation.amountCny : allocation.amountRub)
    .filter(value => value !== null && Number.isFinite(Number(value)));
  return values.length ? roundTo_(sumNumbers_(values), 8) : null;
}

/**
 * BBC КП Generator v2.5.1 — расчётное ядро и автоматические проверки.
 *
 * Расчёт выполняется только по подтверждённым товарам и активным
 * подтверждённым расходам. Итоги, контрольные и составные строки берутся
 * только для сверки и никогда не прибавляются к расходам.
 */
function calculateAndCheckDeal() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const dealId = resolveDealIdForCalculation_(spreadsheet);
  if (!dealId) return;

  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  let result;
  try {
    let model = readDealCalculationModel_(spreadsheet, dealId);
    ensureAutomaticMultiItemAllocations_(spreadsheet, model);
    model = readDealCalculationModel_(spreadsheet, dealId);
    result = calculateDealModel_(model);
    const checks = buildCalculationChecks_(model, result);
    applyPreservedCheckStatuses_(spreadsheet, dealId, checks);
    result.checks = checks;
    result.criticalCount = checks.filter(check =>
      check.severity === 'Критическая ошибка' && check.status === 'Открыто'
    ).length;
    result.warningCount = checks.filter(check =>
      check.severity === 'Предупреждение' && check.status === 'Открыто'
    ).length;
    result.status = result.criticalCount > 0
      ? 'Ошибка'
      : result.warningCount > 0 ? 'Требует проверки' : 'Проверен';

    writeItemLevelCalculations_(spreadsheet, model, result.itemLineCalculation);
    writeCurrentCalculations_(spreadsheet, model, result);
    writeCurrentChecks_(spreadsheet, dealId, checks);
    updateAppliedDecisionRows_(spreadsheet, dealId, result.decisionApplication && result.decisionApplication.applications);
    result.snapshotId = appendCalculationSnapshot_(spreadsheet, model, result);
    updateDealCalculationStatus_(spreadsheet, dealId, result);
  } finally {
    lock.releaseLock();
  }

  writeLog_(
    'USER', 'CALCULATE_AND_CHECK_DEAL', dealId,
    `snapshot_id ${result.snapshotId}; статус ${result.status}; ` +
    `критических: ${result.criticalCount}; предупреждений: ${result.warningCount}`
  );

  SpreadsheetApp.getUi().alert(
    `Расчёт и автоматическая проверка завершены — v${BBC_MVP.version}.\n\n` +
    `Сделка: ${dealId}\n` +
    `Товар: ${formatMoneyForAlert_(result.goodsRub)} RUB\n` +
    `Расходы: ${formatMoneyForAlert_(result.expensesRub)} RUB\n` +
    `Общий итог: ${formatMoneyForAlert_(result.totalRub)} RUB\n\n` +
    `Критических ошибок: ${result.criticalCount}\n` +
    `Предупреждений: ${result.warningCount}\n` +
    `Статус: ${result.status}\n\n` +
    'Результаты записаны на листы «Расчеты», «Проверки» и «Снимки расчетов».'
  );
}

function resolveDealIdForCalculation_(spreadsheet) {
  const activeSheet = spreadsheet.getActiveSheet();
  const activeRange = activeSheet && activeSheet.getActiveRange();
  if (
    activeSheet && activeRange &&
    activeSheet.getName() === BBC_MVP.sheets.deals &&
    activeRange.getRow() >= 2
  ) {
    const selected = String(
      activeSheet.getRange(activeRange.getRow(), 1).getDisplayValue()
    ).trim();
    if (selected) return selected;
  }

  const deals = spreadsheet.getSheetByName(BBC_MVP.sheets.deals);
  if (!deals || deals.getLastRow() < 2) {
    SpreadsheetApp.getUi().alert('На листе «Сделки» нет сделок для расчёта.');
    return '';
  }
  const values = deals.getRange(2, 1, deals.getLastRow() - 1, 1)
    .getDisplayValues().flat().filter(Boolean);
  const defaultDealId = values.length ? values[values.length - 1] : '';
  const response = SpreadsheetApp.getUi().prompt(
    'Расчёт и проверка сделки',
    'Укажите deal_id. Если нужная строка выбрана на листе «Сделки», ' +
    'закройте окно и запустите команду повторно.',
    SpreadsheetApp.getUi().ButtonSet.OK_CANCEL
  );
  if (response.getSelectedButton() !== SpreadsheetApp.getUi().Button.OK) return '';
  const dealId = String(response.getResponseText() || defaultDealId).trim();
  if (!dealId || !dealExists_(dealId)) {
    SpreadsheetApp.getUi().alert(`Сделка ${dealId || 'не указана'} не найдена.`);
    return '';
  }
  return dealId;
}

function readDealCalculationModel_(spreadsheet, dealId) {
  const dealSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.deals);
  const dealRowNumber = findRowByValue_(dealSheet, 1, dealId);
  if (!dealRowNumber) throw new Error(`Сделка ${dealId} не найдена.`);

  const dealHeaders = readSheetHeaders_(dealSheet);
  const dealValues = dealSheet.getRange(dealRowNumber, 1, 1, dealHeaders.length).getValues()[0];
  const dealRecord = rowToRecord_(dealHeaders, dealValues);
  // Legacy-массив сохраняется для обратной совместимости действующего расчётного ядра.
  const deal = dealValues.slice(0, 22);

  const itemsSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.items);
  const itemHeaders = readSheetHeaders_(itemsSheet);
  const allItemRowsFull = readDataRows_(itemsSheet, itemHeaders.length)
    .filter(row => String(row[1]) === String(dealId) && String(row[0]).trim());
  const allItemRecords = allItemRowsFull.map(row => rowToRecord_(itemHeaders, row));
  const itemRecords = allItemRecords.filter(record => isConfirmedStatus_(record['Уровень достоверности']));
  const allItems = allItemRowsFull.map(row => row.slice(0, 26));
  const items = allItems.filter(row => isConfirmedStatus_(row[24]));

  const expensesSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.expenses);
  const expenseHeaders = readSheetHeaders_(expensesSheet);
  const allExpenseRowsFull = readDataRows_(expensesSheet, expenseHeaders.length)
    .filter(row => String(row[1]) === String(dealId) && String(row[0]).trim());
  const allExpenseRecords = allExpenseRowsFull.map(row => rowToRecord_(expenseHeaders, row));
  const activeExpenseRecords = allExpenseRecords.filter(record => isTruthy_(record['Включать во внутренний расчет']));
  const expenseRecords = activeExpenseRecords.filter(record => isConfirmedStatus_(record['Уровень достоверности']));
  const allExpenses = allExpenseRowsFull.map(row => row.slice(0, 20));
  const activeExpenses = allExpenses.filter(row => isTruthy_(row[16]));
  const expenses = activeExpenses.filter(row => isConfirmedStatus_(row[18]));

  const allocationsSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.allocations);
  const allocationHeaders = readSheetHeaders_(allocationsSheet);
  const allocationRowsFull = readDataRows_(allocationsSheet, allocationHeaders.length)
    .filter(row => String(row[2]) === String(dealId));
  const allocationRecords = allocationRowsFull.map(row => rowToRecord_(allocationHeaders, row));
  const allocations = allocationRowsFull.map(row => row.slice(0, 11));

  const tableSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.tableRows);
  const confirmedTableRows = tableSheet && tableSheet.getLastRow() > 1
    ? tableSheet.getRange(2, 1, tableSheet.getLastRow() - 1, 26).getValues()
      .filter(row =>
        String(row[2]) === String(dealId) &&
        isConfirmedStatus_(row[24])
      )
    : [];
  const controls = confirmedTableRows.filter(row =>
    ['Контроль', 'Товар'].includes(String(row[20]))
  );

  // DEV-016.28: исходные курсы могут быть намеренно исключены из writeback как
  // устаревшие, но остаются доказательством формул партнёра. Берём их только из
  // того же import_id, который сформировал активные товары/расходы сделки.
  const activeImportIds = new Set();
  allItemRowsFull.concat(allExpenseRowsFull).forEach(row => {
    row.forEach(value => {
      const match = String(value || '').match(/import_id:\s*(IMP-[a-z0-9-]+)/i);
      if (match) activeImportIds.add(match[1]);
    });
  });
  const linkedSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.linked);
  const sourceRateEvidence = linkedSheet && linkedSheet.getLastRow() > 1
    ? linkedSheet.getRange(2, 1, linkedSheet.getLastRow() - 1, 30).getValues()
      .filter(row =>
        String(row[3]) === String(dealId) &&
        activeImportIds.has(String(row[2])) &&
        /^(CNY|USD|EUR)_RUB_RATE$/.test(String(row[12] || '').trim().toUpperCase()) &&
        parseFlexibleNumber_(row[18]) > 0
      )
      .map(row => ({
        code: String(row[12]).trim().toUpperCase(),
        value: parseFlexibleNumber_(row[18]),
        source: `${row[5] || ''}!${row[15] || row[7] || ''}`,
        importId: String(row[2] || ''),
        reviewStatus: String(row[28] || '')
      }))
    : [];

  // DEV-016.56: retain formula cells from the same active imports that produced
  // current items/expenses. They are audit evidence only; formulas are never executed
  // by the BBC calculation engine.
  const importCellsSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.importCells);
  const sourceFormulaEvidence = importCellsSheet && importCellsSheet.getLastRow() > 1 && activeImportIds.size
    ? importCellsSheet.getRange(2, 1, importCellsSheet.getLastRow() - 1, 15).getValues()
      .filter(row => activeImportIds.has(String(row[0])) && String(row[10] || '').trim())
      .map(row => ({
        importId: String(row[0] || ''),
        dealId: String(row[1] || ''),
        sourceFileId: String(row[2] || ''),
        sourceFile: String(row[3] || ''),
        sheetName: String(row[4] || ''),
        rowNumber: Number(row[5]),
        columnNumber: Number(row[6]),
        cellAddress: String(row[7] || ''),
        rawValue: row[8],
        displayValue: row[9],
        formula: String(row[10] || '').trim()
      }))
    : [];

  const settings = readSettingsMap_(spreadsheet);
  const rateBook = buildCalculationRateBook_(spreadsheet, allExpenses, dealId);
  /*
   * DEV-009 / правило BBC:
   * комиссия рассчитывается автоматически как процент от суммы заказа до комиссии,
   * но не может быть ниже установленного минимума в CNY.
   * Текущее утверждённое правило: 10%, минимум 5 000 CNY.
   */
  const defaultCommissionPercent =
    parseFlexibleNumber_(settings.DEFAULT_BBC_COMMISSION_PERCENT) ?? 10;
  const minimumCommissionCny =
    parseFlexibleNumber_(settings.MIN_BBC_COMMISSION_CNY) ?? 5000;

  const commissionInput = {
    type: 'PERCENT',
    value: defaultCommissionPercent,
    base: 'GOODS_WITH_CHINA_DELIVERY',
    currency: 'CNY',
    minimumCny: minimumCommissionCny,
    confirmedByManager: true,
    confirmationId: 'AUTO-BBC-COMMISSION-RULE',
    confirmedAt: new Date(),
    rulesVersion: BBC_MVP.version,
    source: 'GLOBAL_APPROVED_RULE',
    confirmedByApprovedRule: true
  };

  const normalizedItems = allItemRecords.map(normalizeItemRecord_);
  const normalizedExpenses = allExpenseRecords.map(normalizeExpenseRecord_);
  const normalizedAllocations = allocationRecords.map(normalizeAllocationRecord_);
  const completeness = buildModelCompleteness_(dealRecord, normalizedItems, normalizedExpenses, normalizedAllocations, commissionInput);
  const discrepancyDecisions = readDiscrepancyDecisions_(spreadsheet, dealId);

  return {
    spreadsheet, dealId, deal, dealRecord, dealRowNumber,
    allItems, items, allItemRecords, itemRecords, normalizedItems,
    allExpenses, activeExpenses, expenses, allExpenseRecords, activeExpenseRecords,
    expenseRecords, normalizedExpenses,
    allocations, allocationRecords, normalizedAllocations,
    controls, confirmedTableRows, sourceRateEvidence, sourceFormulaEvidence,
    settings, rateBook, commissionInput, completeness, discrepancyDecisions,
    calculatedAt: new Date()
  };
}

function readSheetHeaders_(sheet) {
  if (!sheet || sheet.getLastColumn() < 1) return [];
  return sheet.getRange(1, 1, 1, sheet.getLastColumn()).getDisplayValues()[0]
    .map(value => String(value || '').trim());
}

function readDataRows_(sheet, width) {
  if (!sheet || sheet.getLastRow() < 2 || width < 1) return [];
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, width).getValues();
}

function rowToRecord_(headers, row) {
  const record = {};
  headers.forEach((header, index) => {
    if (header) record[header] = row[index];
  });
  return record;
}

function normalizeValueStatus_(rawStatus, value) {
  const status = String(rawStatus || '').trim().toUpperCase();
  if (['VALUE', 'CONFIRMED_ZERO', 'UNKNOWN', 'CONFLICT'].includes(status)) return status;
  if (value === '' || value === null || typeof value === 'undefined') return 'UNKNOWN';
  const numeric = parseFlexibleNumber_(value);
  if (numeric === 0) return 'CONFIRMED_ZERO';
  return 'VALUE';
}

function normalizeItemRecord_(record) {
  const quantity = parseFlexibleNumber_(record['Количество']);
  const batchValue = parseFlexibleNumber_(record['Стоимость партии']);
  const dutyMethod = String(record['Тип пошлины'] || '').trim().toUpperCase();
  const dutyRate = parseFlexibleNumber_(record['Ставка пошлины']);
  const importVatRate = parseFlexibleNumber_(record['Ставка НДС']);
  const dutyMethodConfirmedRaw = isTruthy_(record['Метод пошлины подтвержден']);
  const importVatConfirmedRaw = isTruthy_(record['Ставка импортного НДС подтверждена']);
  const dutyDeterministicFromCurrentDeal =
    ['PERCENT', 'EUR_PER_KG', 'USD_PER_KG'].includes(dutyMethod) &&
    dutyRate !== null && Number.isFinite(Number(dutyRate)) && Number(dutyRate) >= 0;
  const importVatDeterministicFromCurrentDeal =
    importVatRate !== null && Number.isFinite(Number(importVatRate)) && Number(importVatRate) >= 0;
  return {
    itemId: String(record['item_id'] || '').trim(),
    dealId: String(record['deal_id'] || '').trim(),
    itemNumber: record['Номер позиции'],
    supplierId: String(record['Поставщик'] || '').trim(),
    name: String(record['Наименование товара'] || '').trim(),
    article: String(record['Артикул'] || '').trim(),
    hsCode: String(record['Код ТН ВЭД'] || '').trim(),
    quantity,
    quantityStatus: normalizeValueStatus_(record['Статус значения количества'], quantity),
    unit: String(record['Единица количества'] || '').trim(),
    unitPrice: parseFlexibleNumber_(record['Цена за единицу']),
    priceCurrency: String(record['Валюта цены'] || '').trim().toUpperCase(),
    batchValue,
    priceType: String(record['Тип цены'] || '').trim().toUpperCase(),
    priceExVat: parseFlexibleNumber_(record['Цена без VAT']),
    chinaVatRate: parseFlexibleNumber_(record['Ставка VAT Китая']),
    priceIncVat: parseFlexibleNumber_(record['Цена с VAT']),
    vatRefundStatus: String(record['Статус возврата VAT'] || '').trim().toUpperCase(),
    vatRefundCostsCny: parseFlexibleNumber_(record['Расходы на возврат VAT CNY']),
    netWeightKg: parseFlexibleNumber_(record['Вес нетто, кг']),
    grossWeightKg: parseFlexibleNumber_(record['Вес брутто, кг']),
    volumeM3: parseFlexibleNumber_(record['Объем, м3']),
    packages: parseFlexibleNumber_(record['Количество мест']),
    importVatRate,
    dutyMethod,
    dutyRate,
    dutyCurrency: String(record['Валюта пошлины'] || '').trim().toUpperCase(),
    dutyMethodConfirmed: dutyMethodConfirmedRaw || dutyDeterministicFromCurrentDeal,
    importVatConfirmed: importVatConfirmedRaw || importVatDeterministicFromCurrentDeal,
    dutyConfirmationBasis: dutyMethodConfirmedRaw ? 'EXPLICIT_FLAG' : (dutyDeterministicFromCurrentDeal ? 'CURRENT_DEAL_SOURCE_FIELDS' : ''),
    importVatConfirmationBasis: importVatConfirmedRaw ? 'EXPLICIT_FLAG' : (importVatDeterministicFromCurrentDeal ? 'CURRENT_DEAL_SOURCE_FIELDS' : ''),
    source: {
      file: String(record['source_file'] || '').trim(),
      sheet: String(record['source_sheet'] || '').trim(),
      cell: String(record['source_cell'] || '').trim(),
