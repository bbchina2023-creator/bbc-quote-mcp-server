function isConfirmedStatus_(value) {
  return ['Подтверждено', 'Исправлено'].includes(String(value).trim());
}

function isTruthy_(value) {
  return value === true || ['TRUE', 'ИСТИНА', 'ДА', 'YES', '1']
    .includes(String(value).trim().toUpperCase());
}

function findDuplicateValues_(values) {
  const seen = new Set();
  const duplicates = new Set();
  values.map(value => String(value).trim()).filter(Boolean).forEach(value => {
    if (seen.has(value)) duplicates.add(value);
    seen.add(value);
  });
  return [...duplicates];
}

function sumNumbers_(values) {
  return values.reduce((sum, value) => {
    const numeric = Number(value);
    return Number.isFinite(numeric) ? sum + numeric : sum;
  }, 0);
}

function roundTo_(value, digits) {
  const factor = Math.pow(10, digits);
  return Math.round((Number(value) + Number.EPSILON) * factor) / factor;
}

function roundMoney_(value) {
  return roundTo_(value, 2);
}

function formatMoneyForAlert_(value) {
  return roundMoney_(value).toFixed(2).replace('.', ',');
}

