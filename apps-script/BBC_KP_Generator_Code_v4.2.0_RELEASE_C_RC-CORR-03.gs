function validateReleaseAControlPaymentReconciliation_(canonical) {
  var issues=[];
  var schedules=(canonical.paymentSchedules||[]).filter(function(ps){return String(ps.scheduleType||'')==='SUPPLIER_ITEM_PAYMENT';});
  if(schedules.length!==1)return {ok:false,issues:[{code:'CONTROL_PAYMENT_SCHEDULE_COUNT',message:'Expected exactly one supplier item payment schedule.'}]};
  var schedule=schedules[0],v=validatePaymentScheduleV1Object_(schedule,canonical);
  if(!v.ok)issues=issues.concat(v.issues);
  var active=(schedule.schemes||[]).filter(function(s){return s.active===true;})[0];
  var byItem={},stageTotal=0;
  (active&&active.stages||[]).forEach(function(stage){
    var allocSum=0;
    (stage.allocations||[]).forEach(function(a){
      if(String(a.entityType||'')!=='ITEM')return;
      var id=String(a.entityId||'');
      byItem[id]=byItem[id]||{amount:0,percent:0};
      byItem[id].amount+=Number(a.amount||0);byItem[id].percent+=Number(a.percent||0);allocSum+=Number(a.amount||0);
    });
    stageTotal+=Number(stage.amount||0);
    if(Math.abs(Number(stage.amount||0)-allocSum)>0.000001)issues.push({code:'CONTROL_PAYMENT_STAGE_AMOUNT',message:'Stage amount does not equal item allocations for '+stage.stageId});
  });
  (canonical.items||[]).forEach(function(item){
    var x=byItem[String(item.itemId||'')];
    if(!x){issues.push({code:'CONTROL_PAYMENT_ITEM_MISSING',message:'No payment allocations for '+item.itemId});return;}
    if(Math.abs(x.amount-Number(item.batchAmount||0))>0.000001)issues.push({code:'CONTROL_PAYMENT_ITEM_AMOUNT',message:'Payment amounts do not reconcile item '+item.itemId});
    if(Math.abs(x.percent-100)>0.000001)issues.push({code:'CONTROL_PAYMENT_ITEM_PERCENT',message:'Payment percentages do not total 100% for '+item.itemId});
  });
  var goods=(canonical.items||[]).reduce(function(s,i){return s+Number(i.batchAmount||0);},0);
  if(Math.abs(stageTotal-goods)>0.000001)issues.push({code:'CONTROL_PAYMENT_TOTAL',message:'Payment stages do not reconcile canonical goods CNY.'});
  return {ok:issues.length===0,issues:issues,stageTotal:stageTotal,goodsTotal:goods,paymentHash:bbcReleaseASha256Hex_(canonical.paymentSchedules||[])};
}

function bbcReleaseAIdempotentStoreWrite_(sheet,headers,record,uniqueField,ignoredComparisonFields) {
  var fields=Array.isArray(uniqueField)?uniqueField.slice():[uniqueField];
  var ignored=new Set(Array.isArray(ignoredComparisonFields)?ignoredComparisonFields:[]);
  var indexes=fields.map(function(field){var idx=headers.indexOf(field);if(idx<0)throw new Error('Unknown immutable key '+field);return idx;});
  var key=fields.map(function(field){return String(record[field]===undefined?'':record[field]);}).join('|');
  var last=sheet.getLastRow();
  if(last>1){
    var rows=sheet.getRange(2,1,last-1,headers.length).getValues();
    for(var i=0;i<rows.length;i++){
      var rowKey=indexes.map(function(idx){return String(rows[i][idx]===undefined?'':rows[i][idx]);}).join('|');
      if(rowKey!==key)continue;
      var existing={};headers.forEach(function(h,j){existing[h]=rows[i][j];});
      var same=headers.every(function(h){
        if(ignored.has(h))return true;
        return String(existing[h]===undefined?'':existing[h])===String(record[h]===undefined?'':record[h]);
      });
      if(!same)throw new Error('Immutable idempotency conflict for '+fields.join('+')+': '+key);
      return {status:'EXISTING_IDENTICAL',key:key};
    }
  }
  sheet.appendRow(headers.map(function(h){return record[h]===undefined?'':record[h];}));
  return {status:'APPENDED',key:key};
}

