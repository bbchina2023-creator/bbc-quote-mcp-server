  const transportCny = buckets.internationalLogistics.cny + buckets.russiaDelivery.cny + buckets.insurance.cny;
  const transportRub = buckets.internationalLogistics.rub + buckets.russiaDelivery.rub + buckets.insurance.rub;
  quoteSheet.getRange('G32').setValue('Стоимость перевозки до границы');
  setQuoteMoneyRow_(quoteSheet, 32, buckets.internationalLogistics.cny, buckets.internationalLogistics.rub);
  setQuoteMoneyRow_(quoteSheet, 33, buckets.russiaDelivery.cny, buckets.russiaDelivery.rub);
  setQuoteMoneyRow_(quoteSheet, 34, buckets.insurance.cny, buckets.insurance.rub);
  setQuoteMoneyRow_(quoteSheet, 35, buckets.partnerCommission.cny, buckets.partnerCommission.rub);
  setQuoteMoneyRow_(quoteSheet, 36, transportCny, transportRub);
  setQuoteMoneyRow_(quoteSheet, 37, quantityTotal ? transportCny / quantityTotal : 0, quantityTotal ? transportRub / quantityTotal : 0);

  setQuoteMoneyRow_(quoteSheet, 40, buckets.customsDuty.cny, buckets.customsDuty.rub);
  setQuoteMoneyRow_(quoteSheet, 41, buckets.vat.cny, buckets.vat.rub);
  setQuoteMoneyRow_(quoteSheet, 42, buckets.customsFee.cny, buckets.customsFee.rub);
  setQuoteMoneyRow_(quoteSheet, 43, buckets.broker.cny, buckets.broker.rub);
  setQuoteMoneyRow_(quoteSheet, 44, buckets.temporaryStorage.cny, buckets.temporaryStorage.rub);
