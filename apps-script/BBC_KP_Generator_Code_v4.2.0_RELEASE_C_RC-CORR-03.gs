function runCalculationRegressionTest() {
  const rates = new Map([
    ['CNY_RUB_RATE', 10.45],
    ['USD_RUB_RATE', 73],
    ['RUB_RUB_RATE', 1]
  ]);
  const goodsRubExpected = 747645.25;
  const expensesRubExpected = 586836.43;
  const totalRubExpected = 1334481.68;
  const goods = convertMoneyForCalculation_(71545, 'CNY', rates);
  const sourceExpenses = [
    [800, 'USD'], [79000, 'RUB'], [12585, 'CNY'], [19705.4, 'CNY'],
    [4924, 'RUB'], [25000, 'RUB'], [0, 'RUB'], [12000, 'RUB'],
    [9200, 'RUB'], [2861.8, 'CNY'], [30000, 'RUB'], [0, 'RUB'],
    [971.938825, 'RUB']
  ];
  const items = [{amountCny: goods.amountCny, amountRub: goods.amountRub}];
  const expenses = sourceExpenses.map(entry => {
    const converted = convertMoneyForCalculation_(entry[0], entry[1], rates);
    if (converted.error) throw new Error(converted.error);
    return {amountCny: converted.amountCny, amountRub: converted.amountRub};
  });
  const result = calculateMoneySummary_(items, expenses);
  const actualGoods = roundMoney_(result.goodsRub);
  const actualExpenses = roundMoney_(result.expensesRub);
  const actualTotal = roundMoney_(result.totalRub);
  const ok =
    actualGoods === goodsRubExpected &&
    actualExpenses === expensesRubExpected &&
    actualTotal === totalRubExpected &&
    classifyExpenseBucket_('Комиссии', 'Финансовые услуги') ===
      'partnerFinancialServices' &&
    classifyExpenseBucket_('Комиссии', 'Агентское вознаграждение') ===
      'partnerCommission' &&
