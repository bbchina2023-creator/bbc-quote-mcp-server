/**
 * Устанавливает проверку ввода по имени заголовка.
 * Используется для новых колонок, чтобы дальнейшее расширение схемы справа
 * не требовало пересчёта жёстко заданных номеров колонок.
 */
function setListValidationByHeader_(sheet, header, values) {
  if (!sheet) return;
  const width = Math.max(sheet.getLastColumn(), 1);
  const headers = sheet.getRange(1, 1, 1, width).getDisplayValues()[0];
  const index = headers.indexOf(header);
  if (index === -1) {
    throw new Error(
      `Лист «${sheet.getName()}»: не найдена колонка «${header}» для проверки ввода.`
    );
  }
  setListValidation_(sheet, index + 1, values);
}

