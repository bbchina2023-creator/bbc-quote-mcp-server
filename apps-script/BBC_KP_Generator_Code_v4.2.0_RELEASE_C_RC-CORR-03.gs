function bbcDocumentContourQuoteFolder_(spreadsheet, settings, dealId) {
  const root = getQuoteOutputFolder_(spreadsheet,settings,dealId);
  return getOrCreateDriveFolder_(root,BBC_DOCUMENT_CONTOUR.outputFolder);
}

function bbcDocumentContourFilesByName_(folder, name) {
  const out = [];
  const it = folder.getFilesByName(name);
  while (it.hasNext()) out.push(it.next());
  return out;
}

function bbcDocumentContourFindCompletedQuoteResultForSnapshot_(spreadsheet, snapshot) {
  const sheet=bbcDocumentContourValidateOperationSheet_(spreadsheet.getSheetByName(BBC_DOCUMENT_CONTOUR.operationsSheet));
  if(!sheet||sheet.getLastRow()<2)return null;
  const rows=sheet.getDataRange().getValues(),h=rows[0].map(String);
  const typeI=h.indexOf('operation_type'),statusI=h.indexOf('status'),resultI=h.indexOf('result_json');
  for(let i=rows.length-1;i>=1;i--){
    if(String(rows[i][typeI])!=='GENERATE_QUOTE'||String(rows[i][statusI])!=='COMPLETED')continue;
    let candidate=null;try{candidate=JSON.parse(String(rows[i][resultI]||''));}catch(error){candidate=null;}
    if(!candidate)continue;
    if(String(candidate.snapshotId||'')!==String(snapshot.snapshotId||''))continue;
    if(String(candidate.snapshotHash||'')!==String(snapshot.snapshotHash||''))continue;
    return candidate;
  }
  return null;
}

function bbcDocumentContourFileBelongsToFolder_(file, folder) {
  if(!file||!folder)return false;
  const parents=file.getParents();
  while(parents.hasNext())if(String(parents.next().getId())===String(folder.getId()))return true;
  return false;
}

function bbcDocumentContourFindExistingQuoteArtifacts_(folder, baseName, provenResult) {
  // Name-only recovery is unsafe because a deal retains its business quote number across
  // canonical revisions. Recovery is allowed only from a COMPLETED operation already bound
  // to the same snapshotId + snapshotHash and to these exact Drive file IDs.
  const files=provenResult&&provenResult.files;
  if(!files||!files.googleSheets||!files.xlsx||!files.pdf)return null;
  try{
    const gs=DriveApp.getFileById(String(files.googleSheets.id||''));
    const xlsx=DriveApp.getFileById(String(files.xlsx.id||''));
    const pdf=DriveApp.getFileById(String(files.pdf.id||''));
    if(gs.isTrashed()||xlsx.isTrashed()||pdf.isTrashed())return null;
    if(gs.getName()!==baseName||xlsx.getName()!==baseName+'.xlsx'||pdf.getName()!==baseName+'.pdf')return null;
    if(gs.getMimeType()!==MimeType.GOOGLE_SHEETS)return null;
    if(!bbcDocumentContourFileBelongsToFolder_(gs,folder)||!bbcDocumentContourFileBelongsToFolder_(xlsx,folder)||!bbcDocumentContourFileBelongsToFolder_(pdf,folder))return null;
    const acceptance=bbcReleaseBXlsxAcceptance_(xlsx);
    const pdfAcceptance=bbcReleaseBPdfAcceptance_(pdf);if(acceptance.ok&&pdfAcceptance.ok)return {googleSheets:gs,xlsx,pdf,xlsxAcceptance:acceptance,pdfAcceptance};
  }catch(error){return null;}
  return null;
}

function bbcDocumentContourCleanupNamedArtifacts_(folder, baseName) {
  [baseName,baseName+'.xlsx',baseName+'.pdf'].forEach(name => bbcDocumentContourFilesByName_(folder,name).forEach(file => { try { file.setTrashed(true); } catch (error) {} }));
}

function bbcDocumentContourCleanupNamedArtifactsExcept_(folder, baseName, keepFileIds) {
  const keep=new Set((keepFileIds||[]).map(String));
  [baseName,baseName+'.xlsx',baseName+'.pdf'].forEach(name => bbcDocumentContourFilesByName_(folder,name).forEach(file => {
    try { if(!keep.has(String(file.getId())))file.setTrashed(true); } catch (error) {}
  }));
}

function bbcDocumentContourGenerateQuote_(args, requestId) {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  if (!spreadsheet) throw new Error('Active BBC spreadsheet is required.');
  const snapshotId = String(args.snapshotId || '').trim(), key = String(args.idempotencyKey || '').trim(), profile = String(args.outputProfile || BBC_DOCUMENT_CONTOUR.outputProfile);
  if (!snapshotId) throw new Error('snapshotId is required.');
  if (profile !== BBC_DOCUMENT_CONTOUR.outputProfile) throw new Error('Unsupported outputProfile: ' + profile);
  const lock = LockService.getDocumentLock(); lock.waitLock(30000);
  let state=null; const created=[];
  try {
    state=bbcDocumentContourBeginOperation_(spreadsheet,'GENERATE_QUOTE',key,{snapshotId,outputProfile:profile},'',snapshotId);
    if(state.existing)return state.result;
    const snapshot=readVerifiedSnapshotV2ById_(spreadsheet,snapshotId);
    if(!snapshot)throw new Error('Verified Snapshot v2 not found: '+snapshotId);
    const integrity=validateSnapshotV2Integrity_(snapshot); if(!integrity.ok)throw new Error('SNAPSHOT_INTEGRITY_BLOCK:'+JSON.stringify(integrity.issues));
    // Any quote-critical canonical change creates a new canonical revision and invalidates
    // older snapshots for new document generation. Old snapshots remain retrievable for audit.
    const latestSnapshot=readLatestVerifiedSnapshotV2ForDeal_(spreadsheet,String(snapshot.dealId||''));
    if(!latestSnapshot||String(latestSnapshot.snapshotId||'')!==String(snapshot.snapshotId||'')){
      throw new Error('SNAPSHOT_STALE_BLOCK: requested Snapshot v2 is not the latest VERIFIED snapshot for this deal.');
    }
    if(!/^BBC-\d{4}-\d{3,}$/.test(String(snapshot.quoteNumber||'')))throw new Error('SNAPSHOT_QUOTE_NUMBER_BLOCK: business quote number is missing or invalid.');
    const approvedTemplate=bbcDocumentContourApprovedTemplateBinding_();
    if(snapshot.templateId!==approvedTemplate.templateId||snapshot.templateVersion!==approvedTemplate.templateVersion||snapshot.outputProfile!==approvedTemplate.outputProfile)throw new Error('SNAPSHOT_TEMPLATE_BINDING_BLOCK: Snapshot v2 is not bound to the currently approved master/profile.');
    if(profile!==snapshot.outputProfile)throw new Error('SNAPSHOT_OUTPUT_PROFILE_BLOCK: requested profile differs from Snapshot v2.');
    const adapter=buildReleaseASnapshotBoundQuoteContext_(spreadsheet,snapshot,{quoteDate:bbcDocumentContourOperationCreatedAt_(state)});
    const contextValidation=validateReleaseASnapshotBoundQuoteContext_(snapshot,adapter); if(!contextValidation.ok)throw new Error('SNAPSHOT_QUOTE_CONTEXT_BLOCK:'+JSON.stringify(contextValidation.issues));
    const model=bbcDocumentContourModelForRenderer_(snapshot), folder=bbcDocumentContourQuoteFolder_(spreadsheet,adapter.settings,snapshot.dealId), quoteNumber=String(snapshot.quoteNumber), baseName=sanitizeFileName_('\u041a\u041f '+quoteNumber+' '+quoteClientFilePart_(adapter.context.client));
    const provenPriorQuote=bbcDocumentContourFindCompletedQuoteResultForSnapshot_(spreadsheet,snapshot);
    const existingArtifacts=bbcDocumentContourFindExistingQuoteArtifacts_(folder,baseName,provenPriorQuote);
    if(existingArtifacts){const recovered={contourVersion:BBC_DOCUMENT_CONTOUR.version,requestId:requestId||'',dealId:snapshot.dealId,quoteNumber,snapshotId:snapshot.snapshotId,snapshotHash:snapshot.snapshotHash,outputProfile:profile,status:'READY',recovered:true,quoteContextSource:'SNAPSHOT_V2',rawImportReadsAfterSnapshot:0,recalculationAfterSnapshot:false,files:{googleSheets:{id:existingArtifacts.googleSheets.getId(),url:existingArtifacts.googleSheets.getUrl(),name:existingArtifacts.googleSheets.getName()},xlsx:{id:existingArtifacts.xlsx.getId(),url:existingArtifacts.xlsx.getUrl(),name:existingArtifacts.xlsx.getName()},pdf:{id:existingArtifacts.pdf.getId(),url:existingArtifacts.pdf.getUrl(),name:existingArtifacts.pdf.getName(),size:existingArtifacts.pdf.getSize()}},xlsxAcceptance:existingArtifacts.xlsxAcceptance};return bbcDocumentContourCompleteOperation_(state,recovered,snapshot.dealId,snapshot.snapshotId);}
    // Do not remove the previous accepted quote before the replacement has passed all
    // acceptance gates. Google Drive permits temporary duplicate names; on failure the catch
    // block removes only the newly created files and leaves the previous accepted set intact.
    const templateFile=DriveApp.getFileById(snapshot.templateId),quoteFile=templateFile.makeCopy(baseName,folder);created.push(quoteFile);
    const quoteSpreadsheet=SpreadsheetApp.openById(quoteFile.getId());
    writeMasterTemplateQuote_(quoteSpreadsheet,adapter.context,model,adapter.result,quoteNumber,'CONTOUR-V1');
    materializeAndValidateClientSheets_(quoteSpreadsheet);removeInternalTemplateSheets_(quoteSpreadsheet);materializeAndValidateClientSheets_(quoteSpreadsheet);normalizeClientSheetPrintAreas_(quoteSpreadsheet);SpreadsheetApp.flush();Utilities.sleep(1000);
    const xlsxFile=exportQuoteFile_(quoteSpreadsheet.getId(),'xlsx',baseName+'.xlsx',folder);created.push(xlsxFile);const xlsxAcceptance=bbcReleaseBXlsxAcceptance_(xlsxFile);if(!xlsxAcceptance.ok)throw new Error('XLSX_ACCEPTANCE_BLOCK:'+JSON.stringify(xlsxAcceptance.issues));
    const clientSheet=quoteSpreadsheet.getSheetByName('Расчет сделки ВЭД');if(!clientSheet)throw new Error('Approved master client sheet missing.');
    const pdfFile=exportMasterQuotePdf_(quoteSpreadsheet.getId(),clientSheet.getSheetId(),baseName,folder);created.push(pdfFile);const pdfAcceptance=bbcReleaseBPdfAcceptance_(pdfFile);if(!pdfAcceptance.ok)throw new Error('PDF_ACCEPTANCE_BLOCK:'+JSON.stringify(pdfAcceptance.issues));
    // Replacement is now fully accepted. Only now retire older same-name artifacts, so an
    // export/render failure can never destroy the last accepted quote set.
    bbcDocumentContourCleanupNamedArtifactsExcept_(folder,baseName,[quoteFile.getId(),xlsxFile.getId(),pdfFile.getId()]);
    const result={contourVersion:BBC_DOCUMENT_CONTOUR.version,requestId:requestId||'',dealId:snapshot.dealId,quoteNumber,snapshotId:snapshot.snapshotId,snapshotHash:snapshot.snapshotHash,outputProfile:profile,status:'READY',recovered:false,quoteContextSource:'SNAPSHOT_V2',rawImportReadsAfterSnapshot:0,recalculationAfterSnapshot:false,totalRub:snapshot.calculationResult.totalRub,totalCny:snapshot.calculationResult.totalCny,files:{googleSheets:{id:quoteFile.getId(),url:quoteFile.getUrl(),name:quoteFile.getName()},xlsx:{id:xlsxFile.getId(),url:xlsxFile.getUrl(),name:xlsxFile.getName()},pdf:{id:pdfFile.getId(),url:pdfFile.getUrl(),name:pdfFile.getName(),size:pdfFile.getSize()}},xlsxAcceptance};
    return bbcDocumentContourCompleteOperation_(state,result,snapshot.dealId,snapshot.snapshotId);
  }catch(error){bbcReleaseBCleanupFiles_(created);bbcDocumentContourFailOperation_(state,error);throw error;}finally{lock.releaseLock();}
}

function bbcDocumentContourGetDealStatus_(args, requestId) {
  const spreadsheet=SpreadsheetApp.getActiveSpreadsheet(),dealId=String(args.dealId||'').trim();
  if(!dealId)throw new Error('dealId is required.');
  const snapshot=readLatestVerifiedSnapshotV2ForDeal_(spreadsheet,dealId);
  let currentQuote=null,staleQuote=null;
  const opSheet=bbcDocumentContourValidateOperationSheet_(spreadsheet.getSheetByName(BBC_DOCUMENT_CONTOUR.operationsSheet));
  if(opSheet&&opSheet.getLastRow()>=2){
    const rows=opSheet.getDataRange().getValues(),h=rows[0].map(String),typeI=h.indexOf('operation_type'),dealI=h.indexOf('deal_id'),statusI=h.indexOf('status'),resultI=h.indexOf('result_json');
    for(let i=rows.length-1;i>=1;i--){
      if(String(rows[i][typeI])!=='GENERATE_QUOTE'||String(rows[i][dealI])!==dealId||String(rows[i][statusI])!=='COMPLETED')continue;
      let candidate=null;try{candidate=JSON.parse(String(rows[i][resultI]||''));}catch(error){candidate=null;}
      if(!candidate)continue;
      if(snapshot&&String(candidate.snapshotId||'')===String(snapshot.snapshotId||'')){currentQuote=candidate;break;}
      if(!staleQuote)staleQuote=candidate;
    }
  }
  const status=currentQuote&&currentQuote.status|| (snapshot?(staleQuote?'STALE_QUOTE_FOR_LATEST_SNAPSHOT':'SNAPSHOT_VERIFIED'):'NO_VERIFIED_SNAPSHOT');
  return {contourVersion:BBC_DOCUMENT_CONTOUR.version,requestId:requestId||'',dealId,verifiedSnapshot:snapshot?{snapshotId:snapshot.snapshotId,snapshotHash:snapshot.snapshotHash,quoteNumber:snapshot.quoteNumber||null,status:snapshot.status,templateId:snapshot.templateId||null,templateVersion:snapshot.templateVersion||null,outputProfile:snapshot.outputProfile||null,totalRub:snapshot.calculationResult&&snapshot.calculationResult.totalRub,totalCny:snapshot.calculationResult&&snapshot.calculationResult.totalCny,createdAt:snapshot.createdAt}:null,quoteFiles:currentQuote&&currentQuote.files||null,staleQuoteSnapshotId:staleQuote&&staleQuote.snapshotId||null,status};
}

function runDocumentContourSelfTest_() {
  const required = ['bbcDocumentContourValidateCanonicalDeal_','bbcDocumentContourRecalculateDeal_','bbcDocumentContourGetVerifiedSnapshot_','bbcDocumentContourGenerateQuote_','bbcDocumentContourGetDealStatus_'];
  const dispatchSource = String(bbcChatApiDispatch_);
  const missing = required.filter(name => dispatchSource.indexOf(name)<0);
  if (missing.length) throw new Error('Document contour dispatch missing: ' + missing.join(', '));
  const quoteSource = String(bbcDocumentContourGenerateQuote_);
  ['readDealCalculationModel_','calculateDealModel_','startDealFromFiles','submitManagerAnswers'].forEach(token => { if (quoteSource.indexOf(token)>=0) throw new Error('Snapshot quote path contains forbidden authority call: ' + token); });
  ['snapshot.templateId','bbcDocumentContourOperationCreatedAt_','SNAPSHOT_TEMPLATE_BINDING_BLOCK'].forEach(token => { if (quoteSource.indexOf(token)<0) throw new Error('Generate retry/template gate missing token: ' + token); });
  const persistSource = String(bbcDocumentContourPersistSnapshotBundle_);
  ['managerDecisions','stores.decisions','decision_id'].forEach(token => { if (persistSource.indexOf(token)<0) throw new Error('ManagerDecision persistence missing token: ' + token); });
  const snapshotHashSource = String(bbcReleaseASnapshotHashPayload_);
  ['templateId','templateVersion','outputProfile'].forEach(token => { if (snapshotHashSource.indexOf(token)<0) throw new Error('Snapshot document binding is not hash-protected: ' + token); });
  if (snapshotHashSource.indexOf('quoteNumber') < 0) throw new Error('Snapshot quote number is not hash-protected.');
  if (String(validateCanonicalDealForCalculation_).indexOf('CANONICAL_STATUS_NOT_CALCULABLE') < 0) throw new Error('Canonical calculation status gate missing.');
  if (String(validateCanonicalDealForQuote_).indexOf('CLIENT_PAYMENT') < 0) throw new Error('Quote-readiness payment gate missing.');
  if (String(validateCanonicalRuleBindingsAgainstRegistry_).indexOf('RULE_BINDING_VERSION_MISMATCH') < 0) throw new Error('Canonical Rule Registry cross-check missing.');
  if (String(validateCanonicalPaymentSchedulesAgainstCalculation_).indexOf('PAYMENT_ITEM_AMOUNT_RECONCILIATION') < 0) throw new Error('Payment/calculation reconciliation gate missing.');
  if (String(bbcDocumentContourPersistSnapshotBundle_).indexOf("['canonical_id','revision']") < 0) throw new Error('Canonical revision persistence key missing.');
  if (String(bbcChatApiAuthenticate_).indexOf('payload.backendToken') < 0) throw new Error('Body-token backend authentication missing.');
  if (String(bbcChatApiAuthenticate_).indexOf('final document contour') < 0 || String(bbcChatApiAuthenticate_).indexOf('finalBodyAction') < 0) throw new Error('Backend body token is not scoped away from legacy orchestration.');
  if (String(bbcChatApiErrorObject_).indexOf('stack:') >= 0) throw new Error('External API error still exposes stack trace.');
  if (String(bbcDocumentContourEnsureQuoteNumber_).indexOf('bbcDocumentContourMaxKnownQuoteSequence_') < 0) throw new Error('Business quote-number registry missing.');
  if (String(bbcDocumentContourGetDealStatus_).indexOf('STALE_QUOTE_FOR_LATEST_SNAPSHOT') < 0) throw new Error('Stale quote status binding missing.');
  if (String(readLatestVerifiedSnapshotV2ForDeal_).indexOf('canonical_revision') < 0) throw new Error('Latest Snapshot selection is not canonical-revision ordered.');
  if (String(bbcDocumentContourGenerateQuote_).indexOf('SNAPSHOT_STALE_BLOCK') < 0) throw new Error('GenerateQuote does not reject stale snapshots.');
  if (String(bbcDocumentContourGetVerifiedSnapshot_).indexOf('Exactly one of snapshotId or dealId') < 0) throw new Error('Snapshot lookup selector is ambiguous.');
  if (String(bbcDocumentContourFindExistingQuoteArtifacts_).indexOf('provenResult') < 0 || String(bbcDocumentContourFindCompletedQuoteResultForSnapshot_).indexOf('snapshotHash') < 0) throw new Error('Quote artifact recovery is not snapshot-provenance bound.');
  const generateSource=String(bbcDocumentContourGenerateQuote_);
  if (generateSource.indexOf('bbcDocumentContourCleanupNamedArtifacts_(folder,baseName)') >= 0 || generateSource.indexOf('bbcDocumentContourCleanupNamedArtifactsExcept_') < generateSource.indexOf('PDF_ACCEPTANCE_BLOCK')) throw new Error('Quote replacement is not transactional across artifact acceptance.');
  if (String(bbcDocumentContourPersistSnapshotBundle_).indexOf("'schedule_id',['created_at']") < 0 || String(bbcDocumentContourPersistSnapshotBundle_).indexOf("'rule_binding_set_id',['created_at']") < 0) throw new Error('Semantic immutable store reuse across canonical revisions is not enabled.');
  const contextSource = String(buildReleaseASnapshotBoundQuoteContext_);
  if (contextSource.indexOf('const quoteDate = new Date();')>=0) throw new Error('Snapshot quote context still uses retry-variant wall-clock date.');
  const readOnlySources = [
    ['validateCanonicalDeal', String(bbcDocumentContourValidateCanonicalDeal_)],
    ['getVerifiedSnapshot', String(bbcDocumentContourGetVerifiedSnapshot_)],
    ['getDealStatus', String(bbcDocumentContourGetDealStatus_)]
  ];
  const forbiddenReadOnlyWrites = ['insertSheet','appendRow','setValue(','setValues(','setFormula','setContent','createFile','makeCopy','setTrashed','bbcDocumentContourEnsureOperationSheet_'];
  readOnlySources.forEach(entry => forbiddenReadOnlyWrites.forEach(token => {
    if (entry[1].indexOf(token)>=0) throw new Error('Read-only contour operation contains write token: ' + entry[0] + ' -> ' + token);
  }));
  const result = {contourVersion:BBC_DOCUMENT_CONTOUR.version,status:'PASS',dispatchOk:true,snapshotBoundQuote:true,readOnlyContract:true,managerDecisionPersistence:true,templateBinding:true,retryStableQuoteDate:true,strictCanonicalGate:true,ruleRegistryBinding:true,paymentCalculationReconciliation:true,canonicalRevisionPersistence:true,semanticStoreReuseAcrossRevisions:true,bodyTokenAuth:true,businessQuoteNumbering:true,staleQuoteProtection:true,artifactRecoveryProvenance:true,forbiddenAuthorityCalls:0,operationsSheet:BBC_DOCUMENT_CONTOUR.operationsSheet,outputProfile:BBC_DOCUMENT_CONTOUR.outputProfile};
  console.log(JSON.stringify(result));
  return result;
}

