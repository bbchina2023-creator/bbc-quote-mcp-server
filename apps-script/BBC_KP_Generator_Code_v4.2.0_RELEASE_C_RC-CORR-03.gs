  setQuoteMoneyRow_(quoteSheet, 47, buckets.marking.cny, buckets.marking.rub);
  // Финансовые услуги партнера уже показаны в разделе 3 и в импорт повторно не включаются.
  setQuoteMoneyRow_(quoteSheet, 48, buckets.partnerFinancialServices.cny, buckets.partnerFinancialServices.rub);
  setQuoteMoneyRow_(quoteSheet, 49, 0, 0);
  setQuoteMoneyRow_(quoteSheet, 50, 0, 0);

  const importCny = buckets.customsDuty.cny + buckets.vat.cny + buckets.customsFee.cny + buckets.broker.cny +
    buckets.temporaryStorage.cny + buckets.customsDelivery.cny + buckets.certification.cny + buckets.marking.cny +
    buckets.partnerFinancialServices.cny;
  const importRub = buckets.customsDuty.rub + buckets.vat.rub + buckets.customsFee.rub + buckets.broker.rub +
