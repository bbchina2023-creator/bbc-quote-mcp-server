  cp009Assert_(
    productionState.state === 'CONFIRMED' &&
    productionState.selectedValue === 'NOT_APPLICABLE' &&
    finalQuestions.length === 0 &&
    closed.conflicts.length === 0 &&
    owner.length === 0 &&
    !calculationBlocked &&
    !quoteBlocked &&
    auditNotes.length === 5,
    'TEST-AI-003 mismatch: ожидается 0 вопросов после verified snapshot',
    {
      productionState: productionState,
      finalQuestions: finalQuestions,
      remainingConflicts: closed.conflicts,
      ownerDecisions: owner,
      auditNotes: auditNotes
    }
  );
  return {
    observed: {
      managerQuestions: finalQuestions.length,
      blockingQuestions: finalQuestions.filter(function(item) { return aiScopeBlocksCalculation_(item.blockingScope); }).length,
      finalQuoteQuestions: finalQuestions.filter(function(item) { return !aiScopeBlocksCalculation_(item.blockingScope) && aiScopeBlocksQuote_(item.blockingScope); }).length,
      conflicts: closed.conflicts.length,
      ownerDecisions: owner.length,
      calculationAllowed: !calculationBlocked,
      quoteAllowed: !quoteBlocked
    }
  };
}

