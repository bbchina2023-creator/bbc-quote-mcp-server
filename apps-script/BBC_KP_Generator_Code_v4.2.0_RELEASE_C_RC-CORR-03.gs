function bbcChatApiSpreadsheet_() {
  const properties = PropertiesService.getScriptProperties();
  const configuredId = String(
    properties.getProperty(BBC_CHAT_API.spreadsheetProperty) || ''
  ).trim();
  if (configuredId) {
    return SpreadsheetApp.openById(configuredId);
  }

  const active = SpreadsheetApp.getActiveSpreadsheet();
  if (active) return active;

  throw new Error(
    'Chat API не привязан к таблице. Выполните «BBC КП Generator → Настроить Chat API / MCP».'
  );
}

function bbcChatApiAuthenticate_(event, payload) {
  const properties = PropertiesService.getScriptProperties();
  const enabled = String(
    properties.getProperty(BBC_CHAT_API.enabledProperty) || ''
  ).trim().toUpperCase() === 'TRUE';
  if (!enabled) {
    throw new Error('Chat API is disabled.');
  }

  const expected = String(
    properties.getProperty(BBC_CHAT_API.tokenProperty) || ''
  ).trim();
  if (!expected) {
    throw new Error('Chat API token is not configured.');
  }

  // Final contour transport sends the backend credential in the JSON body so
  // the secret is not embedded in a URL. The body credential is intentionally scoped
  // to the five final contour operations; it cannot be reused to invoke legacy intake
  // orchestration. Query-token auth remains accepted only for legacy/admin compatibility.
  const bodyToken = String(payload && payload.backendToken || '').trim();
  const queryToken = String(event && event.parameter && event.parameter.token || '').trim();
  const action = String(payload && payload.action || '').trim();
  const args = payload && payload.arguments || {};
  const finalBodyAction = action === 'validateCanonicalDeal' || action === 'recalculateDeal' ||
    action === 'getVerifiedSnapshot' || action === 'getDealStatus' ||
    (action === 'generateQuote' && Boolean(args && args.snapshotId));
  if (bodyToken) {
    if (!finalBodyAction) throw new Error('Unauthorized: backend body token is limited to the final document contour.');
    if (bodyToken !== expected) throw new Error('Unauthorized: invalid Chat API token.');
    return true;
  }
  if (!queryToken || queryToken !== expected) {
    throw new Error('Unauthorized: invalid Chat API token.');
  }
  return true;
}

function bbcChatApiTextOutput_(payload) {
  return ContentService
    .createTextOutput(JSON.stringify(payload))
    .setMimeType(ContentService.MimeType.JSON);
}

function bbcChatApiErrorObject_(error, requestId) {
  // External API responses intentionally omit stack traces. requestId is the
  // correlation handle for server-side diagnostics.
  return {
    ok: false,
    requestId: requestId || `REQ-${Utilities.getUuid()}`,
    version: BBC_MVP.version,
    error: String(error && error.message || error)
  };
}

function doGet(event) {
  try {
    bbcChatApiAuthenticate_(event);
    const spreadsheet = bbcChatApiSpreadsheet_();
    return bbcChatApiTextOutput_({
      ok: true,
      service: 'BBC КП Generator Chat API / MCP',
      version: BBC_MVP.version,
      schemaVersion: BBC_CHAT_API.schemaVersion,
      spreadsheetId: spreadsheet.getId(),
      status: 'READY'
    });
  } catch (error) {
    return bbcChatApiTextOutput_(bbcChatApiErrorObject_(error));
  }
}

function doPost(event) {
  const requestId = `REQ-${Utilities.getUuid()}`;
  try {
    const raw = String(event && event.postData && event.postData.contents || '').trim();
    if (!raw) throw new Error('Empty request body.');
    const payload = JSON.parse(raw);
    bbcChatApiAuthenticate_(event, payload);

    if (payload && payload.jsonrpc === '2.0' && payload.method) {
      return bbcChatApiHandleMcp_(payload, requestId);
    }

    const action = String(payload.action || '').trim();
    if (!action) throw new Error('action is required.');

    const result = bbcChatApiDispatch_(action, payload.arguments || payload, requestId);
    return bbcChatApiTextOutput_({
      ok: true,
      requestId,
      version: BBC_MVP.version,
      result
    });
  } catch (error) {
    return bbcChatApiTextOutput_(bbcChatApiErrorObject_(error, requestId));
  }
}

function bbcChatApiHandleMcp_(request, requestId) {
  const method = String(request.method || '');
  const id = Object.prototype.hasOwnProperty.call(request, 'id') ? request.id : null;

  if (method === 'notifications/initialized') {
    return ContentService.createTextOutput('');
  }

  if (method === 'initialize') {
    const requested = request.params && request.params.protocolVersion;
    return bbcChatApiTextOutput_({
      jsonrpc: '2.0',
      id,
      result: {
        protocolVersion: requested || BBC_CHAT_API.mcpProtocolVersion,
        capabilities: {tools: {listChanged: false}},
        serverInfo: {
          name: 'BBC КП Generator',
          version: BBC_MVP.version
        },
        instructions:
          'Создавайте новую сделку через startDealFromFiles. ' +
          'Передавайте только файлы текущего чата, предварительно загруженные в Google Drive. ' +
          'Если backend вернул managerQuestions, задайте их менеджеру и передайте ответы в submitManagerAnswers. ' +
          'Если quoteFiles присутствуют, покажите менеджеру ссылки Google Sheets, XLSX и PDF.'
      }
    });
  }

  if (method === 'ping') {
    return bbcChatApiTextOutput_({jsonrpc: '2.0', id, result: {}});
  }

  if (method === 'tools/list') {
    return bbcChatApiTextOutput_({
      jsonrpc: '2.0',
      id,
      result: {tools: bbcChatApiMcpTools_()}
    });
  }

  if (method === 'tools/call') {
    const name = String(request.params && request.params.name || '');
    const args = request.params && request.params.arguments || {};
    try {
      const result = bbcChatApiDispatch_(name, args, requestId);
      return bbcChatApiTextOutput_({
        jsonrpc: '2.0',
        id,
        result: {
          content: [{
            type: 'text',
            text: JSON.stringify(result)
          }],
          structuredContent: result,
          isError: false
        }
      });
    } catch (error) {
      return bbcChatApiTextOutput_({
        jsonrpc: '2.0',
        id,
        result: {
          content: [{
            type: 'text',
            text: JSON.stringify(bbcChatApiErrorObject_(error, requestId))
          }],
          isError: true
        }
      });
    }
  }

  return bbcChatApiTextOutput_({
    jsonrpc: '2.0',
    id,
    error: {
      code: -32601,
      message: `Method not found: ${method}`
    }
  });
}

