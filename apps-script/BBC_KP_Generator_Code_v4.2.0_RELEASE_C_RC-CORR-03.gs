/**
 * Контроль наличия всех листов.
 */
function validateDatabaseStructure() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const structures = getBBCStructures();
  const errors = [];

  Object.entries(structures).forEach(([sheetName, config]) => {
    const sheet = spreadsheet.getSheetByName(sheetName);

    if (!sheet) {
      errors.push(`Отсутствует лист: ${sheetName}`);
      return;
    }

    const actualHeaders = sheet
      .getRange(1, 1, 1, config.headers.length)
      .getDisplayValues()[0];

    config.headers.forEach((expected, index) => {
      if (actualHeaders[index] !== expected) {
        errors.push(
          `${sheetName}: колонка ${index + 1} должна называться «${expected}»`
        );
      }
    });
  });

  [
    [BBC_MVP.sheets.deals, 1, 'deal_id'],
    [BBC_MVP.sheets.items, 1, 'item_id'],
    [BBC_MVP.sheets.expenses, 1, 'expense_id'],
    [BBC_MVP.sheets.imports, 1, 'import_id'],
    [BBC_MVP.sheets.recognized, 1, 'recognition_id'],
    [BBC_MVP.sheets.linked, 1, 'link_id'],
    [BBC_MVP.sheets.tableRows, 1, 'row_recognition_id'],
    [BBC_MVP.sheets.calculationSnapshots, 1, 'snapshot_id']
  ].forEach(([sheetName, column, label]) => {
    const sheet = spreadsheet.getSheetByName(sheetName);
    if (!sheet || sheet.getLastRow() < 2) return;
    const values = sheet.getRange(2, column, sheet.getLastRow() - 1, 1)
      .getDisplayValues().flat().filter(Boolean);
    const seen = new Set();
    const duplicates = new Set();
    values.forEach(value => seen.has(value) ? duplicates.add(value) : seen.add(value));
    if (duplicates.size) {
      errors.push(`${sheetName}: дубли ${label}: ${[...duplicates].slice(0, 5).join(', ')}`);
    }
  });

  const settings = spreadsheet.getSheetByName(BBC_MVP.sheets.settings);
  if (settings && settings.getLastRow() > 1) {
    const rows = settings.getRange(2, 1, settings.getLastRow() - 1, 2)
      .getDisplayValues();
    const versionRow = rows.find(row => row[0] === 'DATA_MODEL_VERSION');
    if (!versionRow || versionRow[1] !== BBC_MVP.version) {
      errors.push(`Настройки: DATA_MODEL_VERSION должен быть ${BBC_MVP.version}`);
    }
  }

  if (errors.length > 0) {
    SpreadsheetApp.getUi().alert(
      'Найдены проблемы:\n\n' + errors.join('\n')
    );
    return;
  }

  SpreadsheetApp.getUi().alert(
    'Структура базы корректна. Все обязательные листы и поля присутствуют.'
  );
}

