/**
 * BBC КП Generator — модуль технического анализа Excel партнёра.
 *
 * Требование:
 * в проекте должен быть подключён расширенный сервис Drive API v3.
 *
 * Исходный Excel не изменяется.
 * Для чтения создаётся временная Google-таблица, которая удаляется после анализа.
 */

function importExcelTechnicalMap() {
  const ui = SpreadsheetApp.getUi();

  const dealId = resolveDealIdForExcelImport_(ui);
  if (!dealId) return;

  const response = ui.prompt(
    'Импорт Excel партнёра',
    'Вставьте ссылку на Excel-файл в Google Drive или его ID:',
    ui.ButtonSet.OK_CANCEL
  );

  if (response.getSelectedButton() !== ui.Button.OK) {
    return;
  }

  const input = String(response.getResponseText() || '').trim();

  if (!input) {
    ui.alert('Ссылка или ID файла не указаны.');
    return;
  }

  const sourceFileId = extractDriveFileId_(input);

  if (!sourceFileId) {
    ui.alert(
      'Не удалось определить ID файла.\n\n' +
      'Проверьте ссылку на Excel-файл в Google Drive.'
    );
    return;
  }

  let temporarySpreadsheetId = null;
  let temporarySourceCopyId = null;
  const importId = `IMP-${Utilities.getUuid()}`;
  const startedAt = new Date();
  const lock = LockService.getDocumentLock();

  lock.waitLock(30000);

  try {
    const sourceHandle = openDriveFileForExcelImport_(sourceFileId);
    const sourceFile = sourceHandle.file;
    const sourceName = sourceHandle.originalName || sourceFile.getName();
    const sourceMimeType = sourceHandle.originalMimeType || sourceFile.getMimeType();
    temporarySourceCopyId = sourceHandle.temporaryCopyId || null;

    recordImportStart_(
      importId, dealId, startedAt, sourceFileId, sourceName,
      sourceMimeType
    );

    if (!isSupportedExcelMimeType_(sourceMimeType, sourceName)) {
      throw new Error(
        'Выбранный файл не распознан как Excel.\n' +
        `Название: ${sourceName}\n` +
        `MIME-тип: ${sourceMimeType}`
      );
    }

    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();

    spreadsheet.toast(
      'Создаётся временная копия Excel для анализа…',
      'BBC КП Generator',
      5
    );

    const convertedFile = Drive.Files.create(
      {
        name: `TEMP_BBC_IMPORT_${Date.now()}_${sourceName}`,
        mimeType: 'application/vnd.google-apps.spreadsheet'
      },
      sourceFile.getBlob().setName(sourceName),
      {
        fields: 'id,name,mimeType'
      }
    );

    temporarySpreadsheetId = convertedFile.id;

    if (!temporarySpreadsheetId) {
      throw new Error('Google Drive не вернул ID временной таблицы.');
    }

    const importedSpreadsheet =
      SpreadsheetApp.openById(temporarySpreadsheetId);

    const report = analyzeImportedSpreadsheet_(
      importedSpreadsheet,
      importId,
      dealId,
      sourceFileId,
      sourceName,
      sourceMimeType
    );

    writeImportMap_(spreadsheet, report);
    writeImportCells_(spreadsheet, report);
    writeImportLog_(spreadsheet, report);
    recordImportCompletion_(report, 'Завершён', '');

    spreadsheet.toast(
      'Техническая карта Excel сформирована.',
      'BBC КП Generator',
      5
    );

    ui.alert(
      'Excel успешно проанализирован.\n\n' +
      `import_id: ${importId}\n` +
      `Файл: ${sourceName}\n` +
      `Листов: ${report.sheets.length}\n` +
      `Заполненных ячеек: ${report.totalNonEmptyCells}\n` +
      `Ячеек с формулами: ${report.totalFormulaCells}\n\n` +
      'Результаты записаны на листы:\n' +
      '• Карта импорта\n' +
      '• Импорт — ячейки'
    );

    writeLog_(
      'USER',
      'ANALYZE_EXCEL',
      dealId,
      `Проанализирован файл ${sourceName}; листов: ` +
      `${report.sheets.length}; заполненных ячеек: ` +
      `${report.totalNonEmptyCells}`
    );

  } catch (error) {
    console.error(error);
    recordImportFailureSafe_(importId, error);

    ui.alert(
      'Ошибка анализа Excel:\n\n' +
      (error && error.message ? error.message : String(error))
    );

  } finally {
    if (temporarySpreadsheetId) {
      trashDriveFileSafe_(
        temporarySpreadsheetId,
        'Не удалось удалить временную таблицу:'
      );
    }
    if (temporarySourceCopyId) {
      trashDriveFileSafe_(
        temporarySourceCopyId,
        'Не удалось удалить временную копию исходного Excel:'
      );
    }
    lock.releaseLock();
  }
}

function normalizeDealId_(value) {
  return String(value || '')
    .replace(/[\u2010-\u2015\u2212]/g, '-')
    .replace(/[\u00A0\u2007\u202F]/g, ' ')
    .trim();
}

function getSelectedDealId_() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = spreadsheet.getActiveSheet();
  const range = spreadsheet.getActiveRange();

  if (!sheet || !range || sheet.getName() !== BBC_MVP.sheets.deals) {
    return '';
  }

  const row = range.getRow();
  if (row < 2) return '';

  return normalizeDealId_(sheet.getRange(row, 1).getDisplayValue());
}

function resolveDealIdForExcelImport_(ui) {
  const selectedDealId = getSelectedDealId_();
  if (selectedDealId && dealExists_(selectedDealId)) {
    return selectedDealId;
  }

  const dealResponse = ui.prompt(
    'Импорт Excel партнёра',
    'Выделите строку сделки на листе «Сделки» или введите deal_id:',
    ui.ButtonSet.OK_CANCEL
  );
  if (dealResponse.getSelectedButton() !== ui.Button.OK) return '';

  const dealId = normalizeDealId_(dealResponse.getResponseText());
  if (!dealId || !dealExists_(dealId)) {
    ui.alert(
      'Сделка не найдена.\n\n' +
      'Выделите ячейку в нужной строке листа «Сделки» и повторите импорт.'
    );
    return '';
  }

  return dealId;
}

function dealExists_(dealId) {
  const normalizedDealId = normalizeDealId_(dealId);
  const sheet = SpreadsheetApp.getActiveSpreadsheet()
    .getSheetByName(BBC_MVP.sheets.deals);
  if (!sheet || sheet.getLastRow() < 2 || !normalizedDealId) return false;

  return sheet.getRange(2, 1, sheet.getLastRow() - 1, 1)
    .getDisplayValues()
    .some(row => normalizeDealId_(row[0]) === normalizedDealId);
}

function openDriveFileForExcelImport_(fileId) {
  const normalizedFileId = String(fileId || '').trim();
  if (!normalizedFileId) {
    throw new Error('ID Excel-файла не указан.');
  }

  let lastError = null;
  for (let attempt = 1; attempt <= 3; attempt++) {
    try {
      const file = DriveApp.getFileById(normalizedFileId);
      return {
        file,
        originalName: file.getName(),
        originalMimeType: file.getMimeType(),
        temporaryCopyId: ''
      };
    } catch (error) {
      lastError = error;
      Utilities.sleep(attempt * 600);
    }
  }

  let metadata;
  try {
    metadata = Drive.Files.get(normalizedFileId, {
      fields: 'id,name,mimeType'
    });
  } catch (metadataError) {
    throw new Error(
      'Google Drive не предоставил доступ к Excel-файлу. ' +
      'Проверьте, что файл открыт из того же аккаунта, что и таблица BBC.\n\n' +
      (metadataError && metadataError.message
        ? metadataError.message
        : String(metadataError))
    );
  }

  let copiedFileRecord;
  try {
    copiedFileRecord = Drive.Files.copy(
      {
        name: `TEMP_BBC_SOURCE_${Date.now()}_${metadata.name || 'source.xlsx'}`
      },
      normalizedFileId,
      {
        fields: 'id,name,mimeType'
      }
    );

    const copiedFile = DriveApp.getFileById(copiedFileRecord.id);
    return {
      file: copiedFile,
      originalName: metadata.name || copiedFile.getName(),
      originalMimeType: metadata.mimeType || copiedFile.getMimeType(),
      temporaryCopyId: copiedFileRecord.id
    };
  } catch (copyError) {
    throw new Error(
      'Файл найден в Google Drive, но Apps Script не смог получить его содержимое ' +
      'даже через безопасную временную копию.\n\n' +
      'Первичная ошибка: ' +
      (lastError && lastError.message ? lastError.message : String(lastError)) +
      '\nОшибка резервного доступа: ' +
      (copyError && copyError.message ? copyError.message : String(copyError))
    );
  }
}

function trashDriveFileSafe_(fileId, errorPrefix) {
  try {
    Drive.Files.update(
      { trashed: true },
      fileId
    );
  } catch (deleteError) {
    console.error(errorPrefix, deleteError);
  }
}

function recordImportStart_(
  importId, dealId, startedAt, sourceFileId, sourceName, sourceMimeType
) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet()
    .getSheetByName(BBC_MVP.sheets.imports);
  sheet.appendRow([
    importId, dealId, startedAt, '', sourceFileId, sourceName,
    `https://drive.google.com/open?id=${sourceFileId}`, sourceMimeType,
    '', '', '', getCurrentUser_(), 'Выполняется', ''
  ]);
}

function recordImportCompletion_(report, status, errorText) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet()
    .getSheetByName(BBC_MVP.sheets.imports);
  const row = findRowByValue_(sheet, 1, report.importId);
  if (!row) throw new Error(`Импорт ${report.importId} не найден в реестре.`);
  sheet.getRange(row, 4, 1, 11).setValues([[
    new Date(), report.sourceFileId, report.sourceName, report.sourceUrl,
    report.sourceMimeType, report.sheets.length, report.totalNonEmptyCells,
    report.totalFormulaCells, getCurrentUser_(), status, errorText || ''
  ]]);
}

function recordImportFailureSafe_(importId, error) {
  if (!importId) return;
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet()
      .getSheetByName(BBC_MVP.sheets.imports);
    if (!sheet) return;
    const row = findRowByValue_(sheet, 1, importId);
    if (!row) return;
    sheet.getRange(row, 4).setValue(new Date());
    sheet.getRange(row, 13, 1, 2).setValues([[
      'Ошибка', error && error.message ? error.message : String(error)
    ]]);
  } catch (ignored) {
    console.error(ignored);
  }
}


/**
 * Извлекает ID из:
 * - обычной ссылки Google Drive;
 * - ссылки на открытие файла;
 * - ссылки Google Sheets;
 * - чистого ID.
 */
function extractDriveFileId_(input) {
  const value = String(input || '').trim();

  if (!value) {
    return '';
  }

  const patterns = [
    /\/d\/([a-zA-Z0-9_-]{20,})/,
    /[?&]id=([a-zA-Z0-9_-]{20,})/,
    /^([a-zA-Z0-9_-]{20,})$/
  ];

  for (const pattern of patterns) {
    const match = value.match(pattern);

    if (match && match[1]) {
      return match[1];
    }
  }

  return '';
}


/**
 * Проверка, что выбран Excel-файл.
 */
function isSupportedExcelMimeType_(mimeType, fileName) {
  const allowedMimeTypes = [
    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
    'application/vnd.ms-excel',
    'application/vnd.ms-excel.sheet.macroenabled.12'
  ];

  if (allowedMimeTypes.includes(mimeType)) {
    return true;
  }

  const lowerName = String(fileName || '').toLowerCase();

  return (
    lowerName.endsWith('.xlsx') ||
    lowerName.endsWith('.xls') ||
    lowerName.endsWith('.xlsm')
  );
}


/**
 * Анализирует временно конвертированную Google-таблицу.
 */
function analyzeImportedSpreadsheet_(
  importedSpreadsheet,
  importId,
  dealId,
  sourceFileId,
  sourceName,
  sourceMimeType
) {
  const result = {
    analyzedAt: new Date(),
    importId,
    dealId,
    sourceFileId,
    sourceName,
    sourceMimeType,
    sourceUrl: `https://drive.google.com/open?id=${sourceFileId}`,
    sheets: [],
    totalNonEmptyCells: 0,
    totalFormulaCells: 0
  };

  importedSpreadsheet.getSheets().forEach((sheet, sheetIndex) => {
    const lastRow = sheet.getLastRow();
    const lastColumn = sheet.getLastColumn();

    const gridCells = lastRow * lastColumn;
    if (gridCells > BBC_MVP.maxImportedGridCells) {
      throw new Error(
        `Лист «${sheet.getName()}» занимает ${gridCells} ячеек ` +
        `(последняя строка ${lastRow}, столбец ${lastColumn}). ` +
        `Лимит безопасного анализа: ${BBC_MVP.maxImportedGridCells}.`
      );
    }

    const sheetReport = {
      sheetIndex: sheetIndex + 1,
      sheetName: sheet.getName(),
      lastRow,
      lastColumn,
      nonEmptyCells: 0,
      formulaCells: 0,
      mergedRanges: [],
      cells: []
    };

    if (lastRow > 0 && lastColumn > 0) {
      const range = sheet.getRange(
        1,
        1,
        lastRow,
        lastColumn
      );

      const rawValues = range.getValues();
      const displayValues = range.getDisplayValues();
      const formulas = range.getFormulas();
      const numberFormats = range.getNumberFormats();

      for (let rowIndex = 0; rowIndex < lastRow; rowIndex++) {
        for (
          let columnIndex = 0;
          columnIndex < lastColumn;
          columnIndex++
        ) {
          const rawValue =
            rawValues[rowIndex][columnIndex];

          const displayValue =
            displayValues[rowIndex][columnIndex];

          const formula =
            formulas[rowIndex][columnIndex];

          const isNonEmpty =
            displayValue !== '' ||
            formula !== '' ||
            rawValue !== '';

          if (!isNonEmpty) {
            continue;
          }

          const rowNumber = rowIndex + 1;
          const columnNumber = columnIndex + 1;
          const a1Notation =
            columnNumberToLetter_(columnNumber) +
            rowNumber;

          sheetReport.nonEmptyCells++;

          if (formula) {
            sheetReport.formulaCells++;
          }

          sheetReport.cells.push({
            sheetName: sheet.getName(),
            rowNumber,
            columnNumber,
            a1Notation,
            rawValue: serializeCellValue_(rawValue),
            displayValue,
            formula,
            numberFormat:
              numberFormats[rowIndex][columnIndex],
            detectedType: detectCellType_(
              rawValue,
              displayValue,
              formula
            ),
            detectedCurrency:
              detectCurrency_(displayValue),
            detectedUnit:
              detectMeasurementUnit_(displayValue)
          });
        }
      }

      sheetReport.mergedRanges = range
        .getMergedRanges()
        .map(mergedRange => mergedRange.getA1Notation());
    }

    result.totalNonEmptyCells +=
      sheetReport.nonEmptyCells;

    result.totalFormulaCells +=
      sheetReport.formulaCells;

    result.sheets.push(sheetReport);
  });

  return result;
}


/**
 * Создаёт сводную карту всех листов Excel.
 */
function writeImportMap_(spreadsheet, report) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.importMap);
  const rows = report.sheets.map(item => [
    report.importId, report.dealId, report.analyzedAt, report.sourceFileId,
    report.sourceName, item.sheetIndex, item.sheetName, item.lastRow,
    item.lastColumn,
    item.lastRow && item.lastColumn
      ? `A1:${columnNumberToLetter_(item.lastColumn)}${item.lastRow}` : '',
    item.nonEmptyCells, item.formulaCells, item.mergedRanges.join(', ')
  ]);
  appendRows_(sheet, rows);
}


/**
 * Создаёт подробный реестр заполненных ячеек.
 */
function writeImportCells_(spreadsheet, report) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.importCells);
  const rows = [];

  report.sheets.forEach(sheetReport => {
    sheetReport.cells.forEach(cell => {
      rows.push([
        report.importId,
        report.dealId,
        report.sourceFileId,
        report.sourceName,
        cell.sheetName,
        cell.rowNumber,
        cell.columnNumber,
        cell.a1Notation,
        safeSpreadsheetValue_(cell.rawValue),
        safeSpreadsheetValue_(cell.displayValue),
        safeSpreadsheetText_(cell.formula),
        cell.numberFormat,
        cell.detectedType,
        cell.detectedCurrency,
        cell.detectedUnit
      ]);
    });
  });

  appendRows_(sheet, rows);
}


/**
 * Дополнительная запись в журнал импорта.
 */
function writeImportLog_(spreadsheet, report) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.importLog);

  sheet.appendRow([
    report.analyzedAt,
    report.importId,
    report.dealId,
    report.sourceName,
    report.sourceFileId,
    report.sourceUrl,
    report.sheets.length,
    report.totalNonEmptyCells,
    report.totalFormulaCells,
    getCurrentUser_(),
    'Анализ завершён'
  ]);
}


/**
 * Оформление технических листов.
 */
function formatTechnicalSheet_(
  sheet,
  headerRow,
  numberOfColumns
) {
  sheet
    .getRange(headerRow, 1, 1, numberOfColumns)
    .setFontWeight('bold')
    .setHorizontalAlignment('center')
    .setVerticalAlignment('middle')
    .setWrap(true);

  sheet.autoResizeColumns(1, numberOfColumns);

  for (
    let column = 1;
    column <= numberOfColumns;
    column++
  ) {
    const width = sheet.getColumnWidth(column);

    if (width < 110) {
      sheet.setColumnWidth(column, 110);
    }

    if (width > 320) {
      sheet.setColumnWidth(column, 320);
    }
  }
}

function appendRows_(sheet, rows) {
  if (!rows || rows.length === 0) return;
  const batchSize = 5000;
  for (let start = 0; start < rows.length; start += batchSize) {
    const batch = rows.slice(start, start + batchSize);
    sheet.getRange(sheet.getLastRow() + 1, 1, batch.length, batch[0].length)
      .setValues(batch);
  }
  refreshSheetFilter_(sheet, rows[0].length);
}

function refreshSheetFilter_(sheet, width) {
  const filter = sheet.getFilter();
  if (filter) filter.remove();
  sheet.getRange(1, 1, Math.max(sheet.getLastRow(), 2), width).createFilter();
}

function safeSpreadsheetText_(value) {
  const text = String(value == null ? '' : value);
  if (!text) return '';
  return /^[=+\-@]/.test(text) ? `'${text}` : text;
}

function safeSpreadsheetValue_(value) {
  return typeof value === 'string' ? safeSpreadsheetText_(value) : value;
}

function findRowByValue_(sheet, column, value) {
  if (!sheet || sheet.getLastRow() < 2) return 0;
  const match = sheet.getRange(2, column, sheet.getLastRow() - 1, 1)
    .createTextFinder(String(value)).matchEntireCell(true).findNext();
  return match ? match.getRow() : 0;
}

function getCurrentUser_() {
  // Session.getActiveUser().getEmail() can require an additional OAuth scope
  // and may fail for bound spreadsheets or some Google Workspace policies.
  // User identification is auxiliary metadata and must never block calculations.
  try {
    const activeEmail = Session.getActiveUser().getEmail();
    if (activeEmail) return activeEmail;
  } catch (error) {
    // Continue without requesting extra permissions.
  }

  try {
    const effectiveEmail = Session.getEffectiveUser().getEmail();
    if (effectiveEmail) return effectiveEmail;
  } catch (error) {
    // Continue with a neutral technical identifier.
  }

  return 'UNKNOWN_USER';
}


/**
 * Преобразует номер столбца в букву.
 */
function columnNumberToLetter_(columnNumber) {
  let number = columnNumber;
  let letter = '';

  while (number > 0) {
    const remainder = (number - 1) % 26;

    letter =
      String.fromCharCode(65 + remainder) +
      letter;

    number = Math.floor((number - 1) / 26);
  }

  return letter;
}


/**
 * Безопасное преобразование значения ячейки в текст.
 */
function serializeCellValue_(value) {
  if (value instanceof Date) {
    return Utilities.formatDate(
      value,
      Session.getScriptTimeZone(),
      'yyyy-MM-dd HH:mm:ss'
    );
  }

  if (
    value === null ||
    typeof value === 'undefined'
  ) {
    return '';
  }

  if (typeof value === 'object') {
    try {
      return JSON.stringify(value);
    } catch (error) {
      return String(value);
    }
  }

  return value;
}


/**
 * Определение типа содержимого ячейки.
 */
function detectCellType_(
  rawValue,
  displayValue,
  formula
) {
  if (formula) {
    return 'Формула';
  }

  if (rawValue instanceof Date) {
    return 'Дата';
  }

  if (typeof rawValue === 'number') {
    return 'Число';
  }

  if (typeof rawValue === 'boolean') {
    return 'Логическое значение';
  }

  const text = String(displayValue || '').trim();

  if (!text) {
    return 'Пусто';
  }

  if (
    /https?:\/\/|www\./i.test(text)
  ) {
    return 'Ссылка';
  }

  if (
    /^[+-]?\d+(?:[.,]\d+)?\s*%$/.test(text)
  ) {
    return 'Процент';
  }

  return 'Текст';
}


/**
 * Предварительное определение валюты по тексту ячейки.
 */
function detectCurrency_(value) {
  const text = String(value || '').toUpperCase();

  const currencyPatterns = [
    ['CNY', /CNY|RMB|ЮАН|¥|元/],
    ['RUB', /RUB|РУБ|₽/],
    ['USD', /USD|\$|ДОЛЛ/],
    ['EUR', /EUR|€|ЕВРО/]
  ];

  for (const [currency, pattern] of currencyPatterns) {
    if (pattern.test(text)) {
      return currency;
    }
  }

  return '';
}


/**
 * Предварительное определение единицы измерения.
 */
function detectMeasurementUnit_(value) {
  const text = String(value || '')
    .toLowerCase()
    .replace(/\s+/g, ' ')
    .trim();

  const unitPatterns = [
    ['кг', /(?:^|\s|\/)кг(?:\s|$|\/)/],
    ['г', /(?:^|\s|\/)г(?:\s|$|\/)/],
    ['м3', /м3|м³|куб\.?\s*м/],
    ['шт', /шт\.?|pcs|pieces/],
    ['комплект', /комплект|набор/],
    ['км', /км/],
    ['день', /дн(?:ей|я|ь)?/]
  ];

  for (const [unit, pattern] of unitPatterns) {
    if (pattern.test(text)) {
      return unit;
    }
  }

  return '';
}


/**
 * Самостоятельная единица измерения является значением оформления таблицы,
 * а не заголовком показателя. При импорте raw/display могут дублироваться,
 * поэтому допускается повтор одного и того же обозначения.
 */
function isStandaloneMeasurementUnitLabel_(value) {
  const text = normalizeRecognitionText_(value)
    .replace(/[.,:;]+/g, '')
    .trim();
  if (!text) return false;

  const unitPatterns = [
    /^(?:кг|kg)(?:\s+(?:кг|kg))*$/,
    /^(?:г|g)(?:\s+(?:г|g))*$/,
    /^(?:м3|м³|m3)(?:\s+(?:м3|м³|m3))*$/,
    /^(?:шт|pcs|pieces)(?:\s+(?:шт|pcs|pieces))*$/,
    /^(?:км|km)(?:\s+(?:км|km))*$/
  ];
  return unitPatterns.some(pattern => pattern.test(text));
}
/**
 * BBC КП Generator — предварительное распознавание показателей
 * на основании листа «Импорт — ячейки».
 *
 * Модуль не выполняет финансовые расчёты.
 * Он только классифицирует найденные значения.
 */

function recognizeImportedFields() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const sourceSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.importCells);

  if (!sourceSheet) {
    SpreadsheetApp.getUi().alert(
      'Лист «Импорт — ячейки» не найден.\n' +
      'Сначала выполните технический импорт Excel.'
    );
    return;
  }

  const lastRow = sourceSheet.getLastRow();

  if (lastRow < 2) {
    SpreadsheetApp.getUi().alert(
      'На листе «Импорт — ячейки» отсутствуют данные.'
    );
    return;
  }

  const importId = promptImportId_('Распознавание полей');
  if (!importId) return;

  const values = sourceSheet
    .getRange(2, 1, lastRow - 1, 15)
    .getValues()
    .filter(row => String(row[0]) === importId);

  if (values.length === 0) {
    SpreadsheetApp.getUi().alert(`Для import_id ${importId} ячейки не найдены.`);
    return;
  }

  const recognized = [];
  let excludedNotes = 0;
  let excludedValues = 0;
  let excludedInstructionCells = 0;
  let excludedSemanticNoise = 0;
  let tableHeaders = 0;
  let tableDataRows = 0;
  let duplicateHeaders = 0;
  const candidates = [];
  const cellIndex = buildCellIndex_(values);
  const rowContext = buildRecognitionRowContext_(values);

  values.forEach(row => {
    const [
      rowImportId,
      dealId,
      sourceFileId,
      sourceFile,
      sheetName,
      rowNumber,
      columnNumber,
      cellAddress,
      rawValue,
      displayValue,
      formula,
      numberFormat,
      detectedType,
      detectedCurrency,
      detectedUnit
    ] = row;

    if (isRecognitionInstructionSheet_(sheetName)) {
      excludedInstructionCells++;
      return;
    }

    if (!isLikelyRecognitionLabel_(displayValue, detectedType)) return;
    const preliminaryRole = detectPreliminaryCellRole_(displayValue);
    if (preliminaryRole === 'Значение') {
      excludedValues++;
      return;
    }
    if (preliminaryRole === 'Примечание') {
      excludedNotes++;
      return;
    }

    const text = normalizeRecognitionText_(
      `${rawValue} ${displayValue}`
    );

    const result = classifyImportedCell_(
      text,
      detectedType,
      detectedCurrency,
      detectedUnit
    );

    if (!result.fieldCode) {
      return;
    }

    if (isRecognitionSemanticNoise_(displayValue, result.fieldCode)) {
      excludedSemanticNoise++;
      return;
    }

    const linkedCandidate = findLinkedValue_(
      cellIndex,
      sourceFileId,
      sheetName,
      Number(rowNumber),
      Number(columnNumber),
      result.fieldCode,
      result.valueType
    );

    candidates.push({
      rowImportId,
      dealId,
      sourceFileId,
      sourceFile,
      sheetName,
      rowNumber: Number(rowNumber),
      columnNumber: Number(columnNumber),
      cellAddress,
      displayValue,
      formula,
      detectedCurrency,
      detectedUnit,
      result,
      hasLinkedValue: linkedCandidate.status === 'Найдено'
    });
  });

  const fieldsWithScalarValue = new Set(
    candidates
      .filter(candidate => candidate.hasLinkedValue)
      .map(candidate => buildRecognitionFieldKey_(candidate))
  );

  candidates.forEach(candidate => {
    const result = candidate.result;
    const cellRole = getContextualRecognizedCellRole_(
      candidate,
      rowContext,
      fieldsWithScalarValue
    );
    const linkEligibility = getLinkEligibility_(cellRole, result.fieldCode);
    if (cellRole === 'Заголовок таблицы') tableHeaders++;
    if (cellRole === 'Строка таблицы') tableDataRows++;
    if (cellRole === 'Дублирующий заголовок') duplicateHeaders++;

    recognized.push([
      stableId_('REC', [
        candidate.rowImportId,
        candidate.sheetName,
        candidate.cellAddress,
        result.fieldCode
      ]),
      candidate.rowImportId,
      candidate.dealId,
      candidate.sourceFileId,
      candidate.sourceFile,
      candidate.sheetName,
      candidate.rowNumber,
      candidate.columnNumber,
      candidate.cellAddress,
      candidate.displayValue,
      safeSpreadsheetText_(candidate.formula),
      cellRole,
      linkEligibility,
      result.group,
      result.fieldCode,
      result.fieldName,
      result.valueType,
      candidate.detectedCurrency || result.currency,
      candidate.detectedUnit || result.unit,
      result.confidence,
      result.reason,
      'Требует проверки', ''
    ]);
  });

  writeRecognizedFields_(spreadsheet, recognized);

  SpreadsheetApp.getUi().alert(
    'Предварительное распознавание завершено.\n\n' +
    `Найдено показателей: ${recognized.length}\n\n` +
    `Исключено значений: ${excludedValues}\n` +
    `Исключено примечаний: ${excludedNotes}\n` +
    `Исключено ячеек инструктивных листов: ${excludedInstructionCells}\n` +
    `Исключено семантического шума: ${excludedSemanticNoise}\n` +
    `Заголовков таблиц: ${tableHeaders}\n` +
    `Строк таблиц: ${tableDataRows}\n` +
    `Дублирующих заголовков: ${duplicateHeaders}\n\n` +
    'Результат записан на лист:\n' +
    '«Распознанные поля»'
  );

  writeLog_(
    'USER',
      'RECOGNIZE_IMPORTED_FIELDS',
      values[0][1],
      `Предварительно распознано показателей: ${recognized.length}`
  );
}

function isRecognitionInstructionSheet_(sheetName) {
  const normalized = normalizeRecognitionText_(sheetName);
  return normalized === 'инструкция импортёру' ||
    normalized === 'инструкция импортеру' ||
    normalized.startsWith('инструкция импортёру ') ||
    normalized.startsWith('инструкция импортеру ');
}

function isRecognitionSemanticNoise_(displayValue, fieldCode) {
  const text = normalizeRecognitionText_(displayValue);

  if (fieldCode === 'CLIENT_NAME') {
    return /(клиент\s+и\s+сделк|коммерческ.*предлож.*клиент.*импорт[её]р)/.test(text);
  }

  if (fieldCode === 'ITEM_NAME') {
    return /(оплат|плат[её]ж|договор|контракт|получите\s+товар|часть\s+за\s+товар|стоимост|цена|итого)/.test(text);
  }

  if (fieldCode === 'QUANTITY') {
    return /(договор|контракт|оплат|плат[её]ж|цена|стоимост|итого|курс|формул|ставк)/.test(text);
  }

  if (fieldCode === 'TOTAL_WEIGHT') {
    return /(пошлин|тариф|ставк|за\s*кг|\/\s*кг|евро\s*\/\s*кг|usd\s*\/\s*кг|cny\s*\/\s*кг)/.test(text);
  }

  if (fieldCode === 'CERTIFICATION') {
    return /(хотите|при\s+необходимости|истори[яи]\s+импорт|сертификационн.*орган)/.test(text);
  }

  return false;
}

function detectPreliminaryCellRole_(value) {
  const original = String(value || '').trim();
  const text = normalizeRecognitionText_(original);

  const numberedItems = original.match(/(?:^|\n)\s*\d+[.)]\s*/g) || [];
  if (
    numberedItems.length >= 2 ||
    (original.includes('\n') && original.length > 120) ||
    /^(примечани|комментари|важно|условия расч[её]та)/.test(text)
  ) {
    return 'Примечание';
  }

  const logisticsValue =
    /^(авто|автомобильн|железнодорожн|жд|морск|авиа).*?(достав|перевоз)/
      .test(text) ||
    /^(достав|перевоз).*?[—–-].*(москв|забайкальск|маньчжур|склад)/
      .test(text);
  const looksLikeDescription =
    original.length > 45 || /\([^)]{10,}\)/.test(original);
  const headerSignals = /^(итого|стоимость|расходы|тариф|доставка\s*:)/.test(text);
  if (logisticsValue && looksLikeDescription && !headerSignals) {
    return 'Значение';
  }

  return 'Заголовок';
}

function buildRecognitionRowContext_(rows) {
  const context = new Map();
  rows.forEach(row => {
    const key = [row[2], row[4], Number(row[5])].join('|||');
    if (!context.has(key)) context.set(key, []);
    context.get(key).push({
      columnNumber: Number(row[6]),
      rawValue: row[8],
      displayValue: row[9],
      formula: row[10],
      detectedType: String(row[12] || ''),
      detectedCurrency: row[13]
    });
  });
  return context;
}

function buildRecognitionFieldKey_(candidate) {
  return [
    candidate.sourceFileId,
    candidate.sheetName,
    candidate.result.fieldCode
  ].join('|||');
}

function isTabularHeaderContext_(candidate, rowContext) {
  const key = [
    candidate.sourceFileId,
    candidate.sheetName,
    candidate.rowNumber
  ].join('|||');
  const rowCells = rowContext.get(key) || [];
  const textualColumns = rowCells
    .filter(cell => {
      if (['Число', 'Дата', 'Процент', 'Формула']
        .includes(cell.detectedType)) return false;
      const text = normalizeRecognitionText_(cell.displayValue);
      return text.length >= 2 && text.length <= 120;
    })
    .map(cell => cell.columnNumber)
    .sort((left, right) => left - right);
  if (textualColumns.length < 3) return false;
  return textualColumns[textualColumns.length - 1] - textualColumns[0] <= 7;
}

function isTableDataRowContext_(candidate, rowContext) {
  if (candidate.columnNumber !== 1) return false;
  const key = [
    candidate.sourceFileId,
    candidate.sheetName,
    candidate.rowNumber
  ].join('|||');
  const rowCells = rowContext.get(key) || [];
  const amountCell = rowCells.find(cell => cell.columnNumber === 2);
  const currencyCell = rowCells.find(cell => cell.columnNumber === 3);
  if (!amountCell || !currencyCell) return false;
  const amount = parseFlexibleNumber_(
    amountCell.rawValue == null || amountCell.rawValue === ''
      ? amountCell.displayValue
      : amountCell.rawValue
  );
  const currency = normalizeCurrencyCode_(currencyCell.displayValue);
  return amount !== null && currency !== '';
}

function getContextualRecognizedCellRole_(
  candidate,
  rowContext,
  fieldsWithScalarValue
) {
  const baseRole = getRecognizedCellRole_(candidate.result.fieldCode);
  if (baseRole !== 'Заголовок') return baseRole;
  if (isTableDataRowContext_(candidate, rowContext)) {
    return 'Строка таблицы';
  }
  // DEV-009: информационные блоки товара могут содержать несколько пар
  // «заголовок — значение» в одной строке. Если для текущего заголовка уже
  // найдено допустимое соседнее значение, это не заголовок таблицы и поле
  // должно быть допущено к связыванию.
  if (!candidate.hasLinkedValue && isTabularHeaderContext_(candidate, rowContext)) {
    return 'Заголовок таблицы';
  }
  if (
    !candidate.hasLinkedValue &&
    fieldsWithScalarValue.has(buildRecognitionFieldKey_(candidate))
  ) {
    return 'Дублирующий заголовок';
  }
  return baseRole;
}

function getRecognizedCellRole_(fieldCode) {
  if (fieldCode === 'COMPOSITE_EXPENSE') return 'Составная статья';
  if ([
    'TOTAL_LOGISTICS', 'TOTAL_IMPORT', 'TOTAL_GOODS_PAYMENT', 'GRAND_TOTAL'
  ].includes(fieldCode)) {
    return 'Итог';
  }
  return 'Заголовок';
}

function getLinkEligibility_(cellRole, fieldCode) {
  if (!['Заголовок', 'Итог'].includes(cellRole)) return 'Нет';

  // DEV-009 v3.5.5: к скалярному связыванию допускаются только поля,
  // которые действительно являются одиночными реквизитами сделки/товара.
  // Строки расходов и промежуточные итоги переносятся отдельным механизмом
  // распознавания строк таблиц и не должны повторно связываться как скаляры.
  const scalarFields = new Set([
    'CLIENT_NAME',
    'DEAL_NUMBER',
    'ROUTE',
    'BORDER_CROSSING',
    'DELIVERY_TERMS',
    'ITEM_NAME',
    'ARTICLE',
    'TN_VED',
    'QUANTITY',
    'TOTAL_WEIGHT',
    'VOLUME',
    'VEHICLE_TYPE',
    'USD_RUB_RATE',
    'CNY_RUB_RATE',
    'CERTIFICATION',
    'GRAND_TOTAL'
  ]);

  return scalarFields.has(fieldCode) ? 'Да' : 'Нет';
}

function promptImportId_(title) {
  const ui = SpreadsheetApp.getUi();
  const latest = getLatestCompletedImportId_();
  const response = ui.prompt(
    title,
    `Введите import_id. Оставьте пустым для последнего завершённого: ${latest || 'нет'}`,
    ui.ButtonSet.OK_CANCEL
  );
  if (response.getSelectedButton() !== ui.Button.OK) return '';
  const importId = String(response.getResponseText() || '').trim() || latest;
  if (!importId) {
    ui.alert('Нет завершённых импортов.');
    return '';
  }
  return importId;
}

function getLatestCompletedImportId_() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet()
    .getSheetByName(BBC_MVP.sheets.imports);
  if (!sheet || sheet.getLastRow() < 2) return '';
  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 14).getValues();
  for (let index = rows.length - 1; index >= 0; index--) {
    if (rows[index][12] === 'Завершён') return String(rows[index][0]);
  }
  return '';
}

function isLikelyRecognitionLabel_(displayValue, detectedType) {
  if (['Число', 'Дата', 'Процент', 'Логическое значение', 'Формула']
    .includes(String(detectedType))) return false;
  const text = normalizeRecognitionText_(displayValue);
  return text.length >= 2 && text.length <= 250;
}

function stableId_(prefix, parts) {
  const bytes = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    parts.map(value => String(value)).join('\u001f'),
    Utilities.Charset.UTF_8
  );
  const hex = bytes.map(byte =>
    (`0${((byte + 256) % 256).toString(16)}`).slice(-2)
  );
  return `${prefix}-${hex.join('').slice(0, 24)}`;
}


/**
 * Классификация значения или заголовка.
 */
function classifyImportedCell_(
  text,
  detectedType,
  detectedCurrency,
  detectedUnit
) {
  if (isStandaloneMeasurementUnitLabel_(text)) {
    return {
      group: '',
      fieldCode: '',
      fieldName: '',
      valueType: '',
      currency: '',
      unit: '',
      confidence: '',
      reason: ''
    };
  }

  const rules = getRecognitionRules_();

  for (const rule of rules) {
    if (rule.exclude && rule.exclude.some(pattern => pattern.test(text))) {
      continue;
    }

    if (rule.patterns.some(pattern => pattern.test(text))) {
      return {
        group: rule.group,
        fieldCode: rule.fieldCode,
        fieldName: rule.fieldName,
        valueType: rule.valueType || detectedType || '',
        currency: rule.currency || detectedCurrency || '',
        unit: rule.unit || detectedUnit || '',
        confidence: rule.confidence || 'Средняя',
        reason: `Совпадение по правилу: ${rule.fieldName}`
      };
    }
  }

  return {
    group: '',
    fieldCode: '',
    fieldName: '',
    valueType: '',
    currency: '',
    unit: '',
    confidence: '',
    reason: ''
  };
}


