function buildAiSourceTraceability_(spreadsheet, dealId, deal, itemRecords) {
  const importSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.imports);
  const importRecords = importSheet && importSheet.getLastRow() > 1
    ? readDataRows_(importSheet, readSheetHeaders_(importSheet).length)
      .map(row => rowToRecord_(readSheetHeaders_(importSheet), row))
      .filter(record => String(record['deal_id'] || '') === String(dealId))
    : [];

  const filesByKey = new Map();
  const importsByName = new Map();

  const normalizeFileName = value => String(value || '').trim();
  const extractDriveId = value => {
    const text = String(value || '');
    const match = text.match(/(?:\/d\/|[?&]id=)([-\w]{10,})/);
    return match ? match[1] : '';
  };
  const makeKey = source => String(
    source.fileId || extractDriveId(source.fileUrl) || normalizeFileName(source.fileName)
  ).trim();

  const addUsage = (target, usage) => {
    const normalized = Object.assign({
      entity: '', itemNumber: '', sourceSheet: '', sourceCells: '', sourceType: ''
    }, usage || {});
    const signature = JSON.stringify(normalized);
    if (!target._usageKeys.has(signature)) {
      target._usageKeys.add(signature);
      target.usage.push(normalized);
    }
  };

  const upsertFile = source => {
    const normalized = {
      fileId: String(source.fileId || extractDriveId(source.fileUrl) || '').trim(),
      fileName: normalizeFileName(source.fileName),
      fileUrl: String(source.fileUrl || '').trim(),
      mimeType: String(source.mimeType || '').trim(),
      importId: String(source.importId || '').trim(),
      importStatus: String(source.importStatus || '').trim()
    };
    const key = makeKey(normalized);
    if (!key) return null;
    if (!filesByKey.has(key)) {
      filesByKey.set(key, Object.assign(normalized, {usage: [], _usageKeys: new Set()}));
    } else {
      const existing = filesByKey.get(key);
      Object.keys(normalized).forEach(field => {
        if (!existing[field] && normalized[field]) existing[field] = normalized[field];
      });
    }
    const record = filesByKey.get(key);
    if (record.fileName) importsByName.set(record.fileName, record);
    return record;
  };

  importRecords.forEach(record => {
    upsertFile({
      fileId: record['ID исходного файла'],
      fileName: record['Название исходного файла'],
      fileUrl: record['Ссылка'],
      mimeType: record['MIME-тип'],
      importId: record['import_id'],
      importStatus: record['Статус']
    });
  });

  const dealSource = upsertFile({
    fileName: deal['Исходный файл'],
    fileUrl: deal['Ссылка на исходный файл']
  });
  if (dealSource) addUsage(dealSource, {entity: 'DEAL'});

  (itemRecords || []).forEach((item, index) => {
    const fileName = normalizeFileName(item['source_file']);
    if (!fileName) return;
    const imported = importsByName.get(fileName);
    const source = imported || upsertFile({fileName});
    if (!source) return;
    addUsage(source, {
      entity: 'ITEM',
      itemNumber: item['Номер позиции'] || index + 1,
      sourceSheet: String(item['source_sheet'] || '').trim(),
      sourceCells: String(item['source_cell'] || '').trim(),
      sourceType: String(item['source_type'] || '').trim()
    });
  });

  const files = [...filesByKey.values()].map(source => ({
    fileId: source.fileId,
    fileName: source.fileName,
    fileUrl: source.fileUrl,
    mimeType: source.mimeType,
    importId: source.importId,
    importStatus: source.importStatus,
    usage: source.usage
  }));

  return {files, importsByName};
}

function buildAiItemSourceReference_(item, importsByName) {
  const fileName = String(item['source_file'] || '').trim();
  const imported = fileName && importsByName ? importsByName.get(fileName) : null;
  return {
    fileId: imported ? imported.fileId : '',
    fileName,
    fileUrl: imported ? imported.fileUrl : '',
    sourceSheet: String(item['source_sheet'] || '').trim(),
    sourceCells: String(item['source_cell'] || '').trim(),
    sourceType: String(item['source_type'] || '').trim()
  };
}

function calculateItemPriceConsistencyTolerance_(quantity, unitPrice, expectedBatchPrice) {
  // Цена в текущих импортируемых товарных файлах обычно хранится с точностью
  // до 0,001 единицы валюты. Допуск учитывает максимум половины такого шага
  // на каждую единицу товара и минимальный денежный допуск 0,01.
  return Math.max(
    0.01,
    Math.abs(Number(quantity) || 0) * 0.0005,
    Math.abs(Number(expectedBatchPrice) || 0) * 0.000001
  );
}


function normalizeAiSourceCell_(value) {
  return String(value || '').replace(/\$/g, '').trim().toUpperCase();
}

function buildAiImportedCellIndex_(spreadsheet, dealId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.importCells);
  const result = {byCell: new Map(), byRow: new Map()};
  if (!sheet || sheet.getLastRow() <= 1) return result;

  const headers = readSheetHeaders_(sheet);
  readDataRows_(sheet, headers.length)
    .map(row => rowToRecord_(headers, row))
    .filter(record => String(record['deal_id'] || '') === String(dealId || ''))
    .forEach(record => {
      const fileId = String(record['ID исходного файла'] || '').trim();
      const sourceSheet = String(record['Лист'] || '').trim();
      const sourceCell = normalizeAiSourceCell_(record['Ячейка']);
      const rowNumber = String(record['Строка'] || '').trim();
      if (!fileId || !sourceSheet || !sourceCell) return;

      result.byCell.set(`${fileId}|${sourceSheet}|${sourceCell}`, record);
      const rowKey = `${fileId}|${sourceSheet}|${rowNumber}`;
      if (!result.byRow.has(rowKey)) result.byRow.set(rowKey, []);
      result.byRow.get(rowKey).push(record);
    });

  return result;
}

function buildAiImportedCellIndexFromRecords_(records) {
  const result = {byCell: new Map(), byRow: new Map()};
  (records || []).forEach(function(record) {
    const fileId = aiText_(record && record['ID исходного файла']);
    const sourceSheet = aiText_(record && record['Лист']);
    const sourceCell = normalizeAiSourceCell_(record && record['Ячейка']);
    const rowNumber = aiText_(record && record['Строка']);
    if (!fileId || !sourceSheet || !sourceCell) return;
    result.byCell.set(`${fileId}|${sourceSheet}|${sourceCell}`, record);
    const rowKey = `${fileId}|${sourceSheet}|${rowNumber}`;
    if (!result.byRow.has(rowKey)) result.byRow.set(rowKey, []);
    result.byRow.get(rowKey).push(record);
  });
  return result;
}

function parseAiSourceCells_(value) {
  return (String(value || '').match(/[A-Za-z]+\$?\d+/g) || [])
    .map(normalizeAiSourceCell_);
}

function parseTrailingFormulaAdjustment_(formulaText) {
  const formula = String(formulaText || '').trim();
  const trailing = formula.match(/([+-])\s*(\d+(?:[.,]\d+)?)\s*$/);
  if (!trailing) return null;
  const amount = parseFlexibleNumber_(trailing[2]);
  if (!Number.isFinite(amount)) return null;
  return trailing[1] === '-' ? -amount : amount;
}

function resolveKnownItemPriceAdjustment_(importedCellIndex, itemSource, config) {
  if (!importedCellIndex || !itemSource || !itemSource.fileId || !itemSource.sourceSheet) {
    return null;
  }

  const quantity = Number(config.quantity);
  const unitPrice = Number(config.unitPrice);
  const batchPrice = Number(config.batchPrice);
  const expectedBatchPrice = Number(config.expectedBatchPrice);
  const priceDelta = Number(config.priceDelta);
  const tolerance = Number(config.tolerance) || 0.01;
  if (![quantity, unitPrice, batchPrice, expectedBatchPrice, priceDelta].every(Number.isFinite)) {
    return null;
  }

  const records = parseAiSourceCells_(itemSource.sourceCells)
    .map(cell => importedCellIndex.byCell.get(
      `${itemSource.fileId}|${itemSource.sourceSheet}|${cell}`
    ))
    .filter(Boolean);

  const batchRecord = records.find(record => {
    const sourceValue = parseFlexibleNumber_(record['Исходное значение']);
    const displayedValue = parseFlexibleNumber_(record['Отображаемое значение']);
    const formula = String(record['Формула как текст'] || '').trim();
    return formula && (
      (Number.isFinite(sourceValue) && Math.abs(sourceValue - batchPrice) <= tolerance) ||
      (Number.isFinite(displayedValue) && Math.abs(displayedValue - batchPrice) <= tolerance)
    );
  });
  if (!batchRecord) return null;

  const formula = String(batchRecord['Формула как текст'] || '').trim();
  const formulaAdjustment = parseTrailingFormulaAdjustment_(formula);
  if (!Number.isFinite(formulaAdjustment) ||
      Math.abs(formulaAdjustment - priceDelta) > tolerance) {
    return null;
  }

  const rowKey = `${itemSource.fileId}|${itemSource.sourceSheet}|${String(batchRecord['Строка'] || '').trim()}`;
  const rowRecords = importedCellIndex.byRow.get(rowKey) || [];
  const noteCandidates = rowRecords
    .map(record => String(record['Отображаемое значение'] || record['Исходное значение'] || '').trim())
    .filter(value => value && /(?:достав|включ|доплат|надбав|логист|упаков|комисс|юан)/i.test(value));

  return {
    status: 'SOURCE_EXPLAINED_ADJUSTMENT',
    baseAmount: roundTo_(expectedBatchPrice, 6),
    adjustmentAmount: roundTo_(formulaAdjustment, 6),
    batchAmount: roundTo_(batchPrice, 6),
    currency: String(config.currency || '').trim(),
    sourceCell: normalizeAiSourceCell_(batchRecord['Ячейка']),
    sourceFormula: formula,
    sourceNote: noteCandidates[0] || '',
    source: itemSource
  };
}

function formatManagerNumber_(value, digits) {
  const numeric = Number(value);
  if (!Number.isFinite(numeric)) return '';
  return roundTo_(numeric, digits == null ? 3 : digits)
    .toLocaleString('ru-RU', {maximumFractionDigits: digits == null ? 3 : digits});
}

function readAiImportedCellRecords_(spreadsheet, dealId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.importCells);
  if (!sheet || sheet.getLastRow() <= 1) return [];
  const headers = readSheetHeaders_(sheet);
  return readDataRows_(sheet, headers.length)
    .map(row => rowToRecord_(headers, row))
    .filter(record => String(record['deal_id'] || '') === String(dealId || ''));
}

function readAiCheckRecords_(spreadsheet, dealId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.checks);
  if (!sheet || sheet.getLastRow() <= 1) return [];
  const headers = readSheetHeaders_(sheet);
  return readDataRows_(sheet, headers.length)
    .map(row => rowToRecord_(headers, row))
    .filter(record => String(record['deal_id'] || '') === String(dealId || ''));
}

function readAiLatestVerifiedSnapshotSummary_(spreadsheet, dealId) {
  const row = getLatestVerifiedSnapshot_(spreadsheet, dealId);
  if (!row) return null;
  return {
    snapshotId: String(row[0] || '').trim(),
    calculatedAt: row[2] || '',
    rulesVersion: String(row[3] || '').trim(),
    goodsCny: parseFlexibleNumber_(row[6]),
    goodsRub: parseFlexibleNumber_(row[7]),
    expensesCny: parseFlexibleNumber_(row[8]),
    expensesRub: parseFlexibleNumber_(row[9]),
    commissionCny: parseFlexibleNumber_(row[10]),
    commissionRub: parseFlexibleNumber_(row[11]),
    totalCny: parseFlexibleNumber_(row[12]),
    totalRub: parseFlexibleNumber_(row[13]),
    cnyRubRate: parseFlexibleNumber_(row[14]),
    usdRubRate: parseFlexibleNumber_(row[15]),
    eurRubRate: parseFlexibleNumber_(row[16]),
    status: String(row[19] || '').trim()
  };
}

function aiText_(value) {
  return String(value == null ? '' : value).replace(/\u00a0/g, ' ').trim();
}

function aiIsSpreadsheetErrorValue_(value) {
  const text = aiText_(value).toUpperCase();
  return /^(?:#ERROR!|#REF!|#N\/?A!?|#VALUE!|#DIV\/0!|#NAME\?|#NUM!|#NULL!|#SPILL!|#CALC!|#FIELD!|#CONNECT!|#BLOCKED!)$/.test(text);
}

function aiDecodeXmlEntities_(value) {
  return String(value == null ? '' : value)
    .replace(/&#x([0-9a-f]+);/gi, function(_, hex) { return String.fromCharCode(parseInt(hex, 16)); })
    .replace(/&#(\d+);/g, function(_, dec) { return String.fromCharCode(parseInt(dec, 10)); })
    .replace(/&quot;/g, '"')
    .replace(/&apos;|&#39;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&amp;/g, '&');
}

function aiXmlAttribute_(attributes, name) {
  const escaped = String(name || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const match = String(attributes || '').match(new RegExp("(?:^|\\s)" + escaped + "\\s*=\\s*[\"']([^\"']*)[\"']", 'i'));
  return match ? aiDecodeXmlEntities_(match[1]) : '';
}

function aiXmlTextNodes_(xml) {
  const parts = [];
  const regex = /<t(?:\s[^>]*)?>([\s\S]*?)<\/t>/gi;
  let match;
  while ((match = regex.exec(String(xml || ''))) !== null) {
    parts.push(aiDecodeXmlEntities_(match[1].replace(/<[^>]+>/g, '')));
  }
  return parts.join('');
}

function aiNormalizeXlsxZipPath_(target) {
  let path = String(target || '').replace(/\\/g, '/').replace(/^\/+/, '');
  while (path.indexOf('../') === 0) path = path.slice(3);
  if (path.indexOf('xl/') !== 0) path = 'xl/' + path;
  return path.replace(/\/+/g, '/');
}

function aiReadOriginalXlsxCachedCells_(fileId) {
  const result = new Map();
  if (!fileId) return result;
  try {
    const file = DriveApp.getFileById(fileId);
    const fileName = file.getName();
    if (!/\.xlsx$/i.test(fileName)) return result;

    // Utilities.unzip ожидает ZIP Blob. Drive возвращает MIME XLSX, поэтому
    // создаём новый Blob с теми же байтами и явным типом application/zip.
    const sourceBlob = file.getBlob();
    const zipBlob = Utilities.newBlob(sourceBlob.getBytes(), 'application/zip', fileName);
    const entries = Utilities.unzip(zipBlob);
    const byName = new Map();
    entries.forEach(function(blob) {
      const entryName = String(blob.getName() || '')
        .replace(/\\/g, '/')
        .replace(/^\/+/, '');
      // В XLSX нужны только XML/RELS. Бинарные вложения не декодируем как UTF-8.
      if (!/(?:\.xml|\.rels)$/i.test(entryName)) return;
      byName.set(entryName, blob.getDataAsString('UTF-8'));
    });
    const workbookXml = byName.get('xl/workbook.xml') || '';
    const relsXml = byName.get('xl/_rels/workbook.xml.rels') || '';
    if (!workbookXml || !relsXml) return result;

    const relationships = new Map();
    const relRegex = /<Relationship\b([^>]*)\/?>(?:<\/Relationship>)?/gi;
    let relMatch;
    while ((relMatch = relRegex.exec(relsXml)) !== null) {
      const id = aiXmlAttribute_(relMatch[1], 'Id');
      const target = aiXmlAttribute_(relMatch[1], 'Target');
      if (id && target) relationships.set(id, aiNormalizeXlsxZipPath_(target));
    }

    const sharedStrings = [];
    const sharedXml = byName.get('xl/sharedStrings.xml') || '';
    const siRegex = /<si(?:\s[^>]*)?>([\s\S]*?)<\/si>/gi;
    let siMatch;
    while ((siMatch = siRegex.exec(sharedXml)) !== null) sharedStrings.push(aiXmlTextNodes_(siMatch[1]));

    const sheets = [];
    const sheetRegex = /<sheet\b([^>]*)\/?>(?:<\/sheet>)?/gi;
    let sheetMatch;
    while ((sheetMatch = sheetRegex.exec(workbookXml)) !== null) {
      const rawName = aiXmlAttribute_(sheetMatch[1], 'name');
      const relId = aiXmlAttribute_(sheetMatch[1], 'r:id');
      const target = relationships.get(relId);
      if (rawName && target) sheets.push({rawName: rawName, name: aiText_(rawName), target: target});
    }

    sheets.forEach(function(sheet) {
      const xml = byName.get(String(sheet.target || '').replace(/^\/+/, '')) || '';
      if (!xml) return;
      const cellXml = xml.replace(/<c\b[^>]*\/>/gi, '');
      const cellRegex = /<c\b([^>]*)>([\s\S]*?)<\/c>/gi;
      let cellMatch;
      while ((cellMatch = cellRegex.exec(cellXml)) !== null) {
        const attrs = cellMatch[1];
        const body = cellMatch[2];
        const address = normalizeAiSourceCell_(aiXmlAttribute_(attrs, 'r'));
        if (!address) continue;
        const type = aiXmlAttribute_(attrs, 't').toLowerCase();
        const formulaMatch = body.match(/<f(?:\s[^>]*)?>([\s\S]*?)<\/f>/i);
        const valueMatch = body.match(/<v(?:\s[^>]*)?>([\s\S]*?)<\/v>/i);
        let value = '';
        if (type === 'inlinestr') {
          value = aiXmlTextNodes_(body);
        } else if (valueMatch) {
          const raw = aiDecodeXmlEntities_(valueMatch[1].replace(/<[^>]+>/g, ''));
          if (type === 's') value = sharedStrings[Number(raw)] == null ? '' : sharedStrings[Number(raw)];
          else if (type === 'b') value = raw === '1' ? true : false;
          else if (type === 'str') value = raw;
          else if (type === 'e') value = raw;
          else value = /^-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?$/.test(raw) ? Number(raw) : raw;
        }
        if (value === '' || value == null || aiIsSpreadsheetErrorValue_(value)) continue;
        const entry = {
          value: value,
          formula: formulaMatch ? aiDecodeXmlEntities_(formulaMatch[1].replace(/<[^>]+>/g, '')) : '',
          dataType: type || 'n'
        };
        // Импортёр нормализует имя листа trim(). Храним оба ключа.
        result.set(sheet.name + '|' + address, entry);
        result.set(String(sheet.rawName || '') + '|' + address, entry);
      }
    });
  } catch (error) {
    console.warn('DEV-016.16 XLSX cached-value recovery failed for ' + fileId + ': ' + error);
  }
  return result;
}

function buildAiOriginalXlsxCachedIndex_(sourceTraceability) {
  const index = new Map();
  (sourceTraceability && sourceTraceability.files || []).forEach(function(file) {
    if (!file.fileId || !/\.xlsx$/i.test(aiText_(file.fileName))) return;
    const cached = aiReadOriginalXlsxCachedCells_(file.fileId);
    cached.forEach(function(entry, key) {
      index.set(file.fileId + '|' + key, entry);
    });
  });
  return index;
}

function applyAiOriginalXlsxCachedFallback_(records, cachedIndex) {
  return (records || []).map(function(record) {
    const currentValue = aiCellValue_(record);
    const formula = aiCellFormula_(record);
    const needsFallback = aiIsSpreadsheetErrorValue_(currentValue) ||
      (/\[[^\]]+\]/.test(formula) && aiIsPlaceholder_(currentValue));
    if (!needsFallback) return record;
    const fileId = aiText_(record['ID исходного файла']);
    const sheet = aiText_(record['Лист']);
    const cell = normalizeAiSourceCell_(record['Ячейка']);
    const cached = cachedIndex && cachedIndex.get(fileId + '|' + sheet + '|' + cell);
    if (!cached || aiIsPlaceholder_(cached.value) || aiIsSpreadsheetErrorValue_(cached.value)) return record;
    const enriched = Object.assign({}, record);
    enriched['_aiCachedFallback'] = true;
    enriched['_aiOriginalErrorValue'] = currentValue;
    enriched['Отображаемое значение'] = cached.value;
    enriched['Исходное значение'] = cached.value;
    return enriched;
  });
}

function aiCellValue_(record) {
  return aiText_(record && (
    record['Отображаемое значение'] !== '' && record['Отображаемое значение'] != null
      ? record['Отображаемое значение']
      : record['Исходное значение']
  ));
}

function aiCellFormula_(record) {
  return aiText_(record && record['Формула как текст']);
}

function aiFileKey_(fileId, fileName) {
  return aiText_(fileId) || aiText_(fileName);
}

function aiSourceKeyFromRecord_(record) {
  return aiFileKey_(record && record['ID исходного файла'], record && record['Исходный файл']);
}

function aiSheetKey_(fileKey, sheetName) {
  return `${aiText_(fileKey)}|${aiText_(sheetName)}`;
}

function aiIsPlaceholder_(value) {
  const text = aiText_(value);
  return !text || aiIsSpreadsheetErrorValue_(text) ||
    /^(?:[-—–]|нет данных|не указано|n\/?a|null|undefined)$/i.test(text);
}

function aiIsInvalidEvidenceValue_(fieldCode, value) {
  if (aiIsPlaceholder_(value)) return true;
  const textOnlyFields = new Set([
    'deal.manager', 'deal.client', 'deal.scheme', 'logistics.incoterms',
    'logistics.chinaRoute', 'logistics.borderCrossing', 'logistics.destinationCity',
    'logistics.transportMode', 'commercial.paymentTerms', 'customs.dutyMethod'
  ]);
  return textOnlyFields.has(fieldCode) && /^0(?:[.,]0+)?$/.test(aiText_(value));
}

function aiLooksLikePersonName_(value) {
  const text = aiText_(value);
  if (!text || text.length > 80) return false;
  if (/(?:менеджер|фио|социальн|telegram|телеграм|контакт|канал|бот|сети)/i.test(text)) return false;
  return /^[А-ЯЁA-Z][А-ЯЁA-Za-zА-Яа-яёЁ-]*(?:\s+[А-ЯЁA-Z][А-ЯЁA-Za-zА-Яа-яёЁ-]*){0,3}$/.test(text);
}

function aiParseCellAddress_(address) {
  const match = aiText_(address).replace(/\$/g, '').match(/^([A-Z]+)(\d+)$/i);
  if (!match) return {row: 0, col: 0};
  let col = 0;
  String(match[1]).toUpperCase().split('').forEach(ch => {
    col = col * 26 + ch.charCodeAt(0) - 64;
  });
  return {row: Number(match[2]) || 0, col};
}

function aiRecordPosition_(record) {
  const parsed = aiParseCellAddress_(record && record['Ячейка']);
  return {
    row: Number(record && record['Строка']) || parsed.row,
    col: Number(record && record['Столбец']) || parsed.col
  };
}

function aiNormalizeScheme_(value) {
  const text = aiText_(value).toLowerCase();
  if (!text) return '';
  if (/под ключ/.test(text) && /bbc\s*(?:импорт|импорт[её]р)/.test(text)) {
    return 'BBC_IMPORTER_AND_EXPORTER';
  }
  if (/bbc\s*(?:импорт|импорт[её]р).*(?:экспорт|экспорт[её]р)/.test(text)) {
    return 'BBC_IMPORTER_AND_EXPORTER';
  }
  if (/клиент\s*(?:импорт|импорт[её]р).*(?:bbc\s*)?(?:экспорт|экспорт[её]р)/.test(text) ||
      /импорт\s+на\s+себя/.test(text)) {
    return 'CLIENT_IMPORTER_BBC_EXPORTER';
  }
  if (/(?:подрядчик|партн[её]р).*(?:импорт|импорт[её]р)/.test(text) && /bbc/.test(text)) {
    return 'CONTRACTOR_IMPORTER_BBC_ORGANIZER';
  }
  if (/bbc\s*(?:импорт|импорт[её]р)/.test(text)) return 'BBC_IMPORTER';
  if (/bbc\s*(?:экспорт|экспорт[её]р)/.test(text)) return 'BBC_EXPORTER';
  return '';
}

function aiSchemeLabel_(value) {
  const code = aiText_(value);
  if (code === 'BBC_IMPORTER_AND_EXPORTER') return 'ПОД КЛЮЧ — BBC импортёр и экспортёр';
  if (code === 'CLIENT_IMPORTER_BBC_EXPORTER') return 'Клиент импортёр — BBC экспортёр';
  if (code === 'BBC_IMPORTER') return 'BBC импортёр';
  if (code === 'BBC_EXPORTER') return 'BBC экспортёр';
  if (code === 'CONTRACTOR_IMPORTER_BBC_ORGANIZER') return 'Подрядчик — импортёр · BBC организует и сопровождает сделку';
  return code;
}

function aiIsStaticSchemeTemplateLabel_(record, records, text) {
  const value = aiText_(text || aiCellValue_(record));
  if (!/коммерческ(?:ое|ий)\s+предложение[\s\S]{0,80}?по\s+схеме/i.test(value)) return false;
  if (aiCellFormula_(record)) return false;
  const currentPosition = aiRecordPosition_(record);
  return (records || []).some(other => {
    if (other === record) return false;
    const otherText = aiCellValue_(other);
    const otherFormula = aiCellFormula_(other);
    if (!aiNormalizeScheme_(otherText)) return false;
    if (!/(?:сделка\s*№[\s\S]{0,160}?схема\s*:|схема\s*:)/i.test(`${otherText} ${otherFormula}`)) return false;
    const otherPosition = aiRecordPosition_(other);
    if (!currentPosition.row || !otherPosition.row) return true;
    return Math.abs(currentPosition.row - otherPosition.row) <= 5;
  });
}

function aiSplitChinaRouteAndBorder_(value) {
  const original = aiText_(value);
  if (!original) return {route: '', borderCrossing: ''};
  const borderPattern = /(?:^|[;\n,])\s*(?:погран(?:ичный)?\s*переход|погранпереход)\s*[:—-]\s*([^;\n,]+)/i;
  const match = original.match(borderPattern);
  const borderCrossing = match ? aiText_(match[1]).replace(/[.;,]+$/, '').trim() : '';
  const route = original.replace(borderPattern, ' ')
    .replace(/\s*[;,_]+\s*$/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return {route, borderCrossing};
}

function aiNormalizeChinaRoute_(value) {
  return aiSplitChinaRouteAndBorder_(value).route.toLowerCase()
    .replace(/ё/g, 'е')
    .replace(/\s*[→>-]+\s*/g, ' → ')
    .replace(/\s+/g, ' ')
    .trim();
}

function aiNormalizeTransport_(value) {
  const text = aiText_(value).toLowerCase();
  if (/авто|автомоб/.test(text)) return 'AUTO';
  if (/ж\/?д|железнодорож/.test(text)) return 'RAIL';
  if (/авиа/.test(text)) return 'AIR';
  if (/море|морск/.test(text)) return 'SEA';
  if (/мультимод/.test(text)) return 'MULTIMODAL';
  return aiText_(value);
}

function aiTransportLabel_(value) {
  const code = aiText_(value);
  return ({AUTO: 'Авто', RAIL: 'Ж/д', AIR: 'Авиа', SEA: 'Море', MULTIMODAL: 'Мультимодальная'})[code] || code;
}

function aiNormalizeCurrency_(value) {
  const text = aiText_(value).toUpperCase();
  if (/RUB|РУБ|₽/.test(text)) return 'RUB';
  if (/CNY|RMB|ЮАН|¥/.test(text)) return 'CNY';
  if (/USD|ДОЛЛ|\$/.test(text)) return 'USD';
  if (/EUR|ЕВРО|€/.test(text)) return 'EUR';
  return text;
}

function aiNormalizePercentValue_(value) {
  const numeric = parseFlexibleNumber_(value);
  if (!Number.isFinite(numeric)) return NaN;
  if (Math.abs(numeric) > 0 && Math.abs(numeric) <= 1) return roundTo_(numeric * 100, 6);
  return roundTo_(numeric, 6);
}

function aiCanonicalValue_(fieldCode, value) {
  if (value == null) return '';
  if (fieldCode === 'deal.scheme') return aiNormalizeScheme_(value) || aiText_(value).toLowerCase();
  if (fieldCode === 'deal.manager') {
    return aiText_(value).toLowerCase().replace(/ё/g, 'е')
      .replace(/ье$/, 'ья').replace(/ии$/, 'ия').replace(/\s+/g, ' ');
  }
  if (fieldCode === 'logistics.incoterms') {
    const match = aiText_(value).toUpperCase().match(/\b(EXW|FCA|FAS|FOB|CFR|CIF|CPT|CIP|DAP|DPU|DDP)\b/);
    // DEV-016.40: произвольные даты/номера из служебных листов не являются Incoterms.
    return match ? match[1] : '';
  }
  if (fieldCode === 'logistics.chinaRoute') return aiNormalizeChinaRoute_(value);
  if (fieldCode === 'logistics.transportMode') return aiNormalizeTransport_(value) || aiText_(value).toLowerCase();
  if (fieldCode === 'customs.dutyMethod') {
    const text = aiText_(value).toLowerCase().replace(/,/g, '.').replace(/\s+/g, ' ');
    let percent = text.match(/(?:^|[^\d])(\d+(?:\.\d+)?)\s*%/);
    const eurKg = text.match(/(\d+(?:\.\d+)?)\s*(?:евро|eur)\s*\/\s*кг/);
    const usdKg = text.match(/(\d+(?:\.\d+)?)\s*(?:usd|доллар(?:а|ов)?)\s*\/\s*кг/);
    if (!percent && (eurKg || usdKg)) percent = text.match(/(?:^|[^\d])(\d+(?:\.\d+)?)\s*\+\s*\d+(?:\.\d+)?/);
    if (percent && eurKg) return `COMBINED_PERCENT_EUR_KG:${roundTo_(Number(percent[1]), 6)}:${roundTo_(Number(eurKg[1]), 6)}`;
    if (percent && usdKg) return `COMBINED_PERCENT_USD_KG:${roundTo_(Number(percent[1]), 6)}:${roundTo_(Number(usdKg[1]), 6)}`;
    if (percent) return `PERCENT:${roundTo_(Number(percent[1]), 6)}`;
    if (eurKg) return `EUR_KG:${roundTo_(Number(eurKg[1]), 6)}`;
    if (usdKg) return `USD_KG:${roundTo_(Number(usdKg[1]), 6)}`;
    return text.replace(/[^a-zа-яё0-9.%/+_-]+/g, ' ').trim();
  }
  if (fieldCode === 'commission.percent') {
    const percent = aiNormalizePercentValue_(value);
    return Number.isFinite(percent) ? String(percent) : '';
  }
  if (fieldCode === 'logistics.productionDays' &&
      /^(?:NOT_APPLICABLE|N\/A|не\s+применяется|не\s+включается)$/i.test(aiText_(value))) {
    return 'NOT_APPLICABLE';
  }
  if (['logistics.deliveryDays', 'logistics.productionDays'].includes(fieldCode)) {
    const text = aiText_(value).replace(/–|—/g, '-').replace(/\s+/g, '');
    const range = text.match(/^(\d+(?:[.,]\d+)?)-(\d+(?:[.,]\d+)?)$/);
    if (range) return `${Number(range[1].replace(',', '.'))}-${Number(range[2].replace(',', '.'))}`;
    const numeric = parseFlexibleNumber_(value);
    return Number.isFinite(numeric) ? String(roundTo_(numeric, 6)) : '';
  }
  if (['deal.validityDays',
       'customs.eurRubRate', 'deal.totalQuantity',
       'unitEconomics.totalQuantity'].includes(fieldCode)) {
    const numeric = parseFlexibleNumber_(value);
    return Number.isFinite(numeric) ? String(roundTo_(numeric, 6)) : '';
  }
  if (fieldCode === 'deal.quoteCurrency') return aiNormalizeCurrency_(value);
  if (fieldCode === 'commercial.paymentSchedule' && typeof value === 'object') {
    const businessView = aiPaymentScheduleBusinessView_(value);
    return JSON.stringify({
      configuredCount: businessView.configuredCount,
      activeCount: businessView.activeCount,
      labels: businessView.businessRows.map(row => aiText_(row.label || row.text || '')
        .toLowerCase().replace(/\s+/g, ' ').trim()).filter(Boolean)
    });
  }
  if (fieldCode === 'expense.certification' && typeof value === 'object') {
    const amountRub = Number(value.amountRub || 0);
    const amountCny = Number(value.amountCny || 0);
    return JSON.stringify({
      status: (Math.abs(amountRub) > 0.000001 || Math.abs(amountCny) > 0.000001) ? 'INCLUDED' : 'ZERO',
      amountRub,
      amountCny
    });
  }
  if (typeof value === 'object') return JSON.stringify(value);
  return aiText_(value).toLowerCase().replace(/\s+/g, ' ');
}

function aiRoleAuthority_(role, fieldCode) {
  const code = aiText_(role).toUpperCase();
  if (code === 'MANAGER_CONFIRMATION') return 100;
  if (code === 'STRUCTURED_CARD') return 95;
  if (code === 'GLOBAL_APPROVED_RULE') return 92;
  if (code === 'VERIFIED_SNAPSHOT' || code === 'VERIFIED_CHECK') return 90;
  if (code === 'ORDER') return /^deal\.|^logistics\.|^item\./.test(fieldCode) ? 84 : 55;
  if (code === 'PARTNER_CALCULATION') return 82;
  if (code === 'INTERNAL_CALCULATOR') return 78;
  if (code === 'CLIENT_OUTPUT') return /^deal\.|^commercial\.|^logistics\./.test(fieldCode) ? 72 : 45;
  if (code === 'UNIT_ECONOMICS_OUTPUT') return 65;
  if (code === 'ACTIVE_TEMPLATE') return 55;
  if (code === 'TEMPLATE_GUIDANCE') return 20;
  if (code === 'GLOBAL_DEFAULT') return 10;
  return 40;
}

function classifyAiSheetRole_(fileName, sheetName, records) {
  const name = `${aiText_(fileName)} ${aiText_(sheetName)}`.toLowerCase();
  const values = (records || []).map(record => aiCellValue_(record)).filter(Boolean);
  const formulas = (records || []).map(record => aiCellFormula_(record)).filter(Boolean);
  const blob = `${name}\n${values.join('\n')}\n${formulas.join('\n')}`.toLowerCase();
  const reasons = [];
  let role = 'UNKNOWN';
  let confidence = 0.35;

  if (/инструкц.*импорт|эталон|шаблон/.test(name) || /две схемы работы:/.test(blob)) {
    role = 'TEMPLATE_GUIDANCE'; confidence = 0.96; reasons.push('Обнаружены маркеры инструкции/шаблона.');
  }
  if (/юнит[- ]?эконом/.test(name)) {
    role = 'UNIT_ECONOMICS_OUTPUT'; confidence = 0.98; reasons.push('Название листа указывает на юнит-экономику.');
  }
  if (/коммерческ(?:ое|ий) предлож/.test(blob) ||
      (/сделка\s*№/.test(blob) && /график платеж|готовы начать|итого по сделке/.test(blob))) {
    role = 'CLIENT_OUTPUT'; confidence = 0.98; reasons.push('Обнаружены маркеры клиентского КП.');
  }
  if (/расч\.лист/.test(name) || /расходы на доставку и таможенное оформление/.test(blob) ||
      /итого за то \(импорт\)/.test(blob)) {
    role = 'PARTNER_CALCULATION'; confidence = 0.97; reasons.push('Обнаружены маркеры расчёта партнёра.');
  }
  if (/калькулятор/.test(name) ||
      (/блок 1/.test(blob) && /настройка банков|комиссия компании/.test(blob))) {
    role = 'INTERNAL_CALCULATOR'; confidence = 0.97; reasons.push('Обнаружены маркеры внутреннего калькулятора.');
  }
  if (/заказ/.test(name) ||
      (/город назначения/.test(blob) && /желаемый способ доставки/.test(blob))) {
    role = 'ORDER'; confidence = 0.96; reasons.push('Обнаружены маркеры заказа/анкеты товара.');
  }

  // DEV-016.17: роль конкретного листа юнит-экономики имеет приоритет
  // над ролью файла «внутренний калькулятор». Иначе товарная таблица
  // исключалась из резервного извлечения позиций.
  if (/юнит[- ]?эконом/.test(aiText_(sheetName).toLowerCase())) {
    role = 'UNIT_ECONOMICS_OUTPUT';
    confidence = 0.99;
    reasons.push('Конкретный лист является юнит-экономикой товара(ов).');
  }

  return {role, confidence, reasons};
}

function buildAiSourceCatalog_(sourceTraceability, importedRecords) {
  const filesByKey = new Map();
  const sheetRoleByKey = new Map();

  const upsertFile = source => {
    const key = aiFileKey_(source && source.fileId, source && source.fileName);
    if (!key) return null;
    if (!filesByKey.has(key)) {
      filesByKey.set(key, {
        fileKey: key,
        fileId: aiText_(source && source.fileId),
        fileName: aiText_(source && source.fileName),
        fileUrl: aiText_(source && source.fileUrl),
        mimeType: aiText_(source && source.mimeType),
        importId: aiText_(source && source.importId),
        importStatus: aiText_(source && source.importStatus),
        sheets: [],
        detectedRoles: [],
        primaryRole: 'UNKNOWN',
        confidence: 0.35,
        externalReferenceCount: 0
      });
    }
    const target = filesByKey.get(key);
    ['fileId', 'fileName', 'fileUrl', 'mimeType', 'importId', 'importStatus'].forEach(field => {
      if (!target[field] && source && source[field]) target[field] = aiText_(source[field]);
    });
    return target;
  };

  ((sourceTraceability && sourceTraceability.files) || []).forEach(upsertFile);
  (importedRecords || []).forEach(record => upsertFile({
    fileId: record['ID исходного файла'],
    fileName: record['Исходный файл'],
    importId: record['import_id']
  }));

  const recordsBySheet = new Map();
  (importedRecords || []).forEach(record => {
    const fileKey = aiSourceKeyFromRecord_(record);
    const sheetName = aiText_(record['Лист']);
    if (!fileKey || !sheetName) return;
    const key = aiSheetKey_(fileKey, sheetName);
    if (!recordsBySheet.has(key)) recordsBySheet.set(key, []);
    recordsBySheet.get(key).push(record);
  });

  recordsBySheet.forEach((records, key) => {
    const delimiter = key.indexOf('|');
    const fileKey = key.slice(0, delimiter);
    const sheetName = key.slice(delimiter + 1);
    const file = filesByKey.get(fileKey) || upsertFile({fileId: fileKey});
    const classification = classifyAiSheetRole_(file ? file.fileName : '', sheetName, records);
    const formulaCount = records.filter(record => aiCellFormula_(record)).length;
    const externalReferenceCount = records.filter(record => /\[[^\]]+\]/.test(aiCellFormula_(record))).length;
    const sheetInfo = {
      sheetName,
      role: classification.role,
      confidence: classification.confidence,
      reasons: classification.reasons,
      cellCount: records.length,
      formulaCount,
      externalReferenceCount
    };
    if (file) {
      file.sheets.push(sheetInfo);
      file.externalReferenceCount += externalReferenceCount;
      if (!file.detectedRoles.includes(classification.role)) file.detectedRoles.push(classification.role);
      if (classification.confidence > file.confidence) {
        file.primaryRole = classification.role;
        file.confidence = classification.confidence;
      }
    }
    sheetRoleByKey.set(key, classification.role);
  });

  const fileRolePriority = {
    INTERNAL_CALCULATOR: 100,
    CLIENT_OUTPUT: 90,
    PARTNER_CALCULATION: 85,
    ORDER: 82,
    UNIT_ECONOMICS_OUTPUT: 70,
    TEMPLATE_GUIDANCE: 20,
    UNKNOWN: 0
  };
  filesByKey.forEach(file => {
    const roles = (file.detectedRoles || []).slice().sort((a, b) =>
      (fileRolePriority[b] || 0) - (fileRolePriority[a] || 0)
    );
    file.primaryRole = roles[0] || 'UNKNOWN';
    const matchingSheets = (file.sheets || []).filter(sheet => sheet.role === file.primaryRole);
    file.confidence = matchingSheets.length
      ? Math.max.apply(null, matchingSheets.map(sheet => Number(sheet.confidence || 0.35)))
      : Number(file.confidence || 0.35);
  });

  const files = [...filesByKey.values()].map(file => ({
    fileId: file.fileId,
    fileName: file.fileName,
    fileUrl: file.fileUrl,
    mimeType: file.mimeType,
    importId: file.importId,
    importStatus: file.importStatus,
    primaryRole: file.primaryRole,
    detectedRoles: file.detectedRoles,
    confidence: roundTo_(file.confidence, 3),
    sheets: file.sheets,
    externalReferenceCount: file.externalReferenceCount
  }));

  return {files, sheetRoleByKey};
}

function aiEvidenceIndex_() {
  return new Map();
}

function addAiEvidence_(index, fieldCode, value, config) {
  if (!fieldCode || value == null || aiIsInvalidEvidenceValue_(fieldCode, value)) return;
  const entry = Object.assign({
    fieldCode,
    value,
    normalizedValue: aiCanonicalValue_(fieldCode, value),
    sourceRole: 'UNKNOWN',
    sourceFileId: '',
    sourceFileName: '',
    sourceUrl: '',
    sourceSheet: '',
    sourceCells: '',
    formula: '',
    confidence: 0.5,
    confirmed: false,
    evidenceType: 'SOURCE_VALUE',
    note: ''
  }, config || {});
  if (!entry.normalizedValue) return;
  entry.authorityRank = aiRoleAuthority_(entry.sourceRole, fieldCode);
  if (!index.has(fieldCode)) index.set(fieldCode, []);
  const signature = JSON.stringify([
    entry.normalizedValue, entry.sourceRole, entry.sourceFileId || entry.sourceFileName,
    entry.sourceSheet, entry.sourceCells
  ]);
  const list = index.get(fieldCode);
  if (!list.some(item => item._signature === signature)) {
    entry._signature = signature;
    list.push(entry);
  }
}

function aiPublicEvidence_(evidence) {
  return {
    value: evidence.value,
    normalizedValue: evidence.normalizedValue,
    sourceRole: evidence.sourceRole,
    sourceFileId: evidence.sourceFileId,
    sourceFileName: evidence.sourceFileName,
    sourceUrl: evidence.sourceUrl,
    sourceSheet: evidence.sourceSheet,
    sourceCells: evidence.sourceCells,
    formula: evidence.formula,
    confidence: evidence.confidence,
    confirmed: Boolean(evidence.confirmed),
    evidenceType: evidence.evidenceType,
    note: evidence.note || ''
  };
}

function buildAiSheetGrid_(records) {
  const grid = new Map();
  (records || []).forEach(record => {
    const pos = aiRecordPosition_(record);
    if (!pos.row || !pos.col) return;
    grid.set(`${pos.row}|${pos.col}`, record);
  });
  return grid;
}

function aiLooksLikeAdjacentFieldLabel_(value) {
  const text = aiText_(value).toLowerCase().replace(/\s+/g, ' ').trim();
  if (!text) return false;
  return /^(?:товар|менеджер|артикул|клиент\s*\/\s*компания|пункт погран\.?\s*перехода?|тип груз\.?\s*средства|инкотермс|маршрут(?: \(внутри китая\))?|срок доставки|срок производства|код тн\s*вэд|наименование|количество,?\s*шт\.?|объ[её]м,?\s*м[³3]|вес,?\s*кг|курс\s*[¥$]|размер пошлины|цвет\s*\/\s*размер)$/i.test(text);
}

function findAiAdjacentValueRecord_(labelRecord, grid) {
  const pos = aiRecordPosition_(labelRecord);
  const positions = [
    [pos.row, pos.col + 1],
    [pos.row + 1, pos.col],
    [pos.row + 1, pos.col + 1],
    [pos.row, pos.col + 2],
    [pos.row, pos.col + 3],
    [pos.row, pos.col + 4],
    [pos.row, pos.col - 1]
  ];
  for (const pair of positions) {
    const record = grid.get(`${pair[0]}|${pair[1]}`);
    const value = aiCellValue_(record);
    if (record && !aiIsPlaceholder_(value) && !aiIsSpreadsheetErrorValue_(value) && !aiLooksLikeAdjacentFieldLabel_(value)) {
      return record;
    }
  }
  return null;
}

function findAiDirectValueRecord_(labelRecord, grid, options) {
  const pos = aiRecordPosition_(labelRecord);
  const cfg = options || {};
  const positions = [];
  if (cfg.right !== false) positions.push([pos.row, pos.col + 1]);
  if (cfg.below) positions.push([pos.row + 1, pos.col]);
  if (cfg.right2) positions.push([pos.row, pos.col + 2]);
  for (const pair of positions) {
    const record = grid.get(`${pair[0]}|${pair[1]}`);
    const value = aiCellValue_(record);
    if (record && !aiIsPlaceholder_(value) && !aiIsSpreadsheetErrorValue_(value) && !aiLooksLikeAdjacentFieldLabel_(value)) return record;
  }
  return null;
}

function aiPercentValueFromRecord_(record) {
  if (!record) return NaN;
  const display = aiText_(record['Отображаемое значение']);
  const raw = parseFlexibleNumber_(record['Исходное значение']);
  const numberFormat = aiText_(record['Формат числа']);
  if (/%/.test(display)) {
    const displayed = parseFlexibleNumber_(display);
    if (!Number.isFinite(displayed)) return NaN;
    // parseFlexibleNumber_ normalizes visible "7%" to 0.07. The manager package
    // stores commission rates in percentage points, therefore return 7, not 0.07.
    return Math.abs(displayed) <= 1 ? displayed * 100 : displayed;
  }
  if (/%/.test(numberFormat) && Number.isFinite(raw)) return raw * 100;
  return Number.isFinite(raw) ? raw : parseFlexibleNumber_(aiCellValue_(record));
}

function aiIsYesNoValue_(value) {
  return /^(?:да|нет|yes|no|true|false|1|0)$/i.test(aiText_(value));
}

function aiFieldStateValueText_(state, formatter) {
  if (!state) return 'не найден';
  const format = formatter || (value => aiText_(value));
  if (state.state === 'CONFLICT') {
    const values = aiStateCandidateLabels_(state, format).map(item => item.value).filter(Boolean);
    return values.length ? `конфликт: ${values.join(' / ')}` : 'конфликт значений';
  }
  if (state.selectedValue !== '' && state.selectedValue != null) return format(state.selectedValue) || 'не найден';
  const values = aiStateCandidateLabels_(state, format).map(item => item.value).filter(Boolean);
  return values.length ? values.join(' / ') : 'не найден';
}

function findAiManagerValueRecord_(labelRecord, grid) {
  const pos = aiRecordPosition_(labelRecord);
  const positions = [
    [pos.row, pos.col + 1],
    [pos.row + 1, pos.col + 1],
    [pos.row + 1, pos.col],
    [pos.row + 2, pos.col + 1],
    [pos.row + 2, pos.col]
  ];
  for (const pair of positions) {
    const record = grid.get(`${pair[0]}|${pair[1]}`);
    if (record && aiLooksLikePersonName_(aiCellValue_(record))) return record;
  }
  return null;
}

function aiEvidenceConfigFromRecord_(record, sourceCatalog, sourceRoleOverride) {
  const fileKey = aiSourceKeyFromRecord_(record);
  const sheetName = aiText_(record && record['Лист']);
  const sourceRole = sourceRoleOverride ||
    (sourceCatalog && sourceCatalog.sheetRoleByKey.get(aiSheetKey_(fileKey, sheetName))) || 'UNKNOWN';
  const sourceFile = sourceCatalog && sourceCatalog.files.find(file =>
    aiFileKey_(file.fileId, file.fileName) === fileKey
  );
  const cachedFallback = Boolean(record && record['_aiCachedFallback']);
  return {
    sourceRole,
    sourceFileId: aiText_(record && record['ID исходного файла']),
    sourceFileName: aiText_(record && record['Исходный файл']),
    sourceUrl: sourceFile ? sourceFile.fileUrl : '',
    sourceSheet: sheetName,
    sourceCells: aiText_(record && record['Ячейка']),
    formula: aiCellFormula_(record),
    confidence: cachedFallback ? 0.92 : (sourceCatalog && sourceCatalog.sheetRoleByKey.has(aiSheetKey_(fileKey, sheetName)) ? 0.9 : 0.6),
    confirmed: false,
    evidenceType: cachedFallback ? 'SOURCE_XLSX_CACHED_VALUE' : (aiCellFormula_(record) ? 'SOURCE_FORMULA_VALUE' : 'SOURCE_VALUE'),
    note: cachedFallback ? 'Значение восстановлено из кэша исходного XLSX; внешняя формула после конвертации дала ошибку.' : ''
  };
}

function aiNumericRecordsInRow_(records, rowNumber) {
  return (records || []).filter(record => aiRecordPosition_(record).row === rowNumber)
    .map(record => ({record, value: parseFlexibleNumber_(aiCellValue_(record))}))
    .filter(item => Number.isFinite(item.value));
}

function aiInferCurrencyForRecord_(record, records) {
  const direct = aiNormalizeCurrency_(record && (record['Определённая валюта'] || record['Формат числа']));
  if (['RUB', 'CNY', 'USD', 'EUR'].includes(direct)) return direct;
  const pos = aiRecordPosition_(record);
  const candidates = (records || []).filter(other => {
    const otherPos = aiRecordPosition_(other);
    return otherPos.col === pos.col && otherPos.row < pos.row && otherPos.row >= pos.row - 15;
  }).sort((a, b) => aiRecordPosition_(b).row - aiRecordPosition_(a).row);
  for (const candidate of candidates) {
    const text = aiCellValue_(candidate);
    const currency = aiNormalizeCurrency_(text);
    if (['RUB', 'CNY', 'USD', 'EUR'].includes(currency)) return currency;
  }
  const sameRow = (records || []).filter(other => aiRecordPosition_(other).row === pos.row);
  for (const other of sameRow) {
    const currency = aiNormalizeCurrency_(aiCellValue_(other));
    if (['RUB', 'CNY', 'USD', 'EUR'].includes(currency)) return currency;
  }
  return '';
}


function addStructuredCurrentDealProductionEvidence_(index, importedRecords, sourceCatalog) {
  const groups = new Map();
  (importedRecords || []).forEach(record => {
    const fileKey = aiSourceKeyFromRecord_(record);
    const sheetName = aiText_(record && record['Лист']);
    const key = aiSheetKey_(fileKey, sheetName);
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(record);
  });

  groups.forEach(records => {
    const byRow = new Map();
    records.forEach(record => {
      const rowNumber = aiRecordPosition_(record).row;
      if (!rowNumber) return;
      if (!byRow.has(rowNumber)) byRow.set(rowNumber, []);
      byRow.get(rowNumber).push(record);
    });
    const rowNumbers = [...byRow.keys()].sort((a, b) => a - b);
    let header = null;
    for (const rowNumber of rowNumbers) {
      const fields = {};
      (byRow.get(rowNumber) || []).forEach(record => {
        const field = structuredItemHeaderField_(aiCellValue_(record));
        if (field && !fields[field]) fields[field] = aiRecordPosition_(record).col;
      });
      const required = ['name', 'quantity', 'article', 'invoiceAmount', 'productionDays'];
      if (required.every(field => fields[field])) {
        header = {rowNumber, fields};
        break;
      }
    }
    if (!header) return;

    const recordAt = (rowRecords, field) => {
      const col = header.fields[field];
      return (rowRecords || []).find(record => aiRecordPosition_(record).col === col) || null;
    };
    let activeOrdinal = 0;
    rowNumbers.filter(rowNumber => rowNumber > header.rowNumber).forEach(rowNumber => {
      const rowRecords = byRow.get(rowNumber) || [];
      const nameRecord = recordAt(rowRecords, 'name');
      const quantityRecord = recordAt(rowRecords, 'quantity');
      const invoiceRecord = recordAt(rowRecords, 'invoiceAmount');
      const productionRecord = recordAt(rowRecords, 'productionDays');
      const itemNumberRecord = recordAt(rowRecords, 'itemNumber');
      const name = aiText_(aiCellValue_(nameRecord));
      const quantity = parseFlexibleNumber_(aiCellValue_(quantityRecord));
      const invoiceAmount = parseFlexibleNumber_(aiCellValue_(invoiceRecord));
      const productionDays = parseFlexibleNumber_(aiCellValue_(productionRecord));
      if (!name || !(quantity > 0) || !(invoiceAmount > 0) || !(productionDays > 0)) return;
      activeOrdinal += 1;
      const sourceItemNumber = parseFlexibleNumber_(aiCellValue_(itemNumberRecord));
      const itemIdentity = sourceItemNumber > 0 ? Math.round(sourceItemNumber) : activeOrdinal;
      const cfg = aiEvidenceConfigFromRecord_(productionRecord, sourceCatalog);
      addAiEvidence_(index, 'logistics.productionDays', productionDays, Object.assign({}, cfg, {
        evidenceType: 'STRUCTURED_ITEM_SOURCE_VALUE',
        note: `DEV-016.53 STRUCTURED_ITEM_PRODUCTION item=${itemIdentity}; active source row ${rowNumber}; quantity=${quantity}; invoice=${invoiceAmount}`
      }));
    });
  });
}

function extractAiFieldEvidence_(model, sourceCatalog, importedRecords, latestSnapshot) {
  const index = aiEvidenceIndex_();
  const deal = model.dealRecord || {};
  const settings = model.settings || new Map();

  const addCard = (fieldCode, value, note) => addAiEvidence_(index, fieldCode, value, {
    sourceRole: 'STRUCTURED_CARD', sourceSheet: BBC_MVP.sheets.deals,
    sourceCells: String(model.dealRowNumber || ''), confidence: 0.98,
    confirmed: true, evidenceType: 'STRUCTURED_VALUE', note: note || ''
  });

  const manager = cleanManagerValue_(deal['Менеджер']);
  if (manager) addCard('deal.manager', manager);
  if (!aiIsPlaceholder_(deal['Клиент'])) addCard('deal.client', deal['Клиент']);
  if (!aiIsPlaceholder_(deal['Валюта клиентского КП'])) addCard('deal.quoteCurrency', deal['Валюта клиентского КП']);
  const cardValidity = parseFlexibleNumber_(deal['Срок действия КП']);
  if (cardValidity > 0) addCard('deal.validityDays', cardValidity);

  const cardScheme = aiNormalizeScheme_(deal['Схема работы'] || deal['Схема поставки']);
  if (cardScheme) addCard('deal.scheme', cardScheme);
  const rawCardRoute = !aiIsPlaceholder_(deal['Маршрут внутри Китая'])
    ? deal['Маршрут внутри Китая']
    : (!aiIsPlaceholder_(deal['Маршрут']) ? deal['Маршрут'] : '');
  const splitCardRoute = aiSplitChinaRouteAndBorder_(rawCardRoute);
  if (splitCardRoute.route) addCard('logistics.chinaRoute', splitCardRoute.route);
  if (!aiIsPlaceholder_(deal['Инкотермс'])) addCard('logistics.incoterms', deal['Инкотермс']);
  if (!aiIsPlaceholder_(deal['Погранпереход'])) addCard('logistics.borderCrossing', deal['Погранпереход']);
  else if (splitCardRoute.borderCrossing) addCard('logistics.borderCrossing', splitCardRoute.borderCrossing, 'Извлечено из составного поля маршрута.');
  if (!aiIsPlaceholder_(deal['Город назначения'])) addCard('logistics.destinationCity', deal['Город назначения']);
  if (!aiIsPlaceholder_(deal['Тип транспорта'])) addCard('logistics.transportMode', deal['Тип транспорта']);
  const rawDeliveryDays = deal['Срок доставки, дней'] || deal['Срок доставки'];
  const normalizedDeliveryDays = aiCanonicalValue_('logistics.deliveryDays', rawDeliveryDays);
  if (normalizedDeliveryDays) addCard('logistics.deliveryDays', rawDeliveryDays);
  const rawCardProduction = deal['Срок производства, дней'] || deal['Срок производства'];
  const normalizedProductionDays = aiCanonicalValue_('logistics.productionDays', rawCardProduction);
  if (normalizedProductionDays) addCard('logistics.productionDays', rawCardProduction);
  else if (/^(?:NOT_APPLICABLE|N\/A|не\s+применяется|не\s+включается)$/i.test(aiText_(rawCardProduction))) {
    addCard('logistics.productionDays', 'NOT_APPLICABLE', 'Менеджер подтвердил, что срок производства не включается в КП.');
  }
  const cardPaymentText = aiText_(deal['График платежей']);
  if (!aiIsPlaceholder_(deal['Условия оплаты'])) addCard('commercial.paymentTerms', deal['Условия оплаты']);
  else if (cardPaymentText) addCard('commercial.paymentTerms', cardPaymentText, 'Подтверждённая построчная разбивка оплаты по товарам.');
  if (cardPaymentText) addCard('commercial.paymentSchedule', {
    count: 0, rows: [], text: cardPaymentText, confirmedText: true
  });

  const defaultValidity = parseFlexibleNumber_(settings.get('DEFAULT_QUOTE_VALIDITY_DAYS')) || 7;
  addAiEvidence_(index, 'deal.validityDays', defaultValidity, {
    sourceRole: 'GLOBAL_DEFAULT', sourceFileName: 'Настройки BBC', sourceSheet: BBC_MVP.sheets.settings,
    confidence: 0.5, confirmed: false, evidenceType: 'DEFAULT_VALUE', note: 'Значение по умолчанию, не подтверждение сделки.'
  });
  addAiEvidence_(index, 'deal.scheme', 'CLIENT_IMPORTER_BBC_EXPORTER', {
    sourceRole: 'ACTIVE_TEMPLATE', sourceFileName: 'Действующий мастер-шаблон КП',
    confidence: 0.85, confirmed: false, evidenceType: 'ACTIVE_TEMPLATE_VALUE',
    note: 'Схема, которую выведет действующий шаблон при отсутствии подтверждённого выбора.'
  });

  if (model.commissionInput) {
    addAiEvidence_(index, 'commission.percent', model.commissionInput.value, {
      sourceRole: 'GLOBAL_APPROVED_RULE', sourceFileName: 'Правило комиссии BBC',
      sourceSheet: BBC_MVP.sheets.settings, confidence: 0.98, confirmed: true,
      evidenceType: 'APPROVED_RULE', note: `База: ${model.commissionInput.base || ''}; минимум: ${model.commissionInput.minimumCny || ''} CNY.`
    });
  }

  if (latestSnapshot) {
    addAiEvidence_(index, 'calculation.latestTotalRub', latestSnapshot.totalRub, {
      sourceRole: 'VERIFIED_SNAPSHOT', sourceFileName: 'Последний проверенный снимок расчёта',
      sourceSheet: BBC_MVP.sheets.calculationSnapshots, sourceCells: latestSnapshot.snapshotId,
      confidence: 1, confirmed: true, evidenceType: 'VERIFIED_CALCULATION'
    });
  }

  (model.normalizedExpenses || []).forEach(expense => {
    if (/сертифик|деклараци.*соответств/i.test(aiText_(expense.name))) {
      const amountRub = Number(expense.amountRub || (expense.currency === 'RUB' ? expense.amount : 0) || 0);
      const amountCny = Number(expense.amountCny || (expense.currency === 'CNY' ? expense.amount : 0) || 0);
      const status = expense.valueStatus === 'CONFIRMED_ZERO' || (expense.amount === 0 && expense.valueStatus !== 'UNKNOWN')
        ? 'CONFIRMED_ZERO'
        : (expense.valueStatus === 'UNKNOWN' ? 'UNKNOWN' : 'INCLUDED');
      addAiEvidence_(index, 'expense.certification', {status, amountRub, amountCny}, {
        sourceRole: 'STRUCTURED_CARD', sourceFileName: expense.source.file,
        sourceSheet: BBC_MVP.sheets.expenses, sourceCells: expense.expenseId,
        confidence: 0.95, confirmed: status !== 'UNKNOWN', evidenceType: 'STRUCTURED_EXPENSE'
      });
    }
  });

  const groups = new Map();
  (importedRecords || []).forEach(record => {
    const key = aiSheetKey_(aiSourceKeyFromRecord_(record), record['Лист']);
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(record);
  });

  groups.forEach(records => {
    const grid = buildAiSheetGrid_(records);
    const role = sourceCatalog.sheetRoleByKey.get(aiSheetKey_(aiSourceKeyFromRecord_(records[0]), records[0]['Лист'])) || 'UNKNOWN';
    const rowMap = new Map();
    records.forEach(record => {
      const pos = aiRecordPosition_(record);
      if (!rowMap.has(pos.row)) rowMap.set(pos.row, []);
      rowMap.get(pos.row).push(record);
    });

    records.forEach(record => {
      const text = aiCellValue_(record);
      if (!text) return;
      const lower = text.toLowerCase();
      const cfg = aiEvidenceConfigFromRecord_(record, sourceCatalog, role);
      const adjacent = findAiAdjacentValueRecord_(record, grid);
      const adjacentValue = aiCellValue_(adjacent);
      const adjacentCfg = adjacent ? aiEvidenceConfigFromRecord_(adjacent, sourceCatalog, role) : cfg;
      const directRight = findAiDirectValueRecord_(record, grid, {right: true});
      const directRightValue = aiCellValue_(directRight);
      const directRightCfg = directRight ? aiEvidenceConfigFromRecord_(directRight, sourceCatalog, role) : cfg;

      const validityMatch = text.match(/срок\s+действия\s+кп\s*:?[\s\S]{0,20}?(\d{1,3})\s*(?:дн|дней|дня)?/i);
      if (validityMatch) addAiEvidence_(index, 'deal.validityDays', Number(validityMatch[1]), cfg);

      const scheme = aiNormalizeScheme_(text);
      if (scheme && /схем|импорт|экспорт|под ключ/i.test(text)) {
        if (aiIsStaticSchemeTemplateLabel_(record, records, text)) {
          addAiEvidence_(index, 'deal.scheme', scheme, Object.assign({}, cfg, {
            sourceRole: 'ACTIVE_TEMPLATE',
            confidence: Math.min(Number(cfg.confidence || 0.75), 0.75),
            confirmed: false,
            evidenceType: 'STATIC_TEMPLATE_LABEL',
            note: 'Статическая строка оформления КП исключена из фактов сделки: на том же листе найдена более конкретная строка сделки со схемой.'
          }));
        } else {
          addAiEvidence_(index, 'deal.scheme', scheme, cfg);
        }
      }

      const managerCta = text.match(/(?:напишите\s+)?менеджер(?:у|ом)?\s+([А-ЯЁ][а-яё]{2,})/);
      if (managerCta) addAiEvidence_(index, 'deal.manager', managerCta[1], cfg);

      if (/^(?:менеджер|менеджер сделки|фио)$/i.test(text)) {
        const managerRecord = findAiManagerValueRecord_(record, grid);
        if (managerRecord) {
          addAiEvidence_(index, 'deal.manager', aiCellValue_(managerRecord),
            aiEvidenceConfigFromRecord_(managerRecord, sourceCatalog, role));
        }
      }
      // DEV-016.55: client is a same-row scalar. A blank client value must stay blank;
      // the next form label (for example «Страна отправления») is not client evidence.
      if (/клиент\s*\/?\s*компания|^клиент$|^компания клиента$/i.test(text) && !aiIsPlaceholder_(directRightValue)) {
        addAiEvidence_(index, 'deal.client', directRightValue, directRightCfg);
      }
      if (/^срок действия кп$/i.test(text) && !aiIsPlaceholder_(adjacentValue)) {
        const value = parseFlexibleNumber_(adjacentValue);
        if (value > 0) addAiEvidence_(index, 'deal.validityDays', value, adjacentCfg);
      }
      if (/^инкотермс|incoterms/i.test(text) && !aiIsPlaceholder_(adjacentValue)) {
        // DEV-016.55: only a real Incoterms token is admissible. Contract numbers,
        // dates and neighbouring service values cannot become logistics evidence.
        const normalizedIncoterm = aiCanonicalValue_('logistics.incoterms', adjacentValue);
        if (normalizedIncoterm) {
          addAiEvidence_(index, 'logistics.incoterms', adjacentValue, adjacentCfg);
        }
      }
      if (/маршрут\s*\((?:внутри\s+)?кита[яй]\)|маршрут внутри китая/i.test(text) && !aiIsPlaceholder_(adjacentValue)) {
        addAiEvidence_(index, 'logistics.chinaRoute', adjacentValue, adjacentCfg);
      }
      if (/маршрут перевозки/i.test(text) && !aiIsPlaceholder_(adjacentValue)) {
        const routeParts = aiText_(adjacentValue).split(/\s*(?:→|->|—|–|-)\s*/).filter(Boolean);
        if (routeParts.length > 1) {
          addAiEvidence_(index, 'logistics.destinationCity', routeParts[routeParts.length - 1],
            Object.assign({}, adjacentCfg, {note: 'Город назначения извлечён из полного маршрута перевозки.'}));
        }
      }
      if (/погран\.?\s*переход|погранпереход/i.test(text) && !aiIsPlaceholder_(adjacentValue)) {
        addAiEvidence_(index, 'logistics.borderCrossing', adjacentValue, adjacentCfg);
      }
      if (/город назначения/i.test(text) && !aiIsPlaceholder_(adjacentValue)) {
        addAiEvidence_(index, 'logistics.destinationCity', adjacentValue, adjacentCfg);
      }
      if (/груз(?:ового|\.)?\s*средств|желаемый способ доставки|вид транспорта|тип транспорта/i.test(text) && !aiIsPlaceholder_(adjacentValue)) {
        addAiEvidence_(index, 'logistics.transportMode', aiNormalizeTransport_(adjacentValue), adjacentCfg);
      }
      if (/срок.*достав/i.test(text)) {
        const inline = text.match(/срок.*достав[^\d]{0,20}(\d{1,3})/i);
        const value = inline ? Number(inline[1]) : parseFlexibleNumber_(directRightValue);
        if (value > 0) addAiEvidence_(index, 'logistics.deliveryDays', value, inline ? cfg : directRightCfg);
      }
      if (/срок.*производ/i.test(text)) {
        const inline = text.match(/срок.*производ[^\d]{0,20}(\d{1,3})/i);
        const value = inline ? Number(inline[1]) : parseFlexibleNumber_(directRightValue);
        if (value > 0) addAiEvidence_(index, 'logistics.productionDays', value, inline ? cfg : directRightCfg);
      }
      if (/условия оплаты|тип разбивки товара/i.test(text) && !aiIsPlaceholder_(directRightValue)) {
        addAiEvidence_(index, 'commercial.paymentTerms', directRightValue, directRightCfg);
      }
      if (/комиссия (?:компании|bbc).*%|комиссия bbc/i.test(text) && directRight) {
        const value = aiPercentValueFromRecord_(directRight);
        if (Number.isFinite(value)) addAiEvidence_(index, 'commission.percent', value, directRightCfg);
      }
      if (/vat возвращается|возврат vat/i.test(text) && directRight && aiIsYesNoValue_(directRightValue)) {
        addAiEvidence_(index, 'vat.returnStatus', directRightValue, directRightCfg);
      }
      if (/ставка vat/i.test(text) && directRight) {
        const value = aiPercentValueFromRecord_(directRight);
        if (Number.isFinite(value)) addAiEvidence_(index, 'vat.rate', value, directRightCfg);
      }
      if (/цена.*без vat/i.test(text) && directRight) {
        const value = parseFlexibleNumber_(directRightValue);
        if (Number.isFinite(value)) addAiEvidence_(index, 'vat.priceExVat', value, directRightCfg);
      }
      if (/курс eur|курс евро/i.test(text) && !aiIsPlaceholder_(adjacentValue)) {
        const value = parseFlexibleNumber_(adjacentValue);
        if (Number.isFinite(value)) addAiEvidence_(index, 'customs.eurRubRate', value, adjacentCfg);
      }
      if (/курс\s*(?:usd|\$)|расч[её]тный курс/i.test(text) && !aiIsPlaceholder_(adjacentValue)) {
        const value = parseFlexibleNumber_(adjacentValue);
        if (value > 0) addAiEvidence_(index, 'rates.usdRub', value, adjacentCfg);
      }
      if (/курс\s*(?:cny|rmb|¥|юан)/i.test(text) && !aiIsPlaceholder_(adjacentValue)) {
        const value = parseFlexibleNumber_(adjacentValue);
        if (value > 0) addAiEvidence_(index, 'rates.cnyRub', value, adjacentCfg);
      }
      if (/количество,?\s*шт|общее количество/i.test(text) && !aiIsPlaceholder_(adjacentValue)) {
        const value = parseFlexibleNumber_(adjacentValue);
        if (value > 0) addAiEvidence_(index, role === 'UNIT_ECONOMICS_OUTPUT' ? 'unitEconomics.totalQuantity' : 'deal.totalQuantity', value, adjacentCfg);
      }

      if (/сертифик|деклараци.*соответств/i.test(lower)) {
        if (role === 'TEMPLATE_GUIDANCE' || /инструкц/i.test(aiText_(record['Лист']))) return;
        const pos = aiRecordPosition_(record);
        const numerics = aiNumericRecordsInRow_(records, pos.row);
        const looksLikeExpenseLine = numerics.length > 0 ||
          /^(?:⭐\s*)?(?:декларация|сертификация)/i.test(text) ||
          /декларация соответствия\s*\+|расход/i.test(text);
        if (!looksLikeExpenseLine) return;
        let amountRub = 0;
        let amountCny = 0;
        numerics.forEach(item => {
          const currency = aiInferCurrencyForRecord_(item.record, records);
          if (currency === 'RUB') amountRub = Math.max(amountRub, Math.abs(item.value));
          if (currency === 'CNY') amountCny = Math.max(amountCny, Math.abs(item.value));
        });
        const maxValue = numerics.reduce((max, item) => Math.max(max, Math.abs(item.value)), 0);
        if (!amountRub && !amountCny && maxValue) amountRub = maxValue;
        addAiEvidence_(index, 'expense.certification', {
          status: (amountRub || amountCny) ? 'INCLUDED' : 'UNCONFIRMED_ZERO',
          amountRub, amountCny
        }, Object.assign({}, cfg, {sourceCells: `${cfg.sourceCells} row ${pos.row}`}));
      }

      if (/доставка до границы.*международ|доставка фошань.*забайк/i.test(lower)) {
        const pos = aiRecordPosition_(record);
        const numerics = aiNumericRecordsInRow_(records, pos.row);
        let amountUsd = 0;
        let amountRub = 0;
        let amountCny = 0;
        numerics.forEach(item => {
          const currency = aiInferCurrencyForRecord_(item.record, records);
          if (currency === 'USD') amountUsd = Math.max(amountUsd, Math.abs(item.value));
          if (currency === 'RUB') amountRub = Math.max(amountRub, Math.abs(item.value));
          if (currency === 'CNY') amountCny = Math.max(amountCny, Math.abs(item.value));
        });
        addAiEvidence_(index, 'logistics.internationalFreight', {amountUsd, amountRub, amountCny},
          Object.assign({}, cfg, {sourceCells: `${cfg.sourceCells} row ${pos.row}`}));
      }

      if (/^(?:таможенная\s+)?пошлин/i.test(text)) {
        const pos = aiRecordPosition_(record);
        const rowText = (rowMap.get(pos.row) || []).slice()
          .sort((a, b) => aiRecordPosition_(a).col - aiRecordPosition_(b).col)
          .map(aiCellValue_).filter(Boolean).join(' | ');
        if (/(?:%|евро|eur|usd|доллар|инвойс)/i.test(rowText)) {
          addAiEvidence_(index, 'customs.dutyMethod', rowText, cfg);
        }
      }
    });

    if (role === 'UNIT_ECONOMICS_OUTPUT') {
      let headerRow = 0;
      let quantityCol = 0;
      let nameCol = 0;
      records.forEach(record => {
        const text = aiCellValue_(record);
        const pos = aiRecordPosition_(record);
        if (/^кол-?во$|^количество$/i.test(text)) { headerRow = pos.row; quantityCol = pos.col; }
        if (/наименование.*товар/i.test(text)) nameCol = pos.col;
      });
      if (headerRow && quantityCol) {
        let total = 0;
        rowMap.forEach((rowRecords, rowNumber) => {
          if (rowNumber <= headerRow) return;
          const qtyRecord = rowRecords.find(record => aiRecordPosition_(record).col === quantityCol);
          const nameRecord = nameCol ? rowRecords.find(record => aiRecordPosition_(record).col === nameCol) : null;
          const quantity = parseFlexibleNumber_(aiCellValue_(qtyRecord));
          const name = aiCellValue_(nameRecord);
          if (quantity > 0 && (!nameCol || !aiIsPlaceholder_(name))) total += quantity;
        });
        if (total > 0) {
          addAiEvidence_(index, 'unitEconomics.totalQuantity', total,
            aiEvidenceConfigFromRecord_(records[0], sourceCatalog, role));
        }
      }
    }

    const paymentRows = [];
    let totalRub = 0;
    let totalCny = 0;
    let declaredCount = 0;
    rowMap.forEach((rowRecords, rowNumber) => {
      rowRecords.sort((a, b) => aiRecordPosition_(a).col - aiRecordPosition_(b).col);
      const rowText = rowRecords.map(aiCellValue_).filter(Boolean).join(' | ');
      const headerMatch = rowText.match(/график платежей\s*\((\d+)\s*плат/i);
      if (headerMatch) declaredCount = Number(headerMatch[1]);
      if (/^\s*\d+[-–]?(?:й|ый|я)?\s+плат[её]ж/i.test(rowText)) {
        let amountRub = 0;
        let amountCny = 0;
        aiNumericRecordsInRow_(records, rowNumber).forEach(item => {
          const currency = aiInferCurrencyForRecord_(item.record, records);
          if (currency === 'RUB') amountRub = Math.max(amountRub, Math.abs(item.value));
          if (currency === 'CNY') amountCny = Math.max(amountCny, Math.abs(item.value));
        });
        paymentRows.push({
          row: rowNumber,
          label: aiCellValue_(rowRecords[0]),
          text: rowText,
          amountRub,
          amountCny,
          isZero: !(amountRub > 0 || amountCny > 0)
        });
      }
      if (/итого по платежам/i.test(rowText)) {
        aiNumericRecordsInRow_(records, rowNumber).forEach(item => {
          const currency = aiInferCurrencyForRecord_(item.record, records);
          if (currency === 'RUB') totalRub = Math.max(totalRub, Math.abs(item.value));
          if (currency === 'CNY') totalCny = Math.max(totalCny, Math.abs(item.value));
        });
      }
    });
    if (paymentRows.length || declaredCount) {
      const sourceRecord = records[0];
      addAiEvidence_(index, 'commercial.paymentSchedule', {
        count: paymentRows.length || declaredCount,
        declaredCount,
        rows: paymentRows,
        totalRub,
        totalCny
      }, aiEvidenceConfigFromRecord_(sourceRecord, sourceCatalog, role));
    }
  });

  // DEV-016.53: main structured export tables keep item production days vertically
  // under one header. Recover only active rows (name + qty>0 + invoice>0) and
  // preserve item identity so 10/20 is a range, while 30..100 template rows stay out.
  addStructuredCurrentDealProductionEvidence_(index, importedRecords, sourceCatalog);

  return index;
}

function aiFieldRules_() {
  return {
    'deal.manager': {ruleId: 'DEAL-001', fieldName: 'Ответственный менеджер', blockingScope: 'FINAL_QUOTE', answerType: 'TEXT_OR_SINGLE_SELECT', writebackTarget: 'Сделки.Менеджер + ID/дата подтверждения', autoConfirmSingleCandidate: true},
    'deal.client': {ruleId: 'DEAL-002', fieldName: 'Клиент / компания', blockingScope: 'FINAL_QUOTE', answerType: 'TEXT_OR_SINGLE_SELECT', writebackTarget: 'Сделки.Клиент'},
    'deal.quoteCurrency': {ruleId: 'DEAL-003', fieldName: 'Валюта клиентского КП', blockingScope: 'CALCULATION_AND_FINAL_QUOTE', answerType: 'CURRENCY', writebackTarget: 'Сделки.Валюта клиентского КП'},
    'deal.validityDays': {ruleId: 'DEAL-004', fieldName: 'Срок действия КП', blockingScope: 'FINAL_QUOTE', answerType: 'NUMBER_DAYS', writebackTarget: 'Сделки.Срок действия КП', ignoreDefaultsForConflict: true},
    'deal.scheme': {ruleId: 'DEAL-005', fieldName: 'Схема работы и роли сторон', blockingScope: 'CALCULATION_AND_FINAL_QUOTE', answerType: 'SINGLE_SELECT_WITH_OTHER', writebackTarget: 'Сделки.Схема работы / роли сторон', autoConfirmSingleCandidate: true},
    'logistics.incoterms': {ruleId: 'LOG-001', fieldName: 'Инкотермс', blockingScope: 'CALCULATION', answerType: 'SINGLE_SELECT_WITH_OTHER', writebackTarget: 'Сделки.Инкотермс'},
    'logistics.chinaRoute': {ruleId: 'LOG-002', fieldName: 'Маршрут внутри Китая', blockingScope: 'CONDITIONAL_CALCULATION', answerType: 'TEXT', writebackTarget: 'Сделки.Маршрут внутри Китая'},
    'logistics.borderCrossing': {ruleId: 'LOG-003', fieldName: 'Погранпереход', blockingScope: 'CONDITIONAL_CALCULATION', answerType: 'TEXT', writebackTarget: 'Сделки.Погранпереход'},
    'logistics.destinationCity': {ruleId: 'LOG-004', fieldName: 'Город назначения', blockingScope: 'CONDITIONAL_CALCULATION', answerType: 'TEXT', writebackTarget: 'Сделки.Город назначения'},
    'logistics.transportMode': {ruleId: 'LOG-005', fieldName: 'Тип транспорта', blockingScope: 'CONDITIONAL_CALCULATION', answerType: 'SINGLE_SELECT_WITH_OTHER', writebackTarget: 'Сделки.Тип транспорта'},
    'logistics.deliveryDays': {ruleId: 'LOG-006', fieldName: 'Срок международной доставки', blockingScope: 'FINAL_QUOTE', answerType: 'NUMBER_DAYS_OR_POLICY', writebackTarget: 'Сделки.Срок доставки, дней'},
    'logistics.productionDays': {ruleId: 'LOG-007', fieldName: 'Срок производства', blockingScope: 'FINAL_QUOTE', answerType: 'NUMBER_DAYS_OR_NOT_APPLICABLE', writebackTarget: 'Сделки.Срок производства, дней'},
    'commercial.paymentTerms': {ruleId: 'PAY-001', fieldName: 'Условия оплаты', blockingScope: 'FINAL_QUOTE', answerType: 'TEXT', writebackTarget: 'Сделки.Условия оплаты'},
    'commercial.paymentSchedule': {ruleId: 'PAY-002', fieldName: 'График платежей', blockingScope: 'FINAL_QUOTE', answerType: 'PAYMENT_LIST', writebackTarget: 'Платежи (DEV-017) + статус графика в Сделки', autoConfirmSingleCandidate: true},
    'expense.certification': {ruleId: 'EXP-001', fieldName: 'Сертификация / декларация соответствия', blockingScope: 'CALCULATION_AND_FINAL_QUOTE', answerType: 'STATUS_PLUS_VALUE', writebackTarget: 'Расходы + решение менеджера + основание'},
    'commission.percent': {ruleId: 'COM-002', fieldName: 'Правило комиссии BBC по схеме', blockingScope: 'FINAL_QUOTE', answerType: 'STATUS_PLUS_VALUE', writebackTarget: 'Правила комиссии + исключение сделки', ownerDecisionPending: 'DEC-COM-001'},
    'vat.returnStatus': {ruleId: 'VAT-001', fieldName: 'Возврат VAT', blockingScope: 'CALCULATION_AND_FINAL_QUOTE', answerType: 'STATUS_PLUS_VALUE', writebackTarget: 'Товары: VAT + политика сделки'},
    'customs.dutyMethod': {ruleId: 'CUS-002', fieldName: 'Метод пошлины', blockingScope: 'CALCULATION', answerType: 'SINGLE_SELECT_WITH_OTHER', writebackTarget: 'Товары: duty method/rate/currency'}
  };
}

function aiFieldUsesPrimarySourcePriority_(fieldCode) {
  return /^(?:deal\.|logistics\.|commercial\.)/.test(aiText_(fieldCode));
}

function aiIsDerivedEvidenceRole_(role) {
  return ['CLIENT_OUTPUT', 'UNIT_ECONOMICS_OUTPUT', 'ACTIVE_TEMPLATE', 'TEMPLATE_GUIDANCE', 'GLOBAL_DEFAULT']
    .includes(aiText_(role).toUpperCase());
}

function aiApplyPrimarySourcePriority_(fieldCode, substantive) {
  const all = (substantive || []).filter(item => item && item.normalizedValue);
  if (!aiFieldUsesPrimarySourcePriority_(fieldCode) || all.length < 2) return all;

  const primary = all.filter(item => !aiIsDerivedEvidenceRole_(item.sourceRole));
  if (!primary.length) return all;

  const primaryValues = new Set(primary.map(item => item.normalizedValue));
  return all.filter(item => !aiIsDerivedEvidenceRole_(item.sourceRole) || primaryValues.has(item.normalizedValue));
}

function buildAiFieldState_(fieldCode, evidence, rule) {
  const all = (evidence || []).slice().sort((a, b) => b.authorityRank - a.authorityRank);
  const defaults = all.filter(item => item.sourceRole === 'GLOBAL_DEFAULT');
  const templateGuidance = all.filter(item => item.sourceRole === 'ACTIVE_TEMPLATE');
  const substantive = all.filter(item => !['GLOBAL_DEFAULT', 'ACTIVE_TEMPLATE'].includes(item.sourceRole));
  // DEV-016.40: подтверждённая карточка сделки/ответ менеджера имеет приоритет
  // над неподтверждёнными извлечениями из первичных и производных файлов.
  // Конфликт сохраняется только между источниками сопоставимого верхнего приоритета.
  const cardAuthorityFields = new Set([
    'deal.manager', 'deal.client', 'deal.scheme', 'deal.validityDays', 'deal.quoteCurrency',
    'logistics.incoterms', 'logistics.chinaRoute', 'logistics.borderCrossing',
    'logistics.destinationCity', 'logistics.transportMode', 'logistics.deliveryDays',
    'logistics.productionDays', 'commercial.paymentTerms', 'commercial.paymentSchedule'
  ]);
  const authoritative = cardAuthorityFields.has(fieldCode)
    ? substantive.find(item => item.confirmed && Number(item.authorityRank || 0) >= 95 && item.normalizedValue)
    : null;
  const considered = authoritative
    ? substantive.filter(item =>
        item.normalizedValue === authoritative.normalizedValue ||
        Number(item.authorityRank || 0) >= Number(authoritative.authorityRank || 0)
      )
    : aiApplyPrimarySourcePriority_(fieldCode, substantive);
  const candidatesByValue = new Map();
  considered.forEach(item => {
    const key = item.normalizedValue;
    if (!candidatesByValue.has(key)) candidatesByValue.set(key, []);
    candidatesByValue.get(key).push(item);
  });

  let state = 'MISSING';
  let selectedValue = '';
  let reason = 'Достоверное значение не найдено.';
  if (candidatesByValue.size > 1) {
    state = 'CONFLICT';
    reason = 'В источниках найдены разные применимые значения.';
  } else if (candidatesByValue.size === 1) {
    const only = [...candidatesByValue.values()][0];
    const best = only[0];
    selectedValue = best.value;
    const numeric = typeof best.value === 'number' ? best.value : parseFlexibleNumber_(best.value);
    const certificationZero = fieldCode === 'expense.certification' && best.value && typeof best.value === 'object' &&
      !(Math.abs(Number(best.value.amountRub || 0)) > 0.000001 || Math.abs(Number(best.value.amountCny || 0)) > 0.000001);
    const anyConfirmed = only.some(item => item.confirmed);
    if (certificationZero && anyConfirmed) state = 'CONFIRMED_ZERO';
    else if (certificationZero) state = 'UNCONFIRMED_ZERO';
    else if (numeric === 0 && !best.confirmed) state = 'UNCONFIRMED_ZERO';
    else if (numeric === 0 && best.confirmed) state = 'CONFIRMED_ZERO';
    else if (best.confirmed) state = 'CONFIRMED';
    else if (rule && rule.autoConfirmSingleCandidate) state = 'CONFIRMED_BY_SOURCE';
    else if (rule && rule.requiresConfirmation) state = 'FOUND_UNCONFIRMED';
    else state = 'FOUND';
    if (best.confirmed) reason = 'Значение найдено в подтверждённом источнике.';
    else if (rule && rule.autoConfirmSingleCandidate) reason = 'Найдено единственное непротиворечивое значение в допустимом источнике сделки; отдельный вопрос менеджеру не требуется.';
    else reason = 'Значение найдено, но требует проверки применимости.';
  }

  if (fieldCode === 'commission.percent' && candidatesByValue.size === 1 && substantive[0] && substantive[0].sourceRole === 'GLOBAL_APPROVED_RULE') {
    state = 'GLOBAL_RULE_ACTIVE';
    selectedValue = substantive[0].value;
    reason = 'Применено утверждённое глобальное правило; вопрос нужен только при исключении.';
  }

  return {
    fieldCode,
    ruleId: rule ? rule.ruleId : '',
    fieldName: rule ? rule.fieldName : fieldCode,
    state,
    selectedValue,
    candidates: [...candidatesByValue.entries()].map(([normalizedValue, items]) => ({
      normalizedValue,
      displayValue: items[0].value,
      evidence: items.map(aiPublicEvidence_)
    })),
    defaultSuggestions: defaults.map(aiPublicEvidence_),
    templateGuidance: templateGuidance.map(aiPublicEvidence_),
    suppressedEvidence: substantive.filter(item => !considered.includes(item)).map(aiPublicEvidence_),
    blockingScope: rule ? rule.blockingScope : '',
    answerType: rule ? rule.answerType : '',
    writebackTarget: rule ? rule.writebackTarget : '',
    ownerDecisionPending: rule ? rule.ownerDecisionPending || '' : '',
    reason
  };
}

function reconcileAiFieldStates_(evidenceIndex) {
  const rules = aiFieldRules_();
  const result = {};
  Object.keys(rules).forEach(fieldCode => {
    result[fieldCode] = buildAiFieldState_(fieldCode, evidenceIndex.get(fieldCode) || [], rules[fieldCode]);
  });
  return result;
}

function aiHasVerifiedCustoms_(checkRecords, latestSnapshot) {
  return (checkRecords || []).some(record => {
    const field = aiText_(record['Поле или статья']);
    const status = aiText_(record['Статус']).toLowerCase();
    return /(пошлин|импортн.*ндс|итого импорт)/i.test(field) && /(подтвержден|подтверждён|пройден)/.test(status);
  }) || Boolean(latestSnapshot);
}

function aiVatReturnApplicable_(model, evidenceIndex) {
  const vatStatusEvidence = evidenceIndex.get('vat.returnStatus') || [];
  const vatEvidenceSaysYes = vatStatusEvidence.some(item => /^(?:да|yes|true|1)$/i.test(aiText_(item.value)));
  const itemSaysYes = (model.normalizedItems || []).some(item => aiText_(item.vatRefundStatus).toUpperCase() === 'YES');
  const expenseSaysApplicable = (model.normalizedExpenses || []).some(expense =>
    expense.includeInternal && /vat|возврат.*ндс|возврат.*vat/i.test(`${expense.name} ${expense.category}`)
  );
  return vatEvidenceSaysYes || itemSaysYes || expenseSaysApplicable;
}

function aiIsTechnicalZeroPaymentRow_(row) {
  if (!row || !row.isZero) return false;
  return /(?:доп\.?\s*расход|остаток|резерв|если появились)/i.test(aiText_(row.label || row.text || ''));
}

function aiPaymentScheduleBusinessView_(schedule) {
  const source = schedule && typeof schedule === 'object' ? schedule : {};
  const rows = Array.isArray(source.rows) ? source.rows.slice() : [];
  const technicalZeroRows = rows.filter(aiIsTechnicalZeroPaymentRow_);
  const businessRows = rows.filter(row => !aiIsTechnicalZeroPaymentRow_(row));
  const activeRows = businessRows.filter(row => row && !row.isZero);
  const declaredCount = Number(source.declaredCount || 0);
  return {
    declaredCount,
    configuredCount: declaredCount || businessRows.length,
    activeCount: activeRows.length,
    businessRows,
    activeRows,
    technicalZeroRows,
    totalRub: Number(source.totalRub || 0),
    totalCny: Number(source.totalCny || 0)
  };
}

function reconcileAiCachedFallbackConflicts_(fieldStates, evidenceIndex) {
  const auditNotes = [];
  const fields = ['logistics.borderCrossing', 'logistics.deliveryDays'];
  fields.forEach(fieldCode => {
    const state = fieldStates[fieldCode];
    if (!state || state.state !== 'CONFLICT') return;
    const evidence = (evidenceIndex.get(fieldCode) || []).filter(item => item && item.normalizedValue !== '');
    const primary = evidence.filter(item =>
      item.evidenceType !== 'SOURCE_XLSX_CACHED_VALUE' &&
      ['ORDER', 'PARTNER_CALCULATION', 'INTERNAL_CALCULATOR', 'STRUCTURED_CARD', 'VERIFIED_SNAPSHOT', 'VERIFIED_CHECK'].includes(item.sourceRole)
    );
    const cachedDerived = evidence.filter(item =>
      item.evidenceType === 'SOURCE_XLSX_CACHED_VALUE' && item.sourceRole === 'CLIENT_OUTPUT'
    );
    const primaryGroups = new Map();
    primary.forEach(item => {
      const key = aiCanonicalValue_(fieldCode, item.value);
      if (!key) return;
      if (!primaryGroups.has(key)) primaryGroups.set(key, []);
      primaryGroups.get(key).push(item);
    });
    if (primaryGroups.size !== 1 || !cachedDerived.length) return;
    const primaryItems = [...primaryGroups.values()][0].slice().sort((a, b) => b.authorityRank - a.authorityRank);
    const selected = primaryItems[0];
    const conflictingCached = cachedDerived.filter(item => aiCanonicalValue_(fieldCode, item.value) !== selected.normalizedValue);
    if (!conflictingCached.length) return;
    state.state = 'FOUND_UNCONFIRMED';
    state.selectedValue = selected.value;
    state.candidates = [{
      normalizedValue: selected.normalizedValue,
      displayValue: selected.value,
      evidence: primaryItems.map(aiPublicEvidence_)
    }];
    state.reason = 'Значение согласовано по первичному расчёту партнёра и внутреннему калькулятору. Противоречащее значение из производного клиентского файла было восстановлено только из кэша разрушенной внешней ссылки и не блокирует расчёт.';
    auditNotes.push({
      type: 'CACHED_DERIVED_VALUE_OVERRIDDEN_BY_PRIMARY_SOURCES',
      fieldCode,
      selectedValue: selected.value,
      ignoredValues: conflictingCached.map(item => item.value),
      message: `Поле ${fieldCode} согласовано по первичным источникам; кэшированное значение производного клиентского файла сохранено только для аудита.`
    });
  });
  return auditNotes;
}

function reconcileAiDerivedFieldStates_(fieldStates, model, evidenceIndex, checkRecords, latestSnapshot) {
  const auditNotes = [];
  auditNotes.push(...reconcileAiCachedFallbackConflicts_(fieldStates, evidenceIndex));
  const productionState = fieldStates['logistics.productionDays'];
  if (aiResolvePerItemProductionDayRangeState_(productionState)) {
    auditNotes.push({
      type: 'ITEM_LEVEL_PRODUCTION_DAYS_AGGREGATED',
      fieldCode: 'logistics.productionDays',
      selectedValue: productionState.selectedValue,
      aggregation: productionState.aggregation,
      message: 'Несколько item-level сроков производства представлены в клиентском КП единым минимально-максимальным диапазоном без вопроса менеджеру.'
    });
  }
  if (!aiVatReturnApplicable_(model, evidenceIndex)) {
    const vatState = fieldStates['vat.returnStatus'];
    vatState.state = 'NOT_APPLICABLE';
    vatState.selectedValue = 'NOT_APPLICABLE';
    vatState.reason = 'Возврат китайского VAT не заявлен и не используется в проверенной модели сделки.';
    auditNotes.push({
      type: 'VAT_RETURN_NOT_APPLICABLE',
      message: 'Возврат китайского VAT не заявлен; поле согласовано как NOT_APPLICABLE, а не MISSING.'
    });
  }

  if (aiHasVerifiedCustoms_(checkRecords, latestSnapshot)) {
    const dutyState = fieldStates['customs.dutyMethod'];
    if (['MISSING', 'FOUND', 'FOUND_UNCONFIRMED'].includes(dutyState.state)) {
      dutyState.state = 'CONFIRMED_BY_VERIFIED_CALCULATION';
      dutyState.selectedValue = 'VERIFIED_CALCULATION';
      dutyState.reason = 'Метод пошлины и импортный НДС подтверждены последним проверенным расчётом/контрольными проверками.';
      auditNotes.push({
        type: 'CUSTOMS_FIELD_STATE_RECONCILED',
        message: 'Метод пошлины согласован с проверенным расчётом и не остаётся в состоянии MISSING.'
      });
    }
  }
  return auditNotes;
}

function verifyAiCurrentCalculationAgainstSnapshot_(spreadsheet, model, latestSnapshot) {
  const inactive = (reason, extra) => Object.assign({
    active: false,
    reason: reason || 'Нет актуального проверенного снимка.',
    result: null,
    checks: [],
    mismatches: []
  }, extra || {});

  if (!latestSnapshot || aiText_(latestSnapshot.status) !== 'Проверен') {
    return inactive('Последний проверенный снимок отсутствует.');
  }

  try {
    // DEV-016.34: это read-only повторная проверка для команды 8.
    // Расчётное ядро не изменяется и результаты никуда не записываются.
    const result = calculateDealModel_(model);
    const checks = buildCalculationChecks_(model, result);
    applyPreservedCheckStatuses_(spreadsheet, model.dealId, checks);

    const criticalCount = checks.filter(check =>
      check.severity === 'Критическая ошибка' && check.status === 'Открыто'
    ).length;
    const warningCount = checks.filter(check =>
      check.severity === 'Предупреждение' && check.status === 'Открыто'
    ).length;

    if ((result.conversionErrors || []).length || criticalCount > 0 || warningCount > 0) {
      return inactive(
        'Текущая модель больше не подтверждается без открытых ошибок/предупреждений.',
        {result, checks, criticalCount, warningCount}
      );
    }

    const mismatches = [];
    const compareNumber = (field, currentValue, snapshotValue, tolerance) => {
      const current = Number(currentValue);
      const stored = Number(snapshotValue);
      const currentFinite = Number.isFinite(current);
      const storedFinite = Number.isFinite(stored);
      if (!currentFinite && !storedFinite) return;
      if (!currentFinite || !storedFinite || Math.abs(current - stored) > tolerance) {
        mismatches.push(field);
      }
    };

    compareNumber('goodsCny', result.goodsCny, latestSnapshot.goodsCny, 0.0001);
    compareNumber('goodsRub', result.goodsRub, latestSnapshot.goodsRub, 0.01);
    compareNumber('expensesCny', result.expensesCny, latestSnapshot.expensesCny, 0.0001);
    compareNumber('expensesRub', result.expensesRub, latestSnapshot.expensesRub, 0.01);
    compareNumber('commissionCny', result.commissionCalculation && result.commissionCalculation.amountCny,
      latestSnapshot.commissionCny, 0.0001);
    compareNumber('commissionRub', result.commissionCalculation && result.commissionCalculation.amountRub,
      latestSnapshot.commissionRub, 0.01);
    compareNumber('totalCny', result.totalCny, latestSnapshot.totalCny, 0.0001);
    compareNumber('totalRub', result.totalRub, latestSnapshot.totalRub, 0.01);

    if (Number(latestSnapshot.cnyRubRate) > 0) {
      compareNumber('cnyRubRate', result.cnyRub, latestSnapshot.cnyRubRate, 0.000001);
    }
    if (Number(latestSnapshot.usdRubRate) > 0) {
      compareNumber('usdRubRate', result.usdRub, latestSnapshot.usdRubRate, 0.000001);
    }
    if (Number(latestSnapshot.eurRubRate) > 0) {
      compareNumber('eurRubRate', result.eurRub, latestSnapshot.eurRubRate, 0.000001);
    }

    if (mismatches.length) {
      return inactive(
        'Текущая модель отличается от последнего проверенного снимка: ' + mismatches.join(', ') + '.',
        {result, checks, mismatches, criticalCount, warningCount}
      );
    }

    return {
      active: true,
      reason: 'Текущая модель совпадает с последним проверенным снимком и повторно даёт 0 открытых ошибок / предупреждений.',
      result,
      checks,
      mismatches: [],
      criticalCount: 0,
      warningCount: 0
    };
  } catch (error) {
    return inactive('Не удалось повторно подтвердить проверенный расчёт: ' + String(error && error.message || error));
  }
}

function aiQuestionClosedByVerifiedCalculation_(question) {
  return ['COM-002', 'EXP-001', 'VAT-002', 'CUS-003', 'CTRL-002']
    .includes(aiText_(question && question.ruleId));
}

function applyAiVerifiedCalculationClosureResult_(
  model, latestSnapshot, fieldStates, managerQuestions, conflicts, auditNotes, verification
) {
  const questions = managerQuestions || [];
  const sourceConflicts = conflicts || [];
  if (!verification || !verification.active) {
    return {
      managerQuestions: questions,
      conflicts: sourceConflicts,
      technicalFindings: [],
      verification: verification || {active: false}
    };
  }

  const closedQuestions = questions.filter(aiQuestionClosedByVerifiedCalculation_);
  if (!closedQuestions.length) {
    return {
      managerQuestions: questions,
      conflicts: sourceConflicts,
      technicalFindings: [],
      verification
    };
  }

  const closedRuleIds = new Set(closedQuestions.map(question => aiText_(question.ruleId)));
  const closedFieldCodes = new Set(closedQuestions.map(question => aiText_(question.fieldCode)));
  const snapshotId = aiText_(latestSnapshot && latestSnapshot.snapshotId);
  const closeState = (fieldCode, selectedValue, suffix) => {
    const state = fieldStates && fieldStates[fieldCode];
    if (!state) return;
    state.state = 'CONFIRMED_BY_VERIFIED_CALCULATION';
    if (selectedValue !== undefined && selectedValue !== null && selectedValue !== '') {
      state.selectedValue = selectedValue;
    } else if (!state.selectedValue) {
      state.selectedValue = 'VERIFIED_CALCULATION';
    }
    state.reason = 'Закрыто проверенным расчётом' + (snapshotId ? ` ${snapshotId}` : '') +
      ': текущая модель повторно совпала со снимком и дала 0 открытых ошибок / предупреждений.' +
      (suffix ? ' ' + suffix : '');
  };

  if (closedRuleIds.has('COM-002')) {
    closeState('commission.percent', model && model.commissionInput ? model.commissionInput.value : '',
      'Применено действующее утверждённое правило комиссии BBC.');
  }
  if (closedRuleIds.has('EXP-001')) closeState('expense.certification', 'VERIFIED_CALCULATION');
  if (closedRuleIds.has('VAT-002')) closeState('vat.returnStatus', 'VERIFIED_CALCULATION');
  if (closedRuleIds.has('CUS-003')) closeState('customs.dutyMethod', 'VERIFIED_CALCULATION');

  closedQuestions.forEach(question => {
    auditNotes.push({
      type: 'MANAGER_QUESTION_CLOSED_BY_VERIFIED_CALCULATION',
      ruleId: question.ruleId,
      fieldCode: question.fieldCode,
      snapshotId,
      originalState: question.state,
      originalQuestion: question.question,
      message: 'Исходное расхождение сохранено для аудита; повторный вопрос менеджеру не создаётся, ' +
        'поскольку текущая модель совпадает с последним проверенным снимком.'
    });
  });

  const remainingQuestions = questions.filter(question => !aiQuestionClosedByVerifiedCalculation_(question));
  const remainingConflicts = sourceConflicts.filter(conflict => {
    const ruleId = aiText_(conflict && conflict.ruleId);
    const fieldCode = aiText_(conflict && (conflict.fieldCode || conflict.field));
    return !closedRuleIds.has(ruleId) && !closedFieldCodes.has(fieldCode);
  });
  const technicalFindings = closedQuestions.map(question => ({
    findingId: `TECH-VERIFIED-CLOSED-${question.ruleId}-${question.fieldCode || 'FIELD'}`,
    type: 'SOURCE_CONFLICT_CLOSED_BY_VERIFIED_CALCULATION',
    severity: 'INFO',
    managerQuestionRequired: false,
    ruleId: question.ruleId,
    fieldCode: question.fieldCode,
    snapshotId,
    message: 'Расхождение источников сохранено как audit/technical evidence и не блокирует менеджера.'
  }));

  return {
    managerQuestions: remainingQuestions,
    conflicts: remainingConflicts,
    technicalFindings,
    verification
  };
}

function reconcileAiVerifiedCalculationClosure_(
  spreadsheet, model, latestSnapshot, fieldStates, managerQuestions, conflicts, auditNotes
) {
  const verification = verifyAiCurrentCalculationAgainstSnapshot_(spreadsheet, model, latestSnapshot);
  return applyAiVerifiedCalculationClosureResult_(
    model, latestSnapshot, fieldStates, managerQuestions, conflicts, auditNotes, verification
  );
}

function buildAiOwnerDecisionsPending_(fieldStates) {
  return Object.values(fieldStates).filter(state =>
    state.ownerDecisionPending && ['MISSING', 'CONFLICT', 'UNCONFIRMED_ZERO'].includes(state.state)
  ).map(state => ({
    decisionId: state.ownerDecisionPending,
    fieldCode: state.fieldCode,
    fieldName: state.fieldName,
    state: state.state,
    blockingScope: state.blockingScope,
    reason: state.reason,
    requiredAction: state.fieldCode === 'commission.percent'
      ? 'Подтвердить индивидуальную ставку комиссии либо применить действующее утверждённое правило BBC.'
      : 'Утвердить политику поля либо разрешить менеджеру выбрать значение в диалоге.'
  }));
}

function aiStateCandidateLabels_(state, formatter) {
  return (state.candidates || []).map(candidate => {
    const value = formatter ? formatter(candidate.displayValue) : candidate.displayValue;
    const sources = candidate.evidence.map(item =>
      [item.sourceFileName || item.sourceRole, item.sourceSheet, item.sourceCells].filter(Boolean).join(' / ')
    ).filter(Boolean);
    return {value, sources};
  });
}

function aiScopeBlocksCalculation_(scope) {
  return /CALCULATION/.test(aiText_(scope).toUpperCase());
}

function aiScopeBlocksQuote_(scope) {
  return aiScopeBlocksCalculation_(scope) || /FINAL_QUOTE/.test(aiText_(scope).toUpperCase());
}

function buildAiQuestionEntry_(state, question, config) {
  return Object.assign({
    ruleId: state.ruleId,
    fieldCode: state.fieldCode,
    entity: state.fieldCode.split('.')[0].toUpperCase(),
    fieldName: state.fieldName,
    state: state.state,
    question,
    required: true,
    blockingScope: state.blockingScope,
    answerType: state.answerType,
    writebackTarget: state.writebackTarget,
    candidates: state.candidates,
    defaultSuggestions: state.defaultSuggestions,
    recheck: ['reconcileFieldStates_', 'rebuildManagerQuestions_', 'recalculateAllowances_']
  }, config || {});
}

function aiIsPerItemProductionDaySet_(state) {
  if (!state || state.fieldCode !== 'logistics.productionDays' || state.state !== 'CONFLICT') return false;
  const candidates = Array.isArray(state.candidates) ? state.candidates : [];
  if (candidates.length < 2) return false;

  const itemIdentities = new Set();
  for (const candidate of candidates) {
    const evidence = Array.isArray(candidate.evidence) ? candidate.evidence : [];
    if (!evidence.length) return false;
    let candidateHasItemIdentity = false;
    for (const item of evidence) {
      const sheet = aiText_(item.sourceSheet);
      const structuredMatch = aiText_(item.note).match(/DEV-016\.53\s+STRUCTURED_ITEM_PRODUCTION\s+item=(\d+)/i);
      if (structuredMatch) {
        itemIdentities.add(`ROW:${structuredMatch[1]}`);
        candidateHasItemIdentity = true;
        continue;
      }
      const itemSheetMatch = sheet.match(/(?:товар\s*|商品\s*)(\d+)/i);
      if (itemSheetMatch) {
        itemIdentities.add(`SHEET:${itemSheetMatch[1]}`);
        candidateHasItemIdentity = true;
      }
    }
    if (!candidateHasItemIdentity) return false;
  }
  return itemIdentities.size >= 2;
}

function aiProductionDayBounds_(value) {
  const normalized = aiCanonicalValue_('logistics.productionDays', value);
  if (!normalized || normalized === 'NOT_APPLICABLE') return null;
  const range = String(normalized).match(/^(\d+(?:\.\d+)?)-(\d+(?:\.\d+)?)$/);
  if (range) {
    const first = Number(range[1]);
    const second = Number(range[2]);
    if (!Number.isFinite(first) || !Number.isFinite(second)) return null;
    return {min: Math.min(first, second), max: Math.max(first, second)};
  }
  const numeric = Number(normalized);
  return Number.isFinite(numeric) ? {min: numeric, max: numeric} : null;
}

function aiProductionDayRangeText_(minValue, maxValue) {
  const clean = value => Number.isInteger(value) ? String(value) : String(roundTo_(value, 6));
  return Math.abs(Number(maxValue) - Number(minValue)) <= 0.000001
    ? clean(Number(minValue))
    : `${clean(Number(minValue))}-${clean(Number(maxValue))}`;
}

function aiResolvePerItemProductionDayRangeState_(state) {
  if (!aiIsPerItemProductionDaySet_(state)) return false;
  const bounds = (state.candidates || []).map(candidate => aiProductionDayBounds_(candidate.displayValue));
  if (bounds.some(item => !item)) return false;

  const minValue = Math.min(...bounds.map(item => item.min));
  const maxValue = Math.max(...bounds.map(item => item.max));
  if (!Number.isFinite(minValue) || !Number.isFinite(maxValue)) return false;

  state.state = 'CONFIRMED_BY_SOURCE_AGGREGATION';
  state.selectedValue = aiProductionDayRangeText_(minValue, maxValue);
  state.ownerDecisionPending = '';
  state.reason = 'Разные сроки производства относятся к разным товарным позициям текущей сделки. Клиентское сводное поле сформировано как минимально-максимальный диапазон только из item-level источников; исходные значения и lineage сохранены.';
  state.aggregation = {
    method: 'ITEM_LEVEL_MIN_MAX_RANGE',
    minDays: minValue,
    maxDays: maxValue,
    sourceCandidateCount: (state.candidates || []).length
  };
  return true;
}

function buildAiCoreFieldQuestions_(fieldStates, latestSnapshot) {
  const questions = [];
  const add = (fieldCode, question, config) => questions.push(buildAiQuestionEntry_(fieldStates[fieldCode], question, config));

  const manager = fieldStates['deal.manager'];
  if (['MISSING', 'CONFLICT'].includes(manager.state)) {
    const candidates = aiStateCandidateLabels_(manager);
    add('deal.manager', candidates.length
      ? `В исходных материалах найден менеджер «${candidates[0].value}», но в карточке сделки нет подтверждённого ответственного. Подтвердите это имя либо укажите актуального менеджера.`
      : 'В переданных материалах не найден подтверждённый ответственный менеджер. Укажите менеджера BBC по этой сделке.');
  }

  const client = fieldStates['deal.client'];
  if (['MISSING', 'CONFLICT'].includes(client.state)) {
    add('deal.client', client.state === 'CONFLICT'
      ? 'В источниках найдены разные значения клиента. Подтвердите, для кого формируется КП.'
      : 'В переданных материалах не найден подтверждённый клиент. Укажите клиента или компанию.');
  }

  const currency = fieldStates['deal.quoteCurrency'];
  if (['MISSING', 'CONFLICT'].includes(currency.state)) add('deal.quoteCurrency', 'Подтвердите валюту клиентского КП: RUB или CNY.');

  const validity = fieldStates['deal.validityDays'];
  if (['MISSING', 'CONFLICT'].includes(validity.state)) {
    const candidates = aiStateCandidateLabels_(validity, value => `${formatManagerNumber_(value, 0)} дней`);
    const defaultValue = validity.defaultSuggestions.length ? `${formatManagerNumber_(validity.defaultSuggestions[0].value, 0)} дней` : '';
    if (validity.state === 'CONFLICT' && candidates.length > 1) {
      add('deal.validityDays', `В фактических источниках сделки найдены разные сроки действия КП: ${candidates.map(item => item.value).join(' / ')}. Укажите применяемый срок.`);
    } else {
      add('deal.validityDays', `Срок действия КП не найден. Укажите количество календарных дней${defaultValue ? ` (значение по умолчанию — ${defaultValue})` : ''}.`);
    }
  }

  const scheme = fieldStates['deal.scheme'];
  if (['MISSING', 'CONFLICT'].includes(scheme.state)) {
    const candidates = aiStateCandidateLabels_(scheme, aiSchemeLabel_);
    const templateValues = (scheme.templateGuidance || []).map(item => aiSchemeLabel_(item.value)).filter(Boolean);
    if (scheme.state === 'CONFLICT' && candidates.length > 1) {
      add('deal.scheme', `Обнаружено противоречие между фактическими источниками сделки: ${candidates.map(item => `«${item.value}»`).join(' и ')}. Подтвердите применяемую схему и роли импортёра/экспортёра.`);
    } else if (candidates.length) {
      let text = `В исходном КП найдена схема «${candidates[0].value}». Подтвердите её и роли сторон либо укажите другую схему.`;
      if (templateValues.length && !templateValues.includes(candidates[0].value)) text += ` Действующий шаблон без подтверждённого выбора сформирует вариант «${templateValues[0]}», поэтому выбор схемы обязателен.`;
      add('deal.scheme', text);
    } else add('deal.scheme', 'Схема сделки не определена. Укажите, кто является импортёром и экспортёром и какую роль выполняет BBC.');
  }

  const logisticsFields = ['logistics.incoterms', 'logistics.chinaRoute', 'logistics.borderCrossing',
    'logistics.destinationCity', 'logistics.transportMode', 'logistics.deliveryDays', 'logistics.productionDays'];
  const criticalCodes = ['logistics.incoterms', 'logistics.chinaRoute', 'logistics.borderCrossing',
    'logistics.destinationCity', 'logistics.transportMode'];
  const criticalUnresolved = criticalCodes.filter(code =>
    ['MISSING', 'CONFLICT', 'UNCONFIRMED_ZERO'].includes(fieldStates[code].state)
  );
  if (criticalUnresolved.length) {
    const fragments = criticalUnresolved.map(code =>
      `${fieldStates[code].fieldName} — ${aiFieldStateValueText_(fieldStates[code], code === 'logistics.transportMode' ? aiTransportLabel_ : undefined)}`
    );
    const baseState = Object.assign({}, fieldStates[criticalUnresolved[0]], {
      ruleId: 'LOG-008', fieldCode: 'logistics.confirmation', fieldName: 'Неопределённые логистические параметры',
      state: 'MISSING_OR_CONFLICT', blockingScope: 'CALCULATION_AND_FINAL_QUOTE', answerType: 'LOGISTICS_BUNDLE',
      writebackTarget: 'Сделки: Инкотермс, маршрут, погранпереход, город, транспорт'
    });
    questions.push(buildAiQuestionEntry_(baseState,
      `Уточните только неопределённые логистические параметры: ${fragments.join('; ')}.`,
      {relatedFieldCodes: criticalUnresolved}
    ));
  }

  const deliveryState = fieldStates['logistics.deliveryDays'];
  if (['MISSING', 'CONFLICT', 'UNCONFIRMED_ZERO'].includes(deliveryState.state)) {
    const values = aiStateCandidateLabels_(deliveryState, value => `${formatManagerNumber_(value, 0)} дней`);
    add('logistics.deliveryDays', deliveryState.state === 'CONFLICT' && values.length > 1
      ? `В источниках найдены разные сроки международной доставки: ${values.map(item => item.value).join(' / ')}. Укажите применяемый срок.`
      : 'Срок международной доставки не найден. Укажите количество календарных дней.');
  }

  const productionState = fieldStates['logistics.productionDays'];
  aiResolvePerItemProductionDayRangeState_(productionState);
  if (['MISSING', 'CONFLICT', 'UNCONFIRMED_ZERO'].includes(productionState.state)) {
    const values = aiStateCandidateLabels_(productionState, value => `${formatManagerNumber_(value, 0)} дней`);
    add('logistics.productionDays', productionState.state === 'CONFLICT' && values.length > 1
      ? `В применимых источниках одного уровня найдены разные значения срока производства: ${values.map(item => item.value).join(' / ')}. Укажите применяемый срок.`
      : 'Укажите срок производства товара в календарных днях либо подтвердите, что срок производства не включается в КП.');
  }

  const schedule = fieldStates['commercial.paymentSchedule'];
  const terms = fieldStates['commercial.paymentTerms'];
  if (['MISSING', 'CONFLICT'].includes(schedule.state) || ['MISSING', 'CONFLICT'].includes(terms.state)) {
    const scheduleCandidates = (schedule.candidates || []).filter(candidate => candidate.displayValue && typeof candidate.displayValue === 'object');
    const descriptors = [];
    scheduleCandidates.forEach(candidate => {
      const view = aiPaymentScheduleBusinessView_(candidate.displayValue);
      const source = candidate.evidence && candidate.evidence.length
        ? (candidate.evidence[0].sourceFileName || candidate.evidence[0].sourceRole || 'источник')
        : 'источник';
      const descriptor = `${source}: ${view.configuredCount || 'неопределённое число'} этапов` +
        ` (${view.activeCount} ненулевых), итог ${formatManagerNumber_(view.totalRub, 2)} RUB`;
      if (!descriptors.includes(descriptor)) descriptors.push(descriptor);
    });
    const termValues = aiStateCandidateLabels_(terms).map(item => item.value).filter(Boolean);
    let text = '';
    if (schedule.state === 'FOUND_UNCONFIRMED' && scheduleCandidates.length) {
      const view = aiPaymentScheduleBusinessView_(scheduleCandidates[0].displayValue);
      text = `В источниках найден согласованный график: ${view.configuredCount || 'неопределённое число'} этапов ` +
        `(${view.activeCount} ненулевых).`;
      if (termValues.length) text += ` Условия разбивки товара: ${termValues.join(' / ')}.`;
      text += ' Подтвердите структуру и условия наступления платежей. Суммы этапов не выбираются между старыми файлами: они должны быть пересчитаны автоматически после разрешения исходных стоимостных расхождений. Нулевая резервная строка «доп. расходы и остаток» исключена.';
    } else {
      text = descriptors.length
        ? `В источниках найдены различающиеся структуры графика платежей: ${descriptors.join('; ')}.`
        : 'Подтверждённый график платежей не найден.';
      if (termValues.length) text += ` Условия разбивки товара: ${termValues.join(' / ')}.`;
      const currentTotalRub = latestSnapshot && latestSnapshot.totalRub ? Number(latestSnapshot.totalRub) : 0;
      if (currentTotalRub) text += ` Последний проверенный итог сделки — ${formatManagerNumber_(currentTotalRub, 2)} RUB.`;
      text += ' Подтвердите структуру, проценты и условия наступления каждого платежа. Нулевая резервная строка «доп. расходы и остаток» автоматически исключена.';
    }
    add('commercial.paymentSchedule', text, {relatedFieldCodes: ['commercial.paymentTerms']});
  }
  return questions;
}

function buildAiItemQuestions_(model, sourceTraceability, importedCellIndex, extractedData, conflicts, auditNotes) {
  const questions = [];
  const itemRecords = model.allItemRecords || [];

  if (!itemRecords.length) {
    questions.push({
      ruleId: 'ITEM-000', fieldCode: 'items', entity: 'DEAL', fieldName: 'Товары',
      state: 'MISSING', question: 'В переданных материалах не найдены товарные позиции. Загрузите или укажите перечень товаров.',
      required: true, blockingScope: 'CALCULATION', answerType: 'FILE_OR_LIST', writebackTarget: 'Товары'
    });
    return questions;
  }

  itemRecords.forEach((item, index) => {
    const itemNumber = item['Номер позиции'] || index + 1;
    const itemName = aiText_(item['Наименование товара']);
    const label = itemName || `позиция ${itemNumber}`;
    const quantity = parseFlexibleNumber_(item['Количество']);
    const unit = aiText_(item['Единица количества']);
    const unitPrice = parseFlexibleNumber_(item['Цена за единицу']);
    const batchPrice = parseFlexibleNumber_(item['Стоимость партии']);
    const priceCurrency = aiText_(item['Валюта цены']).toUpperCase();
    const tnVed = aiText_(item['Код ТН ВЭД']).replace(/\D/g, '');
    const itemSource = buildAiItemSourceReference_(item, sourceTraceability.importsByName);
    const extractedItem = {
      itemId: aiText_(item['item_id']), itemNumber, name: itemName,
      quantity: quantity || '', unit, unitPrice: unitPrice || '', batchPrice: batchPrice || '',
      priceCurrency, tnVed, source: itemSource
    };
    extractedData.items.push(extractedItem);

    const add = (field, fieldName, question, reason) => questions.push({
      ruleId: `ITEM-${String(itemNumber).padStart(3, '0')}-${field}`,
      fieldCode: `item.${itemNumber}.${field}`, entity: 'ITEM', itemNumber, itemId: extractedItem.itemId,
      fieldName, state: 'MISSING', question, reason, required: true,
      blockingScope: 'CALCULATION', answerType: 'TEXT_OR_NUMBER', writebackTarget: `Товары.${fieldName}`
    });

    if (!itemName) add('name', 'Наименование товара', `Укажите наименование товара для позиции ${itemNumber}.`, 'Позиция должна быть идентифицирована.');
    if (!(quantity > 0)) add('quantity', 'Количество товара', `Какое количество указать для товара «${label}»?`, 'Количество необходимо для расчёта.');
    if (!unit) add('unit', 'Единица измерения', `Какая единица измерения используется для товара «${label}»?`, 'Единица обязательна для спецификации.');
    if (!(unitPrice > 0) && !(batchPrice > 0)) add('price', 'Цена товара', `Укажите цену за единицу или стоимость партии для товара «${label}».`, 'Без цены расчёт невозможен.');
    if (!priceCurrency) add('priceCurrency', 'Валюта цены', `В какой валюте указана цена товара «${label}»?`, 'Для пересчёта нужна валюта.');
    if (itemNeedsTnVed_(item, model) && !tnVed) add('tnVed', 'Код ТН ВЭД', `Укажите или подтвердите код ТН ВЭД для товара «${label}».`, 'Код нужен для пошлины и НДС.');

    if (quantity > 0 && unitPrice > 0 && batchPrice > 0) {
      const expectedBatchPrice = quantity * unitPrice;
      const priceDelta = batchPrice - expectedBatchPrice;
      const tolerance = calculateItemPriceConsistencyTolerance_(quantity, unitPrice, expectedBatchPrice);
      if (Math.abs(priceDelta) <= tolerance) {
        extractedItem.priceConsistency = {status: 'MATCH', expectedBatchPrice: roundTo_(expectedBatchPrice, 6), statedBatchPrice: batchPrice, delta: roundTo_(priceDelta, 6), tolerance: roundTo_(tolerance, 6)};
      } else {
        const knownAdjustment = resolveKnownItemPriceAdjustment_(importedCellIndex, itemSource, {
          quantity, unitPrice, batchPrice, expectedBatchPrice, priceDelta, tolerance, currency: priceCurrency
        });
        if (knownAdjustment) {
          extractedItem.priceConsistency = knownAdjustment;
          auditNotes.push({
            type: 'EXPLAINED_ITEM_PRICE_ADJUSTMENT', itemNumber, itemName: label,
            message: `Стоимость партии включает объяснённую корректировку ${formatManagerNumber_(knownAdjustment.adjustmentAmount, 6)} ${knownAdjustment.currency}.`,
            evidence: knownAdjustment
          });
        } else {
          extractedItem.priceConsistency = {status: 'UNEXPLAINED_MISMATCH', expectedBatchPrice: roundTo_(expectedBatchPrice, 6), statedBatchPrice: batchPrice, delta: roundTo_(priceDelta, 6), tolerance: roundTo_(tolerance, 6)};
          const conflict = {
            ruleId: 'CTRL-001', entity: 'ITEM', itemId: extractedItem.itemId, itemNumber, itemName: label,
            fieldCode: `item.${itemNumber}.priceConsistency`, type: 'ITEM_PRICE_TOTAL_MISMATCH',
            fieldName: 'Расхождение цены и стоимости партии', quantity, unitPrice,
            expectedBatchPrice: roundTo_(expectedBatchPrice, 6), statedBatchPrice: batchPrice,
            delta: roundTo_(priceDelta, 6), tolerance: roundTo_(tolerance, 6), currency: priceCurrency,
            source: itemSource, required: true, blockingScope: 'CALCULATION',
            question: `По товару №${itemNumber} «${label}» обнаружено необъяснённое расхождение: ` +
              `${formatManagerNumber_(quantity, 3)} × ${formatManagerNumber_(unitPrice, 6)} ${priceCurrency || 'валюта не указана'} = ` +
              `${formatManagerNumber_(expectedBatchPrice, 6)}, однако стоимость партии указана ${formatManagerNumber_(batchPrice, 6)}. ` +
              'Подтвердите правильную цену, стоимость партии или основание различия.'
          };
          conflicts.push(conflict);
          questions.push(Object.assign({}, conflict, {state: 'CONFLICT', answerType: 'TEXT_OR_SINGLE_SELECT', writebackTarget: 'Проверки / Решения по расхождениям'}));
        }
      }
    }
  });
  return questions;
}


function findAiRightValueRecord_(labelRecord, grid) {
  const pos = aiRecordPosition_(labelRecord);
  for (let offset = 1; offset <= 4; offset += 1) {
    const record = grid.get(`${pos.row}|${pos.col + offset}`);
    if (record && !aiIsPlaceholder_(aiCellValue_(record))) return record;
  }
  return null;
}

function findAiSheetField_(records, grid, includePattern, excludePattern) {
  for (const record of records || []) {
    const label = aiCellValue_(record);
    if (!label || !includePattern.test(label)) continue;
    if (excludePattern && excludePattern.test(label)) continue;
    const valueRecord = findAiRightValueRecord_(record, grid) || findAiAdjacentValueRecord_(record, grid);
    if (!valueRecord || aiIsPlaceholder_(aiCellValue_(valueRecord))) continue;
    return {labelRecord: record, valueRecord, value: aiCellValue_(valueRecord)};
  }
  return null;
}

function aiNumberFromImportedRecord_(record) {
  if (!record) return null;
  const raw = record['Исходное значение'];
  const rawNumber = parseFlexibleNumber_(raw);
  if (rawNumber !== null && Number.isFinite(rawNumber)) return rawNumber;
  const displayedNumber = parseFlexibleNumber_(aiCellValue_(record));
  return displayedNumber !== null && Number.isFinite(displayedNumber) ? displayedNumber : null;
}

function aiVatRateFromImportedRecord_(record) {
  if (!record) return null;
  const rawNumber = parseFlexibleNumber_(record['Исходное значение']);
  if (rawNumber !== null && Number.isFinite(rawNumber)) {
    if (Math.abs(rawNumber) <= 1) return rawNumber;
    return rawNumber / 100;
  }
  const displayedNumber = parseFlexibleNumber_(aiCellValue_(record));
  if (displayedNumber === null || !Number.isFinite(displayedNumber)) return null;
  return (/%/.test(aiCellValue_(record)) || Math.abs(displayedNumber) > 1)
    ? displayedNumber / 100
    : displayedNumber;
}

function aiLastNumberFromText_(value) {
  const matches = aiText_(value).replace(/[\s\u00a0]/g, '').match(/-?\d+(?:[.,]\d+)?/g) || [];
  if (!matches.length) return null;
  return parseFlexibleNumber_(matches[matches.length - 1]);
}

function aiProductTokens_(value) {
  const stop = new Set(['товар', 'для', 'размер', 'шапка', 'шапочка', 'плавания', 'шт', 'взрослая', 'детская']);
  return new Set(aiText_(value).toLowerCase().replace(/ё/g, 'е')
    .replace(/[^a-zа-я0-9]+/gi, ' ').split(/\s+/)
    .filter(token => token.length > 2 && !stop.has(token)));
}

function aiProductNameSimilarity_(left, right) {
  const a = aiProductTokens_(left);
  const b = aiProductTokens_(right);
  if (!a.size || !b.size) return 0;
  let common = 0;
  a.forEach(token => { if (b.has(token)) common += 1; });
  return common / Math.max(a.size, b.size);
}

function aiNumbersClose_(left, right, absoluteTolerance, relativeTolerance) {
  const a = Number(left);
  const b = Number(right);
  if (!Number.isFinite(a) || !Number.isFinite(b)) return false;
  const tolerance = Math.max(Number(absoluteTolerance || 0), Math.max(Math.abs(a), Math.abs(b)) * Number(relativeTolerance || 0));
  return Math.abs(a - b) <= tolerance;
}

function buildAiItemVatProfiles_(model, importedRecords, sourceCatalog) {
  const groups = new Map();
  (importedRecords || []).forEach(record => {
    const key = aiSheetKey_(aiSourceKeyFromRecord_(record), record['Лист']);
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(record);
  });

  const sheetProfiles = [];
  groups.forEach(records => {
    const grid = buildAiSheetGrid_(records);
    const nameField = findAiSheetField_(records, grid, /наименование товара/i);
    const quantityField = findAiSheetField_(records, grid, /общее количество единиц товара/i);
    const priceExVatField = findAiSheetField_(records, grid, /цена за единицу без\s*(?:кит\.?\s*)?(?:ндс|vat)/i);
    const priceIncVatField = findAiSheetField_(records, grid, /цена за единицу с\s*(?:кит\.?\s*)?(?:ндс|vat)/i);
    const nominalVatField = findAiSheetField_(records, grid, /^(?:кит\.?\s*)?(?:ндс|vat)\s*%/i, /поставщик/i);
    const supplierVatField = findAiSheetField_(records, grid, /поставщик.*продаст.*(?:ндс|vat).*%/i);
    const batchIncVatField = findAiSheetField_(records, grid, /цена за партию с\s*(?:кит\.?\s*)?(?:ндс|vat)/i);
    const legacyBatchField = findAiSheetField_(records, grid, /общая стоимость товара/i);
    const unitPriceField = findAiSheetField_(records, grid, /цена за единицу товара/i, /без\s*(?:кит\.?\s*)?(?:ндс|vat)|с\s*(?:кит\.?\s*)?(?:ндс|vat)/i);

    if (!nameField || !quantityField || (!priceExVatField && !priceIncVatField && !nominalVatField)) return;

    const sourceRole = sourceCatalog.sheetRoleByKey.get(aiSheetKey_(aiSourceKeyFromRecord_(records[0]), records[0]['Лист'])) || 'UNKNOWN';
    const sourceCfg = aiEvidenceConfigFromRecord_(nameField.valueRecord, sourceCatalog, sourceRole);
    const cells = {};
    const addCell = (key, field) => {
      if (field && field.valueRecord) cells[key] = aiText_(field.valueRecord['Ячейка']);
    };
    addCell('name', nameField);
    addCell('quantity', quantityField);
    addCell('unitPrice', unitPriceField);
    addCell('priceExVat', priceExVatField);
    addCell('priceIncVat', priceIncVatField);
    addCell('batchIncVat', batchIncVatField);
    addCell('nominalVatRate', nominalVatField);
    addCell('supplierInvoiceVatRate', supplierVatField);
    addCell('legacyBatchValue', legacyBatchField);

    sheetProfiles.push({
      sourceFileId: sourceCfg.sourceFileId,
      sourceFileName: sourceCfg.sourceFileName,
      sourceUrl: sourceCfg.sourceUrl,
      sourceSheet: sourceCfg.sourceSheet,
      sourceRole,
      name: nameField.value,
      quantity: aiNumberFromImportedRecord_(quantityField.valueRecord),
      unitPrice: unitPriceField ? aiNumberFromImportedRecord_(unitPriceField.valueRecord) : null,
      priceExVat: priceExVatField ? aiNumberFromImportedRecord_(priceExVatField.valueRecord) : null,
      priceIncVat: priceIncVatField ? aiNumberFromImportedRecord_(priceIncVatField.valueRecord) : null,
      batchIncVat: batchIncVatField ? aiNumberFromImportedRecord_(batchIncVatField.valueRecord) : null,
      nominalVatRate: nominalVatField ? aiVatRateFromImportedRecord_(nominalVatField.valueRecord) : null,
      supplierInvoiceVatRate: supplierVatField ? aiVatRateFromImportedRecord_(supplierVatField.valueRecord) : null,
      legacyBatchRaw: legacyBatchField ? legacyBatchField.value : '',
      legacyBatchValue: legacyBatchField
        ? (aiNumberFromImportedRecord_(legacyBatchField.valueRecord) !== null
          ? aiNumberFromImportedRecord_(legacyBatchField.valueRecord)
          : aiLastNumberFromText_(legacyBatchField.value))
        : null,
      cells
    });
  });

  const items = model.normalizedItems || [];
  const candidates = [];
  sheetProfiles.forEach((profile, profileIndex) => {
    items.forEach(item => {
      let score = 0;
      if (profile.quantity !== null && item.quantity > 0) {
        score += aiNumbersClose_(profile.quantity, item.quantity, 0.001, 0.000001) ? 6 : -6;
      }
      const profileUnitPrice = profile.priceIncVat !== null ? profile.priceIncVat : profile.unitPrice;
      if (profileUnitPrice !== null && item.unitPrice > 0) {
        score += aiNumbersClose_(profileUnitPrice, item.unitPrice, 0.00001, 0.00001) ? 6 : -3;
      }
      if (profile.batchIncVat !== null && item.batchPrice > 0) {
        score += aiNumbersClose_(profile.batchIncVat, item.batchPrice, 0.01, 0.00001) ? 4 : -2;
      }
      score += aiProductNameSimilarity_(profile.name, item.name) * 4;
      score += aiRoleAuthority_(profile.sourceRole, `item.${item.itemNumber}.vat`) / 100;
      candidates.push({profile, profileIndex, item, score});
    });
  });
  candidates.sort((left, right) => right.score - left.score);

  const matchedItems = new Set();
  const matchedProfiles = new Set();
  const profiles = [];
  candidates.forEach(candidate => {
    const itemKey = candidate.item.itemId || `ITEM-${candidate.item.itemNumber}`;
    if (candidate.score < 7 || matchedItems.has(itemKey) || matchedProfiles.has(candidate.profileIndex)) return;
    matchedItems.add(itemKey);
    matchedProfiles.add(candidate.profileIndex);
    const profile = candidate.profile;
    const item = candidate.item;
    const impliedVatRate = profile.priceExVat > 0 && profile.priceIncVat > 0
      ? profile.priceIncVat / profile.priceExVat - 1
      : null;
    profiles.push(Object.assign({}, profile, {
      itemId: item.itemId,
      itemNumber: item.itemNumber,
      itemName: item.name,
      canonicalQuantity: item.quantity,
      canonicalUnitPrice: item.unitPrice,
      canonicalBatchPrice: item.batchPrice,
      canonicalPriceExVat: item.priceExVat,
      canonicalChinaVatRate: item.chinaVatRate,
      canonicalPriceIncVat: item.priceIncVat,
      canonicalVatRefundStatus: aiText_(item.vatRefundStatus).toUpperCase(),
      canonicalManagerNote: aiText_(item.raw && item.raw['Комментарий']),
      returnStatus: aiText_(item.vatRefundStatus).toUpperCase(),
      impliedVatRate: impliedVatRate === null ? null : roundTo_(impliedVatRate, 8),
      matchScore: roundTo_(candidate.score, 4)
    }));
  });
  return profiles;
}

function aiCanonicalVatManagerConfirmation_(profile) {
  const note = aiText_(profile && profile.canonicalManagerNote);
  const explicitlyConfirmed = /менеджер\s+подтвердил/i.test(note) && /(?:vat|ндс)/i.test(note);
  const returnStatus = aiText_(profile && profile.canonicalVatRefundStatus).toUpperCase();
  const priceExVat = Number(profile && profile.canonicalPriceExVat);
  const priceIncVat = Number(profile && profile.canonicalPriceIncVat);
  const vatRate = Number(profile && profile.canonicalChinaVatRate);
  const hasCompleteValues =
    returnStatus === 'YES' &&
    Number.isFinite(priceExVat) && priceExVat > 0 &&
    Number.isFinite(priceIncVat) && priceIncVat > 0 &&
    Number.isFinite(vatRate) && vatRate >= 0;
  const impliedVatRate = hasCompleteValues ? priceIncVat / priceExVat - 1 : null;
  const internallyConsistent = hasCompleteValues &&
    Math.abs(impliedVatRate - vatRate) <= 0.0005;

  return {
    confirmed: Boolean(explicitlyConfirmed && internallyConsistent),
    explicitlyConfirmed: Boolean(explicitlyConfirmed),
    returnStatus,
    priceExVat: Number.isFinite(priceExVat) ? priceExVat : null,
    priceIncVat: Number.isFinite(priceIncVat) ? priceIncVat : null,
    vatRate: Number.isFinite(vatRate) ? vatRate : null,
    impliedVatRate: impliedVatRate === null ? null : roundTo_(impliedVatRate, 8),
    internallyConsistent: Boolean(internallyConsistent),
    note
  };
}

function publicAiItemVatProfile_(profile, status, reason) {
  return {
    status,
    reason: reason || '',
    returnStatus: profile.returnStatus,
    priceExVat: profile.priceExVat,
    priceIncVat: profile.priceIncVat,
    nominalVatRate: profile.nominalVatRate,
    supplierInvoiceVatRate: profile.supplierInvoiceVatRate,
    impliedVatRate: profile.impliedVatRate,
    managerConfirmation: aiCanonicalVatManagerConfirmation_(profile),
    source: {
      fileId: profile.sourceFileId,
      fileName: profile.sourceFileName,
      fileUrl: profile.sourceUrl,
      sourceSheet: profile.sourceSheet,
      sourceCells: profile.cells
    }
  };
}

function buildAiCurrentCalculationPreview_(model) {
  if (!model || !Array.isArray(model.items) || !model.rateBook || !model.settings) {
    return {available: false, reason: 'MODEL_NOT_READY', result: null, checks: [], criticalChecks: [], customsErrorsByItem: new Map()};
  }
  try {
    const result = calculateDealModel_(model);
    const checks = buildCalculationChecks_(model, result);
    const criticalChecks = checks.filter(check =>
      check.severity === 'Критическая ошибка' && check.status === 'Открыто'
    );
    const customsErrorsByItem = new Map();
    (result.itemLineCalculation && result.itemLineCalculation.errors || []).forEach(error => {
      if (!/(?:пошлин|импортн.*ндс|ндс)/i.test(aiText_(error.field) + ' ' + aiText_(error.message))) return;
      const key = aiText_(error.itemId);
      if (!customsErrorsByItem.has(key)) customsErrorsByItem.set(key, []);
      customsErrorsByItem.get(key).push(error);
    });
    return {available: true, reason: '', result, checks, criticalChecks, customsErrorsByItem};
  } catch (error) {
    return {available: false, reason: String(error && error.message || error), result: null, checks: [], criticalChecks: [], customsErrorsByItem: new Map()};
  }
}

function aiLegacyCriticalCheckStillActive_(record, currentCriticalChecks) {
  const current = currentCriticalChecks || [];
  const recordId = aiText_(record && record['check_id']);
  if (recordId && current.some(check => aiText_(check.id) === recordId)) return true;
  const field = aiText_(record && record['Поле или статья']).toLowerCase();
  const message = aiText_(record && record['Комментарий']).toLowerCase();
  return current.some(check => {
    const currentField = aiText_(check.field).toLowerCase();
    const currentMessage = aiText_(check.message).toLowerCase();
    if (field && currentField === field) return true;
    if (message && currentMessage === message) return true;
    return false;
  });
}

function buildAiSpecialFindings_(model, fieldStates, evidenceIndex, checkRecords, latestSnapshot, itemVatProfiles) {
  const questions = [];
  const conflicts = [];
  const technicalFindings = [];
  const auditNotes = [];
  const currentPreview = buildAiCurrentCalculationPreview_(model);

  const sourceCommission = (evidenceIndex.get('commission.percent') || []).filter(item => item.sourceRole !== 'GLOBAL_APPROVED_RULE');
  const approvedCommission = (evidenceIndex.get('commission.percent') || []).find(item => item.sourceRole === 'GLOBAL_APPROVED_RULE');
  const commissionConflicts = sourceCommission.filter(item => approvedCommission && item.normalizedValue !== approvedCommission.normalizedValue);
  const explicitCommissionOverrides = commissionConflicts.filter(item =>
    item.confirmed && ['MANAGER_CONFIRMATION', 'STRUCTURED_CARD'].includes(aiText_(item.sourceRole).toUpperCase())
  );
  const staleCommissionNoise = commissionConflicts.filter(item => !explicitCommissionOverrides.includes(item));
  if (staleCommissionNoise.length && approvedCommission) {
    const state = fieldStates['commission.percent'];
    const approvedPercent = aiNormalizePercentValue_(approvedCommission.value);
    state.state = 'GLOBAL_RULE_ACTIVE';
    state.selectedValue = approvedCommission.value;
    state.reason = 'Применено утверждённое глобальное правило BBC; отличающиеся значения более низкого приоритета сохранены как evidence.';
    state.candidates = [{
      normalizedValue: approvedCommission.normalizedValue,
      displayValue: approvedCommission.value,
      evidence: [aiPublicEvidence_(approvedCommission)]
    }];
    technicalFindings.push({
      findingId: 'TECH-STALE-COMMISSION-PERCENT',
      type: 'LOWER_AUTHORITY_COMMISSION_MISMATCH',
      severity: 'INFO',
      managerQuestionRequired: false,
      fieldCode: 'commission.percent',
      approvedPercent,
      staleValues: staleCommissionNoise.map(item => aiNormalizePercentValue_(item.value)),
      approvedSource: aiPublicEvidence_(approvedCommission),
      staleSources: staleCommissionNoise.map(aiPublicEvidence_),
      message: 'Отличающийся процент комиссии найден только в источнике ниже утверждённого правила BBC. В расчёте применяется утверждённое правило; вопрос менеджеру не требуется.'
    });
  }
  if (explicitCommissionOverrides.length) {
    const state = fieldStates['commission.percent'];
    const sourcePercent = aiNormalizePercentValue_(explicitCommissionOverrides[0].value);
    const approvedPercent = aiNormalizePercentValue_(approvedCommission.value);
    state.state = 'CONFLICT';
    state.reason = 'Явно подтверждённое значение сделки отличается от действующего утверждённого правила комиссии BBC и требует owner decision.';
    state.candidates = [approvedCommission].concat(explicitCommissionOverrides).map(item => {
      const percent = aiNormalizePercentValue_(item.value);
      return {
        normalizedValue: Number.isFinite(percent) ? String(percent) : item.normalizedValue,
        displayValue: Number.isFinite(percent) ? percent : item.value,
        evidence: [aiPublicEvidence_(item)]
      };
    });
    const question = buildAiQuestionEntry_(state,
      `По сделке явно подтверждена индивидуальная комиссия ${formatManagerNumber_(sourcePercent, 3)}%, а действующее утверждённое правило BBC — ${formatManagerNumber_(approvedPercent, 3)}%. ` +
      'Зафиксируйте основание исключения для решения владельца; до утверждения исключения расчёт использует стандартное правило.');
    questions.push(question);
    conflicts.push(question);
  }

  const certEvidence = (evidenceIndex.get('expense.certification') || []).filter(item => item.sourceRole !== 'TEMPLATE_GUIDANCE' && !/инструкц/i.test(aiText_(item.sourceSheet)));
  const certValues = new Map();
  certEvidence.forEach(item => {
    const key = item.normalizedValue;
    if (!certValues.has(key)) certValues.set(key, []);
    certValues.get(key).push(item);
  });
  const authoritativeCertEvidence = certEvidence.filter(item =>
    item.confirmed && ['MANAGER_CONFIRMATION', 'STRUCTURED_CARD'].includes(aiText_(item.sourceRole).toUpperCase())
  );
  const authoritativeCertValues = new Map();
  authoritativeCertEvidence.forEach(item => {
    if (!authoritativeCertValues.has(item.normalizedValue)) authoritativeCertValues.set(item.normalizedValue, []);
    authoritativeCertValues.get(item.normalizedValue).push(item);
  });
  if (authoritativeCertValues.size === 1) {
    const state = fieldStates['expense.certification'];
    const authoritative = authoritativeCertEvidence.slice().sort((a, b) => b.authorityRank - a.authorityRank)[0];
    const value = authoritative.value && typeof authoritative.value === 'object' ? authoritative.value : {};
    const zero = !(Math.abs(Number(value.amountRub || 0)) > 0.000001 || Math.abs(Number(value.amountCny || 0)) > 0.000001);
    state.state = zero ? 'CONFIRMED_ZERO' : 'CONFIRMED';
    state.selectedValue = authoritative.value;
    state.reason = 'Подтверждённое каноническое значение сертификации имеет приоритет над более низкоприоритетным source noise.';
    state.candidates = [{normalizedValue: authoritative.normalizedValue, displayValue: authoritative.value, evidence: authoritativeCertValues.get(authoritative.normalizedValue).map(aiPublicEvidence_)}];
    const mismatched = certEvidence.filter(item => item.normalizedValue !== authoritative.normalizedValue);
    if (mismatched.length) {
      technicalFindings.push({
        findingId: 'TECH-STALE-CERTIFICATION-MISMATCH',
        type: 'LOWER_AUTHORITY_CERTIFICATION_MISMATCH',
        severity: 'INFO',
        managerQuestionRequired: false,
        fieldCode: 'expense.certification',
        authoritativeValue: authoritative.value,
        staleValues: mismatched.map(item => item.value),
        authoritativeSource: aiPublicEvidence_(authoritative),
        staleSources: mismatched.map(aiPublicEvidence_),
        message: 'Подтверждённое каноническое значение сертификации однозначно. Отличающиеся значения более низкого приоритета сохранены как техническое evidence и не создают вопрос менеджеру.'
      });
    }
  } else if (authoritativeCertValues.size > 1 || certValues.size > 1) {
    const state = fieldStates['expense.certification'];
    state.state = 'CONFLICT';
    const activeValues = authoritativeCertValues.size > 1 ? authoritativeCertValues : certValues;
    state.candidates = [...activeValues.entries()].map(([normalizedValue, items]) => ({normalizedValue, displayValue: items[0].value, evidence: items.map(aiPublicEvidence_)}));
    const question = buildAiQuestionEntry_(state,
      'В применимых источниках сертификация имеет разные статусы или суммы. Укажите корректный вариант и основание для этой сделки.');
    questions.push(question);
    conflicts.push(question);
  }

  const freightEvidence = evidenceIndex.get('logistics.internationalFreight') || [];
  const usdRateEvidence = (evidenceIndex.get('rates.usdRub') || []).slice()
    .sort((a, b) => b.authorityRank - a.authorityRank);
  const primaryFreightEvidence = freightEvidence.filter(item =>
    item.value && ['PARTNER_CALCULATION', 'INTERNAL_CALCULATOR'].includes(item.sourceRole)
  );
  const partnerFreight = primaryFreightEvidence.find(item => Number(item.value.amountUsd) > 0);
  const primaryRubFreight = primaryFreightEvidence.find(item => Number(item.value.amountRub) > 0);
  const outputFreight = freightEvidence.find(item =>
    item.value && Number(item.value.amountRub) > 0 && item.sourceRole === 'CLIENT_OUTPUT'
  );
  const usdRate = usdRateEvidence.find(item => Number(item.value) > 0);
  if (partnerFreight && outputFreight && usdRate) {
    const expectedRub = Number(partnerFreight.value.amountUsd) * Number(usdRate.value);
    const statedRub = Number(outputFreight.value.amountRub);
    const deltaRub = statedRub - expectedRub;
    const tolerance = Math.max(1, Math.abs(expectedRub) * 0.001);
    const primaryRubConsistent = !primaryRubFreight ||
      Math.abs(Number(primaryRubFreight.value.amountRub) - expectedRub) <= tolerance;
    if (Math.abs(deltaRub) > tolerance && primaryRubConsistent) {
      technicalFindings.push({
        findingId: 'TECH-DERIVED-CLIENT-FREIGHT-MISMATCH',
        type: 'DERIVED_CLIENT_OUTPUT_FREIGHT_MISMATCH',
        severity: 'MATERIALIZE_ON_EXPORT',
        managerQuestionRequired: false,
        fieldCode: 'logistics.internationalFreight',
        authoritativeValue: {
          amountUsd: Number(partnerFreight.value.amountUsd),
          usdRubRate: Number(usdRate.value),
          amountRub: roundTo_(expectedRub, 2)
        },
        derivedValue: {amountRub: roundTo_(statedRub, 2)},
        deltaRub: roundTo_(deltaRub, 2),
        authoritativeSources: [partnerFreight, primaryRubFreight, usdRate].filter(Boolean).map(aiPublicEvidence_),
        derivedSource: aiPublicEvidence_(outputFreight),
        message: 'Первичная USD-ставка международной доставки и применимый курс сделки однозначно задают пересчитанное значение. ' +
          (primaryRubFreight ? 'Первичное RUB-значение не противоречит пересчёту. ' : '') +
          'Отличающееся значение производного клиентского КП признано устаревшим и не создаёт вопрос менеджеру. ' +
          'При новом экспорте значение должно быть материализовано из текущего расчёта.'
      });
    } else if (Math.abs(deltaRub) > tolerance) {
      const question = {
        ruleId: 'LOG-009', fieldCode: 'logistics.internationalFreight', entity: 'LOGISTICS',
        fieldName: 'Конвертация международной доставки', state: 'CONFLICT',
        question: `Ставка международной доставки — ${formatManagerNumber_(partnerFreight.value.amountUsd, 2)} USD. ` +
          `По найденному курсу ${formatManagerNumber_(usdRate.value, 4)} RUB это ${formatManagerNumber_(expectedRub, 2)} RUB, ` +
          `однако в клиентском КП указано ${formatManagerNumber_(statedRub, 2)} RUB. ` +
          'Подтвердите применяемое значение и основание курса/конвертации.',
        required: true, blockingScope: 'CALCULATION_AND_FINAL_QUOTE',
        answerType: 'TEXT_OR_SINGLE_SELECT', writebackTarget: 'Расходы + Курсы + Проверки',
        candidates: [aiPublicEvidence_(partnerFreight), aiPublicEvidence_(outputFreight), aiPublicEvidence_(usdRate)],
        calculated: {expectedRub: roundTo_(expectedRub, 2), statedRub: roundTo_(statedRub, 2), deltaRub: roundTo_(deltaRub, 2)}
      };
      questions.push(question);
      conflicts.push(question);
    }
  }

  const vatProfiles = itemVatProfiles || [];
  let itemVatConflictCount = 0;
  const vatProfileResults = [];
  vatProfiles.forEach(profile => {
    const returnYes = profile.returnStatus === 'YES';
    const returnNo = profile.returnStatus === 'NO';
    const hasPriceBase = profile.priceExVat > 0 && profile.priceIncVat > 0;
    const hasNominalRate = profile.nominalVatRate !== null && profile.nominalVatRate >= 0;
    const hasSupplierRate = profile.supplierInvoiceVatRate !== null && profile.supplierInvoiceVatRate >= 0;
    const rateTolerance = 0.0005;
    const priceRateMatches = hasPriceBase && hasNominalRate &&
      Math.abs(profile.impliedVatRate - profile.nominalVatRate) <= rateTolerance;
    const supplierRateMatches = hasNominalRate && hasSupplierRate &&
      Math.abs(profile.supplierInvoiceVatRate - profile.nominalVatRate) <= rateTolerance;
    const managerConfirmation = aiCanonicalVatManagerConfirmation_(profile);

    let reconciliationStatus = returnNo ? 'VAT_REFUND_NOT_USED' : 'SOURCE_CONFIRMED';
    let reconciliationReason = returnNo
      ? 'По позиции возврат VAT не применяется.'
      : 'VAT-параметры индивидуального товарного листа согласованы.';

    if (returnYes && managerConfirmation.confirmed) {
      reconciliationStatus = 'CONFIRMED_BY_MANAGER_CANONICAL';
      reconciliationReason =
        'Менеджер явно подтвердил полный внутренне согласованный набор VAT в канонических полях товара.';
      auditNotes.push({
        type: 'ITEM_LEVEL_VAT_CONFIRMED_BY_MANAGER_CANONICAL',
        itemId: profile.itemId,
        itemNumber: profile.itemNumber,
        itemName: profile.itemName,
        sourceSupplierInvoiceVatRate: profile.supplierInvoiceVatRate,
        confirmedVatRate: managerConfirmation.vatRate,
        confirmedReturnStatus: managerConfirmation.returnStatus,
        message: `По товару №${profile.itemNumber || ''} исходное поле ставки поставщика ` +
          `${profile.supplierInvoiceVatRate === null ? 'не заполнено' : formatManagerNumber_(profile.supplierInvoiceVatRate * 100, 4) + '%'}` +
          ` сохранено как evidence. Менеджер подтвердил VAT ${formatManagerNumber_(managerConfirmation.vatRate * 100, 4)}% ` +
          `и возврат ${managerConfirmation.returnStatus}; повторный вопрос не требуется.`
      });
    } else if (returnYes && (!hasPriceBase || !hasNominalRate)) {
      reconciliationStatus = 'SOURCE_DATA_INCOMPLETE';
      reconciliationReason = 'Для заявленного возврата VAT не хватает подтверждённой цены без/с VAT и/или номинальной ставки VAT.';
      const question = {
        ruleId: `VAT-${String(profile.itemNumber || '').padStart(3, '0')}-SOURCE`,
        fieldCode: `item.${profile.itemNumber}.vatSourceReconciliation`,
        entity: 'ITEM', itemId: profile.itemId, itemNumber: profile.itemNumber,
        fieldName: 'Возврат VAT и ставка поставщика', state: 'MISSING',
        question: `По товару №${profile.itemNumber || ''} «${profile.itemName || ''}» возврат VAT отмечен «Да», ` +
          'но в индивидуальном товарном листе не найден минимально достаточный набор: цена без VAT, цена с VAT и номинальная ставка VAT. ' +
          'Укажите недостающие значения либо выберите «VAT не возвращается».',
        required: true, blockingScope: 'CALCULATION_AND_FINAL_QUOTE', answerType: 'STATUS_PLUS_VALUE',
        writebackTarget: 'Товары: цена без VAT / ставка VAT / статус возврата + решение менеджера',
        source: publicAiItemVatProfile_(profile, reconciliationStatus, reconciliationReason).source
      };
      questions.push(question);
      conflicts.push(question);
      itemVatConflictCount += 1;
    } else if (returnYes && !priceRateMatches) {
      reconciliationStatus = 'PRICE_RATE_CONFLICT';
      reconciliationReason = 'Цена без VAT и цена с VAT не соответствуют заявленной ставке.';
      const question = {
        ruleId: `VAT-${String(profile.itemNumber || '').padStart(3, '0')}-SOURCE`,
        fieldCode: `item.${profile.itemNumber}.vatSourceReconciliation`,
        entity: 'ITEM', itemId: profile.itemId, itemNumber: profile.itemNumber,
        fieldName: 'Возврат VAT и ставка поставщика', state: 'CONFLICT',
        question: `По товару №${profile.itemNumber || ''} цена без VAT ${formatManagerNumber_(profile.priceExVat, 6)} CNY ` +
          `и цена с VAT ${formatManagerNumber_(profile.priceIncVat, 6)} CNY дают ставку ${formatManagerNumber_(profile.impliedVatRate * 100, 4)}%, ` +
          `однако в источнике указано ${formatManagerNumber_(profile.nominalVatRate * 100, 4)}%. Подтвердите правильную ставку и базу возврата VAT.`,
        required: true, blockingScope: 'CALCULATION_AND_FINAL_QUOTE', answerType: 'STATUS_PLUS_VALUE',
        writebackTarget: 'Товары: цена без VAT / ставка VAT / статус возврата + решение менеджера',
        source: publicAiItemVatProfile_(profile, reconciliationStatus, reconciliationReason).source
      };
      questions.push(question);
      conflicts.push(question);
      itemVatConflictCount += 1;
    } else if (returnYes && hasSupplierRate && !supplierRateMatches) {
      reconciliationStatus = 'SUPPLIER_INVOICE_RATE_CONFLICT';
      reconciliationReason = 'Ставка в инвойсе поставщика противоречит цене и заявленной ставке VAT.';
      const question = {
        ruleId: `VAT-${String(profile.itemNumber || '').padStart(3, '0')}-SOURCE`,
        fieldCode: `item.${profile.itemNumber}.vatSourceReconciliation`,
        entity: 'ITEM', itemId: profile.itemId, itemNumber: profile.itemNumber,
        fieldName: 'Возврат VAT и ставка поставщика', state: 'CONFLICT',
        question: `По товару №${profile.itemNumber || ''} «${profile.itemName || ''}» цена без VAT ` +
          `${formatManagerNumber_(profile.priceExVat, 6)} CNY и цена с VAT ${formatManagerNumber_(profile.priceIncVat, 6)} CNY ` +
          `соответствуют ставке ${formatManagerNumber_(profile.nominalVatRate * 100, 4)}%, ` +
          `однако в поле «Кит. поставщик продаст товар с НДС %» указано ${formatManagerNumber_(profile.supplierInvoiceVatRate * 100, 4)}%. ` +
          'Подтвердите фактическую ставку НДС в инвойсе поставщика и возможность возврата VAT.',
        required: true, blockingScope: 'CALCULATION_AND_FINAL_QUOTE', answerType: 'STATUS_PLUS_VALUE',
        writebackTarget: 'Товары: ставка поставщика / статус возврата VAT + решение менеджера',
        source: publicAiItemVatProfile_(profile, reconciliationStatus, reconciliationReason).source
      };
      questions.push(question);
      conflicts.push(question);
      itemVatConflictCount += 1;
    } else if (returnYes) {
      if (!hasSupplierRate) {
        auditNotes.push({
          type: 'ITEM_LEVEL_VAT_SUPPLIER_RATE_REDUNDANTLY_ABSENT',
          itemId: profile.itemId,
          itemNumber: profile.itemNumber,
          itemName: profile.itemName,
          message: 'Отдельная дублирующая ставка VAT в инвойсе поставщика не заполнена, но цена без VAT, цена с VAT и номинальная ставка образуют полный согласованный набор текущего источника; вопрос менеджеру не требуется.'
        });
      }
      auditNotes.push({
        type: 'ITEM_LEVEL_VAT_SOURCE_CONFIRMED', itemId: profile.itemId,
        itemNumber: profile.itemNumber, itemName: profile.itemName,
        message: `VAT-параметры товара №${profile.itemNumber || ''} подтверждены индивидуальным листом: ` +
          `${formatManagerNumber_(profile.priceExVat, 6)} CNY без VAT, ${formatManagerNumber_(profile.priceIncVat, 6)} CNY с VAT, ` +
          `ставка ${formatManagerNumber_(profile.nominalVatRate * 100, 4)}%.`
      });
    }

    vatProfileResults.push({
      itemId: profile.itemId,
      itemNumber: profile.itemNumber,
      itemName: profile.itemName,
      reconciliation: publicAiItemVatProfile_(profile, reconciliationStatus, reconciliationReason)
    });

    if (profile.legacyBatchValue !== null && profile.canonicalBatchPrice > 0 &&
        !aiNumbersClose_(profile.legacyBatchValue, profile.canonicalBatchPrice, 0.01, 0.00001)) {
      technicalFindings.push({
        findingId: `TECH-STALE-ITEM-BATCH-${profile.itemId || profile.itemNumber}-${profile.sourceSheet}`,
        type: 'STALE_SOURCE_ITEM_BATCH_VALUE', severity: 'INFO', managerQuestionRequired: false,
        itemId: profile.itemId, itemNumber: profile.itemNumber, itemName: profile.itemName,
        sourceValue: profile.legacyBatchValue, sourceRawValue: profile.legacyBatchRaw,
        canonicalValue: profile.canonicalBatchPrice,
        delta: roundTo_(profile.legacyBatchValue - profile.canonicalBatchPrice, 6),
        currency: 'CNY',
        source: {
          fileId: profile.sourceFileId, fileName: profile.sourceFileName, fileUrl: profile.sourceUrl,
          sourceSheet: profile.sourceSheet, sourceCell: profile.cells.legacyBatchValue || ''
        },
        message: 'В индивидуальном товарном листе найден устаревший итог партии. ' +
          'Он сохранён как техническое замечание и не используется вместо подтверждённой стоимости партии.'
      });
    }
  });

  if (vatProfiles.length) {
    const vatState = fieldStates['vat.returnStatus'];
    vatState.state = itemVatConflictCount ? 'ITEM_LEVEL_CONFLICT' : 'ITEM_LEVEL_RECONCILED';
    vatState.selectedValue = {
      itemCount: vatProfiles.length,
      refundYesCount: vatProfiles.filter(profile => profile.returnStatus === 'YES').length,
      refundNoCount: vatProfiles.filter(profile => profile.returnStatus === 'NO').length,
      conflictCount: itemVatConflictCount
    };
    vatState.reason = itemVatConflictCount
      ? 'VAT-параметры связаны с конкретными товарами; по части позиций выявлены реальные противоречия источника.'
      : 'VAT-параметры связаны с конкретными товарами и согласованы по индивидуальным листам и/или явным подтверждениям менеджера.';
  }

  if (!vatProfiles.length) {
    const vatStatusEvidence = (evidenceIndex.get('vat.returnStatus') || []).filter(item => aiIsYesNoValue_(item.value));
    const vatYes = vatStatusEvidence.find(item => /^(?:да|yes|true|1)$/i.test(aiText_(item.value)));
    const priceEvidence = (evidenceIndex.get('vat.priceExVat') || []).filter(item => Number(item.value) > 0);
    const rateEvidence = (evidenceIndex.get('vat.rate') || []).filter(item => Number(item.value) > 0);
    if (vatYes && (!priceEvidence.length || !rateEvidence.length)) {
      const vatState = fieldStates['vat.returnStatus'];
      vatState.state = 'SOURCE_DATA_INCOMPLETE';
      vatState.selectedValue = 'YES';
      vatState.candidates = [{normalizedValue: 'yes', displayValue: 'Да', evidence: vatStatusEvidence.map(aiPublicEvidence_)}];
      vatState.reason = 'Возврат VAT заявлен, но отсутствует положительная цена без VAT и/или ставка VAT поставщика.';
      const question = buildAiQuestionEntry_(vatState,
        'Во внутреннем калькуляторе возврат VAT отмечен «Да», однако цена за единицу без VAT и ставка VAT поставщика равны нулю или не подтверждены. Укажите цену без VAT и фактическую ставку поставщика либо подтвердите, что VAT по этой сделке не возвращается.',
        {relatedFieldCodes: ['vat.priceExVat', 'vat.rate']});
      question.ruleId = 'VAT-002';
      question.fieldCode = 'vat.calculationInputs';
      question.fieldName = 'Исходные данные возврата VAT';
      question.blockingScope = 'CALCULATION_AND_FINAL_QUOTE';
      questions.push(question);
      conflicts.push(question);
    }
  }

  const dutyEvidence = evidenceIndex.get('customs.dutyMethod') || [];
  const authoritativeDutyEvidence = dutyEvidence.filter(item =>
    ['PARTNER_CALCULATION', 'INTERNAL_CALCULATOR', 'STRUCTURED_CARD', 'VERIFIED_SNAPSHOT'].includes(item.sourceRole)
  );
  const specificDutyEvidence = authoritativeDutyEvidence.filter(item =>
    /^(?:COMBINED_|PERCENT:|EUR_KG:|USD_KG:)/.test(aiText_(item.normalizedValue))
  );
  const dutyEvidenceForAuthority = specificDutyEvidence.length ? specificDutyEvidence : authoritativeDutyEvidence;
  const derivedDutyEvidence = dutyEvidence.filter(item =>
    item.sourceRole === 'CLIENT_OUTPUT' || (specificDutyEvidence.length && !specificDutyEvidence.includes(item))
  );
  const authoritativeDutyValues = new Map();
  dutyEvidenceForAuthority.forEach(item => {
    if (!authoritativeDutyValues.has(item.normalizedValue)) authoritativeDutyValues.set(item.normalizedValue, []);
    authoritativeDutyValues.get(item.normalizedValue).push(item);
  });
  const dutyState = fieldStates['customs.dutyMethod'];
  if (dutyState && authoritativeDutyValues.size === 1) {
    const authoritative = dutyEvidenceForAuthority.slice().sort((a, b) => b.authorityRank - a.authorityRank)[0];
    dutyState.state = 'CONFIRMED_BY_SOURCE';
    dutyState.selectedValue = authoritative.value;
    dutyState.candidates = [{
      normalizedValue: authoritative.normalizedValue,
      displayValue: authoritative.value,
      evidence: dutyEvidenceForAuthority.filter(item => item.normalizedValue === authoritative.normalizedValue).map(aiPublicEvidence_)
    }];
    dutyState.reason = 'Единственный непротиворечивый метод пошлины подтверждён текущим первичным расчётным источником; отдельный вопрос менеджеру не требуется.';

    const mismatchedDerived = derivedDutyEvidence.filter(item => item.normalizedValue !== authoritative.normalizedValue);
    if (mismatchedDerived.length) {
      technicalFindings.push({
        findingId: 'TECH-DERIVED-DUTY-METHOD-MISMATCH',
        type: 'DERIVED_OUTPUT_METHOD_NOTE_MISMATCH',
        severity: 'INFO',
        managerQuestionRequired: false,
        fieldCode: 'customs.dutyMethod',
        authoritativeValue: authoritative.value,
        derivedValues: mismatchedDerived.map(item => item.value),
        message: 'Комментарий о методе пошлины в производном клиентском КП отличается от первичного расчёта партнёра. Для сделки принят первичный расчёт; различие сохранено как техническое замечание.'
      });
    }
  }

  const dutyEvidenceForVerification = dutyEvidenceForAuthority.length ? dutyEvidenceForAuthority : dutyEvidence;
  const eurRateEvidence = evidenceIndex.get('customs.eurRubRate') || [];
  const hasEuroDuty = dutyEvidenceForVerification.some(item => /(?:евро|eur)/i.test(aiText_(item.value)));
  const validEurRate = eurRateEvidence.find(item => Number(item.value) > 0);
  const authoritativeConflict = authoritativeDutyValues.size > 1;
  if (authoritativeConflict || (hasEuroDuty && !validEurRate)) {
    const candidateLabels = authoritativeConflict
      ? [...authoritativeDutyValues.values()].map(items => ({value: items[0].value}))
      : aiStateCandidateLabels_(dutyState || {candidates: []});
    let questionText = authoritativeConflict
      ? `В первичных расчётных источниках найдены разные методы расчёта пошлины: ${candidateLabels.map(item => `«${item.value}»`).join(' и ')}. Подтвердите применяемый метод и основание.`
      : 'В первичном расчётном источнике используется комбинированная пошлина с компонентом EUR/кг.';
    if (hasEuroDuty && !validEurRate) {
      questionText += ' Для воспроизведения комбинированного варианта не найден подтверждённый курс EUR/RUB — укажите курс либо подтвердите импортированную сумму как ручное значение с основанием.';
    }
    const question = {
      ruleId: 'CUS-003', fieldCode: 'customs.combinedDutyVerification', entity: 'CUSTOMS',
      fieldName: 'Метод и проверяемость пошлины', state: authoritativeConflict ? 'CONFLICT' : 'DERIVED_UNVERIFIED',
      question: questionText,
      required: true, blockingScope: 'CALCULATION_AND_FINAL_QUOTE', answerType: 'TEXT_OR_SINGLE_SELECT',
      writebackTarget: 'Курсы / Методы пошлин / Проверки',
      candidates: dutyEvidenceForVerification.map(aiPublicEvidence_),
      relatedFieldCodes: ['customs.dutyMethod']
    };
    questions.push(question);
    conflicts.push(question);
  }

  const dealQty = (evidenceIndex.get('deal.totalQuantity') || []).slice().sort((a, b) => b.authorityRank - a.authorityRank)[0];
  const unitQty = (evidenceIndex.get('unitEconomics.totalQuantity') || []).slice().sort((a, b) => b.authorityRank - a.authorityRank)[0];
  if (dealQty && unitQty) {
    const delta = Number(unitQty.value) - Number(dealQty.value);
    if (Math.abs(delta) > 0.000001) {
      const itemQuantityTotal = sumNumbers_(
        (model.normalizedItems || [])
          .map(item => Number(item.quantity || 0))
          .filter(value => Number.isFinite(value) && value > 0)
      );
      const canonicalItemsConfirmDealTotal = itemQuantityTotal > 0 &&
        aiNumbersClose_(itemQuantityTotal, Number(dealQty.value), 0.000001, 0.000001);
      const unitEconomicsIsDerived = ['CLIENT_OUTPUT'].includes(aiText_(unitQty.sourceRole));

      if (canonicalItemsConfirmDealTotal && unitEconomicsIsDerived) {
        technicalFindings.push({
          findingId: 'TECH-DERIVED-UNIT-QUANTITY-MISMATCH',
          type: 'DERIVED_UNIT_ECONOMICS_QUANTITY_MISMATCH',
          severity: 'MATERIALIZE_ON_EXPORT',
          managerQuestionRequired: false,
          fieldCode: 'control.totalQuantityReconciliation',
          authoritativeQuantity: roundTo_(Number(dealQty.value), 6),
          canonicalItemQuantityTotal: roundTo_(itemQuantityTotal, 6),
          derivedUnitEconomicsQuantity: roundTo_(Number(unitQty.value), 6),
          delta: roundTo_(delta, 6),
          authoritativeSource: aiPublicEvidence_(dealQty),
          derivedSource: aiPublicEvidence_(unitQty),
          message: 'Сумма текущих канонических товарных строк совпадает со сводным количеством сделки. ' +
            'Отличающееся количество в производной юнит-экономике признано устаревшим и не создаёт вопрос менеджеру.'
        });
      } else {
        const question = {
          ruleId: 'CTRL-002', fieldCode: 'control.totalQuantityReconciliation', entity: 'CONTROL',
          fieldName: 'Сверка общего количества и товарных строк', state: 'RECONCILIATION_ERROR',
          question: `В сводной части указано ${formatManagerNumber_(dealQty.value, 3)} шт., ` +
            `а сумма количеств заполненных строк юнит-экономики равна ${formatManagerNumber_(unitQty.value, 3)} шт. ` +
            'Укажите отсутствующую позицию/единицу либо исправьте общий итог.',
          required: true, blockingScope: 'CALCULATION_AND_FINAL_QUOTE', answerType: 'TEXT_OR_SINGLE_SELECT',
          writebackTarget: 'Товары + Проверки',
          candidates: [aiPublicEvidence_(dealQty), aiPublicEvidence_(unitQty)], delta: roundTo_(delta, 6)
        };
        questions.push(question);
        conflicts.push(question);
      }
    }
  }

  const paymentScheduleEvidence = evidenceIndex.get('commercial.paymentSchedule') || [];
  paymentScheduleEvidence.forEach(item => {
    const schedule = item.value && typeof item.value === 'object' ? item.value : null;
    if (!schedule) return;
    const view = aiPaymentScheduleBusinessView_(schedule);
    const countMismatch = view.declaredCount > 0 && view.businessRows.length > 0 && view.declaredCount !== view.businessRows.length;
    if (view.technicalZeroRows.length) {
      auditNotes.push({
        type: 'PAYMENT_TECHNICAL_ZERO_ROWS_RECONCILED',
        sourceFileId: item.sourceFileId || '', sourceFileName: item.sourceFileName || '', sourceSheet: item.sourceSheet || '',
        ignoredRows: view.technicalZeroRows.map(row => ({row: row.row, label: row.label})),
        message: 'Нулевая резервная строка графика платежей исключена из числа этапов и сохранена только как технический резерв.'
      });
    }
    if (!countMismatch) return;
    technicalFindings.push({
      findingId: `TECH-PAYMENT-${item.sourceFileId || item.sourceFileName || 'SOURCE'}-${item.sourceSheet || ''}`,
      type: 'PAYMENT_PRESENTATION_MISMATCH', severity: 'REVIEW',
      fileId: item.sourceFileId || '', fileName: item.sourceFileName || '', fileUrl: item.sourceUrl || '',
      sheetName: item.sourceSheet || '', declaredPaymentCount: view.declaredCount,
      businessPaymentRowCount: view.businessRows.length,
      managerQuestionRequired: false,
      action: 'При генерации нового КП привести число отображаемых этапов к заголовку; технические резервные строки не выводить как действующие платежи.'
    });
  });

  const unresolvedChecks = (checkRecords || []).filter(record => {
    const status = aiText_(record['Статус']).toLowerCase();
    const severity = aiText_(record['Критичность']).toLowerCase();
    return /крит/.test(severity) && !/(?:подтвержден|подтверждён|пройден|исправлен|закрыт)/.test(status);
  });
  unresolvedChecks.forEach(record => {
    if (currentPreview.available && !aiLegacyCriticalCheckStillActive_(record, currentPreview.criticalChecks)) {
      technicalFindings.push({
        findingId: `TECH-STALE-CHECK-${aiText_(record['check_id']) || Utilities.getUuid()}`,
        type: 'STALE_CRITICAL_CHECK_RESOLVED_BY_CURRENT_MODEL',
        severity: 'INFO',
        managerQuestionRequired: false,
        fieldCode: `check.${aiText_(record['check_id'])}`,
        fieldName: aiText_(record['Поле или статья']) || 'Критическая проверка',
        previousCheck: record,
        message: 'Старая критическая проверка больше не воспроизводится текущим read-only детерминированным расчётом. Она сохранена как технический след и не создаёт вопрос менеджеру.'
      });
      return;
    }
    const question = {
      ruleId: 'CTRL-001', fieldCode: `check.${aiText_(record['check_id'])}`, entity: 'CHECK',
      fieldName: aiText_(record['Поле или статья']) || 'Критическая проверка', state: 'CONFLICT',
      question: `Текущая детерминированная модель воспроизводит нерешённую критическую проверку «${aiText_(record['Поле или статья'])}»: ` +
        `${aiText_(record['Исходное значение'])} против ${aiText_(record['Пересчитанное значение'])}. ` +
        'Укажите корректный вариант или основание различия.',
      required: true, blockingScope: 'CALCULATION', answerType: 'TEXT_OR_SINGLE_SELECT',
      writebackTarget: 'Проверки / Решения по расхождениям', evidence: record
    };
    questions.push(question);
    conflicts.push(question);
  });

  const verifiedCustoms = aiHasVerifiedCustoms_(checkRecords, latestSnapshot);
  if (!verifiedCustoms) {
    (model.normalizedItems || []).forEach(item => {
      const currentCustomsErrors = currentPreview.available
        ? (currentPreview.customsErrorsByItem.get(aiText_(item.itemId)) || [])
        : [];
      const customsResolvableNow = currentPreview.available && currentCustomsErrors.length === 0;
      if (customsResolvableNow) {
        auditNotes.push({
          type: 'CUSTOMS_CONFIRMED_BY_CURRENT_DETERMINISTIC_SOURCE',
          itemId: item.itemId,
          itemNumber: item.itemNumber,
          message: 'Текущая read-only модель детерминированно рассчитывает пошлину и импортный НДС по данным сделки; отдельный вопрос менеджеру не требуется.'
        });
        return;
      }
      if (!item.dutyMethodConfirmed || !item.importVatConfirmed || currentCustomsErrors.length) {
        const detail = currentCustomsErrors.length
          ? currentCustomsErrors.map(error => aiText_(error.message)).filter(Boolean).join('; ')
          : 'не хватает детерминированного основания метода/ставки пошлины или ставки импортного НДС';
        const question = {
          ruleId: 'CUS-001', fieldCode: `item.${item.itemNumber}.customs`, entity: 'ITEM',
          itemId: item.itemId, itemNumber: item.itemNumber, fieldName: 'Метод пошлины и импортный НДС',
          state: 'MISSING', question: `По товару №${item.itemNumber || ''} текущий расчёт не может детерминированно завершить таможенный блок: ${detail}. Укажите только недостающее значение или основание.`,
          required: true, blockingScope: 'CALCULATION', answerType: 'SINGLE_SELECT_WITH_OTHER',
          writebackTarget: 'Товары + Решения по расхождениям + Проверки'
        };
        questions.push(question);
      }
    });
  } else {
    auditNotes.push({type: 'CUSTOMS_CONFIRMED_BY_VERIFIED_CALCULATION', message: 'Пошлина и импортный НДС подтверждены проверенным расчётом/контрольными проверками; пустые сырые флаги товара не превращены в вопросы.'});
  }

  const uniqueTechnicalFindings = [];
  const technicalFindingIds = new Set();
  technicalFindings.forEach(finding => {
    const key = finding.findingId || JSON.stringify([finding.type, finding.fileId, finding.sheetName, finding.message]);
    if (technicalFindingIds.has(key)) return;
    technicalFindingIds.add(key);
    uniqueTechnicalFindings.push(finding);
  });
  return {questions, conflicts, technicalFindings: uniqueTechnicalFindings, auditNotes, itemVatProfiles: vatProfileResults};
}


function buildAiStaleSourceItemFindingsFallback_(importedRecords, itemVatProfiles) {
  const findings = [];
  const records = importedRecords || [];
  (itemVatProfiles || []).forEach(profile => {
    const cell = aiText_((profile.cells || {}).legacyBatchValue);
    if (!cell || !(profile.canonicalBatchPrice > 0)) return;

    const record = records.find(item => {
      const sameFile = (profile.sourceFileId && aiText_(item['ID исходного файла']) === aiText_(profile.sourceFileId)) ||
        (profile.sourceFileName && aiText_(item['Исходный файл']) === aiText_(profile.sourceFileName));
      return sameFile && aiText_(item['Лист']) === aiText_(profile.sourceSheet) &&
        normalizeAiSourceCell_(item['Ячейка']) === normalizeAiSourceCell_(cell);
    });
    if (!record) return;

    let sourceValue = aiNumberFromImportedRecord_(record);
    if (sourceValue === null) sourceValue = aiLastNumberFromText_(aiCellValue_(record));
    if (sourceValue === null || !Number.isFinite(sourceValue)) return;
    if (aiNumbersClose_(sourceValue, profile.canonicalBatchPrice, 0.01, 0.00001)) return;

    findings.push({
      findingId: `TECH-STALE-ITEM-BATCH-${profile.itemId || profile.itemNumber}-${profile.sourceSheet}`,
      type: 'STALE_SOURCE_ITEM_BATCH_VALUE',
      severity: 'INFO',
      managerQuestionRequired: false,
      itemId: profile.itemId,
      itemNumber: profile.itemNumber,
      itemName: profile.itemName,
      sourceValue,
      sourceRawValue: aiCellValue_(record),
      canonicalValue: profile.canonicalBatchPrice,
      delta: roundTo_(sourceValue - profile.canonicalBatchPrice, 6),
      currency: 'CNY',
      source: {
        fileId: profile.sourceFileId,
        fileName: profile.sourceFileName,
        fileUrl: profile.sourceUrl,
        sourceSheet: profile.sourceSheet,
        sourceCell: cell
      },
      message: 'В индивидуальном товарном листе найден устаревший итог партии. ' +
        'Он сохранён как техническое замечание и не используется вместо подтверждённой стоимости партии.'
    });
  });
  return findings;
}


function buildAiStaleSourceItemFindingsFromExtractedData_(importedRecords, extractedItems) {
  const findings = [];
  const records = importedRecords || [];

  (extractedItems || []).forEach(item => {
    const reconciliation = item && item.vatSourceReconciliation ? item.vatSourceReconciliation : {};
    const source = reconciliation.source || {};
    const sourceCells = source.sourceCells || {};
    const legacyCell = aiText_(sourceCells.legacyBatchValue);
    const canonicalValue = Number(item && item.batchPrice);
    if (!legacyCell || !Number.isFinite(canonicalValue) || canonicalValue <= 0) return;

    const record = records.find(candidate => {
      const sameFile = (source.fileId && aiText_(candidate['ID исходного файла']) === aiText_(source.fileId)) ||
        (source.fileName && aiText_(candidate['Исходный файл']) === aiText_(source.fileName));
      return sameFile && aiText_(candidate['Лист']) === aiText_(source.sourceSheet) &&
        normalizeAiSourceCell_(candidate['Ячейка']) === normalizeAiSourceCell_(legacyCell);
    });
    if (!record) return;

    // Формульная ячейка является рабочим расчётом источника, а не устаревшим ручным итогом.
    if (aiCellFormula_(record)) return;

    const rawValue = aiCellValue_(record);
    const rawSourceValue = aiText_(record['Исходное значение']);
    const looksLikeManualExpression = /[=+*/]/.test(rawSourceValue);
    let sourceValue = looksLikeManualExpression
      ? aiLastNumberFromText_(rawValue)
      : aiNumberFromImportedRecord_(record);
    if (sourceValue === null || !Number.isFinite(sourceValue)) {
      sourceValue = aiLastNumberFromText_(rawValue);
    }
    if (sourceValue === null || !Number.isFinite(sourceValue)) return;
    if (aiNumbersClose_(sourceValue, canonicalValue, 0.01, 0.00001)) return;

    findings.push({
      findingId: `TECH-STALE-ITEM-BATCH-${item.itemId || item.itemNumber}-${source.sourceSheet}`,
      type: 'STALE_SOURCE_ITEM_BATCH_VALUE',
      severity: 'INFO',
      managerQuestionRequired: false,
      itemId: item.itemId,
      itemNumber: item.itemNumber,
      itemName: item.name,
      sourceValue,
      sourceRawValue: rawValue,
      canonicalValue,
      delta: roundTo_(sourceValue - canonicalValue, 6),
      currency: item.priceCurrency || 'CNY',
      source: {
        fileId: source.fileId || '',
        fileName: source.fileName || '',
        fileUrl: source.fileUrl || '',
        sourceSheet: source.sourceSheet || '',
        sourceCell: legacyCell
      },
      message: 'В индивидуальном товарном листе найден ручной/исторический итог партии, ' +
        'который отличается от подтверждённой стоимости партии. Значение сохранено как техническое замечание и не используется в расчёте.'
    });
  });

  return findings;
}


function aiFindKnownProductTotals_(records) {
  const totals = [];
  const groups = new Map();
  (records || []).forEach(function(record) {
    const key = aiSheetKey_(aiSourceKeyFromRecord_(record), record['Лист']);
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(record);
  });
  groups.forEach(function(sheetRecords) {
    const grid = buildAiSheetGrid_(sheetRecords);
    sheetRecords.forEach(function(record) {
      const label = aiCellValue_(record);
      if (!/(?:стоимость товара у поставщика|^стоимость товара$)/i.test(label)) return;
      const pos = aiRecordPosition_(record);
      const rowNumerics = aiNumericRecordsInRow_(sheetRecords, pos.row);
      rowNumerics.forEach(function(item) {
        const value = Math.abs(Number(item.value));
        if (!(value > 0)) return;
        const currency = aiInferCurrencyForRecord_(item.record, sheetRecords);
        if (['CNY', 'RUB', 'USD', 'EUR'].includes(currency)) {
          totals.push({value: value, currency: currency, record: item.record});
        }
      });
    });
  });
  return totals;
}

function aiFindSharedTnVedFromRecords_(records) {
  const groups = new Map();
  (records || []).forEach(function(record) {
    const key = aiSheetKey_(aiSourceKeyFromRecord_(record), record['Лист']);
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(record);
  });
  let best = '';
  groups.forEach(function(sheetRecords) {
    if (best) return;
    const grid = buildAiSheetGrid_(sheetRecords);
    sheetRecords.forEach(function(record) {
      if (best || !/(?:код\s*)?тн\s*вэд/i.test(aiCellValue_(record))) return;
      const valueRecord = findAiRightValueRecord_(record, grid) || findAiAdjacentValueRecord_(record, grid);
      const digits = aiText_(aiCellValue_(valueRecord)).replace(/\D/g, '');
      if (digits.length >= 6) best = digits;
    });
  });
  return best;
}

function buildAiSourceItemRecords_(importedRecords, sourceCatalog) {
  const groups = new Map();
  (importedRecords || []).forEach(record => {
    const key = aiSheetKey_(aiSourceKeyFromRecord_(record), record['Лист']);
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(record);
  });
  const sharedTnVed = aiFindSharedTnVedFromRecords_(importedRecords);
  const items = [];

  function priceHeaderScore_(text) {
    const value = aiText_(text).toLowerCase().replace(/\s+/g, ' ').trim();
    if (!value) return -999;
    if (/за ед rub|за единицу rub|итог|под ключ|услуги|расходы|маржа|комисси/.test(value)) return -100;
    if (/стоимость\s+ед\s*товар|стоимость\s+единиц[ыа]\s*товар|цена\s+за\s+1\s*шт|цена.*без vat/.test(value)) return 120;
    if (/стоимость\s+(?:1\s*)?(?:шт|ед(?:\.|иниц)?|товар)|цена.*(?:шт|единиц|ед\.?)/.test(value)) return 100;
    if (/^сумма$/.test(value)) return 40;
    return -999;
  }

  groups.forEach(records => {
    const fileKey = aiSourceKeyFromRecord_(records[0]);
    const sheetName = aiText_(records[0]['Лист']);
    const role = sourceCatalog.sheetRoleByKey.get(aiSheetKey_(fileKey, sheetName)) || 'UNKNOWN';
    if (!['CLIENT_OUTPUT', 'ORDER', 'PARTNER_CALCULATION', 'INTERNAL_CALCULATOR', 'UNIT_ECONOMICS_OUTPUT', 'UNKNOWN'].includes(role)) return;
    const sourceFile = (sourceCatalog.files || []).find(file => aiFileKey_(file.fileId, file.fileName) === fileKey) || {};
    const rowMap = new Map();
    records.forEach(record => {
      const pos = aiRecordPosition_(record);
      if (!rowMap.has(pos.row)) rowMap.set(pos.row, []);
      rowMap.get(pos.row).push(record);
    });

    let selectedHeader = null;
    rowMap.forEach((rowRecords, rowNumber) => {
      const fields = {rowNumber, nameCol: 0, unitCol: 0, qtyCol: 0, priceCol: 0, priceScore: -999, priceHeader: ''};
      rowRecords.forEach(record => {
        const col = aiRecordPosition_(record).col;
        const text = aiCellValue_(record);
        if (/наименование.*товар|описание груза/i.test(text)) fields.nameCol = col;
        if (/^ед\.?\s*изм|единица измер/i.test(text)) fields.unitCol = col;
        if (/^кол-?во$|^количество(?:,?\s*шт\.?)?$/i.test(text)) fields.qtyCol = col;
        const score = priceHeaderScore_(text);
        if (score > fields.priceScore) { fields.priceScore = score; fields.priceCol = col; fields.priceHeader = text; }
      });
      if (fields.nameCol && fields.qtyCol && fields.priceCol && fields.priceScore > 0) {
        if (!selectedHeader || fields.priceScore > selectedHeader.priceScore ||
            (fields.priceScore === selectedHeader.priceScore && fields.rowNumber < selectedHeader.rowNumber)) selectedHeader = fields;
      }
    });
    if (!selectedHeader) return;

    [...rowMap.keys()].sort((a,b)=>a-b).forEach(rowNumber => {
      if (rowNumber <= selectedHeader.rowNumber) return;
      const byCol = new Map((rowMap.get(rowNumber) || []).map(record => [aiRecordPosition_(record).col, record]));
      const nameRecord = byCol.get(selectedHeader.nameCol);
      const qtyRecord = byCol.get(selectedHeader.qtyCol);
      const priceRecord = byCol.get(selectedHeader.priceCol);
      const name = aiCellValue_(nameRecord);
      const quantity = parseFlexibleNumber_(aiCellValue_(qtyRecord));
      const unitPrice = parseFlexibleNumber_(aiCellValue_(priceRecord));
      if (!name || /итого/i.test(name) || !(quantity > 0) || !(unitPrice > 0)) return;
      const unitRecord = selectedHeader.unitCol ? byCol.get(selectedHeader.unitCol) : null;
      const unit = aiCellValue_(unitRecord) || 'шт.';
      const currency = aiInferCurrencyForRecord_(priceRecord, records) || aiNormalizeCurrency_(selectedHeader.priceHeader) || 'CNY';
      const sourceCells = [nameRecord, qtyRecord, priceRecord].filter(Boolean).map(record => aiText_(record['Ячейка'])).filter(Boolean).join(',');
      items.push({
        item_id: 'SRCITEM-' + Utilities.getUuid(),
        'Номер позиции': items.length + 1,
        'Наименование товара': name,
        'Количество': quantity,
        'Единица количества': unit,
        'Цена за единицу': roundTo_(unitPrice, 8),
        'Стоимость партии': roundTo_(quantity * unitPrice, 8),
        'Валюта цены': currency,
        'Код ТН ВЭД': sharedTnVed,
        source_file: aiText_(nameRecord && nameRecord['Исходный файл']),
        source_sheet: sheetName,
        source_cell: sourceCells,
        source_type: 'SOURCE_SPECIFICATION_TABLE',
        _aiSourceRole: role,
        _aiSourceFilePrimaryRole: sourceFile.primaryRole || role,
        _aiSourcePriceMode: 'UNIT_PRICE',
        _aiSourcePriceHeader: selectedHeader.priceHeader
      });
    });
  });

  const rolePriority = {ORDER: 110, INTERNAL_CALCULATOR: 100, PARTNER_CALCULATION: 90, CLIENT_OUTPUT: 80, UNIT_ECONOMICS_OUTPUT: 70, UNKNOWN: 40};
  const deduplicated = [];
  const indexBySignature = new Map();
  items.forEach(item => {
    const signature = [normalizeRecognitionText_(item['Наименование товара']), roundTo_(Number(item['Количество'] || 0), 6),
      normalizeRecognitionText_(item['Единица количества']), aiText_(item['Валюта цены']).toUpperCase(),
      roundTo_(Number(item['Цена за единицу'] || 0), 6)].join('|');
    if (!indexBySignature.has(signature)) {
      indexBySignature.set(signature, deduplicated.length);
      deduplicated.push(item);
      return;
    }
    const existingIndex = indexBySignature.get(signature);
    const existing = deduplicated[existingIndex];
    const existingPriority = rolePriority[existing._aiSourceFilePrimaryRole] || rolePriority[existing._aiSourceRole] || 0;
    const candidatePriority = rolePriority[item._aiSourceFilePrimaryRole] || rolePriority[item._aiSourceRole] || 0;
    const alt = {sourceFile: item.source_file, sourceSheet: item.source_sheet, sourceCell: item.source_cell,
      sourceRole: item._aiSourceRole, filePrimaryRole: item._aiSourceFilePrimaryRole};
    if (candidatePriority > existingPriority) {
      item._aiAlternativeSources = (existing._aiAlternativeSources || []).concat([{
        sourceFile: existing.source_file, sourceSheet: existing.source_sheet, sourceCell: existing.source_cell,
        sourceRole: existing._aiSourceRole, filePrimaryRole: existing._aiSourceFilePrimaryRole
      }]);
      deduplicated[existingIndex] = item;
    } else existing._aiAlternativeSources = (existing._aiAlternativeSources || []).concat([alt]);
  });
  deduplicated.forEach((item,index)=>item['Номер позиции']=index+1);
  return deduplicated;
}

function buildAiManagerIntakeCore_(model, prepared) {
  const sourceTraceability = prepared.sourceTraceability || {files: [], importsByName: new Map()};
  const importedRecords = prepared.importedCellRecords || [];
  const checkRecords = prepared.checkRecords || [];
  const latestSnapshot = prepared.latestVerifiedSnapshot || null;
  const sourceCatalog = buildAiSourceCatalog_(sourceTraceability, importedRecords);
  const itemVatProfiles = buildAiItemVatProfiles_(model, importedRecords, sourceCatalog);
  const evidenceIndex = extractAiFieldEvidence_(model, sourceCatalog, importedRecords, latestSnapshot);
  const fieldStates = reconcileAiFieldStates_(evidenceIndex);
  const derivedStateAuditNotes = reconcileAiDerivedFieldStates_(fieldStates, model, evidenceIndex, checkRecords, latestSnapshot);
  const importedCellIndex = prepared.importedCellIndex || {byCell: new Map(), byRow: new Map()};

  const extractedData = {
    deal: {
      manager: fieldStates['deal.manager'].selectedValue || '',
      client: fieldStates['deal.client'].selectedValue || '',
      quoteCurrency: fieldStates['deal.quoteCurrency'].selectedValue || '',
      quoteValidityDays: fieldStates['deal.validityDays'].selectedValue || '',
      scheme: fieldStates['deal.scheme'].selectedValue || '',
      incoterms: fieldStates['logistics.incoterms'].selectedValue || '',
      chinaRoute: fieldStates['logistics.chinaRoute'].selectedValue || '',
      borderCrossing: fieldStates['logistics.borderCrossing'].selectedValue || '',
      destinationCity: fieldStates['logistics.destinationCity'].selectedValue || '',
      transportMode: fieldStates['logistics.transportMode'].selectedValue || '',
      deliveryDays: fieldStates['logistics.deliveryDays'].selectedValue || '',
      productionDays: fieldStates['logistics.productionDays'].selectedValue || ''
    },
    items: [],
    commission: {
      type: model.commissionInput ? model.commissionInput.type : '',
      value: model.commissionInput ? model.commissionInput.value : '',
      base: model.commissionInput ? model.commissionInput.base : '',
      currency: model.commissionInput ? model.commissionInput.currency : '',
      minimumCny: model.commissionInput ? model.commissionInput.minimumCny : '',
      confirmationStatus: 'CONFIRMED_BY_APPROVED_RULE',
      managerConfirmationRequired: false,
      source: 'GLOBAL_APPROVED_RULE'
    },
    sourceFiles: sourceTraceability.files || [],
    latestVerifiedSnapshot: latestSnapshot
  };

  const missingInputs = [];
  const conflicts = [];
  const auditNotes = derivedStateAuditNotes.slice();
  if (model && model._aiSourceItemRecovery && !['CANONICAL_ONLY', 'CANONICAL_PRESERVED', 'NONE'].includes(model._aiSourceItemRecovery.mode)) {
    auditNotes.push({
      type: 'SOURCE_ITEM_RECOVERY_FOR_MANAGER_INTAKE',
      mode: model._aiSourceItemRecovery.mode,
      canonicalCount: model._aiSourceItemRecovery.canonicalCount,
      sourceCount: model._aiSourceItemRecovery.sourceCount,
      message: 'Недостающие товарные поля для manager-intake восстановлены только из текущих документов сделки; повторные вопросы по найденным значениям не создаются.'
    });
  }
  const recoveredCachedRecords = importedRecords.filter(record => Boolean(record && record['_aiCachedFallback']));
  if (recoveredCachedRecords.length) {
    auditNotes.push({
      type: 'XLSX_CACHED_VALUES_RECOVERED',
      recoveredCellCount: recoveredCachedRecords.length,
      message: `Из исходных XLSX восстановлено ${recoveredCachedRecords.length} кэшированных значений ячеек с разрушенными внешними ссылками.`
    });
  }
  let managerQuestions = buildAiCoreFieldQuestions_(fieldStates, latestSnapshot);
  const itemQuestions = buildAiItemQuestions_(model, sourceTraceability, importedCellIndex, extractedData, conflicts, auditNotes);
  managerQuestions.push(...itemQuestions);

  const special = buildAiSpecialFindings_(model, fieldStates, evidenceIndex, checkRecords, latestSnapshot, itemVatProfiles);
  managerQuestions.push(...special.questions);
  conflicts.push(...special.conflicts);
  auditNotes.push(...special.auditNotes);

  const verifiedClosure = reconcileAiVerifiedCalculationClosure_(
    prepared.spreadsheet || null, model, latestSnapshot, fieldStates, managerQuestions, conflicts, auditNotes
  );
  managerQuestions = verifiedClosure.managerQuestions;
  conflicts.splice(0, conflicts.length, ...verifiedClosure.conflicts);
  const ownerDecisionsPending = buildAiOwnerDecisionsPending_(fieldStates);
  const vatResultByItemId = new Map((special.itemVatProfiles || []).map(entry => [entry.itemId, entry.reconciliation]));
  extractedData.items.forEach(item => {
    if (vatResultByItemId.has(item.itemId)) item.vatSourceReconciliation = vatResultByItemId.get(item.itemId);
  });

  Object.values(fieldStates).forEach(state => {
    const hasRelatedQuestion = managerQuestions.some(question =>
      question.fieldCode === state.fieldCode || (question.relatedFieldCodes || []).includes(state.fieldCode)
    );
    if (['MISSING', 'FOUND_UNCONFIRMED', 'UNCONFIRMED_ZERO'].includes(state.state) && hasRelatedQuestion) {
      missingInputs.push({
        ruleId: state.ruleId, entity: state.fieldCode.split('.')[0].toUpperCase(),
        field: state.fieldCode, fieldName: state.fieldName, state: state.state,
        required: true, blockingScope: state.blockingScope, reason: state.reason,
        candidates: state.candidates, defaultSuggestions: state.defaultSuggestions
      });
    }
    if (state.state === 'CONFLICT' && hasRelatedQuestion) {
      conflicts.push({
        ruleId: state.ruleId, entity: state.fieldCode.split('.')[0].toUpperCase(),
        field: state.fieldCode, fieldName: state.fieldName, state: state.state,
        required: true, blockingScope: state.blockingScope, reason: state.reason,
        candidates: state.candidates
      });
    }
  });

  const technicalFindings = (special.technicalFindings || [])
    .concat(verifiedClosure.technicalFindings || []);
  const existingFindingIds = new Set(technicalFindings.map(item => item.findingId));
  buildAiStaleSourceItemFindingsFallback_(importedRecords, itemVatProfiles).forEach(item => {
    if (!existingFindingIds.has(item.findingId)) {
      technicalFindings.push(item);
      existingFindingIds.add(item.findingId);
    }
  });
  buildAiStaleSourceItemFindingsFromExtractedData_(importedRecords, extractedData.items).forEach(item => {
    if (!existingFindingIds.has(item.findingId)) {
      technicalFindings.push(item);
      existingFindingIds.add(item.findingId);
    }
  });
  const unresolvedExternalFormulaRecords = importedRecords.filter(record => {
    const formula = aiCellFormula_(record);
    return /\[[^\]]+\][^!]*!/.test(formula) && aiIsSpreadsheetErrorValue_(aiCellValue_(record));
  });
  sourceCatalog.files.forEach(file => {
    if (file.externalReferenceCount > 0) {
      const fileKey = aiFileKey_(file.fileId, file.fileName);
      const unresolvedReferenceCount = unresolvedExternalFormulaRecords.filter(record =>
        aiSourceKeyFromRecord_(record) === fileKey
      ).length;
      const recovered = unresolvedReferenceCount === 0;
      technicalFindings.push({
        findingId: `TECH-EXTERNAL-${file.fileId || file.fileName}`,
        type: recovered ? 'EXTERNAL_DEPENDENCY_MATERIALIZE_ON_EXPORT' : 'EXTERNAL_DEPENDENCY_UNRESOLVED',
        severity: recovered ? 'MATERIALIZE_ON_EXPORT' : 'BLOCK_TECHNICAL_EXPORT',
        fileId: file.fileId, fileName: file.fileName, fileUrl: file.fileUrl,
        externalReferenceCount: file.externalReferenceCount,
        unresolvedReferenceCount: unresolvedReferenceCount,
        cachedValuesRecovered: recovered,
        managerQuestionRequired: false,
        action: recovered
          ? 'При генерации нового технического XLSX использовать восстановленные значения, материализовать формулы и удалить внешние связи.'
          : 'Технический экспорт заблокирован: восстановить оставшиеся значения формул, затем материализовать данные и удалить внешние связи.'
      });
    }
  });

  const schemeStateForTemplate = fieldStates['deal.scheme'];
  const schemeTemplateGuidance = schemeStateForTemplate.templateGuidance || [];
  if (schemeStateForTemplate.selectedValue && schemeTemplateGuidance.length) {
    const selectedCanonical = aiCanonicalValue_('deal.scheme', schemeStateForTemplate.selectedValue);
    const templateCanonical = aiCanonicalValue_('deal.scheme', schemeTemplateGuidance[0].value);
    if (selectedCanonical && templateCanonical && selectedCanonical !== templateCanonical) {
      technicalFindings.push({
        findingId: 'TECH-ACTIVE-TEMPLATE-SCHEME-MISMATCH',
        type: 'ACTIVE_TEMPLATE_GUIDANCE_MISMATCH',
        severity: 'INFO',
        managerQuestionRequired: false,
        fieldCode: 'deal.scheme',
        sourceValue: aiSchemeLabel_(schemeStateForTemplate.selectedValue),
        activeTemplateValue: aiSchemeLabel_(schemeTemplateGuidance[0].value),
        message: 'Активный шаблон не является фактом сделки и исключён из источников конфликта; различие сохранено как техническое предупреждение.'
      });
    }
  }

  const seenQuestionKeys = new Set();
  const uniqueQuestions = managerQuestions.filter(question => {
    const key = `${question.ruleId}|${question.fieldCode}|${question.itemId || ''}|${question.itemNumber || ''}`;
    if (seenQuestionKeys.has(key)) return false;
    seenQuestionKeys.add(key);
    return true;
  });
  uniqueQuestions.forEach((question, index) => {
    question.questionId = `Q-${String(index + 1).padStart(3, '0')}`;
  });

  const seenConflictKeys = new Set();
  const uniqueConflicts = conflicts.filter(function(conflict) {
    let semanticField = conflict.fieldCode || conflict.field || '';
    if (semanticField === 'customs.combinedDutyVerification') semanticField = 'customs.dutyMethod';
    const key = [semanticField, conflict.itemId || '', conflict.itemNumber || '', conflict.type || ''].join('|');
    if (seenConflictKeys.has(key)) return false;
    seenConflictKeys.add(key);
    return true;
  });

  const calculationBlocked = uniqueQuestions.some(question => aiScopeBlocksCalculation_(question.blockingScope));
  const quoteBlockedByQuestion = uniqueQuestions.some(question => aiScopeBlocksQuote_(question.blockingScope));
  const quoteBlockedByTechnicalFinding = technicalFindings.some(item => item.severity === 'BLOCK_FINAL_QUOTE');
  const quoteBlockedByOwnerDecision = ownerDecisionsPending.some(item => aiScopeBlocksQuote_(item.blockingScope));
  const quoteBlocked = calculationBlocked || quoteBlockedByQuestion || quoteBlockedByTechnicalFinding || quoteBlockedByOwnerDecision;
  const technicalExportAllowed = !technicalFindings.some(item => item.severity === 'BLOCK_TECHNICAL_EXPORT');

  const publicFieldStates = Object.keys(fieldStates).map(key => fieldStates[key]);
  const packageStatus = quoteBlocked
    ? (calculationBlocked ? 'NEEDS_MANAGER_INPUT_BEFORE_CALCULATION' : 'NEEDS_MANAGER_INPUT_BEFORE_FINAL_QUOTE')
    : 'READY_FOR_CALCULATION_AND_QUOTE';

  return {
    dealNumber: aiText_((model.dealRecord || {})['Номер сделки']),
    packageStatus,
    calculationAllowed: !calculationBlocked,
    quoteAllowed: !quoteBlocked,
    technicalExportAllowed,
    sourceCatalog: sourceCatalog.files,
    fieldStates: publicFieldStates,
    extractedData,
    missingInputs,
    conflicts: uniqueConflicts,
    managerQuestions: uniqueQuestions,
    technicalFindings,
    auditNotes,
    ownerDecisionsPending,
    verifiedCalculationClosure: {
      active: Boolean(verifiedClosure.verification && verifiedClosure.verification.active),
      reason: verifiedClosure.verification ? verifiedClosure.verification.reason : '',
      snapshotId: latestSnapshot ? latestSnapshot.snapshotId : ''
    },
    confirmationSummary: {
      instruction: 'Используйте значения из текущих документов сделки без повторного подтверждения. Менеджеру задаются только вопросы по действительно отсутствующим данным или реальным конфликтам; после устранения блокирующих пробелов формируйте КП.',
      deal: extractedData.deal,
      commission: extractedData.commission,
      itemCount: extractedData.items.length,
      items: extractedData.items,
      blockingQuestionCount: uniqueQuestions.filter(question => aiScopeBlocksCalculation_(question.blockingScope)).length,
      finalQuoteQuestionCount: uniqueQuestions.filter(question => !aiScopeBlocksCalculation_(question.blockingScope) && aiScopeBlocksQuote_(question.blockingScope)).length,
      ownerDecisionCount: ownerDecisionsPending.length
    }
  };
}

function aiItemIntakeCompletenessScore_(item) {
  if (!item) return 0;
  let score = 0;
  if (aiText_(item['Наименование товара'])) score += 1;
  if (parseFlexibleNumber_(item['Количество']) > 0) score += 1;
  if (aiText_(item['Единица количества'])) score += 1;
  if (parseFlexibleNumber_(item['Цена за единицу']) > 0 || parseFlexibleNumber_(item['Стоимость партии']) > 0) score += 1;
  if (aiText_(item['Валюта цены'])) score += 1;
  if (aiText_(item['Код ТН ВЭД']).replace(/\D/g, '').length >= 6) score += 1;
  return score;
}

function aiFillMissingItemFieldsFromSource_(canonicalItem, sourceItem) {
  const merged = Object.assign({}, canonicalItem || {});
  const source = sourceItem || {};
  const textFields = ['Наименование товара', 'Единица количества', 'Валюта цены', 'Код ТН ВЭД'];
  const numericFields = ['Количество', 'Цена за единицу', 'Стоимость партии'];

  textFields.forEach(field => {
    if (!aiText_(merged[field]) && aiText_(source[field])) merged[field] = source[field];
  });
  numericFields.forEach(field => {
    if (!(parseFlexibleNumber_(merged[field]) > 0) && parseFlexibleNumber_(source[field]) > 0) {
      merged[field] = source[field];
    }
  });

  if (!aiText_(merged.source_file) && aiText_(source.source_file)) merged.source_file = source.source_file;
  if (!aiText_(merged.source_sheet) && aiText_(source.source_sheet)) merged.source_sheet = source.source_sheet;
  if (!aiText_(merged.source_cell) && aiText_(source.source_cell)) merged.source_cell = source.source_cell;
  if (!aiText_(merged.source_type) && aiText_(source.source_type)) merged.source_type = source.source_type;
  return merged;
}

function buildAiAssessmentItemRecords_(canonicalItems, sourceItems) {
  const canonical = (canonicalItems || []).map(item => Object.assign({}, item));
  const source = (sourceItems || []).map(item => Object.assign({}, item));
  if (!canonical.length) return {items: source, mode: source.length ? 'SOURCE_ONLY' : 'NONE'};
  if (!source.length) return {items: canonical, mode: 'CANONICAL_ONLY'};

  const canonicalScores = canonical.map(aiItemIntakeCompletenessScore_);
  const sourceScores = source.map(aiItemIntakeCompletenessScore_);
  const canonicalAverage = canonicalScores.reduce((sum, value) => sum + value, 0) / canonicalScores.length;
  const sourceAverage = sourceScores.reduce((sum, value) => sum + value, 0) / sourceScores.length;

  // Safe 1:1 enrichment: current source may fill only fields that are genuinely
  // missing in the canonical item. Existing canonical values are never overwritten.
  if (canonical.length === source.length) {
    return {
      items: canonical.map((item, index) => aiFillMissingItemFieldsFromSource_(item, source[index])),
      mode: 'SOURCE_ENRICHED_1_TO_1'
    };
  }

  // A partially-created/stale canonical set must not generate false manager questions
  // when current-deal source documents contain a materially more complete item set.
  // This substitution is intake-only; it does not mutate calculation rows.
  const canonicalClearlyIncomplete = canonicalAverage < 3.5 || canonicalScores.some(score => score < 3);
  const sourceMateriallyComplete = sourceAverage >= 4.5 && sourceScores.every(score => score >= 4);
  if (canonicalClearlyIncomplete && sourceMateriallyComplete && sourceAverage > canonicalAverage + 1) {
    return {items: source, mode: 'SOURCE_RECOVERY_REPLACES_STALE_CANONICAL'};
  }

  return {items: canonical, mode: 'CANONICAL_PRESERVED'};
}

function buildManagerIntakeAssessment_(spreadsheet, model) {
  let sourceTraceability = buildAiSourceTraceability_(
    spreadsheet, model.dealId, model.dealRecord || {}, model.allItemRecords || []
  );
  const rawImportedRecords = readAiImportedCellRecords_(spreadsheet, model.dealId);
  const cachedIndex = buildAiOriginalXlsxCachedIndex_(sourceTraceability);
  const importedRecords = applyAiOriginalXlsxCachedFallback_(rawImportedRecords, cachedIndex);
  const initialCatalog = buildAiSourceCatalog_(sourceTraceability, importedRecords);
  const sourceItemRecords = buildAiSourceItemRecords_(importedRecords, initialCatalog);
  const assessmentItems = buildAiAssessmentItemRecords_(model.allItemRecords || [], sourceItemRecords);
  const assessmentModel = assessmentItems.items !== (model.allItemRecords || [])
    ? Object.assign({}, model, {
        allItemRecords: assessmentItems.items,
        _aiSourceItemRecovery: {
          mode: assessmentItems.mode,
          canonicalCount: (model.allItemRecords || []).length,
          sourceCount: sourceItemRecords.length
        }
      })
    : model;
  if (assessmentItems.mode !== 'CANONICAL_ONLY' && assessmentItems.mode !== 'CANONICAL_PRESERVED') {
    sourceTraceability = buildAiSourceTraceability_(
      spreadsheet, model.dealId, model.dealRecord || {}, assessmentItems.items
    );
  }
  return buildAiManagerIntakeCore_(assessmentModel, {
    spreadsheet,
    sourceTraceability,
    importedCellRecords: importedRecords,
    checkRecords: readAiCheckRecords_(spreadsheet, model.dealId),
    latestVerifiedSnapshot: readAiLatestVerifiedSnapshotSummary_(spreadsheet, model.dealId),
    importedCellIndex: buildAiImportedCellIndexFromRecords_(importedRecords)
  });
}

function cleanManagerValue_(value) {
  const text = String(value || '').trim();
  if (!text || /^(?:UNKNOWN_USER|UNKNOWN|SYSTEM|СИСТЕМА)$/i.test(text)) return '';
  // DEV-016.40: корпоративный e-mail является допустимым подтверждённым
  // идентификатором менеджера и не должен превращаться в MISSING.
  return text;
}

function itemNeedsTnVed_(itemRecord, model) {
  if (parseFlexibleNumber_(itemRecord['Ставка пошлины']) > 0) return true;
  if (parseFlexibleNumber_(itemRecord['Ставка НДС']) > 0) return true;
  const customsPattern = /(пошлин|тамож|импортн.*ндс|ндс.*импорт)/i;
  return (model.allExpenseRecords || []).some(record =>
    isTruthy_(record['Включать во внутренний расчет']) &&
    customsPattern.test(String(record['Наименование расхода'] || ''))
  );
}

function getLatestVerifiedSnapshot_(spreadsheet, dealId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.calculationSnapshots);
  if (!sheet || sheet.getLastRow() < 2) return null;
  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 23).getValues()
    .filter(row =>
      String(row[1]) === String(dealId) &&
      Number(row[17]) === 0 && Number(row[18]) === 0 &&
      String(row[19]).trim() === 'Проверен'
    );
  if (!rows.length) return null;
  rows.sort((left, right) => new Date(right[2]).getTime() - new Date(left[2]).getTime());
  return rows[0];
}

function validateQuoteSource_(model, result, snapshot) {
  const dealStatus = String(model.deal[10] || '').trim();
  if (!['Проверен', 'Готов'].includes(dealStatus)) {
    throw new Error(
      'Сделка не имеет статуса «Проверен». Сначала выполните команду ' +
      '«6. Рассчитать и проверить сделку».'
    );
  }
  if (!snapshot) {
    throw new Error(
      'Не найден проверенный снимок расчёта без ошибок и предупреждений. ' +
      'Выполните команду «6. Рассчитать и проверить сделку».'
    );
  }
  if (result.conversionErrors.length) {
    throw new Error('В текущих данных есть ошибки валют или курсов.');
  }
  if (!String(model.deal[3] || '').trim()) {
    throw new Error(
      'На листе «Сделки» заполните поле «Клиент» для выбранной сделки, ' +
      'затем снова сформируйте КП.'
    );
  }
  if (!model.items.length) {
    throw new Error('В сделке нет ни одного подтверждённого товара.');
  }
  if (!(Number(result.totalRub) > 0)) {
    throw new Error('Общий итог сделки должен быть больше нуля.');
  }
  const mismatches = [];
  const compare = (label, actual, stored, tolerance) => {
    if (Math.abs(Number(actual) - Number(stored)) > tolerance) mismatches.push(label);
  };
  if (Number(snapshot[4]) !== model.items.length) mismatches.push('количество товаров');
  if (Number(snapshot[5]) !== model.expenses.length) mismatches.push('количество расходов');
  compare('стоимость товара', result.goodsRub, snapshot[7], 0.01);
  compare('сумма расходов', result.expensesRub, snapshot[9], 0.01);
  compare('общий итог', result.totalRub, snapshot[13], 0.01);
  if (mismatches.length) {
    throw new Error(
      'Данные изменились после последней проверки: ' + mismatches.join(', ') + '. ' +
      'Снова выполните команду «6. Рассчитать и проверить сделку».'
    );
  }
}

function getLatestApprovedScalarValueForDeal_(spreadsheet, dealId, fieldCode) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.linked);
  if (!sheet || sheet.getLastRow() < 2) return '';
  const width = Math.min(30, sheet.getLastColumn());
  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, width).getValues();
  for (let index = rows.length - 1; index >= 0; index -= 1) {
    const row = rows[index];
    if (String(row[3] || '') !== String(dealId)) continue;
    if (String(row[12] || '') !== String(fieldCode)) continue;
    if (!['Подтверждено', 'Исправлено'].includes(String(row[28] || '').trim())) continue;
    const value = row[18] !== '' ? row[18] : row[16];
    if (value !== '' && value !== null && value !== undefined) return value;
  }
  return '';
}

function splitQuoteRoute_(routeValue, explicitBorder) {
  const source = String(routeValue || '').trim();
  const match = source.match(/^(.*?)(?:;\s*погранпереход:\s*(.*))?$/i);
  const route = String(match && match[1] || source).trim().replace(/;$/, '');
  const border = String(explicitBorder || match && match[2] || '').trim();
  return {route, border};
}

function validateRenderedQuoteTotals_(quoteSheet, expectedTotalRub) {
  const sectionValues = quoteSheet.getRange('F47:F49').getValues()
    .flat().map(value => Number(value || 0));
  const sectionTotal = roundMoney_(sumNumbers_(sectionValues));
  const expected = roundMoney_(Number(expectedTotalRub || 0));
  if (Math.abs(sectionTotal - expected) > 0.01) {
    throw new Error(
      `Контроль клиентского КП не пройден: сумма отображаемых разделов ` +
      `${sectionTotal} RUB не равна итогу ${expected} RUB.`
    );
  }
  const shares = quoteSheet.getRange('G47:G49').getValues()
    .flat().map(value => Number(value || 0));
  if (Math.abs(sumNumbers_(shares) - 1) > 0.0001) {
    throw new Error('Контроль клиентского КП не пройден: доли разделов не дают 100%.');
  }
}

function splitQuoteItemNameAndSize_(value) {
  const source = String(value || '').trim();
  if (!source) return {name: 'Товар', size: ''};

  const lines = source.split(/\r?\n/).map(line => line.trim()).filter(Boolean);
  let size = '';
  const nameLines = [];
  lines.forEach(line => {
    const match = line.match(/^размер\s*:\s*(.+)$/i);
    if (match) {
      size = String(match[1] || '').trim();
    } else {
      nameLines.push(line);
    }
  });
  return {
    name: nameLines.join(' ').replace(/\s{2,}/g, ' ').trim() || 'Товар',
    size
  };
}

function resolveQuoteUsdRubFromVerifiedCalculation_(result) {
  const value = parseFlexibleNumber_(result && result.usdRub);
  return Number(value) > 0 ? Number(value) : '';
}

function buildQuoteContext_(spreadsheet, model, result, intake) {
  const deal = model.deal;
  const dealRecord = model.dealRecord || {};
  const settings = model.settings;
  const requestedFormat = String(deal[12] || '').trim();
  const formats = [
    'Краткое', 'Расширенное по товарам', 'Расширенное по категориям',
    'Расширенное товары + категории'
  ];
  const format = formats.includes(requestedFormat) ? requestedFormat : 'Краткое';
  const intakeDeal = intake && intake.extractedData && intake.extractedData.deal || {};
  const requestedCurrency = String(
    intakeDeal.quoteCurrency || dealRecord['Валюта клиентского КП'] || deal[13] || ''
  ).trim().toUpperCase();
  const currency = ['RUB', 'CNY'].includes(requestedCurrency)
    ? requestedCurrency
    : String(settings.get('DEFAULT_CLIENT_CURRENCY') || 'RUB').toUpperCase();
  const normalizedCurrency = ['RUB', 'CNY'].includes(currency) ? currency : 'RUB';
  // Default не имеет права перезаписывать факт сделки. Если срок не найден,
  // финальное КП будет заблокировано после построения контекста.
  const validityDays = Math.max(0, Math.round(
    parseFlexibleNumber_(intakeDeal.quoteValidityDays) ||
    parseFlexibleNumber_(dealRecord['Срок действия КП']) || 0
  ));
  const quoteDate = new Date();
  const validUntil = new Date(quoteDate.getTime() + validityDays * 86400000);
  const money = rubValue => normalizedCurrency === 'CNY'
    ? Number(rubValue) / Number(result.cnyRub)
    : Number(rubValue);

  const paymentSourceRows = getImportCellsByDealId_(spreadsheet, model.dealId);
  let sourcePaymentSplitProfile = extractStructuredPaymentSplitProfileFromRows_(
    paymentSourceRows,
    intakeDeal.scheme || dealRecord['Схема работы'] || dealRecord['Схема поставки'] || deal[8] || ''
  );
  // DEV-016.58: direct evidence fallback for sources where alternative payment schemes
  // coexist on one sheet and the generic extractor cannot materialize an item profile.
  // This remains source-only: it never invents percentages and is restricted to the
  // active deal's imported cells plus the confirmed deal scheme.
  if (!sourcePaymentSplitProfile || sourcePaymentSplitProfile.status !== 'CONFIRMED' ||
      !Object.keys(sourcePaymentSplitProfile.itemSplits || {}).length) {
    const directProfile = extractDirectSourcePaymentSplitProfile_(
      paymentSourceRows,
      intakeDeal.scheme || dealRecord['Схема работы'] || dealRecord['Схема поставки'] || deal[8] || '',
      result.convertedItems.length
    );
    if (directProfile.status === 'CONFIRMED') sourcePaymentSplitProfile = directProfile;
  }
  const paymentText = String(dealRecord['График платежей'] || '');
  const items = result.convertedItems.map((item, index) => {
    const quantity = Number(item.row[10] || 0);
    const nameAndSize = splitQuoteItemNameAndSize_(item.row[4] || 'Товар');
    const amountCny = roundMoney_(Number(item.amountCny || 0));
    const amountRub = roundMoney_(Number(item.amountRub || 0));
    return {
      itemId: String(item.id || ''),
      number: item.row[2] || index + 1,
      paymentSplit: resolveQuoteItemPaymentSplit_(paymentText, index + 1, sourcePaymentSplitProfile),
      name: nameAndSize.name,
      size: nameAndSize.size,
      article: item.row[5] || '',
      category: item.row[6] || '',
      tnVed: item.row[9] || '',
      quantity,
      unit: item.row[11] || '',
      grossWeight: item.row[16] || '',
      volume: item.row[17] || '',
      unitPriceCny: quantity > 0 ? roundTo_(amountCny / quantity, 6) : 0,
      amountCny,
      amountRub,
      amount: money(amountRub)
    };
  });

  const visibleExpenses = result.convertedExpenses.filter(expense =>
    isTruthy_(expense.row[17])
  );
  const categoryMap = new Map();
  visibleExpenses.forEach(expense => {
    const name = String(expense.row[4] || 'Прочие услуги').trim();
    categoryMap.set(name, (categoryMap.get(name) || 0) + money(expense.amountRub || 0));
  });
  const categories = [...categoryMap.entries()].map(entry => ({
    name: entry[0], amount: roundMoney_(entry[1])
  }));
  if (!categories.length && result.expensesRub) {
    categories.push({
      name: 'Комплекс услуг по организации поставки',
      amount: roundMoney_(money(result.expensesRub))
    });
  }

  const approvedBorderCrossing = getLatestApprovedScalarValueForDeal_(
    spreadsheet, model.dealId, 'BORDER_CROSSING'
  );
  const routeParts = splitQuoteRoute_(deal[9] || '', approvedBorderCrossing);
  const sourceRoute = String(intakeDeal.route || dealRecord['Маршрут'] || intakeDeal.chinaRoute || dealRecord['Маршрут внутри Китая'] || '').trim();
  const sourceBorder = String(intakeDeal.borderCrossing || dealRecord['Погранпереход'] || '').trim();
  const paymentSchedule = quoteIntakeValue_(intake, 'commercial.paymentSchedule');

  return {
    dealId: model.dealId,
    dealNumber: deal[1] || '',
    client: intakeDeal.client || deal[3] || '',
    manager: intakeDeal.manager || cleanManagerValue_(deal[4]) || '',
    partner: deal[5] || '',
    scheme: intakeDeal.scheme || dealRecord['Схема работы'] || dealRecord['Схема поставки'] || deal[8] || '',
    deliveryTerms: intakeDeal.incoterms || dealRecord['Инкотермс'] || deal[8] || '',
    route: sourceRoute || routeParts.route || '',
    borderCrossing: sourceBorder || routeParts.border || '',
    destinationCity: intakeDeal.destinationCity || dealRecord['Город назначения'] || '',
    transportMode: intakeDeal.transportMode || dealRecord['Тип транспорта'] || '',
    deliveryDays: intakeDeal.deliveryDays || dealRecord['Срок доставки, дней'] || '',
    productionDays: intakeDeal.productionDays || dealRecord['Срок производства, дней'] || '',
    paymentTerms: quoteIntakeValue_(intake, 'commercial.paymentTerms') || dealRecord['Условия оплаты'] || '',
    paymentSchedule,
    paymentRows: buildCurrentQuotePaymentRows_(paymentSchedule, result),
    comment: deal[15] || '',
    format,
    currency: normalizedCurrency,
    quoteDate,
    validUntil,
    validityDays,
    company: settings.get('COMPANY_NAME') || 'BBC',
    subtitle: settings.get('COMPANY_SUBTITLE') || 'BIG BUSINESS CHINA',
    address: settings.get('COMPANY_ADDRESS') || '',
    warehouses: settings.get('COMPANY_WAREHOUSES') || '',
    email: settings.get('COMPANY_EMAIL') || '',
    telegram: settings.get('COMPANY_TELEGRAM') || '',
    phone: settings.get('COMPANY_PHONE') || '',
    wechat: settings.get('COMPANY_WECHAT') || '',
    website: settings.get('COMPANY_WEBSITE') || '',
    items,
    categories,
    goods: roundMoney_(money(result.goodsRub)),
expenses: roundMoney_(money(result.expensesRub)),
total: roundMoney_(money(result.totalRub)),

preCommissionTotal: roundMoney_(
  money(result.preCommissionSummary.totalRub)
),

bbcCommission: {
  type: model.commissionInput.type || '',
  inputValue: model.commissionInput.value || 0,
  calculationBase: model.commissionInput.base || '',
  inputCurrency: model.commissionInput.currency || '',
  confirmedByManager: Boolean(
    model.commissionInput.confirmedByManager
  ),
  amount: roundMoney_(
    money(result.commissionCalculation.amountRub || 0)
  )
},

cnyRub: result.cnyRub,
usdRub: resolveQuoteUsdRubFromVerifiedCalculation_(result)
  };
}

function getNextQuoteVersion_(spreadsheet, dealId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.documents);
  let maxVersion = 0;
  if (sheet && sheet.getLastRow() > 1) {
    sheet.getRange(2, 1, sheet.getLastRow() - 1, 11).getDisplayValues()
      .filter(row => String(row[1]) === String(dealId))
      .forEach(row => {
        const match = String(row[4]).match(/(\d+)/);
        if (match) maxVersion = Math.max(maxVersion, Number(match[1]));
      });
  }
  return `v${String(maxVersion + 1).padStart(3, '0')}`;
}

function getQuoteOutputFolder_(spreadsheet, settings, dealId) {
  const rootName = settings.get('QUOTE_OUTPUT_FOLDER_NAME') ||
    'BBC КП Generator — документы';
  const root = getOrCreateDriveFolder_(DriveApp.getRootFolder(), rootName);
  return getOrCreateDriveFolder_(root, sanitizeFileName_(dealId));
}

function getOrCreateDriveFolder_(parent, name) {
  const folders = parent.getFoldersByName(name);
  return folders.hasNext() ? folders.next() : parent.createFolder(name);
}

function writeQuoteSpreadsheet_(quoteSpreadsheet, context) {
  const sheet = quoteSpreadsheet.getSheets()[0];
  sheet.setName('Коммерческое предложение');
  sheet.clear();
  sheet.setHiddenGridlines(true);
  sheet.setFrozenRows(0);
  sheet.setColumnWidths(1, 6, 115);
  sheet.setColumnWidth(1, 54);
  sheet.setColumnWidth(2, 210);
  sheet.setColumnWidth(3, 120);
  sheet.setColumnWidth(4, 115);
  sheet.setColumnWidth(5, 115);
  sheet.setColumnWidth(6, 135);

  const dark = '#17324D';
  const gold = '#D8A935';
  const light = '#EEF3F7';
  const green = '#DDEFE4';
  let row = 1;

  sheet.getRange(row, 1, 2, 6).merge()
    .setValue(`${context.company} — ${context.subtitle}`)
    .setBackground(dark).setFontColor('#FFFFFF')
    .setFontSize(18).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.setRowHeights(row, 2, 30);
  row += 3;
  sheet.getRange(row, 1, 1, 6).merge()
    .setValue('КОММЕРЧЕСКОЕ ПРЕДЛОЖЕНИЕ')
    .setFontSize(16).setFontWeight('bold').setFontColor(dark)
    .setHorizontalAlignment('center');
  row += 2;

  const meta = [
    ['Клиент', quoteValueOrDash_(context.client), 'Дата', formatQuoteDate_(context.quoteDate)],
    ['Номер сделки', quoteValueOrDash_(context.dealNumber || context.dealId),
      'Действительно до', formatQuoteDate_(context.validUntil)],
    ['Условия поставки', quoteValueOrDash_(context.deliveryTerms),
      'Валюта КП', context.currency],
    ['Маршрут', quoteValueOrDash_(context.route), 'Формат', context.format]
  ];
  sheet.getRange(row, 1, meta.length, 6).setValues(meta.map(entry => [
    entry[0], entry[1], '', entry[2], entry[3], ''
  ])).setVerticalAlignment('middle');
  sheet.getRange(row, 1, meta.length, 1).setFontWeight('bold').setFontColor(dark);
  sheet.getRange(row, 4, meta.length, 1).setFontWeight('bold').setFontColor(dark);
  sheet.getRange(row, 2, meta.length, 2).mergeAcross();
  sheet.getRange(row, 5, meta.length, 2).mergeAcross();
  sheet.getRange(row, 1, meta.length, 6).setBorder(true, true, true, true, true, true, '#C9D4DE', SpreadsheetApp.BorderStyle.SOLID);
  row += meta.length + 2;

  row = writeQuoteSectionTitle_(sheet, row, 'ИТОГОВАЯ СТОИМОСТЬ', dark, gold);
  const summaryStart = row;
  const summary = [
    ['Стоимость товарной партии', context.goods],
    ['Услуги и расходы по поставке', context.expenses],
    ['ОБЩАЯ СТОИМОСТЬ', context.total]
  ];
  sheet.getRange(row, 1, summary.length, 4).setValues(summary.map(entry => [
    '', entry[0], '', entry[1]
  ]));
  sheet.getRange(row, 2, summary.length, 2).mergeAcross();
  sheet.getRange(row, 4, summary.length, 3).mergeAcross();
  sheet.getRange(row, 4, summary.length, 3)
    .setNumberFormat('#,##0.00 "' + context.currency + '"')
    .setHorizontalAlignment('right');
  sheet.getRange(row, 1, summary.length, 6)
    .setBorder(true, true, true, true, true, true, '#C9D4DE', SpreadsheetApp.BorderStyle.SOLID);
  sheet.getRange(row + 2, 1, 1, 6).setBackground(green).setFontWeight('bold').setFontSize(12);
  row += summary.length + 2;

  if (quoteIncludesItems_(context.format)) {
    row = writeQuoteSectionTitle_(sheet, row, 'ТОВАРЫ', dark, gold);
    const headers = [['№', 'Наименование', 'ТН ВЭД', 'Количество', 'Вес / объём', 'Стоимость']];
    sheet.getRange(row, 1, 1, 6).setValues(headers)
      .setBackground(light).setFontWeight('bold').setFontColor(dark);
    row += 1;
    const itemRows = context.items.map(item => [
      item.number,
      item.name + (item.article ? `, арт. ${item.article}` : ''),
      item.tnVed || '—',
      item.quantity ? `${item.quantity} ${item.unit || ''}`.trim() : '—',
      [item.grossWeight ? `${item.grossWeight} кг` : '', item.volume ? `${item.volume} м³` : '']
        .filter(Boolean).join(' / ') || '—',
      item.amount
    ]);
    if (itemRows.length) {
      sheet.getRange(row, 1, itemRows.length, 6).setValues(itemRows);
      sheet.getRange(row, 6, itemRows.length, 1)
        .setNumberFormat('#,##0.00 "' + context.currency + '"');
      row += itemRows.length;
    }
    sheet.getRange(row - itemRows.length - 1, 1, itemRows.length + 1, 6)
      .setBorder(true, true, true, true, true, true, '#C9D4DE', SpreadsheetApp.BorderStyle.SOLID);
    row += 2;
  }

  if (quoteIncludesCategories_(context.format)) {
    row = writeQuoteSectionTitle_(sheet, row, 'СОСТАВ УСЛУГ', dark, gold);
    sheet.getRange(row, 1, 1, 6).setValues([[
      '№', 'Категория', '', '', '', 'Стоимость'
    ]]).setBackground(light).setFontWeight('bold').setFontColor(dark);
    sheet.getRange(row, 2, 1, 4).merge();
    row += 1;
    const categoryRows = context.categories.map((category, index) => [
      index + 1, category.name, '', '', '', category.amount
    ]);
    if (categoryRows.length) {
      sheet.getRange(row, 1, categoryRows.length, 6).setValues(categoryRows);
      for (let offset = 0; offset < categoryRows.length; offset += 1) {
        sheet.getRange(row + offset, 2, 1, 4).merge();
      }
      sheet.getRange(row, 6, categoryRows.length, 1)
        .setNumberFormat('#,##0.00 "' + context.currency + '"');
      row += categoryRows.length;
    }
    sheet.getRange(row - categoryRows.length - 1, 1, categoryRows.length + 1, 6)
      .setBorder(true, true, true, true, true, true, '#C9D4DE', SpreadsheetApp.BorderStyle.SOLID);
    row += 2;
  }

  if (context.comment) {
    sheet.getRange(row, 1, 1, 6).merge().setValue(`Комментарий: ${context.comment}`)
      .setWrap(true).setBackground('#FFF7E1');
    row += 2;
  }
  const contacts = [context.email, context.telegram, context.phone, context.wechat, context.website]
    .filter(Boolean).join(' · ');
  const location = [context.address, context.warehouses ? `Склады: ${context.warehouses}` : '']
    .filter(Boolean).join(' · ');
  sheet.getRange(row, 1, 1, 6).merge()
    .setValue([contacts, location].filter(Boolean).join('\n'))
    .setBackground(dark).setFontColor('#FFFFFF').setWrap(true)
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  sheet.setRowHeight(row, 42);
  sheet.getRange(1, 1, row, 6).setFontFamily('Arial').setVerticalAlignment('middle');
  sheet.autoResizeRows(1, row);
  sheet.setRowHeights(summaryStart, 3, 28);
  sheet.setRowHeight(row, 42);
}

function writeQuoteSectionTitle_(sheet, row, title, background, accent) {
  sheet.getRange(row, 1, 1, 6).merge().setValue(title)
    .setBackground(background).setFontColor('#FFFFFF')
    .setFontWeight('bold').setHorizontalAlignment('left');
  sheet.getRange(row, 1).setNote(`Раздел документа BBC; акцент ${accent}`);
  return row + 1;
}

function quoteIncludesItems_(format) {
  return ['Расширенное по товарам', 'Расширенное товары + категории']
    .includes(String(format));
}

function quoteIncludesCategories_(format) {
  return ['Расширенное по категориям', 'Расширенное товары + категории']
    .includes(String(format));
}

function exportQuoteFile_(spreadsheetId, format, fileName, folder) {
  const parameters = format === 'pdf'
    ? '&size=A4&portrait=true&fitw=true&sheetnames=false&printtitle=false' +
      '&pagenumbers=false&gridlines=false&fzr=false'
    : '';
  const url = `https://docs.google.com/spreadsheets/d/${spreadsheetId}/export?format=${format}${parameters}`;
  const response = UrlFetchApp.fetch(url, {
    headers: {Authorization: `Bearer ${ScriptApp.getOAuthToken()}`},
    muteHttpExceptions: true
  });
  const status = response.getResponseCode();
  if (status < 200 || status >= 300) {
    throw new Error(`Не удалось создать ${format.toUpperCase()}: HTTP ${status}.`);
  }
  return folder.createFile(response.getBlob().setName(fileName));
}


