/**
 * Главная функция создания базы.
 */
function initializeBBCMVP() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);

  try {
    const structures = getBBCStructures();
    backupLegacyTechnicalSheets_(spreadsheet, structures);

    Object.entries(structures).forEach(([sheetName, config]) => {
      const sheet = getOrCreateSheet_(spreadsheet, sheetName);
      configureSheet_(sheet, config);
    });

    fillSettings_(spreadsheet);
    fillDictionaries_(spreadsheet);
    hardenExistingDictionaries_(spreadsheet);
    applyValidations_(spreadsheet);

    spreadsheet.setActiveSheet(
      spreadsheet.getSheetByName(BBC_MVP.sheets.deals)
    );

    writeLog_(
      'SYSTEM',
      'INITIALIZE_DATABASE',
      '',
      `Структура BBC КП Generator v${BBC_MVP.version} создана или обновлена`
    );

    SpreadsheetApp.getUi().alert(
      `База BBC КП Generator v${BBC_MVP.version} готова.\n\n` +
      'Старые технические листы с несовместимой схемой сохранены как LEGACY.'
    );
  } finally {
    lock.releaseLock();
  }
}

function backupLegacyTechnicalSheets_(spreadsheet, structures) {
  const technicalNames = [
    BBC_MVP.sheets.importMap,
    BBC_MVP.sheets.importCells,
    BBC_MVP.sheets.importLog,
    BBC_MVP.sheets.recognized,
    BBC_MVP.sheets.linked,
    BBC_MVP.sheets.tableRows
  ];
  const suffix = Utilities.formatDate(
    new Date(), spreadsheet.getSpreadsheetTimeZone(), 'yyyyMMdd-HHmmss'
  );

  technicalNames.forEach(sheetName => {
    const sheet = spreadsheet.getSheetByName(sheetName);
    if (!sheet || sheet.getLastRow() < 2) return;
    const expected = structures[sheetName].headers;
    const width = Math.min(Math.max(sheet.getLastColumn(), 1), expected.length);
    const actual = sheet.getRange(1, 1, 1, width)
      .getDisplayValues()[0];
    if (actual.join('\u001f') === expected.join('\u001f')) return;
    sheet.setName(buildUniqueSheetName_(
      spreadsheet, `${sheetName} LEGACY ${suffix}`
    ));
  });

  spreadsheet.getSheets().forEach(sheet => {
    if (!/^Лист\d+$/.test(sheet.getName()) || sheet.getLastRow() < 1) return;
    const width = Math.min(Math.max(sheet.getLastColumn(), 1), 40);
    const headers = sheet.getRange(1, 1, 1, width).getDisplayValues()[0];
    const headerSet = new Set(headers.map(value => String(value).trim()));
    let canonicalName = '';
    if (
      headers[0] === 'recognition_id' &&
      headerSet.has('Код поля') &&
      headerSet.has('Основание распознавания')
    ) {
      canonicalName = BBC_MVP.sheets.recognized;
    } else if (
      headers[0] === 'link_id' &&
      headerSet.has('Ячейка значения') &&
      headerSet.has('Статус связывания')
    ) {
      canonicalName = BBC_MVP.sheets.linked;
    }
    if (!canonicalName) return;
    sheet.setName(buildUniqueSheetName_(
      spreadsheet, `${canonicalName} LEGACY ${suffix}`
    ));
  });
}

function buildUniqueSheetName_(spreadsheet, preferredName) {
  const base = String(preferredName).slice(0, 100);
  if (!spreadsheet.getSheetByName(base)) return base;
  for (let index = 2; index < 1000; index++) {
    const suffix = ` (${index})`;
    const candidate = `${base.slice(0, 100 - suffix.length)}${suffix}`;
    if (!spreadsheet.getSheetByName(candidate)) return candidate;
  }
  throw new Error('Не удалось подобрать уникальное имя для LEGACY-листа.');
}

