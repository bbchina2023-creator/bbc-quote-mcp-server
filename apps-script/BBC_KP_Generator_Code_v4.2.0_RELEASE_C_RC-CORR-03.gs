    assert(validatePaymentScheduleV1Object_(schedule).ok, 'Confirmed zero must not be missing.');
  });
  test('A1-PAYMENT-ACTIVE-SCHEME', function() {
    var schedule={scheduleId:'PX',dealId:'D1',scheduleType:'CLIENT_PAYMENT',activeSchemeId:'S1',currency:'RUB',confirmationState:'CONFLICT',lineageRefs:['E1'],schemes:[1,2].map(function(n){return {schemeId:'S'+n,name:'S'+n,applicability:null,active:true,lineageRefs:['E1'],stages:[{stageId:'S'+n+'T',order:1,stageCode:null,label:'100',dueCondition:null,percent:100,amount:null,zeroConfirmed:false,lineageRefs:['E1'],confirmationState:'CONFIRMED_BY_SOURCE',allocations:[]}]};})};
    assert(!validatePaymentScheduleV1Object_(schedule).ok, 'Two active schemes must fail.');
