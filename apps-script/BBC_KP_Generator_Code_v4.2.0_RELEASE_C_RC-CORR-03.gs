function bbcReleaseBPhase18UnitEconomicsPreflight_(context,result){
  const itemLines = new Map((result.itemLineCalculation && result.itemLineCalculation.rows || []).map(row => [String(row.itemId), row]));
  const itemExpenseMap = result.itemExpenseMap || new Map();
  const convertedItems = result.convertedItems || [];
  const totalInvoiceRub = Number(result.goodsRub || 0) + Number(result.bucketTotals && result.bucketTotals.chinaDelivery && result.bucketTotals.chinaDelivery.rub || 0);
  const commissionRub = Number(result.bucketTotals && result.bucketTotals.bbcCommission && result.bucketTotals.bbcCommission.rub || 0);
  const cnyRub = Number(result.cnyRub || 0);
  let renderedTotalRub = 0;
  let renderedPartnerRub = 0;
  const rows=[];
  (context.items || []).forEach((item,index)=>{
    const convertedItem=convertedItems[index]||{};
    const itemId=String(convertedItem.id||'');
    const line=itemLines.get(itemId)||{};
    const quantity=Number(item.quantity||0);
    const goodsRub=Number(item.amountRub||0);
    const expenses=(itemExpenseMap.get(itemId)||[]).slice();
    const bucketRub=bucket=>sumNumbers_(expenses.filter(expense=>expense.bucket===bucket).map(expense=>Number(expense.amountRub||0)));
    const chinaRub=bucketRub('chinaDelivery');
    const goodsWithChinaRub=goodsRub+chinaRub;
    const share=totalInvoiceRub>0?goodsWithChinaRub/totalInvoiceRub:0;
    const servicesRub=commissionRub*share + Number(result.bucketTotals.exportSupport.rub||0)*share + Number(result.bucketTotals.supplierBankFees.rub||0)*share + Number(result.bucketTotals.incomingBankFees.rub||0)*share + bucketRub('other');
    const partnerRub=bucketRub('partnerCommission');
    const transportRub=bucketRub('internationalLogistics')+bucketRub('russiaDelivery')+bucketRub('insurance')+partnerRub;
    const importRub=Number(line.dutyRub||0)+Number(line.importVatRub||0)+bucketRub('customsFee')+bucketRub('broker')+bucketRub('temporaryStorage')+bucketRub('customsDelivery')+bucketRub('certification')+bucketRub('marking')+bucketRub('partnerFinancialServices');
    const totalRub=goodsWithChinaRub+servicesRub+transportRub+importRub;
    renderedTotalRub+=totalRub;renderedPartnerRub+=partnerRub;
    rows.push({itemId,servicesCnyPerUnit:quantity&&cnyRub?servicesRub/cnyRub/quantity:0,transportCnyPerUnit:quantity&&cnyRub?transportRub/cnyRub/quantity:0,importCnyPerUnit:quantity&&cnyRub?importRub/cnyRub/quantity:0,totalCnyPerUnit:quantity&&cnyRub?totalRub/cnyRub/quantity:0});
  });
  const b=BBC_RELEASE_B_PHASE18.benchmark;
  if(Math.abs(roundTo_(renderedTotalRub,8)-roundTo_(b.totalRub,8))>0.01)throw new Error('Phase18 unit-economics preflight total mismatch: '+renderedTotalRub+' vs '+b.totalRub);
  if(Math.abs(roundTo_(renderedPartnerRub,8)-roundTo_(b.partnerCommissionRub,8))>0.01)throw new Error('Phase18 unit-economics preflight partnerCommission mismatch: '+renderedPartnerRub+' vs '+b.partnerCommissionRub);
  const expected=[
    {services:3.0074825764974564,transport:6.391372314390044,importValue:9.750833329736274,total:37.75423367516923},
    {services:3.8499594568373934,transport:8.181767860019209,importValue:12.482304397448324,total:48.33021148958583}
  ];
  if(rows.length===2){rows.forEach((row,i)=>{const e=expected[i];[['servicesCnyPerUnit',e.services],['transportCnyPerUnit',e.transport],['importCnyPerUnit',e.importValue],['totalCnyPerUnit',e.total]].forEach(pair=>{if(Math.abs(Number(row[pair[0]])-Number(pair[1]))>0.000001)throw new Error('Phase18 unit-economics benchmark mismatch '+pair[0]+' item '+(i+1)+': '+row[pair[0]]+' vs '+pair[1]);});});}
  return {ok:true,renderedTotalRub:roundTo_(renderedTotalRub,8),renderedPartnerRub:roundTo_(renderedPartnerRub,8),rows};
}

