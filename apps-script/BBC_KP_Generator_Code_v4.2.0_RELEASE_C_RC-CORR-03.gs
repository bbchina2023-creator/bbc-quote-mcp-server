function resolveClientManagerName_(managerValue, templateManagerName) {
  const manager = String(managerValue || '').trim();
  const isTechnical = value =>
    !value || /^(?:UNKNOWN_USER|UNKNOWN|SYSTEM|СИСТЕМА)$/i.test(value);

  // DEV-016.40: e-mail менеджера является допустимым клиентским идентификатором,
  // если именно он подтверждён в карточке сделки.
  if (!isTechnical(manager)) return manager;
  return 'Менеджер BBC';
}

function resolveClientCompanyName_(companyValue) {
  const value = String(companyValue || '').trim();
  if (!value || /^BBC$/i.test(value)) return 'BIG BUSINESS CHINA';
  return value;
}

function quoteSchemeLabel_(context) {
  const terms = String(context.deliveryTerms || '').trim();
  return terms ? `ПОД КЛЮЧ (${terms})` : 'ПОД КЛЮЧ';
}

function quoteSchemeTitle_(context) {
  const raw = aiText_(context && context.scheme || '').trim();
  const canonicalLabels={BBC_IMPORTER_AND_EXPORTER:'ПОД КЛЮЧ — BBC ИМПОРТЁР И ЭКСПОРТЁР',CLIENT_IMPORTER_BBC_EXPORTER:'КЛИЕНТ ИМПОРТЁР 🤝 BBC ЭКСПОРТЁР',BBC_IMPORTER:'BBC ИМПОРТЁР',BBC_EXPORTER:'BBC ЭКСПОРТЁР',CONTRACTOR_IMPORTER_BBC_ORGANIZER:'ПОДРЯДЧИК — ИМПОРТЁР · BBC ОРГАНИЗУЕТ И СОПРОВОЖДАЕТ СДЕЛКУ'};
  if(canonicalLabels[raw])return canonicalLabels[raw];
  const scheme = raw.toLowerCase();
  if (/(?:подрядчик|партн[её]р).*(?:импорт|импорт[её]р)/.test(scheme)) return 'ПОДРЯДЧИК — ИМПОРТЁР · BBC ОРГАНИЗУЕТ И СОПРОВОЖДАЕТ СДЕЛКУ';
  return 'КЛИЕНТ ИМПОРТЁР 🤝 BBC ЭКСПОРТЁР';
}

function sumQuoteItemField_(items, field) {
  return roundTo_(
    (items || []).reduce(
      (sum, item) => sum + (Number(item[field]) || 0),
      0
    ),
    4
  );
}

function quoteDutyDescription_(result) {
  const rows = result.itemLineCalculation &&
    result.itemLineCalculation.rows || [];
  const values = [...new Set(
    rows.map(row => {
      const rate = Number(row.dutyRate || 0);
      const currency = String(row.dutyCurrency || '').trim();
      const method = String(row.dutyMethod || '').trim();
      if (method === 'EUR_PER_KG' && rate) return `${rate} EUR/кг`;
      if (method === 'USD_PER_KG' && rate) return `${rate} USD/кг`;
      if (rate) return `${rate}%`;
      return '';
    }).filter(Boolean)
  )];
  return values.length ? values.join('; ') : 'Согласно расчету';
}

function setQuoteMoneyRow_(sheet, row, cny, rub) {
