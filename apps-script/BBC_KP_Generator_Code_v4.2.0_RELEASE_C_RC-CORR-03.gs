  const requiredSheetNames = [
    'Лист1', 'Лист2', 'Расчет сделки ВЭД',
    'Юнит-экономика товара(ов)', 'Инструкция импортёру'
  ];
  const errorPattern = /#(?:REF!|DIV\/0!|VALUE!|N\/A|NAME\?|NUM!|NULL!)/i;
  const failures = [];
  SpreadsheetApp.flush();
  requiredSheetNames.forEach(name => {
    const sheet = quoteSpreadsheet.getSheetByName(name);
    if (!sheet) {
      failures.push(`${name}: лист отсутствует`);
      return;
    }
    sheet.getDataRange().getDisplayValues().forEach((row, rowIndex) => {
      row.forEach((value, columnIndex) => {
        if (errorPattern.test(String(value || ''))) failures.push(`${name}!R${rowIndex + 1}C${columnIndex + 1}: ${value}`);
      });
    });
  });
  if (failures.length) throw new Error('КП содержит ошибки формул\n' + failures.slice(0, 30).join('\n'));
}

function removeInternalTemplateSheets_(quoteSpreadsheet) {
  // DEV-016.40: Лист1 и Лист2 — часть утверждённого 5-листового benchmark.
  const quoteSheet = quoteSpreadsheet.getSheetByName('Расчет сделки ВЭД');
  if (quoteSheet) quoteSpreadsheet.setActiveSheet(quoteSheet);
}

function normalizeClientSheetPrintAreas_(quoteSpreadsheet) {
  // DEV-016.40: сохраняем полную формульную книгу; PDF-экспорт задаёт диапазон отдельно.
  const quoteSheet = quoteSpreadsheet.getSheetByName('Расчет сделки ВЭД');
  if (quoteSheet) quoteSpreadsheet.setActiveSheet(quoteSheet);
  SpreadsheetApp.flush();
}

function exportMasterQuotePdf_(spreadsheetId, sheetId, fileName, folder) {
  // DEV-016.40: клиентский Google Sheet/XLSX сохраняет все 5 листов benchmark.
  // Для PDF создаётся временная копия: внутренние Лист1/Лист2 скрываются,
  // клиентские листы обрезаются до утверждённых печатных диапазонов, после
  // экспорта временная копия удаляется. Исходная формульная книга не меняется.
  const sourceFile = DriveApp.getFileById(spreadsheetId);
  const tempFile = sourceFile.makeCopy(
    sanitizeFileName_(`TEMP PDF ${fileName} ${Utilities.getUuid()}`),
    folder
  );
  let pdfBlob;
  try {
    const tempSpreadsheet = SpreadsheetApp.openById(tempFile.getId());
    ['Лист1', 'Лист2'].forEach(name => {
      const sheet = tempSpreadsheet.getSheetByName(name);
      if (sheet) sheet.hideSheet();
    });
    const printAreas = {
      'Расчет сделки ВЭД': {rows: 84, columns: 7},
      'Юнит-экономика товара(ов)': {rows: 25, columns: 10},
      'Инструкция импортёру': {rows: 68, columns: 6}
    };
    Object.keys(printAreas).forEach(name => {
      const sheet = tempSpreadsheet.getSheetByName(name);
      if (!sheet) return;
      const cfg = printAreas[name];
      if (sheet.getMaxRows() > cfg.rows) {
        sheet.deleteRows(cfg.rows + 1, sheet.getMaxRows() - cfg.rows);
      }
      if (sheet.getMaxColumns() > cfg.columns) {
        sheet.deleteColumns(cfg.columns + 1, sheet.getMaxColumns() - cfg.columns);
      }
    });
    SpreadsheetApp.flush();
    Utilities.sleep(500);
    const url =
      `https://docs.google.com/spreadsheets/d/${tempFile.getId()}/export` +
      '?format=pdf&single=false&size=letter&portrait=true&scale=2' +
      '&sheetnames=false&printtitle=false&pagenumbers=false' +
      '&gridlines=false&fzr=false&top_margin=0.25' +
      '&bottom_margin=0.25&left_margin=0.25&right_margin=0.25';
    const response = UrlFetchApp.fetch(url, {
      headers: {Authorization: `Bearer ${ScriptApp.getOAuthToken()}`},
      muteHttpExceptions: true
    });
    if (response.getResponseCode() !== 200) {
      throw new Error(`PDF export HTTP ${response.getResponseCode()}: ${response.getContentText().slice(0, 500)}`);
    }
    pdfBlob = response.getBlob().setName(`${fileName}.pdf`);
  } finally {
    tempFile.setTrashed(true);
  }
  return folder.createFile(pdfBlob);
}

function generateQuoteDocuments() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  let stage = 'START';
  let dealId = '';
  try {
    stage = 'RESOLVE_DEAL';
    dealId = resolveDealIdForCalculation_(spreadsheet);
    if (!dealId) return;

    stage = 'READ_MODEL';
    const model = readDealCalculationModel_(spreadsheet, dealId);

    stage = 'CALCULATE_MODEL';
    const result = calculateDealModel_(model);

    stage = 'READ_VERIFIED_SNAPSHOT';
    const snapshot = getLatestVerifiedSnapshot_(spreadsheet, dealId);

    stage = 'VALIDATE_SOURCE';
    validateQuoteSource_(model, result, snapshot);

    stage = 'RECONCILE_FINAL_QUOTE_EVIDENCE';
    const intake = buildManagerIntakeAssessment_(spreadsheet, model);

    // DEV-016.48: фактический final-quote gate должен исполняться, а не только
    // существовать как неиспользуемый helper. Он блокирует и owner/technical gates,
    // которые не обязаны проявляться пустым полем в client context.
    stage = 'VALIDATE_FINAL_QUOTE_INTAKE';
    validateFinalQuoteIntake_(intake);

    stage = 'BUILD_CONTEXT';
    const context = buildQuoteContext_(spreadsheet, model, result, intake);

    stage = 'VALIDATE_CONTEXT';
    validateMasterQuoteContext_(context, model, result, intake);

    stage = 'CREATE_NAMES';
    const version = getNextQuoteVersion_(spreadsheet, dealId);
    const externalQuoteNumber = getExternalQuoteNumber_(model, context);
    const baseName = sanitizeFileName_(
      `КП ${externalQuoteNumber} ${quoteClientFilePart_(context.client)} ${version}`
    );

    stage = 'RESOLVE_OUTPUT_FOLDER';
    const outputFolder = getQuoteOutputFolder_(spreadsheet, model.settings, dealId);

    stage = 'OPEN_TEMPLATE_FILE';
    const templateFile = DriveApp.getFileById(BBC_QUOTE_TEMPLATE_ID);

    stage = 'COPY_TEMPLATE';
    const quoteFile = templateFile.makeCopy(baseName, outputFolder);

    stage = 'OPEN_TEMPLATE_COPY';
    const quoteSpreadsheet = SpreadsheetApp.openById(quoteFile.getId());

    stage = 'WRITE_MASTER_TEMPLATE';
    writeMasterTemplateQuote_(
      quoteSpreadsheet,
      context,
      model,
      result,
      externalQuoteNumber,
      version
    );

    stage = 'MATERIALIZE_AND_VALIDATE_CLIENT_SHEETS';
    materializeAndValidateClientSheets_(quoteSpreadsheet);

    stage = 'REMOVE_INTERNAL_SHEETS';
    removeInternalTemplateSheets_(quoteSpreadsheet);

    stage = 'VALIDATE_AFTER_INTERNAL_SHEET_REMOVAL';
    materializeAndValidateClientSheets_(quoteSpreadsheet);

    stage = 'NORMALIZE_CLIENT_PRINT_AREAS';
    normalizeClientSheetPrintAreas_(quoteSpreadsheet);

    stage = 'FLUSH_TEMPLATE';
    SpreadsheetApp.flush();
    Utilities.sleep(1200);

    stage = 'GET_CLIENT_SHEET';
    const clientSheet = quoteSpreadsheet.getSheetByName('Расчет сделки ВЭД');
    if (!clientSheet) {
      throw new Error('В мастер-шаблоне отсутствует лист «Расчет сделки ВЭД».');
    }

    stage = 'EXPORT_XLSX';
    const xlsxFile = exportQuoteFile_(
      quoteSpreadsheet.getId(),
      'xlsx',
      `${baseName}.xlsx`,
      outputFolder
    );

    stage = 'EXPORT_PDF';
    const pdfFile = exportMasterQuotePdf_(
      quoteSpreadsheet.getId(),
      clientSheet.getSheetId(),
      `${baseName}.pdf`,
      outputFolder
    );

    stage = 'WRITE_DOCUMENT_RECORDS';
    appendQuoteDocumentRecords_(spreadsheet, {
      dealId,
      format: 'DEV-015.5',
      version,
      baseName,
      googleFile: quoteFile,
      xlsxFile,
      pdfFile,
      createdBy: context.manager || 'Система BBC'
    });

    stage = 'UPDATE_DEAL_STATUS';
    updateDealDocumentStatus_(spreadsheet, model.dealRowNumber);

    stage = 'WRITE_SUCCESS_LOG';
    writeLog_(
      'DOCUMENT',
      'GENERATE_DEV015_2_MASTER_TEMPLATE_QUOTE',
      dealId,
      `Создано КП DEV-015.5 ${externalQuoteNumber} ${version}: Google Sheets, Excel и многостраничный PDF`
    );

    SpreadsheetApp.getUi().alert(
      'Коммерческое предложение сформировано по эталонному шаблону.\n\n' +
      `Код: v${BBC_MVP.version}\n` +
      `Номер КП: ${externalQuoteNumber}\n` +
      `Версия: ${version}\n` +
      `Товарных позиций: ${context.items.length}\n\n` +
      'Созданы: Google Таблица, Excel и многостраничный PDF.\n' +
      'Внутренние расчетные листы в клиентские файлы не включены.\n' +
      'Ссылки записаны на лист «Документы».'
    );
  } catch (error) {
    const message = String(error && error.message || error);
    const stack = String(error && error.stack || '');
    console.error(`STAGE=${stage}; DEAL=${dealId}; MESSAGE=${message}; STACK=${stack}`);
    writeLog_(
      'ERROR',
      'GENERATE_DEV015_2_MASTER_TEMPLATE_QUOTE_FAILED',
      dealId,
      `Этап: ${stage}; Ошибка: ${message}; Стек: ${stack}`
    );
    SpreadsheetApp.getUi().alert(
      'КП не сформировано.\n\n' +
      `Этап: ${stage}\n` +
      `Ошибка: ${message}`
    );
    throw error;
  } finally {
    lock.releaseLock();
  }
}

