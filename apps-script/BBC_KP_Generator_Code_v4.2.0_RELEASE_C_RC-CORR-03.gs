function bbcChatApiDispatch_(action, args, requestId) {
  switch (String(action || '')) {
    case 'startDealFromFiles':
      return bbcChatApiStartDealFromFiles_(args || {}, requestId);
    case 'submitManagerAnswers':
      return bbcChatApiSubmitManagerAnswers_(args || {}, requestId);
    case 'generateQuote':
      if (args && args.snapshotId) return bbcDocumentContourGenerateQuote_(args || {}, requestId);
      return bbcChatApiGenerateQuote_(args && args.dealId, requestId);
    case 'getDealPackage':
      return bbcChatApiGetDealPackage_(args && args.dealId, requestId);
    case 'validateCanonicalDeal':
      return bbcDocumentContourValidateCanonicalDeal_(args || {}, requestId);
    case 'recalculateDeal':
      return bbcDocumentContourRecalculateDeal_(args || {}, requestId);
    case 'getVerifiedSnapshot':
      return bbcDocumentContourGetVerifiedSnapshot_(args || {}, requestId);
    case 'getDealStatus':
      return bbcDocumentContourGetDealStatus_(args || {}, requestId);
    default:
      throw new Error(`Неизвестная операция Chat API: ${action}`);
  }
}

function bbcChatApiCreateDeal_(spreadsheet, args, files) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.deals);
  if (!sheet) throw new Error('Лист «Сделки» не найден.');

  const headers = readSheetHeaders_(sheet);
  const row = Array(headers.length).fill('');
  const now = new Date();
  const dealId = `BBC-${Utilities.getUuid()}`;
  const values = {
    'deal_id': dealId,
    'Дата создания': now,
    'Клиент': safeSpreadsheetText_(args.clientHint || ''),
    'Менеджер': safeSpreadsheetText_(args.managerName || ''),
    'Исходный файл': (files || []).map(file => file.fileName || file.driveFileId || '')
      .filter(Boolean).join('; '),
    'Ссылка на исходный файл': (files || []).map(file => file.driveUrl ||
      (file.driveFileId ? `https://drive.google.com/open?id=${file.driveFileId}` : ''))
      .filter(Boolean).join('; '),
    'Статус обработки': 'Новый',
    'Режим комиссии BBC': 'Ручной',
    'Формат КП': 'Краткое',
    'Валюта клиентского КП': 'RUB',
    'Дата последнего изменения': now,
    'Статус данных сделки': 'UNKNOWN'
  };

  headers.forEach((header, index) => {
    if (Object.prototype.hasOwnProperty.call(values, header)) row[index] = values[header];
  });
  sheet.appendRow(row);

  writeLog_('SYSTEM', 'CHAT_CREATE_DEAL', dealId, 'Сделка создана из ChatGPT Projects.');
  return dealId;
}

function bbcChatApiNormalizeFile_(file) {
  const driveUrl = String(file && file.driveUrl || '').trim();
  const explicitId = String(file && file.driveFileId || '').trim();
  const driveFileId = explicitId || extractDriveFileId_(driveUrl);
  if (!driveFileId) {
    throw new Error('Не удалось определить Drive file ID одного из исходных файлов.');
  }
  return {
    driveFileId,
    driveUrl: driveUrl || `https://drive.google.com/open?id=${driveFileId}`,
    fileName: safeSpreadsheetText_(file && file.fileName || '')
  };
}

function bbcChatApiRecordImportStart_(
  spreadsheet, importId, dealId, startedAt, sourceFileId, sourceName, sourceMimeType
) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.imports);
  sheet.appendRow([
    importId, dealId, startedAt, '', sourceFileId, sourceName,
    `https://drive.google.com/open?id=${sourceFileId}`, sourceMimeType,
    '', '', '', getCurrentUser_(), 'Выполняется', ''
  ]);
}

function bbcChatApiRecordImportCompletion_(spreadsheet, report, status, errorText) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.imports);
  const row = findRowByValue_(sheet, 1, report.importId);
  if (!row) throw new Error(`Импорт ${report.importId} не найден в реестре.`);
  sheet.getRange(row, 4, 1, 11).setValues([[
    new Date(), report.sourceFileId, report.sourceName, report.sourceUrl,
    report.sourceMimeType, report.sheets.length, report.totalNonEmptyCells,
    report.totalFormulaCells, getCurrentUser_(), status, errorText || ''
  ]]);
}

function bbcChatApiImportExcelFile_(spreadsheet, dealId, fileRef) {
  const importId = `IMP-${Utilities.getUuid()}`;
  let temporarySpreadsheetId = null;
  let temporarySourceCopyId = null;
  const startedAt = new Date();

  try {
    const sourceHandle = openDriveFileForExcelImport_(fileRef.driveFileId);
    const sourceFile = sourceHandle.file;
    const sourceName = sourceHandle.originalName || sourceFile.getName();
    const sourceMimeType = sourceHandle.originalMimeType || sourceFile.getMimeType();
    temporarySourceCopyId = sourceHandle.temporaryCopyId || null;

    if (!isSupportedExcelMimeType_(sourceMimeType, sourceName)) {
      throw new Error(
        `UNSUPPORTED_SOURCE_TYPE: ${sourceName} (${sourceMimeType}). ` +
        'DEV-016.38 автоматический binary intake поддерживает XLS/XLSX.'
      );
    }

    bbcChatApiRecordImportStart_(
      spreadsheet, importId, dealId, startedAt,
      fileRef.driveFileId, sourceName, sourceMimeType
    );

    const convertedFile = Drive.Files.create(
      {
        name: `TEMP_BBC_CHAT_IMPORT_${Date.now()}_${sourceName}`,
        mimeType: 'application/vnd.google-apps.spreadsheet'
      },
      sourceFile.getBlob().setName(sourceName),
      {fields: 'id,name,mimeType'}
    );
    temporarySpreadsheetId = convertedFile.id;
    if (!temporarySpreadsheetId) {
      throw new Error('Google Drive не вернул ID временной таблицы.');
    }

    const importedSpreadsheet = SpreadsheetApp.openById(temporarySpreadsheetId);
    const report = analyzeImportedSpreadsheet_(
      importedSpreadsheet,
      importId,
      dealId,
      fileRef.driveFileId,
      sourceName,
      sourceMimeType
    );

    writeImportMap_(spreadsheet, report);
    writeImportCells_(spreadsheet, report);
    writeImportLog_(spreadsheet, report);
    bbcChatApiRecordImportCompletion_(spreadsheet, report, 'Завершён', '');

    return {
      importId,
      sourceFileId: fileRef.driveFileId,
      sourceName,
      sourceMimeType,
      sheets: report.sheets.length,
      nonEmptyCells: report.totalNonEmptyCells,
      formulaCells: report.totalFormulaCells
    };
  } catch (error) {
    try {
      const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.imports);
      const row = sheet && findRowByValue_(sheet, 1, importId);
      if (row) {
        sheet.getRange(row, 4).setValue(new Date());
        sheet.getRange(row, 13, 1, 2).setValues([[
          'Ошибка', String(error && error.message || error)
        ]]);
      }
    } catch (ignored) {
      console.error(ignored);
    }
    throw error;
  } finally {
    if (temporarySpreadsheetId) {
      trashDriveFileSafe_(temporarySpreadsheetId, 'Не удалось удалить временную таблицу:');
    }
    if (temporarySourceCopyId) {
      trashDriveFileSafe_(
        temporarySourceCopyId, 'Не удалось удалить временную копию исходного Excel:'
      );
    }
  }
}

function bbcChatApiRecognizeImportedFields_(spreadsheet, importId) {
  const sourceSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.importCells);
  if (!sourceSheet || sourceSheet.getLastRow() < 2) {
    throw new Error('Нет данных на листе «Импорт — ячейки».');
  }

  const values = sourceSheet
    .getRange(2, 1, sourceSheet.getLastRow() - 1, 15)
    .getValues()
    .filter(row => String(row[0]) === String(importId));
  if (!values.length) throw new Error(`Для import_id ${importId} ячейки не найдены.`);

  const recognized = [];
  const candidates = [];
  const cellIndex = buildCellIndex_(values);
  const rowContext = buildRecognitionRowContext_(values);

  values.forEach(row => {
    const [
      rowImportId, dealId, sourceFileId, sourceFile, sheetName,
      rowNumber, columnNumber, cellAddress, rawValue, displayValue,
      formula, , detectedType, detectedCurrency, detectedUnit
    ] = row;

    if (isRecognitionInstructionSheet_(sheetName)) return;
    if (!isLikelyRecognitionLabel_(displayValue, detectedType)) return;
    const preliminaryRole = detectPreliminaryCellRole_(displayValue);
    if (preliminaryRole === 'Значение' || preliminaryRole === 'Примечание') return;

    const result = classifyImportedCell_(
      normalizeRecognitionText_(`${rawValue} ${displayValue}`),
      detectedType, detectedCurrency, detectedUnit
    );
    if (!result.fieldCode) return;
    if (isRecognitionSemanticNoise_(displayValue, result.fieldCode)) return;

    const linkedCandidate = findLinkedValue_(
      cellIndex, sourceFileId, sheetName,
      Number(rowNumber), Number(columnNumber),
      result.fieldCode, result.valueType
    );

    candidates.push({
      rowImportId, dealId, sourceFileId, sourceFile, sheetName,
      rowNumber: Number(rowNumber), columnNumber: Number(columnNumber),
      cellAddress, displayValue, formula, detectedCurrency, detectedUnit,
      result, hasLinkedValue: linkedCandidate.status === 'Найдено'
    });
  });

  const fieldsWithScalarValue = new Set(
    candidates.filter(candidate => candidate.hasLinkedValue)
      .map(candidate => buildRecognitionFieldKey_(candidate))
  );

  candidates.forEach(candidate => {
    const result = candidate.result;
    const cellRole = getContextualRecognizedCellRole_(
      candidate, rowContext, fieldsWithScalarValue
    );
    const linkEligibility = getLinkEligibility_(cellRole, result.fieldCode);

    recognized.push([
      stableId_('REC', [
        candidate.rowImportId, candidate.sheetName,
        candidate.cellAddress, result.fieldCode
      ]),
      candidate.rowImportId,
      candidate.dealId,
      candidate.sourceFileId,
      candidate.sourceFile,
      candidate.sheetName,
      candidate.rowNumber,
      candidate.columnNumber,
      candidate.cellAddress,
      candidate.displayValue,
      safeSpreadsheetText_(candidate.formula),
      cellRole,
      linkEligibility,
      result.group,
      result.fieldCode,
      result.fieldName,
      result.valueType,
      candidate.detectedCurrency || result.currency,
      candidate.detectedUnit || result.unit,
      result.confidence,
      result.reason,
      'Требует проверки',
      ''
    ]);
  });

  writeRecognizedFields_(spreadsheet, recognized);
  writeLog_(
    'SYSTEM', 'CHAT_RECOGNIZE_FIELDS', values[0][1],
    `import_id ${importId}; распознано ${recognized.length}`
  );
  return {recognizedCount: recognized.length};
}

function bbcChatApiLinkRecognizedFields_(spreadsheet, importId) {
  const recognizedSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.recognized);
  const cellsSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.importCells);
  if (!recognizedSheet || !cellsSheet) {
    throw new Error('Не найдены листы распознавания.');
  }

  const allRecognizedRows = recognizedSheet.getLastRow() > 1
    ? recognizedSheet.getRange(2, 1, recognizedSheet.getLastRow() - 1, 23)
      .getValues().filter(row => String(row[1]) === String(importId))
    : [];
  const recognizedRows = allRecognizedRows.filter(row => String(row[12]) === 'Да');
  const cellRows = cellsSheet.getLastRow() > 1
    ? cellsSheet.getRange(2, 1, cellsSheet.getLastRow() - 1, 15)
      .getValues().filter(row => String(row[0]) === String(importId))
    : [];

  if (!cellRows.length) throw new Error(`Для import_id ${importId} нет импортированных ячеек.`);

  const cellIndex = buildCellIndex_(cellRows);
  const resultRows = recognizedRows.map(row => {
    const linked = findLinkedValue_(
      cellIndex, row[3], row[5], Number(row[6]), Number(row[7]),
      row[14], row[16]
    );
    return [
      stableId_('LNK', [row[0]]), row[0], importId, row[2],
      row[3], row[4], row[5], row[8], row[9], row[11], row[12],
      row[13], row[14], row[15], row[16], linked.valueCell,
      linked.displayValue, linked.rawValue,
      normalizeLinkedValue_(linked, row[14], row[16]),
      safeSpreadsheetText_(linked.formula), linked.detectedType,
      linked.detectedCurrency || row[17],
      linked.detectedUnit || row[18], linked.direction, linked.distance,
      linked.confidence || row[19], linked.status, linked.reason,
      'Требует проверки', ''
    ];
  });

  writeLinkedFields_(spreadsheet, resultRows);
  const linkedCount = resultRows.filter(row => row[15] !== '').length;
  writeLog_(
    'SYSTEM', 'CHAT_LINK_FIELDS',
    allRecognizedRows.length ? allRecognizedRows[0][2] : '',
    `import_id ${importId}; связано ${linkedCount}`
  );
  return {linkedCount, total: resultRows.length};
}

function bbcChatApiRecognizeTableRows_(spreadsheet, importId) {
  const cellsSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.importCells);
  if (!cellsSheet || cellsSheet.getLastRow() < 2) {
    throw new Error('Нет данных импорта для распознавания строк.');
  }
  const cellRows = cellsSheet
    .getRange(2, 1, cellsSheet.getLastRow() - 1, 15)
    .getValues()
    .filter(row => String(row[0]) === String(importId));
  if (!cellRows.length) throw new Error(`Для import_id ${importId} ячейки не найдены.`);

  const groups = buildImportedRowGroups_(cellRows);
  const currencyColumnsBySheet = buildImportedCurrencyColumnMap_(groups);
  const rows = [];
  const sectionBySheet = new Map();

  groups.forEach(group => {
    const orderedCells = [...group.cells.entries()]
      .sort((left, right) => left[0] - right[0]);

    const sectionCell = orderedCells.find(([, cell]) =>
      detectImportedSection_(cell.displayValue || cell.rawValue)
    );
    const hasNumericCell = orderedCells.some(([, cell]) =>
      parseFlexibleNumber_(
        cell.rawValue == null || cell.rawValue === ''
          ? cell.displayValue : cell.rawValue
      ) !== null
    );
    if (sectionCell && !hasNumericCell) {
      sectionBySheet.set(
        group.sheetKey,
        detectImportedSection_(sectionCell[1].displayValue || sectionCell[1].rawValue)
      );
      return;
    }

    let labelCell = null;
    let result = null;
    orderedCells.some(([, cell]) => {
      const candidate = classifyImportedTableRow_(cell.displayValue || cell.rawValue);
      if (!candidate.fieldCode) return false;
      labelCell = cell;
      result = candidate;
      return true;
    });
    if (!labelCell || !result) return;

    const amountSelection = selectImportedTableAmount_(
      group, labelCell,
      currencyColumnsBySheet.get(group.sheetKey) || new Map()
    );
    if (!amountSelection) return;

    rows.push(buildRecognizedTableRow_(
      group, sectionBySheet.get(group.sheetKey) || '',
      labelCell, amountSelection.amountCell, amountSelection.currencyCell,
      amountSelection.currency, amountSelection.amount, result
    ));
  });

  detectImportedRates_(groups).forEach(rate => rows.push(rate));
  writeRecognizedTableRows_(spreadsheet, rows);
  writeLog_(
    'SYSTEM', 'CHAT_RECOGNIZE_TABLE_ROWS', cellRows[0][1],
    `import_id ${importId}; строк ${rows.length}`
  );
  return {rowCount: rows.length};
}

function bbcChatApiFieldAuthorityCode_(fieldCode) {
  const map = {
    CLIENT_NAME: 'deal.client',
    DEAL_NUMBER: 'deal.number',
    ROUTE: 'logistics.route',
    BORDER_CROSSING: 'logistics.borderCrossing',
    DELIVERY_TERMS: 'logistics.incoterms',
    ITEM_NAME: 'item.name',
    ARTICLE: 'item.article',
    TN_VED: 'item.tnVed',
    QUANTITY: 'item.quantity',
    TOTAL_WEIGHT: 'item.weight',
    VOLUME: 'item.volume',
    VEHICLE_TYPE: 'logistics.transportMode',
    CERTIFICATION: 'expense.certification',
    GRAND_TOTAL: 'deal.total'
  };
  return map[String(fieldCode || '').toUpperCase()] || `expense.${String(fieldCode || '').toLowerCase()}`;
}

function bbcChatApiSourceCatalog_(spreadsheet, dealId) {
  const model = readDealCalculationModel_(spreadsheet, dealId);
  const trace = buildAiSourceTraceability_(
    spreadsheet, dealId, model.dealRecord || {}, model.allItemRecords || []
  );
  const records = readAiImportedCellRecords_(spreadsheet, dealId);
  return buildAiSourceCatalog_(trace, records);
}

function bbcChatApiCanonicalCandidateValue_(value) {
  if (value === null || value === undefined) return '';
  if (typeof value === 'number') return roundTo_(value, 8).toFixed(8);
  const numeric = parseFlexibleNumber_(value);
  if (numeric !== null && String(value).trim() !== '') {
    return roundTo_(numeric, 8).toFixed(8);
  }
  return normalizeRecognitionText_(value);
}

function bbcChatApiAutoReview_(spreadsheet, dealId) {
  const catalog = bbcChatApiSourceCatalog_(spreadsheet, dealId);
  const linkedSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.linked);
  const tableSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.tableRows);

  const linkedRows = linkedSheet && linkedSheet.getLastRow() > 1
    ? linkedSheet.getRange(2, 1, linkedSheet.getLastRow() - 1, 30).getValues()
    : [];
  const tableRows = tableSheet && tableSheet.getLastRow() > 1
    ? tableSheet.getRange(2, 1, tableSheet.getLastRow() - 1, 26).getValues()
    : [];

  const linkedCandidates = linkedRows.map((row, index) => ({row, index}))
    .filter(entry =>
      String(entry.row[3]) === String(dealId) &&
      String(entry.row[10]) === 'Да' &&
      String(entry.row[26]) === 'Найдено' &&
      entry.row[18] !== '' &&
      !/^(CNY|USD|EUR)_RUB_RATE$/.test(String(entry.row[12] || '').toUpperCase()) &&
      !isSpreadsheetErrorToken_(entry.row[18])
    );

  const linkedGroups = new Map();
  linkedCandidates.forEach(entry => {
    const code = String(entry.row[12] || '').trim();
    if (!linkedGroups.has(code)) linkedGroups.set(code, []);
    const fileKey = aiFileKey_(entry.row[4], entry.row[5]);
    const role = catalog.sheetRoleByKey.get(
      aiSheetKey_(fileKey, String(entry.row[6] || ''))
    ) || 'UNKNOWN';
    entry.role = role;
    entry.authority = aiRoleAuthority_(role, bbcChatApiFieldAuthorityCode_(code));
    entry.valueKey = bbcChatApiCanonicalCandidateValue_(entry.row[18]);
    linkedGroups.get(code).push(entry);
  });

  let linkedConfirmed = 0;
  let linkedRejected = 0;
  linkedGroups.forEach(entries => {
    const maxAuthority = Math.max.apply(null, entries.map(item => item.authority));
    const top = entries.filter(item => item.authority === maxAuthority);
    const topValues = new Set(top.map(item => item.valueKey));
    entries.forEach(item => {
      const rowNumber = item.index + 2;
      if (topValues.size === 1 && item.authority === maxAuthority) {
        linkedSheet.getRange(rowNumber, 29, 1, 2).setValues([[
          'Подтверждено',
          `DEV-016.38 AUTO_SOURCE_ROLE=${item.role}; authority=${item.authority}`
        ]]);
        linkedConfirmed++;
      } else if (item.authority < maxAuthority) {
        linkedSheet.getRange(rowNumber, 29, 1, 2).setValues([[
          'Не применять',
          `DEV-016.38 lower-priority source ${item.role}; authority=${item.authority}`
        ]]);
        linkedRejected++;
      }
    });
  });

  const tableCandidates = tableRows.map((row, index) => ({row, index}))
    .filter(entry =>
      String(entry.row[2]) === String(dealId) &&
      String(entry.row[21]) === 'Да' &&
      parseFlexibleNumber_(entry.row[13]) !== null &&
      !isSpreadsheetErrorToken_(entry.row[13]) &&
      String(entry.row[20]) !== 'Курс валют'
    );

  const tableGroups = new Map();
  tableCandidates.forEach(entry => {
    const code = String(entry.row[18] || '').trim();
    if (!tableGroups.has(code)) tableGroups.set(code, []);
    const fileKey = aiFileKey_(entry.row[3], entry.row[4]);
    const role = catalog.sheetRoleByKey.get(
      aiSheetKey_(fileKey, String(entry.row[5] || ''))
    ) || 'UNKNOWN';
    entry.role = role;
    entry.authority = aiRoleAuthority_(role, bbcChatApiFieldAuthorityCode_(code));
    entry.valueKey = [
      bbcChatApiCanonicalCandidateValue_(entry.row[13]),
      String(entry.row[16] || '').trim().toUpperCase()
    ].join('|');
    tableGroups.get(code).push(entry);
  });

  let tableConfirmed = 0;
  let tableRejected = 0;
  tableGroups.forEach(entries => {
    const maxAuthority = Math.max.apply(null, entries.map(item => item.authority));
    const top = entries.filter(item => item.authority === maxAuthority);
    const topValues = new Set(top.map(item => item.valueKey));
    entries.forEach(item => {
      const rowNumber = item.index + 2;
      if (topValues.size === 1 && item.authority === maxAuthority) {
        tableSheet.getRange(rowNumber, 25, 1, 2).setValues([[
          'Подтверждено',
          `DEV-016.38 AUTO_SOURCE_ROLE=${item.role}; authority=${item.authority}`
        ]]);
        tableConfirmed++;
      } else if (item.authority < maxAuthority) {
        tableSheet.getRange(rowNumber, 25, 1, 2).setValues([[
          'Не применять',
          `DEV-016.38 lower-priority source ${item.role}; authority=${item.authority}`
        ]]);
        tableRejected++;
      }
    });
  });

  return {
    linkedConfirmed,
    linkedRejected,
    tableConfirmed,
    tableRejected
  };
}

function bbcChatApiApprovedRowsForImport_(spreadsheet, importId) {
  const linkedSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.linked);
  const tableSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.tableRows);
  const approvedStatuses = new Set(['Подтверждено', 'Исправлено']);

  const linked = linkedSheet && linkedSheet.getLastRow() > 1
    ? linkedSheet.getRange(2, 1, linkedSheet.getLastRow() - 1, 30).getValues()
      .filter(row =>
        String(row[2]) === String(importId) &&
        approvedStatuses.has(String(row[28]))
      )
    : [];
  const table = tableSheet && tableSheet.getLastRow() > 1
    ? tableSheet.getRange(2, 1, tableSheet.getLastRow() - 1, 26).getValues()
      .filter(row =>
        String(row[1]) === String(importId) &&
        String(row[21]) === 'Да' &&
        approvedStatuses.has(String(row[24]))
      )
    : [];
  return {linked, table};
}

function bbcChatApiApplyDealAndItems_(spreadsheet, dealId, importIds) {
  let appliedItems = 0;
  let scalarFields = 0;
  const structured = extractStructuredCurrentDealItems_(
    spreadsheet, importIds || [], dealId
  );

  if (structured.items && structured.items.length >= 2) {
    appliedItems = upsertStructuredCurrentDealItems_(
      spreadsheet, dealId, structured.items, structured.customs || {}
    );
  }

  (importIds || []).forEach(importId => {
    const approved = bbcChatApiApprovedRowsForImport_(spreadsheet, importId);
    if (!approved.linked.length && !approved.table.length) return;

    const scalar = buildApprovedScalarMap_(approved.linked);
    const scalarMeta = buildApprovedScalarMetaMap_(approved.linked);
    const importRecord = getImportRecord_(spreadsheet, importId);

    if (scalar.size) {
      applyVerifiedDealData_(
        spreadsheet, dealId, scalar, scalarMeta, importRecord, importId
      );
      scalarFields += scalar.size;
    }

    if (structured.items && structured.items.length >= 2) return;

    const hasItemEvidence =
      approved.table.some(row => String(row[20]) === '\u0422\u043e\u0432\u0430\u0440') ||
      [...scalar.keys()].some(code => [
        'ITEM_NAME', 'ARTICLE', 'TN_VED', 'QUANTITY', 'TOTAL_PRODUCT_VALUE',
        'GROSS_WEIGHT', 'NET_WEIGHT', 'TOTAL_WEIGHT', 'VOLUME', 'PACKAGE_COUNT'
      ].includes(code)) ||
      extractMultiItemOrderTable_(spreadsheet, importId, dealId).length > 0;

    if (hasItemEvidence) {
      appliedItems = Math.max(
        appliedItems,
        applyVerifiedItemData_(
          spreadsheet, dealId, importId, scalar, scalarMeta, approved.table
        )
      );
    }
  });

  return {scalarFields, appliedItems};
}


function bbcChatApiIntakeFieldStateMap_(intake) {
  const map = new Map();
  ((intake && intake.fieldStates) || []).forEach(state => {
    if (state && state.fieldCode) map.set(String(state.fieldCode), state);
  });
  return map;
}

function bbcChatApiSourceResolvedState_(state) {
  if (!state) return false;
  return [
    'CONFIRMED', 'CONFIRMED_BY_SOURCE', 'CONFIRMED_BY_SOURCE_AGGREGATION',
    'FOUND', 'CONFIRMED_ZERO'
  ].includes(String(state.state || '')) &&
    state.selectedValue !== '' && state.selectedValue !== null &&
    state.selectedValue !== undefined;
}

function bbcChatApiDealWritebackValue_(fieldCode, value) {
  if (fieldCode === 'deal.scheme') {
    const raw = String(value || '').trim();
    const normalized = /^(?:BBC_IMPORTER_AND_EXPORTER|CLIENT_IMPORTER_BBC_EXPORTER|BBC_IMPORTER|BBC_EXPORTER|CONTRACTOR_IMPORTER_BBC_ORGANIZER)$/.test(raw)
      ? raw
      : aiNormalizeScheme_(value);
    return safeSpreadsheetText_(normalized ? aiSchemeLabel_(normalized) : value);
  }
  if (fieldCode === 'logistics.incoterms') {
    return safeSpreadsheetText_(aiCanonicalValue_(fieldCode, value) || value);
  }
  if (fieldCode === 'logistics.transportMode') {
    return safeSpreadsheetText_(aiTransportLabel_(aiNormalizeTransport_(value)));
  }
  if (['logistics.deliveryDays', 'logistics.productionDays'].includes(fieldCode)) {
    return safeSpreadsheetText_(aiCanonicalValue_(fieldCode, value) || value);
  }
  return safeSpreadsheetText_(value);
}

function bbcChatApiBuildSourceDealUpdates_(intake, paymentProfile, itemCount) {
  const states = bbcChatApiIntakeFieldStateMap_(intake);
  const updates = new Map();
  const fieldColumns = {
    'deal.client': 4,
    'deal.manager': 5,
    'deal.scheme': 9,
    'deal.quoteCurrency': 14,
    'deal.validityDays': 15,
    'logistics.incoterms': 30,
    'logistics.chinaRoute': 31,
    'logistics.borderCrossing': 32,
    'logistics.destinationCity': 33,
    'logistics.transportMode': 34,
    'logistics.deliveryDays': 35,
    'logistics.productionDays': 36
  };
  Object.keys(fieldColumns).forEach(fieldCode => {
    const state = states.get(fieldCode);
    if (!bbcChatApiSourceResolvedState_(state)) return;
    updates.set(fieldColumns[fieldCode], bbcChatApiDealWritebackValue_(fieldCode, state.selectedValue));
  });

  if (paymentProfile && paymentProfile.status === 'CONFIRMED') {
    const count = Math.max(1, Number(itemCount || 0));
    const schedule = [];
    for (let index = 1; index <= count; index++) {
      schedule.push(`Товар ${index} — ${paymentProfile.display}`);
    }
    updates.set(28, paymentProfile.display);
    updates.set(29, schedule.join('; '));
  }
  return updates;
}

function bbcChatApiWriteResolvedSourceDealFields_(spreadsheet, dealId, intake, itemCount) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.deals);
  const rowNumber = findRowByValue_(sheet, 1, dealId);
  if (!rowNumber) throw new Error(`Сделка ${dealId} не найдена.`);
  const paymentProfile = extractStructuredPaymentSplitProfileFromRows_(
    getImportCellsByDealId_(spreadsheet, dealId)
  );
  const updates = bbcChatApiBuildSourceDealUpdates_(intake, paymentProfile, itemCount);
  if (!updates.size) return {appliedCount: 0, fields: [], paymentProfile: paymentProfile.status};

  const row = sheet.getRange(rowNumber, 1, 1, 36).getValues()[0];
  while (row.length < 36) row.push('');
  const fields = [];
  updates.forEach((value, oneBasedColumn) => {
    row[oneBasedColumn - 1] = value;
    fields.push(oneBasedColumn);
  });
  row[16] = new Date();
  row[25] = BBC_MVP.version;
  row[26] = mergeSystemComment_(
    row[26],
    'DEV-016.54: source-resolved deal fields materialized before calculation'
  );
  sheet.getRange(rowNumber, 1, 1, 36).setValues([row]);
  return {appliedCount: updates.size, fields, paymentProfile: paymentProfile.status};
}

function bbcChatApiApplyExpenses_(spreadsheet, dealId, importIds) {
  let expenseCount = 0;
  const issues = [];

  (importIds || []).forEach(importId => {
    const approved = bbcChatApiApprovedRowsForImport_(spreadsheet, importId);
    const expenseRows = approved.table.filter(row => row[20] === 'Расход');
    if (!expenseRows.length) return;

    const conversionIssues = validateExpenseConversionInputs_(
      spreadsheet, expenseRows, dealId
    );
    if (conversionIssues.length) {
      issues.push.apply(issues, conversionIssues);
      return;
    }

    expenseCount += applyVerifiedExpenseData_(
      spreadsheet, dealId, importId, approved.table
    );
  });

  return {expenseCount, issues: [...new Set(issues)]};
}

function bbcChatApiRateCodeToField_(code) {
  const source = String(code || '').toUpperCase();
  if (source === 'CNY_RUB_RATE') return 'rates.cnyRub';
  if (source === 'USD_RUB_RATE') return 'rates.usdRub';
  if (source === 'EUR_RUB_RATE') return 'rates.eurRub';
  return '';
}

function bbcChatApiRateFieldToCode_(fieldCode) {
  const source = String(fieldCode || '');
  if (source === 'rates.cnyRub') return 'CNY_RUB_RATE';
  if (source === 'rates.usdRub') return 'USD_RUB_RATE';
  if (source === 'rates.eurRub') return 'EUR_RUB_RATE';
  return '';
}

function bbcChatApiBuildRateQuestion_(currency, fieldCode, distinct) {
  const values = (distinct || []).filter(value => Number(value) > 0);
  // DEV-016.43: единственное однозначное значение из текущих документов — это
  // данные сделки, а не вопрос менеджеру. Даже если технический контур не успел
  // материализовать его в лист «Курсы валют», managerQuestions остаётся чистым.
  if (values.length === 1) return null;

  const question = values.length > 1
    ? `Во входных файлах найдены разные курсы ${currency}/RUB: ` +
      values.map(value => formatManagerNumber_(value, 4)).join(' / ') +
      '. Укажите актуальный курс для сделки.'
    : `Во входных файлах не найден подтверждённый курс ${currency}/RUB. ` +
      'Укажите актуальный курс для сделки.';

  return {
    questionId: `RATE-${currency}`,
    ruleId: `RATE-${currency}`,
    fieldCode,
    entity: 'RATE',
    fieldName: `Курс ${currency}/RUB`,
    state: values.length > 1 ? 'CONFLICT' : 'MISSING',
    question,
    required: true,
    blockingScope: 'CALCULATION_AND_FINAL_QUOTE',
    answerType: 'RATE_CONFIRM_OR_VALUE',
    writebackTarget: 'Курсы валют',
    candidates: values.map(value => ({displayValue: value, normalizedValue: value}))
  };
}

function bbcChatApiRateQuestions_(spreadsheet, dealId) {
  const tableSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.tableRows);
  const linkedSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.linked);
  const tableRows = tableSheet && tableSheet.getLastRow() > 1
    ? tableSheet.getRange(2, 1, tableSheet.getLastRow() - 1, 26).getValues()
      .filter(row => String(row[2]) === String(dealId))
    : [];
  const linkedRows = linkedSheet && linkedSheet.getLastRow() > 1
    ? linkedSheet.getRange(2, 1, linkedSheet.getLastRow() - 1, 30).getValues()
      .filter(row => String(row[3]) === String(dealId))
    : [];

  /*
   * A currency becomes required only because a canonical item or an approved
   * source row actually uses it. Merely finding a historical rate in an old
   * client output must not create a manager question for an otherwise unused
   * currency.
   */
  const approvedStatuses = new Set(['Подтверждено', 'Исправлено']);
  const currencies = new Set();
  try {
    const model = readDealCalculationModel_(spreadsheet, dealId);
    (model.normalizedItems || []).forEach(item => {
      if ((item.batchValue > 0 || item.unitPrice > 0) &&
          ['CNY', 'USD', 'EUR'].includes(item.priceCurrency)) {
        currencies.add(item.priceCurrency);
      }
      if (item.dutyRate > 0 && ['CNY', 'USD', 'EUR'].includes(item.dutyCurrency)) {
        currencies.add(item.dutyCurrency);
      }
    });
    (model.normalizedExpenses || []).forEach(expense => {
      if (expense.includeInternal && expense.amount > 0 &&
          ['CNY', 'USD', 'EUR'].includes(expense.currency)) {
        currencies.add(expense.currency);
      }
    });
  } catch (ignored) {
    // Initial intake may still be incomplete; approved source rows below remain authoritative.
  }

  tableRows.forEach(row => {
    if (String(row[20]) === 'Курс валют') return;
    if (!approvedStatuses.has(String(row[24] || '').trim())) return;
    const currency = String(row[16] || '').trim().toUpperCase();
    if (['CNY', 'USD', 'EUR'].includes(currency)) currencies.add(currency);
  });
  linkedRows.forEach(row => {
    if (/^(CNY|USD|EUR)_RUB_RATE$/.test(String(row[12] || '').trim().toUpperCase())) return;
    if (!approvedStatuses.has(String(row[28] || '').trim())) return;
    const currency = String(row[21] || '').trim().toUpperCase();
    if (['CNY', 'USD', 'EUR'].includes(currency)) currencies.add(currency);
  });

  // The multi-item «Заказ» importer has a canonical CNY price even when the
  // source has no explicit currency scalar; the canonical item check above
  // already covers that case. Do not infer USD/EUR from generic '$' or formula
  // formatting in unrelated historical sheets.

  const currentBook = buildCalculationRateBook_(spreadsheet, [], dealId);
  const confirmed = currentBook.selected || new Map();
  const candidates = new Map();

  linkedRows.forEach(row => {
    if (!approvedStatuses.has(String(row[28] || '').trim())) return;
    const code = String(row[12] || '').trim().toUpperCase();
    if (!/^(CNY|USD|EUR)_RUB_RATE$/.test(code)) return;
    const value = parseFlexibleNumber_(row[18]);
    if (!(value > 0)) return;
    if (!candidates.has(code)) candidates.set(code, []);
    candidates.get(code).push({
      value,
      source: `${row[5] || ''}!${row[15] || row[7] || ''}`
    });
  });
  tableRows.forEach(row => {
    if (String(row[20]) !== 'Курс валют') return;
    if (!approvedStatuses.has(String(row[24] || '').trim())) return;
    const code = String(row[18] || '').trim().toUpperCase();
    const value = parseFlexibleNumber_(row[13]);
    if (!/^(CNY|USD|EUR)_RUB_RATE$/.test(code) || !(value > 0)) return;
    if (!candidates.has(code)) candidates.set(code, []);
    candidates.get(code).push({
      value,
      source: `${row[4] || ''}!${row[10] || ''}`
    });
  });

  const questions = [];
  [...currencies].sort().forEach(currency => {
    const code = `${currency}_RUB_RATE`;
    if (confirmed.has(code)) return;
    const fieldCode = bbcChatApiRateCodeToField_(code);
    const entries = candidates.get(code) || [];
    const distinct = [...new Set(entries.map(entry => roundTo_(entry.value, 8).toFixed(8)))]
      .map(Number);

    const question = bbcChatApiBuildRateQuestion_(currency, fieldCode, distinct);
    if (question) questions.push(question);
  });

  return questions;
}

function bbcChatApiMergeQuestions_(intake, rateQuestions) {
  const source = (intake && intake.managerQuestions || []).slice();
  const seen = new Set(source.map(question => `${question.ruleId}|${question.fieldCode}`));
  (rateQuestions || []).forEach(question => {
    const key = `${question.ruleId}|${question.fieldCode}`;
    if (!seen.has(key)) {
      source.unshift(question);
      seen.add(key);
    }
  });
  source.forEach((question, index) => {
    if (!question.questionId || /^Q-\d+$/.test(String(question.questionId))) {
      question.questionId = question.questionId || `Q-${String(index + 1).padStart(3, '0')}`;
    }
  });
  return source;
}

function bbcChatApiGateState_(intake, rateQuestions) {
  const rates = rateQuestions || [];
  const externalRateBlocksCalculation = rates.some(question =>
    aiScopeBlocksCalculation_(question.blockingScope)
  );
  const externalRateBlocksQuote = rates.some(question =>
    aiScopeBlocksQuote_(question.blockingScope)
  );
  return {
    calculationAllowed:
      (!intake || intake.calculationAllowed !== false) &&
      !externalRateBlocksCalculation,
    quoteGateAllowed:
      (!intake || intake.quoteAllowed !== false) &&
      !externalRateBlocksQuote
  };
}

function bbcChatApiPackageStatus_(intake, rateQuestions, verifiedResult, quoteFiles) {
  if (quoteFiles) return 'QUOTE_READY';
  const gate = bbcChatApiGateState_(intake, rateQuestions);
  if (!gate.calculationAllowed) return 'NEEDS_MANAGER_INPUT_BEFORE_CALCULATION';
  if (!gate.quoteGateAllowed) return 'NEEDS_MANAGER_INPUT_BEFORE_FINAL_QUOTE';
  return verifiedResult && verifiedResult.status === 'Проверен'
    ? 'READY_FOR_CALCULATION_AND_QUOTE'
    : 'CALCULATION_NOT_VERIFIED';
}

function bbcChatApiCalculate_(spreadsheet, dealId) {
  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  let result;
  try {
    let model = readDealCalculationModel_(spreadsheet, dealId);
    ensureAutomaticMultiItemAllocations_(spreadsheet, model);
    model = readDealCalculationModel_(spreadsheet, dealId);
    result = calculateDealModel_(model);
    const checks = buildCalculationChecks_(model, result);
    applyPreservedCheckStatuses_(spreadsheet, dealId, checks);
    result.checks = checks;
    result.criticalCount = checks.filter(check =>
      check.severity === 'Критическая ошибка' && check.status === 'Открыто'
    ).length;
    result.warningCount = checks.filter(check =>
      check.severity === 'Предупреждение' && check.status === 'Открыто'
    ).length;
    result.status = result.criticalCount > 0
      ? 'Ошибка'
      : result.warningCount > 0 ? 'Требует проверки' : 'Проверен';

    writeItemLevelCalculations_(spreadsheet, model, result.itemLineCalculation);
    writeCurrentCalculations_(spreadsheet, model, result);
    writeCurrentChecks_(spreadsheet, dealId, checks);
    updateAppliedDecisionRows_(
      spreadsheet, dealId,
      result.decisionApplication && result.decisionApplication.applications
    );
    result.snapshotId = appendCalculationSnapshot_(spreadsheet, model, result);
    updateDealCalculationStatus_(spreadsheet, dealId, result);
  } finally {
    lock.releaseLock();
  }

  writeLog_(
    'SYSTEM', 'CHAT_CALCULATE_AND_CHECK', dealId,
    `snapshot_id ${result.snapshotId}; status ${result.status}; ` +
    `critical ${result.criticalCount}; warnings ${result.warningCount}`
  );

  return {
    snapshotId: result.snapshotId,
    status: result.status,
    goodsRub: result.goodsRub,
    expensesRub: result.expensesRub,
    totalRub: result.totalRub,
    totalCny: result.totalCny,
    cnyRub: result.cnyRub,
    usdRub: result.usdRub,
    eurRub: result.eurRub,
    criticalCount: result.criticalCount,
    warningCount: result.warningCount
  };
}

function bbcChatApiTryProgress_(spreadsheet, dealId, importIds, options) {
  const opts = options || {};
  /*
   * DEV-016.38 safety invariant:
   * source writeback is performed only during the initial file intake. Once a
   * manager has answered in ChatGPT, canonical manager-confirmed values must not
   * be overwritten by re-applying lower-authority imported source rows.
   */
  const reapplySourceData = opts.reapplySourceData !== false;
  const autoReview = reapplySourceData
    ? bbcChatApiAutoReview_(spreadsheet, dealId)
    : {skipped: true, reason: 'MANAGER_CONFIRMED_CANONICAL_VALUES_PRESERVED'};
  const dealItemApply = reapplySourceData
    ? bbcChatApiApplyDealAndItems_(spreadsheet, dealId, importIds)
    : {scalarFields: 0, appliedItems: 0, skipped: true};
  // DEV-016.41: если в текущих документах сделки найден ровно один
  // непротиворечивый курс, он применяется автоматически как source-confirmed.
  // Менеджеру задаётся вопрос только при отсутствии курса или реальном конфликте.
  const sourceRateApply = reapplySourceData
    ? bbcChatApiAutoApplyUniqueSourceRates_(spreadsheet, dealId)
    : {appliedCount: 0, applied: [], skipped: true};
  const rateQuestions = bbcChatApiRateQuestions_(spreadsheet, dealId);

  let expenseApply = {expenseCount: 0, issues: []};
  let calculation = null;

  if (!rateQuestions.length) {
    expenseApply = bbcChatApiApplyExpenses_(spreadsheet, dealId, importIds);
  }

  // DEV-016.48: до записывающего расчёта выполняется source-only intake gate.
  // Это не позволяет создавать новый snapshot/derived output, если текущие документы
  // всё ещё содержат реально блокирующий пробел или конфликт.
  let preCalculationModel = readDealCalculationModel_(spreadsheet, dealId);
  let preCalculationIntake = buildManagerIntakeAssessment_(spreadsheet, preCalculationModel);
  const sourceDealSync = reapplySourceData
    ? bbcChatApiWriteResolvedSourceDealFields_(
        spreadsheet, dealId, preCalculationIntake,
        dealItemApply.appliedItems || (preCalculationModel.normalizedItems || []).length
      )
    : {appliedCount: 0, fields: [], paymentProfile: 'SKIPPED'};
  if (sourceDealSync.appliedCount) {
    preCalculationModel = readDealCalculationModel_(spreadsheet, dealId);
    preCalculationIntake = buildManagerIntakeAssessment_(spreadsheet, preCalculationModel);
  }
  const preCalculationGate = bbcChatApiGateState_(preCalculationIntake, rateQuestions);

  if (preCalculationGate.calculationAllowed && !expenseApply.issues.length) {
    try {
      calculation = bbcChatApiCalculate_(spreadsheet, dealId);
    } catch (error) {
      calculation = {
        status: 'NOT_CALCULATED',
        error: String(error && error.message || error)
      };
    }
  }

  // После допустимого расчёта intake строится повторно уже по фактическому текущему
  // snapshot/check state. При блокировке до расчёта это остаётся чистой read-only оценкой.
  const model = readDealCalculationModel_(spreadsheet, dealId);
  const intake = buildManagerIntakeAssessment_(spreadsheet, model);
  const questions = bbcChatApiMergeQuestions_(intake, rateQuestions);
  const gate = bbcChatApiGateState_(intake, rateQuestions);
  const calculationAllowed = gate.calculationAllowed;
  const quoteGateAllowed = gate.quoteGateAllowed;
  const quoteAllowed =
    quoteGateAllowed &&
    Boolean(calculation && calculation.status === 'Проверен');

  let quoteFiles = null;
  if (
    opts.autoGenerateQuote !== false &&
    BBC_CHAT_API.autoGenerateQuote &&
    quoteAllowed &&
    calculation &&
    calculation.status === 'Проверен'
  ) {
    quoteFiles = bbcChatApiGenerateQuote_(dealId, opts.requestId);
  }

  return {
    dealId,
    packageStatus: bbcChatApiPackageStatus_(intake, rateQuestions, calculation, quoteFiles),
    calculationAllowed,
    quoteAllowed,
    managerQuestions: questions,
    ownerDecisionsPending: intake.ownerDecisionsPending || [],
    conflicts: intake.conflicts || [],
    technicalFindings: intake.technicalFindings || [],
    autoReview,
    applied: {
      scalarFields: dealItemApply.scalarFields,
      dealFields: sourceDealSync.appliedCount,
      dealFieldColumns: sourceDealSync.fields,
      items: dealItemApply.appliedItems,
      expenses: expenseApply.expenseCount,
      expenseIssues: expenseApply.issues
    },
    calculation,
    quoteFiles
  };
}

function bbcChatApiStartDealFromFiles_(args, requestId) {
  const spreadsheet = bbcChatApiSpreadsheet_();
  const files = (args.files || []).map(bbcChatApiNormalizeFile_);
  if (!files.length) throw new Error('Не переданы исходные файлы сделки.');

  const dealId = bbcChatApiCreateDeal_(spreadsheet, args, files);
  const importResults = [];
  const importIds = [];
  let backup = null;

  try {
    backup = createPreWritebackBackup_(
      spreadsheet,
      stableId_('CHAT', [dealId, Date.now(), BBC_MVP.version])
    );

    files.forEach(file => {
      const imported = bbcChatApiImportExcelFile_(spreadsheet, dealId, file);
      importResults.push(imported);
      importIds.push(imported.importId);
      bbcChatApiRecognizeImportedFields_(spreadsheet, imported.importId);
      bbcChatApiLinkRecognizedFields_(spreadsheet, imported.importId);
      bbcChatApiRecognizeTableRows_(spreadsheet, imported.importId);
    });

    const progress = bbcChatApiTryProgress_(spreadsheet, dealId, importIds, {
      autoGenerateQuote: args.autoGenerateQuote !== false,
      requestId
    });

    writeLog_(
      'SYSTEM', 'CHAT_START_DEAL_FROM_FILES', dealId,
      `request_id ${requestId}; imports ${importIds.join(', ')}; status ${progress.packageStatus}`
    );

    return Object.assign(progress, {
      requestId,
      version: BBC_MVP.version,
      importResults,
      backup: backup ? {id: backup.id, url: backup.url} : null
    });
  } catch (error) {
    writeLog_(
      'ERROR', 'CHAT_START_DEAL_FROM_FILES_FAILED', dealId,
      `request_id ${requestId}; ${String(error && error.message || error)}`
    );
    throw error;
  }
}

function bbcChatApiFindQuestion_(spreadsheet, dealId, questionId, fieldCode) {
  const model = readDealCalculationModel_(spreadsheet, dealId);
  const intake = buildManagerIntakeAssessment_(spreadsheet, model);
  const questions = bbcChatApiMergeQuestions_(
    intake, bbcChatApiRateQuestions_(spreadsheet, dealId)
  );
  return questions.find(question =>
    (questionId && String(question.questionId) === String(questionId)) ||
    (fieldCode && String(question.fieldCode) === String(fieldCode))
  ) || null;
}

function bbcChatApiIsAffirmative_(value) {
  if (value === true) return true;
  const text = String(value == null ? '' : value).trim().toLowerCase();
  return ['да', 'yes', 'y', 'true', 'подтверждаю', 'актуален', 'актуально']
    .includes(text);
}

function bbcChatApiResolveAnswerValue_(question, answer) {
  const explicit = answer && Object.prototype.hasOwnProperty.call(answer, 'value')
    ? answer.value
    : answer && answer.answerText;

  if (
    bbcChatApiIsAffirmative_(explicit) &&
    question && Array.isArray(question.candidates) &&
    question.candidates.length === 1
  ) {
    const candidate = question.candidates[0];
    if (Object.prototype.hasOwnProperty.call(candidate, 'displayValue')) {
      return candidate.displayValue;
    }
    if (Object.prototype.hasOwnProperty.call(candidate, 'value')) {
      return candidate.value;
    }
  }
  return explicit;
}

function bbcChatApiSetDealField_(spreadsheet, dealId, header, value, managerInputId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.deals);
  const rowNumber = findRowByValue_(sheet, 1, dealId);
  if (!rowNumber) throw new Error(`Сделка ${dealId} не найдена.`);
  const headers = readSheetHeaders_(sheet);
  const index = headers.indexOf(header);
  if (index === -1) throw new Error(`На листе «Сделки» нет поля «${header}».`);
  sheet.getRange(rowNumber, index + 1).setValue(value);

  const confirmationIdIndex = headers.indexOf('ID подтверждения менеджера');
  const confirmationDateIndex = headers.indexOf('Дата подтверждения менеджера');
  const modifiedIndex = headers.indexOf('Дата последнего изменения');
  if (confirmationIdIndex >= 0) {
    sheet.getRange(rowNumber, confirmationIdIndex + 1).setValue(managerInputId);
  }
  if (confirmationDateIndex >= 0) {
    sheet.getRange(rowNumber, confirmationDateIndex + 1).setValue(new Date());
  }
  if (modifiedIndex >= 0) {
    sheet.getRange(rowNumber, modifiedIndex + 1).setValue(new Date());
  }
}

function bbcChatApiUpsertSourceRate_(spreadsheet, dealId, code, value, sourceHint) {
  const numeric = parseFlexibleNumber_(value);
  if (!(numeric > 0)) {
    throw new Error(`Для ${code} требуется положительный числовой курс.`);
  }

  const sourceCurrency = String(code).replace('_RUB_RATE', '');
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.rates);
  const rows = sheet.getLastRow() > 1
    ? sheet.getRange(2, 1, sheet.getLastRow() - 1, 14).getValues()
    : [];
  const existing = rows.findIndex(row =>
    String(row[13]) === String(dealId) &&
    String(row[2]).trim().toUpperCase() === sourceCurrency &&
    String(row[3]).trim().toUpperCase() === 'RUB' &&
    isTruthy_(row[7])
  );
  const sourceId = `AUTO-SOURCE-${stableId_('RATE', [dealId, sourceCurrency, numeric]).slice(-16)}`;
  const row = [
    `RATE-${sourceCurrency}-RUB-${stableId_('SOURCE', [dealId, sourceCurrency, numeric]).slice(-16)}`,
    new Date(),
    sourceCurrency,
    'RUB',
    numeric,
    `Автоматически из документов сделки${sourceHint ? `: ${sourceHint}` : ''}`,
    'Документ',
    true,
    'Единственное непротиворечивое значение из текущих документов сделки; вопрос менеджеру не требуется',
    'DEAL_CALCULATION',
    true,
    sourceId,
    new Date(),
    dealId
  ];

  if (existing >= 0) {
    sheet.getRange(existing + 2, 1, 1, 14).setValues([row]);
  } else {
    sheet.appendRow(row);
  }
  return numeric;
}

function bbcChatApiAutoApplyUniqueSourceRates_(spreadsheet, dealId) {
  // DEV-016.55: unique source rates must be persisted before the calculation gate.
  // Recognition rows are current-deal evidence even before a human review status is set;
  // explicit «Не применять» rows are excluded and true multi-value conflicts stay unresolved.
  const currentBook = buildCalculationRateBook_(spreadsheet, [], dealId);
  const confirmed = currentBook.selected || new Map();
  const candidates = new Map();
  const addCandidate = (code, value, source) => {
    const normalizedCode = String(code || '').trim().toUpperCase();
    const numeric = parseFlexibleNumber_(value);
    if (!/^(CNY|USD|EUR)_RUB_RATE$/.test(normalizedCode) || !(numeric > 0)) return;
    if (!candidates.has(normalizedCode)) candidates.set(normalizedCode, []);
    candidates.get(normalizedCode).push({value: numeric, source: source || ''});
  };

  const tableSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.tableRows);
  const tableRows = tableSheet && tableSheet.getLastRow() > 1
    ? tableSheet.getRange(2, 1, tableSheet.getLastRow() - 1, 26).getValues()
      .filter(row => String(row[2]) === String(dealId))
    : [];
  tableRows.forEach(row => {
    if (String(row[20] || '') !== 'Курс валют') return;
    if (String(row[24] || '').trim() === 'Не применять') return;
    addCandidate(row[18], row[13], `${row[4] || ''}!${row[10] || row[8] || ''}`);
  });

  const linkedSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.linked);
  const linkedRows = linkedSheet && linkedSheet.getLastRow() > 1
    ? linkedSheet.getRange(2, 1, linkedSheet.getLastRow() - 1, 30).getValues()
      .filter(row => String(row[3]) === String(dealId))
    : [];
  linkedRows.forEach(row => {
    if (String(row[28] || '').trim() === 'Не применять') return;
    addCandidate(row[12], row[18], `${row[5] || ''}!${row[15] || row[7] || ''}`);
  });

  const applied = [];
  ['CNY_RUB_RATE', 'USD_RUB_RATE', 'EUR_RUB_RATE'].forEach(code => {
    if (confirmed.has(code)) return;
    const entries = candidates.get(code) || [];
    const distinct = [...new Set(entries.map(entry => roundTo_(entry.value, 8).toFixed(8)))].map(Number);
    if (distinct.length !== 1) return;
    const value = distinct[0];
    const sourceHint = [...new Set(entries.map(entry => entry.source).filter(Boolean))].join('; ');
    bbcChatApiUpsertSourceRate_(spreadsheet, dealId, code, value, sourceHint || 'единственный курс в текущих вводных документах');
    applied.push({fieldCode: bbcChatApiRateCodeToField_(code), code, value, source: sourceHint});
  });

  if (applied.length) {
    writeLog_('SYSTEM', 'CHAT_AUTO_APPLY_SOURCE_RATES', dealId, JSON.stringify(applied));
  }
  return {appliedCount: applied.length, applied};
}

function bbcChatApiUpsertRate_(spreadsheet, dealId, code, value, managerInputId) {
  const numeric = parseFlexibleNumber_(value);
  if (!(numeric > 0)) {
    throw new Error(`Для ${code} требуется положительный числовой курс.`);
  }

  const sourceCurrency = String(code).replace('_RUB_RATE', '');
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.rates);
  const rows = sheet.getLastRow() > 1
    ? sheet.getRange(2, 1, sheet.getLastRow() - 1, 14).getValues()
    : [];
  const existing = rows.findIndex(row =>
    String(row[13]) === String(dealId) &&
    String(row[2]).trim().toUpperCase() === sourceCurrency &&
    String(row[3]).trim().toUpperCase() === 'RUB' &&
    isTruthy_(row[7])
  );

  const row = [
    `RATE-${sourceCurrency}-RUB-${stableId_('CHAT', [dealId, sourceCurrency, Date.now()]).slice(-16)}`,
    new Date(),
    sourceCurrency,
    'RUB',
    numeric,
    'Подтверждено менеджером в ChatGPT Projects',
    'Ручной',
    true,
    'Рабочий курс сделки; подтверждён менеджером в чате',
    'DEAL_CALCULATION',
    true,
    managerInputId,
    new Date(),
    dealId
  ];

  if (existing >= 0) {
    sheet.getRange(existing + 2, 1, 1, 14).setValues([row]);
  } else {
    sheet.appendRow(row);
  }
  return numeric;
}

function bbcChatApiFindItemRow_(spreadsheet, dealId, answer, question) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.items);
  const headers = readSheetHeaders_(sheet);
  const rows = readDataRows_(sheet, headers.length);
  const itemId = String(
    answer && answer.itemId || question && question.itemId || ''
  ).trim();
  const itemNumber = Number(
    answer && answer.itemNumber || question && question.itemNumber || 0
  );

  let index = -1;
  if (itemId) {
    index = rows.findIndex(row =>
      String(row[0]) === itemId && String(row[1]) === String(dealId)
    );
  }
  if (index < 0 && itemNumber) {
    index = rows.findIndex(row =>
      String(row[1]) === String(dealId) && Number(row[2]) === itemNumber
    );
  }
  if (index < 0) {
    throw new Error(
      `Не найдена товарная позиция для ответа ${question && question.fieldCode || ''}.`
    );
  }
  return {sheet, headers, rowNumber: index + 2};
}

function bbcChatApiSetItemField_(spreadsheet, dealId, answer, question, header, value) {
  const target = bbcChatApiFindItemRow_(spreadsheet, dealId, answer, question);
  const column = target.headers.indexOf(header);
  if (column < 0) throw new Error(`На листе «Товары» нет поля «${header}».`);
  target.sheet.getRange(target.rowNumber, column + 1).setValue(value);

  const confidenceColumn = target.headers.indexOf('Уровень достоверности');
  if (confidenceColumn >= 0) {
    target.sheet.getRange(target.rowNumber, confidenceColumn + 1).setValue('Подтверждено');
  }
  const commentColumn = target.headers.indexOf('Комментарий');
  if (commentColumn >= 0) {
    const old = target.sheet.getRange(target.rowNumber, commentColumn + 1).getDisplayValue();
    target.sheet.getRange(target.rowNumber, commentColumn + 1).setValue(
      mergeSystemComment_(old, 'DEV-016.38: значение подтверждено менеджером в ChatGPT Projects.')
    );
  }
}

function bbcChatApiApplyAnswer_(spreadsheet, dealId, answer, question, managerInputId) {
  const fieldCode = String(
    answer.fieldCode || question && question.fieldCode || ''
  ).trim();
  if (!fieldCode) throw new Error('В ответе не указан fieldCode.');

  let value = bbcChatApiResolveAnswerValue_(question, answer);

  const rateCode = bbcChatApiRateFieldToCode_(fieldCode);
  if (rateCode) {
    if (bbcChatApiIsAffirmative_(value)) {
      const candidates = question && question.candidates || [];
      if (candidates.length !== 1) {
        throw new Error(`Для ${fieldCode} укажите числовой курс.`);
      }
      value = candidates[0].displayValue;
    }
    return bbcChatApiUpsertRate_(
      spreadsheet, dealId, rateCode, value, managerInputId
    );
  }

  if (fieldCode === 'logistics.confirmation') {
    const data = value && typeof value === 'object' ? value : {};
    const mappings = [
      ['incoterms', 'Инкотермс'],
      ['chinaRoute', 'Маршрут внутри Китая'],
      ['route', 'Маршрут внутри Китая'],
      ['borderCrossing', 'Погранпереход'],
      ['destinationCity', 'Город назначения'],
      ['transportMode', 'Тип транспорта'],
      ['deliveryDays', 'Срок доставки, дней'],
      ['productionDays', 'Срок производства, дней']
    ];
    let written = 0;
    mappings.forEach(mapping => {
      const key = mapping[0];
      if (!Object.prototype.hasOwnProperty.call(data, key)) return;
      bbcChatApiSetDealField_(
        spreadsheet, dealId, mapping[1], data[key], managerInputId
      );
      written += 1;
    });
    if (!written) {
      throw new Error(
        'Для logistics.confirmation передайте объект с уточнёнными полями: ' +
        'incoterms, chinaRoute, borderCrossing, destinationCity, transportMode, ' +
        'deliveryDays или productionDays.'
      );
    }
    return data;
  }

  const dealMap = {
    'deal.manager': 'Менеджер',
    'deal.client': 'Клиент',
    'deal.quoteCurrency': 'Валюта клиентского КП',
    'deal.validityDays': 'Срок действия КП',
    'deal.scheme': 'Схема поставки',
    'logistics.incoterms': 'Инкотермс',
    'logistics.chinaRoute': 'Маршрут внутри Китая',
    'logistics.borderCrossing': 'Погранпереход',
    'logistics.destinationCity': 'Город назначения',
    'logistics.transportMode': 'Тип транспорта',
    'logistics.deliveryDays': 'Срок доставки, дней',
    'logistics.productionDays': 'Срок производства, дней',
    'commercial.paymentTerms': 'Условия оплаты',
    'commercial.paymentSchedule': 'График платежей'
  };
  if (dealMap[fieldCode]) {
    bbcChatApiSetDealField_(
      spreadsheet, dealId, dealMap[fieldCode],
      typeof value === 'object' ? JSON.stringify(value) : value,
      managerInputId
    );
    return value;
  }

  const itemMatch = fieldCode.match(/^item\.(\d+)\.(name|quantity|unit|price|priceCurrency|tnVed)$/);
  if (itemMatch) {
    const itemFieldMap = {
      name: 'Наименование товара',
      quantity: 'Количество',
      unit: 'Единица количества',
      price: 'Цена за единицу',
      priceCurrency: 'Валюта цены',
      tnVed: 'Код ТН ВЭД'
    };
    const answerWithNumber = Object.assign({}, answer, {itemNumber: Number(itemMatch[1])});
    bbcChatApiSetItemField_(
      spreadsheet, dealId, answerWithNumber, question,
      itemFieldMap[itemMatch[2]], value
    );
    return value;
  }

  if (/^item\.(\d+)\.vatSourceReconciliation$/.test(fieldCode)) {
    const match = fieldCode.match(/^item\.(\d+)\./);
    const answerWithNumber = Object.assign({}, answer, {
      itemNumber: Number(match[1])
    });
    const data = value && typeof value === 'object' ? value : {};
    if (data.priceExVat !== undefined) {
      bbcChatApiSetItemField_(
        spreadsheet, dealId, answerWithNumber, question,
        'Цена без VAT', data.priceExVat
      );
    }
    if (data.vatRate !== undefined) {
      const vatRate = parseFlexibleNumber_(data.vatRate);
      bbcChatApiSetItemField_(
        spreadsheet, dealId, answerWithNumber, question,
        'Ставка VAT Китая', vatRate !== null && vatRate > 1 ? vatRate / 100 : vatRate
      );
    }
    if (data.priceIncVat !== undefined) {
      bbcChatApiSetItemField_(
        spreadsheet, dealId, answerWithNumber, question,
        'Цена с VAT', data.priceIncVat
      );
    }
    if (data.vatRefundStatus !== undefined) {
      bbcChatApiSetItemField_(
        spreadsheet, dealId, answerWithNumber, question,
        'Статус возврата VAT', normalizeVatRefundStatus_(data.vatRefundStatus)
      );
    }
    return data;
  }

  if (fieldCode === 'vat.returnStatus') {
    const normalized = normalizeVatRefundStatus_(
      value && typeof value === 'object' ? value.status : value
    );
    const items = spreadsheet.getSheetByName(BBC_MVP.sheets.items);
    const headers = readSheetHeaders_(items);
    const rows = readDataRows_(items, headers.length);
    const statusColumn = headers.indexOf('Статус возврата VAT');
    const confidenceColumn = headers.indexOf('Уровень достоверности');
    rows.forEach((row, index) => {
      if (String(row[1]) !== String(dealId)) return;
      items.getRange(index + 2, statusColumn + 1).setValue(normalized);
      if (confidenceColumn >= 0) {
        items.getRange(index + 2, confidenceColumn + 1).setValue('Подтверждено');
      }
    });
    return normalized;
  }

  if (fieldCode === 'customs.dutyMethod') {
    const data = value && typeof value === 'object' ? value : {method: value};
    const target = bbcChatApiFindItemRow_(spreadsheet, dealId, answer, question);
    const setters = {
      'Тип пошлины': data.method,
      'Ставка пошлины': data.rate,
      'Валюта пошлины': data.currency,
      'Метод пошлины подтвержден': true
    };
    Object.keys(setters).forEach(header => {
      if (setters[header] === undefined) return;
      const column = target.headers.indexOf(header);
      if (column >= 0) {
        target.sheet.getRange(target.rowNumber, column + 1).setValue(setters[header]);
      }
    });
    return data;
  }

  throw new Error(
    `DEV-016.38: автоматический writeback для fieldCode «${fieldCode}» ещё не определён.`
  );
}

function bbcChatApiDealImportIds_(spreadsheet, dealId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.imports);
  if (!sheet || sheet.getLastRow() < 2) return [];
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, 14).getValues()
    .filter(row =>
      String(row[1]) === String(dealId) &&
      String(row[12]) === 'Завершён'
    )
    .map(row => String(row[0]));
}

function bbcChatApiSubmitManagerAnswers_(args, requestId) {
  const spreadsheet = bbcChatApiSpreadsheet_();
  const dealId = normalizeDealId_(args.dealId);
  if (!dealId || !findRowByValue_(
    spreadsheet.getSheetByName(BBC_MVP.sheets.deals), 1, dealId
  )) {
    throw new Error(`Сделка ${dealId || 'не указана'} не найдена.`);
  }
  const answers = Array.isArray(args.answers) ? args.answers : [];
  if (!answers.length) throw new Error('Не переданы ответы менеджера.');

  const managerInputId = stableId_('MGR-CHAT', [
    dealId, requestId, Date.now()
  ]);

  const appliedAnswers = [];
  answers.forEach(answer => {
    const question = bbcChatApiFindQuestion_(
      spreadsheet, dealId, answer.questionId, answer.fieldCode
    );
    if (!question && !answer.fieldCode) {
      throw new Error(
        `Вопрос ${answer.questionId || 'без ID'} не найден. Передайте fieldCode.`
      );
    }
    const value = bbcChatApiApplyAnswer_(
      spreadsheet, dealId, answer, question, managerInputId
    );
    appliedAnswers.push({
      questionId: answer.questionId || question && question.questionId || '',
      fieldCode: answer.fieldCode || question && question.fieldCode || '',
      value
    });
  });

  const importIds = bbcChatApiDealImportIds_(spreadsheet, dealId);
  const progress = bbcChatApiTryProgress_(spreadsheet, dealId, importIds, {
    autoGenerateQuote: args.autoGenerateQuote !== false,
    requestId,
    reapplySourceData: false
  });

  writeLog_(
    'SYSTEM', 'CHAT_SUBMIT_MANAGER_ANSWERS', dealId,
    `request_id ${requestId}; manager_input_id ${managerInputId}; answers ${appliedAnswers.length}; status ${progress.packageStatus}`
  );

  return Object.assign(progress, {
    requestId,
    version: BBC_MVP.version,
    managerInputId,
    appliedAnswers
  });
}

function bbcChatApiLatestDocuments_(spreadsheet, dealId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.documents);
  if (!sheet || sheet.getLastRow() < 2) return [];
  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 11).getValues()
    .filter(row => String(row[1]) === String(dealId));
  return rows.slice(-12).map(row => ({
    documentId: row[0],
    type: row[2],
    format: row[3],
    version: row[4],
    fileName: row[5],
    url: row[6],
    createdAt: row[7],
    status: row[9]
  }));
}

function bbcChatApiGetDealPackage_(dealId, requestId) {
  const spreadsheet = bbcChatApiSpreadsheet_();
  const normalized = normalizeDealId_(dealId);
  if (!normalized) throw new Error('dealId не указан.');
  const model = readDealCalculationModel_(spreadsheet, normalized);
  const intake = buildManagerIntakeAssessment_(spreadsheet, model);
  const rateQuestions = bbcChatApiRateQuestions_(spreadsheet, normalized);
  const questions = bbcChatApiMergeQuestions_(intake, rateQuestions);
  const snapshot = readAiLatestVerifiedSnapshotSummary_(spreadsheet, normalized);
  const documents = bbcChatApiLatestDocuments_(spreadsheet, normalized);

  return {
    requestId,
    version: BBC_MVP.version,
    dealId: normalized,
    packageStatus: bbcChatApiPackageStatus_(intake, rateQuestions, snapshot, null),
    calculationAllowed: bbcChatApiGateState_(intake, rateQuestions).calculationAllowed,
    quoteAllowed:
      bbcChatApiGateState_(intake, rateQuestions).quoteGateAllowed &&
      Boolean(snapshot && snapshot.status === 'Проверен'),
    managerQuestions: questions,
    conflicts: intake.conflicts || [],
    ownerDecisionsPending: intake.ownerDecisionsPending || [],
    technicalFindings: intake.technicalFindings || [],
    latestVerifiedSnapshot: snapshot,
    documents
  };
}

function bbcChatApiGenerateQuote_(dealId, requestId) {
  const spreadsheet = bbcChatApiSpreadsheet_();
  const normalized = normalizeDealId_(dealId);
  if (!normalized) throw new Error('dealId не указан.');

  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  let stage = 'START';
  try {
    stage = 'READ_MODEL';
    const model = readDealCalculationModel_(spreadsheet, normalized);

    stage = 'CALCULATE_MODEL';
    const result = calculateDealModel_(model);

    stage = 'READ_VERIFIED_SNAPSHOT';
    const snapshot = getLatestVerifiedSnapshot_(spreadsheet, normalized);

    stage = 'VALIDATE_SOURCE';
    validateQuoteSource_(model, result, snapshot);

    stage = 'RECONCILE_FINAL_QUOTE_EVIDENCE';
    const intake = buildManagerIntakeAssessment_(spreadsheet, model);

    // DEV-016.49: API generateQuote проходит тот же обязательный final-quote gate,
    // что и ручной generateQuoteDocuments. Наличие verified snapshot само по себе
    // не разрешает выпуск, если intake всё ещё содержит FINAL_QUOTE blocker.
    stage = 'VALIDATE_FINAL_QUOTE_INTAKE';
    validateFinalQuoteIntake_(intake);

    stage = 'BUILD_CONTEXT';
    const context = buildQuoteContext_(spreadsheet, model, result, intake);

    stage = 'VALIDATE_CONTEXT';
    validateMasterQuoteContext_(context, model, result, intake);

    stage = 'CREATE_NAMES';
    const version = getNextQuoteVersion_(spreadsheet, normalized);
    const externalQuoteNumber = getExternalQuoteNumber_(model, context);
    const baseName = sanitizeFileName_(
      `КП ${externalQuoteNumber} ${quoteClientFilePart_(context.client)} ${version}`
    );

    stage = 'RESOLVE_OUTPUT_FOLDER';
    const outputFolder = getQuoteOutputFolder_(
      spreadsheet, model.settings, normalized
    );

    stage = 'COPY_TEMPLATE';
    const templateFile = DriveApp.getFileById(BBC_QUOTE_TEMPLATE_ID);
    const quoteFile = templateFile.makeCopy(baseName, outputFolder);
    const quoteSpreadsheet = SpreadsheetApp.openById(quoteFile.getId());

    stage = 'WRITE_MASTER_TEMPLATE';
    writeMasterTemplateQuote_(
      quoteSpreadsheet, context, model, result, externalQuoteNumber, version
    );
    materializeAndValidateClientSheets_(quoteSpreadsheet);
    removeInternalTemplateSheets_(quoteSpreadsheet);
    materializeAndValidateClientSheets_(quoteSpreadsheet);
    normalizeClientSheetPrintAreas_(quoteSpreadsheet);
    SpreadsheetApp.flush();
    Utilities.sleep(1200);

    const clientSheet = quoteSpreadsheet.getSheetByName('Расчет сделки ВЭД');
    if (!clientSheet) {
      throw new Error('В мастер-шаблоне отсутствует лист «Расчет сделки ВЭД».');
    }

    stage = 'EXPORT_XLSX';
    const xlsxFile = exportQuoteFile_(
      quoteSpreadsheet.getId(), 'xlsx', `${baseName}.xlsx`, outputFolder
    );
    stage = 'EXPORT_PDF';
    const pdfFile = exportMasterQuotePdf_(
      quoteSpreadsheet.getId(), clientSheet.getSheetId(),
      `${baseName}.pdf`, outputFolder
    );

    stage = 'WRITE_DOCUMENT_RECORDS';
    appendQuoteDocumentRecords_(spreadsheet, {
      dealId: normalized,
      format: 'DEV-015.5',
      version,
      baseName,
      googleFile: quoteFile,
      xlsxFile,
      pdfFile,
      createdBy: context.manager || 'Система BBC'
    });
    updateDealDocumentStatus_(spreadsheet, model.dealRowNumber);

    writeLog_(
      'DOCUMENT', 'CHAT_GENERATE_QUOTE', normalized,
      `request_id ${requestId || ''}; ${externalQuoteNumber} ${version}; Google/XLSX/PDF`
    );

    return {
      status: 'QUOTE_READY',
      dealId: normalized,
      quoteNumber: externalQuoteNumber,
      version,
      itemCount: context.items.length,
      totalRub: result.totalRub,
      totalCny: result.totalCny,
      files: {
        googleSheets: {
          id: quoteFile.getId(),
          name: quoteFile.getName(),
          url: quoteFile.getUrl()
        },
        xlsx: {
          id: xlsxFile.getId(),
          name: xlsxFile.getName(),
          url: xlsxFile.getUrl()
        },
        pdf: {
          id: pdfFile.getId(),
          name: pdfFile.getName(),
          url: pdfFile.getUrl()
        }
      }
    };
  } catch (error) {
    writeLog_(
      'ERROR', 'CHAT_GENERATE_QUOTE_FAILED', normalized,
      `request_id ${requestId || ''}; stage ${stage}; ${String(error && error.message || error)}`
    );
    throw new Error(
      `КП не сформировано. Этап ${stage}: ${String(error && error.message || error)}`
    );
  } finally {
    lock.releaseLock();
  }
}

/**
 * Pure regression checks for the public MCP contract and rate-confirmation parser.
 * Does not read or write production sheets.
 */
function runChatApiContractRegressionTest() {
  const tools = bbcChatApiMcpTools_();
  const names = tools.map(tool => tool.name);
  const expected = [
    'startDealFromFiles',
    'submitManagerAnswers',
    'generateQuote',
    'getDealPackage'
  ];
  expected.forEach(name => {
    if (!names.includes(name)) {
      throw new Error(`TEST-CHAT-API-001: отсутствует MCP tool ${name}`);
    }
  });

  if (!bbcChatApiIsAffirmative_('да') || !bbcChatApiIsAffirmative_(true)) {
    throw new Error('TEST-CHAT-API-002: affirmative parser mismatch');
  }
  if (bbcChatApiRateFieldToCode_('rates.cnyRub') !== 'CNY_RUB_RATE') {
    throw new Error('TEST-CHAT-API-003: rate field mapping mismatch');
  }

  const rules = aiFieldRules_();
  const managerState = buildAiFieldState_('deal.manager', [{
    value: 'Катя', normalizedValue: 'катя', sourceRole: 'ORDER', authorityRank: 80, confirmed: false
  }], rules['deal.manager']);
  if (managerState.state !== 'CONFIRMED_BY_SOURCE') {
    throw new Error(`TEST-CHAT-API-004: unique source manager must not require confirmation; state=${managerState.state}`);
  }

  const canonicalItems = [{
    'Номер позиции': 1, 'Наименование товара': '', 'Количество': '', 'Единица количества': '',
    'Цена за единицу': '', 'Стоимость партии': '', 'Валюта цены': '', 'Код ТН ВЭД': ''
  }];
  const sourceItems = [
    {'Номер позиции':1,'Наименование товара':'Органайзер · JM009','Количество':220,'Единица количества':'шт.','Цена за единицу':18.60454545,'Стоимость партии':4093,'Валюта цены':'CNY','Код ТН ВЭД':'4202921100'},
    {'Номер позиции':2,'Наименование товара':'Органайзер · SS2021-1129','Количество':1780,'Единица количества':'шт.','Цена за единицу':23.81617978,'Стоимость партии':42392.8,'Валюта цены':'CNY','Код ТН ВЭД':'4202921100'}
  ];
  const recovered = buildAiAssessmentItemRecords_(canonicalItems, sourceItems);
  if (recovered.mode !== 'SOURCE_RECOVERY_REPLACES_STALE_CANONICAL' || recovered.items.length !== 2) {
    throw new Error(`TEST-CHAT-API-005: stale canonical item recovery failed; mode=${recovered.mode}; count=${recovered.items.length}`);
  }

  const oneToOne = buildAiAssessmentItemRecords_([{
    'Номер позиции':1,'Наименование товара':'Органайзер','Количество':220,'Единица количества':'шт.',
    'Цена за единицу':'','Стоимость партии':'','Валюта цены':'','Код ТН ВЭД':''
  }], [sourceItems[0]]);
  if (parseFlexibleNumber_(oneToOne.items[0]['Цена за единицу']) <= 0 || oneToOne.items[0]['Валюта цены'] !== 'CNY') {
    throw new Error('TEST-CHAT-API-006: 1:1 source enrichment failed');
  }

  function FakeRange(values) { this.values = values; }
  FakeRange.prototype.getValues = function() { return this.values; };
  function FakeSheet(rows) { this.rows = rows; }
  FakeSheet.prototype.getLastRow = function() { return this.rows.length + 1; };
  FakeSheet.prototype.getRange = function() { return new FakeRange(this.rows); };
  const rateRow = new Array(26).fill('');
  rateRow[2] = 'D1'; rateRow[4] = 'source.xlsx'; rateRow[10] = 'B2'; rateRow[13] = 12.5;
  rateRow[18] = 'CNY_RUB_RATE'; rateRow[20] = 'Курс валют'; rateRow[24] = 'Подтверждено';
  const fakeSpreadsheet = {
    getSheetByName: function(name) {
      if (name === BBC_MVP.sheets.rates) return null;
      if (name === BBC_MVP.sheets.tableRows) return new FakeSheet([rateRow]);
      if (name === BBC_MVP.sheets.linked) return null;
      return null;
    }
  };
  const sourceRateBook = buildCalculationRateBook_(fakeSpreadsheet, [], 'D1');
  if (Math.abs(Number(sourceRateBook.selected.get('CNY_RUB_RATE')) - 12.5) > 0.00000001) {
    throw new Error('TEST-CHAT-API-007: unique current-deal source rate was not selected automatically');
  }

  if (bbcChatApiBuildRateQuestion_('CNY', 'rates.cnyRub', [12.5]) !== null) {
    throw new Error('TEST-CHAT-API-008: unique current-deal rate must not create a manager question');
  }
  const rateConflictQuestion = bbcChatApiBuildRateQuestion_('CNY', 'rates.cnyRub', [12.5, 12.7]);
  if (!rateConflictQuestion || rateConflictQuestion.state !== 'CONFLICT') {
    throw new Error('TEST-CHAT-API-009: conflicting source rates must create a conflict question');
  }

  const sourceOnlyStates = cp009ResolvedFieldStates_();
  sourceOnlyStates['deal.manager'] = buildAiFieldState_('deal.manager', [
    {value:'Катя', normalizedValue:'катя', sourceRole:'ORDER', authorityRank:80, confirmed:false}
  ], rules['deal.manager']);
  sourceOnlyStates['deal.scheme'] = buildAiFieldState_('deal.scheme', [
    {value:'КЛИЕНТ — ИМПОРТЁР · BBC — ЭКСПОРТЁР', normalizedValue:'CLIENT_IMPORTER_BBC_EXPORTER', sourceRole:'ORDER', authorityRank:80, confirmed:false}
  ], rules['deal.scheme']);
  sourceOnlyStates['commercial.paymentSchedule'] = buildAiFieldState_('commercial.paymentSchedule', [
    {value:{count:2,declaredCount:2,rows:[{row:1,label:'50%',amountRub:1},{row:2,label:'50%',amountRub:1}]}, normalizedValue:'SCHEDULE-50-50', sourceRole:'ORDER', authorityRank:80, confirmed:false}
  ], rules['commercial.paymentSchedule']);
  const sourceOnlyQuestions = buildAiCoreFieldQuestions_(sourceOnlyStates, null).filter(function(question) {
    return ['deal.manager','deal.scheme','commercial.paymentSchedule'].includes(question.fieldCode);
  });
  if (sourceOnlyQuestions.length) {
    throw new Error('TEST-CHAT-API-010: unique source manager/scheme/payment schedule must not require confirmation');
  }

