function bbcDocumentContourRecalculateDeal_(args, requestId) {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  if (!spreadsheet) throw new Error('Active BBC spreadsheet is required.');
  const canonical = bbcDocumentContourNormalizeCanonical_(args.canonicalDeal);
  const key = String(args.idempotencyKey || '').trim();
  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  let state = null;
  try {
    state = bbcDocumentContourBeginOperation_(spreadsheet,'RECALCULATE_DEAL',key,{canonicalDeal:canonical},canonical.dealId,'');
    if (state.existing) return state.result;
    const registry = bbcDocumentContourRuleRegistry_();
    const schema = validateCanonicalDealV1Object_(canonical);
    if (!schema.ok) throw new Error('CANONICAL_SCHEMA_BLOCK:' + JSON.stringify(schema.issues));
    const readiness = validateCanonicalDealForQuote_(canonical,registry);
    if (!readiness.ok) throw new Error('CANONICAL_QUOTE_READINESS_BLOCK:' + JSON.stringify(readiness.issues));
    const operationCreatedAt = bbcDocumentContourOperationCreatedAt_(state);
    const candidate = calculateReleaseAPureCandidate_(canonical,registry,{mode:BBC_RELEASE_A_PHASE2.modes.PRODUCTION,calculatedAt:operationCreatedAt});
    const verification = verifyReleaseACandidate_(canonical,candidate,registry);
    if (!verification.ok) throw new Error('CALCULATION_VERIFICATION_BLOCK:' + JSON.stringify({criticalErrors:verification.criticalErrors,warnings:verification.warnings}));
    const paymentCalculationValidation = validateCanonicalPaymentSchedulesAgainstCalculation_(canonical,candidate.result);
    if (!paymentCalculationValidation.ok) throw new Error('PAYMENT_CALCULATION_RECONCILIATION_BLOCK:' + JSON.stringify(paymentCalculationValidation.issues));
    const quoteNumber = bbcDocumentContourEnsureQuoteNumber_(spreadsheet, canonical.dealId, operationCreatedAt);
    const canonicalHash = bbcReleaseASha256Hex_(canonical), paymentHash = bbcReleaseASha256Hex_(canonical.paymentSchedules||[]), ruleHash = bbcReleaseASha256Hex_(registry);
    const templateBinding = bbcDocumentContourApprovedTemplateBinding_();
    const snapshotId = stableId_('SNP2_CONTOUR',[canonical.dealId,canonicalHash,paymentHash,ruleHash,quoteNumber,templateBinding.templateId,templateBinding.templateVersion,templateBinding.outputProfile]);
    let stored = null;
    try { stored = readVerifiedSnapshotV2ById_(spreadsheet,snapshotId); } catch (error) { stored = null; }
    if (!stored) {
      const snapshot = createReleaseAVerifiedSnapshot_(canonical,candidate,registry,{snapshotId,createdAt:new Date(operationCreatedAt),createdBy:BBC_DOCUMENT_CONTOUR.createdBy,codeVersion:BBC_MVP.version,calculationEngineVersion:BBC_MVP.version,quoteNumber,templateId:templateBinding.templateId,templateVersion:templateBinding.templateVersion,outputProfile:templateBinding.outputProfile});
      bbcDocumentContourPersistSnapshotBundle_(spreadsheet,canonical,registry,snapshot);
      SpreadsheetApp.flush();
      stored = readVerifiedSnapshotV2ById_(spreadsheet,snapshotId);
    }
    if (!stored) throw new Error('SNAPSHOT_READBACK_FAILED');
    const integrity = validateSnapshotV2Integrity_(stored), applicability = isSnapshotV2Applicable_(stored,canonical,registry);
    if (!integrity.ok || !applicability.ok) throw new Error('SNAPSHOT_INTEGRITY_BLOCK:' + JSON.stringify({integrity,applicability}));
    const result = {contourVersion:BBC_DOCUMENT_CONTOUR.version,requestId:requestId||'',dealId:canonical.dealId,quoteNumber:stored.quoteNumber||quoteNumber,snapshotId:stored.snapshotId,snapshotHash:stored.snapshotHash,canonicalHash:stored.canonicalHash,paymentHash:stored.paymentHash,ruleSetHash:stored.ruleSetHash,templateId:stored.templateId,templateVersion:stored.templateVersion,outputProfile:stored.outputProfile,status:stored.status,totalRub:stored.calculationResult.totalRub,totalCny:stored.calculationResult.totalCny,verified:true};
    return bbcDocumentContourCompleteOperation_(state,result,canonical.dealId,stored.snapshotId);
  } catch (error) {
    bbcDocumentContourFailOperation_(state,error);
    throw error;
  } finally { lock.releaseLock(); }
}

function bbcDocumentContourGetVerifiedSnapshot_(args, requestId) {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const snapshotId = String(args.snapshotId || '').trim(), dealId = String(args.dealId || '').trim();
  if ((!snapshotId && !dealId) || (snapshotId && dealId)) throw new Error('Exactly one of snapshotId or dealId is required.');
  const snapshot = snapshotId ? readVerifiedSnapshotV2ById_(spreadsheet,snapshotId) : readLatestVerifiedSnapshotV2ForDeal_(spreadsheet,dealId);
  if (!snapshot) return {contourVersion:BBC_DOCUMENT_CONTOUR.version,requestId:requestId||'',found:false,snapshot:null};
  const integrity = validateSnapshotV2Integrity_(snapshot);
  if (!integrity.ok) throw new Error('SNAPSHOT_INTEGRITY_BLOCK:' + JSON.stringify(integrity.issues));
  const summary = {snapshotId:snapshot.snapshotId,dealId:snapshot.dealId,quoteNumber:snapshot.quoteNumber||null,status:snapshot.status,snapshotHash:snapshot.snapshotHash,canonicalHash:snapshot.canonicalHash,paymentHash:snapshot.paymentHash,ruleSetHash:snapshot.ruleSetHash,templateId:snapshot.templateId||null,templateVersion:snapshot.templateVersion||null,outputProfile:snapshot.outputProfile||null,createdAt:snapshot.createdAt,totalRub:snapshot.calculationResult&&snapshot.calculationResult.totalRub,totalCny:snapshot.calculationResult&&snapshot.calculationResult.totalCny};
  return {contourVersion:BBC_DOCUMENT_CONTOUR.version,requestId:requestId||'',found:true,snapshot:args.includePayload===true?snapshot:summary};
}

function bbcDocumentContourModelForRenderer_(snapshot) {
  const canonical = snapshot.canonicalPayload || {};
  const importVatRates = [...new Set((canonical.items||[]).map(item => Number(item.importVatRate)).filter(value => Number.isFinite(value) && value >= 0))];
  return {normalizedItems:(canonical.items||[]).map(item => ({dutyRate:Number(item.dutyRate||0)})),commissionInput:bbcReleaseBCommissionInputFromSnapshot_(snapshot),importVatRateForTemplate:importVatRates.length===1?importVatRates[0]:null,importVatRateMode:importVatRates.length===0?'UNAVAILABLE':(importVatRates.length===1?'SINGLE':'MIXED')};
