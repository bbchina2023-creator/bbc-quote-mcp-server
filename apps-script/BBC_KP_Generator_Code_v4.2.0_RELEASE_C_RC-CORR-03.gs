/** Release B Phase 1 / DEV-017.0 — snapshot-bound quote acceptance.
 * Authority boundary:
 *   Snapshot v2 -> renderer adapter -> approved master -> artifacts.
 * Forbidden in this path: raw imports, semantic intake, legacy model read, recalculation.
 * This acceptance path does not update legacy deal status or legacy document registry.
 */
const BBC_RELEASE_B_PHASE1 = Object.freeze({
  phase: 'SNAPSHOT_BOUND_QUOTE_ACCEPTANCE',
  runtimeSwitch: false,
  outputProfile: 'FULL_MASTER_WORKBOOK+CLIENT_PDF',
  forbiddenAuthorityCalls: Object.freeze([
    'getImportCellsByDealId_',
    'buildManagerIntakeAssessment_',
    'calculateDealModel_',
    'readDealCalculationModel_',
    'extractStructuredPaymentSplitProfileFromRows_',
    'extractDirectSourcePaymentSplitProfile_'
  ])
});

function readLatestVerifiedSnapshotV2ForDeal_(spreadsheet, dealId) {
  const sheet = spreadsheet.getSheetByName(BBC_RELEASE_A_PHASE4.stores.snapshots);
  if (!sheet || sheet.getLastRow() < 2) return null;
  const rows = sheet.getDataRange().getValues();
  const header = rows[0].map(String);
  const dealIndex = header.indexOf('deal_id');
  const statusIndex = header.indexOf('status');
  const payloadIndex = header.indexOf('payload_json');
  const revisionIndex = header.indexOf('canonical_revision');
  const createdIndex = header.indexOf('created_at');
  if ([dealIndex, statusIndex, payloadIndex, revisionIndex, createdIndex].some(index => index < 0)) {
    throw new Error('Snapshot v2 store schema invalid for Release B Phase 1.');
  }
  const candidates = rows.slice(1).filter(row =>
    String(row[dealIndex]) === String(dealId) && String(row[statusIndex]) === 'VERIFIED'
  );
  if (!candidates.length) return null;
  // Canonical revision is the authority for recency. created_at is only the tie-breaker
  // within the same revision; relying on timestamps alone can resurrect an older revision.
  candidates.sort((a, b) => {
    const revisionDelta=Number(b[revisionIndex]||0)-Number(a[revisionIndex]||0);
    if(revisionDelta!==0)return revisionDelta;
    return new Date(b[createdIndex]).getTime()-new Date(a[createdIndex]).getTime();
  });
  const snapshot = JSON.parse(String(candidates[0][payloadIndex] || '{}'));
  const integrity = validateSnapshotV2Integrity_(snapshot);
  if (!integrity.ok) {
    throw new Error('Latest Snapshot v2 integrity failure: ' + JSON.stringify(integrity.issues));
  }
  return snapshot;
}

function bbcReleaseBCommissionInputFromSnapshot_(snapshot) {
  const registry = snapshot && snapshot.ruleRegistryPayload || {};
  const rules = Array.isArray(registry.rules) ? registry.rules : [];
  const rule = rules.find(item => item && item.ruleId === 'COM-001' && item.productionEligible === true);
  if (!rule) throw new Error('Snapshot v2 has no production-eligible COM-001 commission authority.');
  const p = rule.parameters || {};
  return {
    type: String(p.type || ''),
    value: Number(p.percent || 0),
    base: String(p.base || ''),
    currency: String(p.currency || 'CNY'),
    minimumCny: Number(p.minimumCny || 0),
    confirmedByManager: false,
    confirmedByApprovedRule: true,
    authorityConfirmed: true,
    ruleId: rule.ruleId,
    ruleVersion: rule.version
  };
}

function bbcReleaseBItemPaymentSplitMap_(canonical) {
  const schedules = Array.isArray(canonical && canonical.paymentSchedules) ? canonical.paymentSchedules : [];
  const supplier = schedules.find(schedule => schedule && schedule.scheduleType === 'SUPPLIER_ITEM_PAYMENT');
  if (!supplier) throw new Error('Snapshot v2 has no SUPPLIER_ITEM_PAYMENT schedule.');
  const scheme = (supplier.schemes || []).find(item => item && item.active === true && String(item.schemeId) === String(supplier.activeSchemeId));
  if (!scheme) throw new Error('SUPPLIER_ITEM_PAYMENT has no active scheme.');
  const stages = (scheme.stages || []).slice().sort((a, b) => Number(a.order || 0) - Number(b.order || 0));
  if (stages.length !== 2) {
    throw new Error('Current approved master compatibility renderer supports exactly two supplier-item stages; Snapshot v2 contains ' + stages.length + '. Model supports N stages, but document template capacity must be upgraded under Template Manifest before rendering this case.');
  }
  const byItem = new Map();
  stages.forEach((stage, stageIndex) => {
    (stage.allocations || []).forEach(allocation => {
      if (String(allocation.entityType || '') !== 'ITEM') return;
      const itemId = String(allocation.entityId || '');
      if (!itemId) return;
      if (!byItem.has(itemId)) byItem.set(itemId, [null, null]);
      const pct = Number(allocation.percent);
      if (!Number.isFinite(pct)) throw new Error('Payment allocation percent missing for item ' + itemId + '.');
      byItem.get(itemId)[stageIndex] = pct;
    });
  });
  const out = new Map();
  (canonical.items || []).forEach(item => {
    const pair = byItem.get(String(item.itemId || '')) || [];
    if (!Number.isFinite(pair[0]) || !Number.isFinite(pair[1]) || Math.abs(pair[0] + pair[1] - 100) > 0.000001) {
      throw new Error('Supplier payment split is incomplete for item ' + String(item.itemId || '') + '.');
    }
    out.set(String(item.itemId), `${formatManagerNumber_(pair[0], 4)}/${formatManagerNumber_(pair[1], 4)}`);
  });
  return out;
}

function bbcReleaseBRestoreItemExpenseMap_(canonical) {
  const expenseById = new Map((canonical.expenses || []).map(expense => [String(expense.expenseId || ''), expense]));
  const map = new Map();
  (canonical.items || []).forEach(item => map.set(String(item.itemId || ''), []));
  (canonical.allocations || []).forEach(allocation => {
    const itemId = String(allocation.itemId || '');
    const expense = expenseById.get(String(allocation.expenseId || ''));
    if (!itemId || !expense || !map.has(itemId)) return;
    map.get(itemId).push({
      expenseId: String(allocation.expenseId || ''),
      bucket: String(expense.calculationBucket || ''),
      amountCny: Number(allocation.amountCny || 0),
      amountRub: Number(allocation.amountRub || 0),
      source: 'SNAPSHOT_V2_ALLOCATION'
    });
  });
  return map;
}

function bbcReleaseBInjectResidualPartnerCommissionAllocation_(result) {
  const itemExpenseMap = result.itemExpenseMap || new Map();
  const convertedItems = result.convertedItems || [];
  const partnerTotalRub = Number(result.bucketTotals && result.bucketTotals.partnerCommission && result.bucketTotals.partnerCommission.rub || 0);
  const partnerTotalCny = Number(result.bucketTotals && result.bucketTotals.partnerCommission && result.bucketTotals.partnerCommission.cny || 0);
  let allocatedRub = 0;
  let allocatedCny = 0;
  itemExpenseMap.forEach(expenses => {
    (expenses || []).forEach(expense => {
      if (String(expense.bucket || '') !== 'partnerCommission') return;
      allocatedRub += Number(expense.amountRub || 0);
      allocatedCny += Number(expense.amountCny || 0);
    });
  });
  const residualRub = roundTo_(partnerTotalRub - allocatedRub, 8);
  const residualCny = roundTo_(partnerTotalCny - allocatedCny, 8);
  if (Math.abs(residualRub) <= 0.01 && Math.abs(residualCny) <= 0.000001) return result;
  if (!convertedItems.length) throw new Error('Snapshot renderer cannot allocate residual partnerCommission without items.');

  const bases = convertedItems.map(item => {
    const itemId = String(item.id || '');
    const chinaRub = sumNumbers_((itemExpenseMap.get(itemId) || []).filter(expense => expense.bucket === 'chinaDelivery').map(expense => Number(expense.amountRub || 0)));
    return Number(item.amountRub || 0) + chinaRub;
  });
  const totalBaseRub = sumNumbers_(bases);
  if (!(totalBaseRub > 0)) throw new Error('Snapshot renderer cannot allocate residual partnerCommission: goods-value base is zero.');

  let usedRub = 0;
  let usedCny = 0;
  convertedItems.forEach((item, index) => {
    const itemId = String(item.id || '');
    const isLast = index === convertedItems.length - 1;
    const share = bases[index] / totalBaseRub;
    const amountRub = isLast ? roundTo_(residualRub - usedRub, 8) : roundTo_(residualRub * share, 8);
    const amountCny = isLast ? roundTo_(residualCny - usedCny, 8) : roundTo_(residualCny * share, 8);
    usedRub = roundTo_(usedRub + amountRub, 8);
    usedCny = roundTo_(usedCny + amountCny, 8);
    if (!itemExpenseMap.has(itemId)) itemExpenseMap.set(itemId, []);
    itemExpenseMap.get(itemId).push({
      expenseId:'DISPLAY-ALLOC-PARTNER-COMMISSION-' + itemId,
      bucket:'partnerCommission',
      amountRub,
      amountCny,
      source:'SNAPSHOT_V2_DERIVED_DISPLAY_ALLOCATION',
      method:'GOODS_VALUE_SHARE'
    });
  });
  if (Math.abs(roundTo_(usedRub, 8) - residualRub) > 0.01 || Math.abs(roundTo_(usedCny, 8) - residualCny) > 0.000001) {
    throw new Error('Snapshot renderer partnerCommission display allocation did not reconcile.');
  }
  result.itemExpenseMap = itemExpenseMap;
  return result;
}

function bbcReleaseBResultForRenderer_(snapshot) {
  const canonical = snapshot.canonicalPayload || {};
  const result = bbcReleaseADeepClone_(snapshot.calculationResult || {});
  result.itemExpenseMap = bbcReleaseBRestoreItemExpenseMap_(canonical);
  const convertedById = new Map((result.convertedItems || []).map(item => [String(item.id || ''), item]));
  let supplierPaymentSplitMap = null;
  try { supplierPaymentSplitMap = bbcReleaseBItemPaymentSplitMap_(canonical); } catch (error) { supplierPaymentSplitMap = null; }
  result.convertedItems = (canonical.items || []).slice().sort((a, b) => Number(a.itemNumber || 0) - Number(b.itemNumber || 0)).map(item => {
    const existing = convertedById.get(String(item.itemId || '')) || {};
    return Object.assign({}, existing, {
      id: String(item.itemId || ''),
      quantity: Number(item.quantity || 0),
      amountCny: Number(existing.amountCny != null ? existing.amountCny : item.batchAmount || 0),
      amountRub: Number(existing.amountRub || 0),
      row: null
    });
  });
  return bbcReleaseBInjectResidualPartnerCommissionAllocation_(result);
}

function validateCanonicalPaymentSchedulesAgainstCalculation_(canonical, result) {
  const issues = [];
  try {
    const supplier = bbcDocumentContourActivePaymentSchedule_(canonical, 'SUPPLIER_ITEM_PAYMENT');
    const byItem = new Map((canonical.items || []).map(item => [String(item.itemId || ''), {item, amount:0, percent:0, amountCount:0, percentCount:0, stageCount:0}]));
    supplier.stages.forEach(function(stage, stageIndex) {
      const seen = new Set();
      let stageAllocationAmount = 0, stageHasAmounts = true;
      (stage.allocations || []).forEach(function(a) {
        if (String(a.entityType || '') !== 'ITEM') return;
        const itemId = String(a.entityId || ''), state = byItem.get(itemId);
        if (!state) return;
        if (seen.has(itemId)) issues.push(bbcReleaseAIssue_('PAYMENT_DUPLICATE_ITEM_STAGE', 'SUPPLIER_ITEM_PAYMENT.stages[' + stageIndex + ']', 'Item appears more than once in a supplier payment stage: ' + itemId));
        seen.add(itemId); state.stageCount += 1;
        if (a.amount !== null && typeof a.amount !== 'undefined' && a.amount !== '') { state.amount += Number(a.amount); state.amountCount += 1; stageAllocationAmount += Number(a.amount); } else stageHasAmounts = false;
        if (a.percent !== null && typeof a.percent !== 'undefined' && a.percent !== '') { state.percent += Number(a.percent); state.percentCount += 1; }
      });
      byItem.forEach(function(state, itemId) { if (!seen.has(itemId)) issues.push(bbcReleaseAIssue_('PAYMENT_ITEM_STAGE_MISSING', 'SUPPLIER_ITEM_PAYMENT.stages[' + stageIndex + ']', 'Supplier payment stage has no explicit allocation for item ' + itemId + '. Use explicit zero when applicable.')); });
      if (stage.amount !== null && typeof stage.amount !== 'undefined' && stage.amount !== '' && stageHasAmounts && Math.abs(Number(stage.amount) - stageAllocationAmount) > 0.01) issues.push(bbcReleaseAIssue_('PAYMENT_STAGE_AMOUNT_RECONCILIATION', 'SUPPLIER_ITEM_PAYMENT.stages[' + stageIndex + '].amount', 'Stage amount does not equal item allocation amounts.'));
    });
    byItem.forEach(function(state, itemId) {
      if (state.percentCount === supplier.stages.length && Math.abs(state.percent - 100) > 0.000001) issues.push(bbcReleaseAIssue_('PAYMENT_ITEM_PERCENT_RECONCILIATION', 'SUPPLIER_ITEM_PAYMENT', 'Item percentages do not total 100% for ' + itemId + '.'));
      if (state.amountCount === supplier.stages.length && Number.isFinite(Number(state.item.batchAmount)) && Math.abs(state.amount - Number(state.item.batchAmount)) > 0.01) issues.push(bbcReleaseAIssue_('PAYMENT_ITEM_AMOUNT_RECONCILIATION', 'SUPPLIER_ITEM_PAYMENT', 'Item payment amounts do not reconcile batchAmount for ' + itemId + '.'));
    });
  } catch (error) {
    issues.push(bbcReleaseAIssue_('SUPPLIER_PAYMENT_RECONCILIATION', 'paymentSchedules', String(error && error.message || error)));
  }
  try { buildCanonicalClientPaymentPlan_(canonical, result); }
  catch (error) { issues.push(bbcReleaseAIssue_('CLIENT_PAYMENT_RECONCILIATION', 'paymentSchedules', String(error && error.message || error))); }
  return bbcReleaseAValidationResult_(issues);
}

function buildReleaseASnapshotBoundQuoteContext_(spreadsheet, snapshot, options) {
  options = options || {};
  const canonical = snapshot.canonicalPayload || {};
  const deal = canonical.deal || {};
  const logistics = deal.logistics || {};
  const result = bbcReleaseBResultForRenderer_(snapshot);
  const settings = readSettingsMap_(spreadsheet);
  const convertedById = new Map((result.convertedItems || []).map(item => [String(item.id || ''), item]));
  let supplierPaymentSplitMap = null;
  try { supplierPaymentSplitMap = bbcReleaseBItemPaymentSplitMap_(canonical); } catch (error) { supplierPaymentSplitMap = null; }
  const quoteCurrency = String(deal.quoteCurrency || '').trim().toUpperCase();
  if (!['RUB', 'CNY'].includes(quoteCurrency)) throw new Error('Snapshot quoteCurrency must explicitly be RUB or CNY.');
  const validityDays = Number(deal.validityDays);
  if (!Number.isInteger(validityDays) || validityDays <= 0) throw new Error('Snapshot validityDays must be a positive integer.');
  const money = rubValue => quoteCurrency === 'CNY' ? Number(rubValue || 0) / Number(result.cnyRub || 0) : Number(rubValue || 0);
  const items = (canonical.items || []).slice().sort((a, b) => Number(a.itemNumber || 0) - Number(b.itemNumber || 0)).map((item, index) => {
    const converted = convertedById.get(String(item.itemId || '')) || {};
    const quantity = Number(item.quantity || 0);
    const amountCny = roundMoney_(Number(converted.amountCny != null ? converted.amountCny : item.batchAmount || 0));
    const amountRub = roundMoney_(Number(converted.amountRub || 0));
    const nameAndSize = splitQuoteItemNameAndSize_(item.name || '');
    return {
      itemId: String(item.itemId || ''), number: item.itemNumber || index + 1, paymentSplit:'',
      name: nameAndSize.name, size: nameAndSize.size, article: item.article || '', category: item.category || '', tnVed: item.tnVed || '',
      quantity, unit: item.quantityUnit || '', grossWeight: item.grossWeightKg == null ? '' : Number(item.grossWeightKg), volume: item.volumeM3 == null ? '' : Number(item.volumeM3),
      unitPriceCny: quantity > 0 ? roundTo_(amountCny / quantity, 6) : 0, amountCny, amountRub, amount: money(amountRub)
    };
  });
  const quoteDate = new Date(options.quoteDate || snapshot.createdAt || new Date(0));
  if (!Number.isFinite(quoteDate.getTime())) throw new Error('Snapshot quote date is invalid.');
  const validUntil = new Date(quoteDate.getTime() + validityDays * 86400000);
  const context = {
    dealId: canonical.dealId,
    dealNumber: snapshot.quoteNumber || '',
    client: String(deal.client || ''), manager: String(deal.manager || ''), partner: String(deal.partner || ''), scheme: String(deal.scheme || ''),
    deliveryTerms: String(logistics.incoterms || ''), route: String(logistics.chinaRoute || ''), borderCrossing: String(logistics.borderCrossing || ''), destinationCity: String(logistics.destinationCity || ''), transportMode: String(logistics.transportMode || ''),
    deliveryDays: logistics.deliveryDays, productionDays: bbcReleaseAResolvedDisplayValue_(canonical, 'DEAL', canonical.dealId, 'productionDays', logistics.productionDays),
    paymentTerms: String(deal.paymentTermsText || ''), paymentSchedule:null, paymentRows:[], comment:String(deal.comment || ''), format:'Kratkoe', currency:quoteCurrency,
    quoteDate, validUntil, validityDays,
    company: settings.get('COMPANY_NAME') || 'BBC', subtitle: settings.get('COMPANY_SUBTITLE') || 'BIG BUSINESS CHINA', address: settings.get('COMPANY_ADDRESS') || '', warehouses: settings.get('COMPANY_WAREHOUSES') || '', email: settings.get('COMPANY_EMAIL') || '', telegram: settings.get('COMPANY_TELEGRAM') || '', phone: settings.get('COMPANY_PHONE') || '', wechat: settings.get('COMPANY_WECHAT') || '', website: settings.get('COMPANY_WEBSITE') || '',
    items, supplierPaymentSplitMap, categories:[], goods:roundMoney_(money(result.goodsRub)), expenses:roundMoney_(money(result.expensesRub)), total:roundMoney_(money(result.totalRub)), preCommissionTotal:roundMoney_(money(result.preCommissionSummary && result.preCommissionSummary.totalRub || 0)),
    bbcCommission:{type:bbcReleaseBCommissionInputFromSnapshot_(snapshot).type,inputValue:bbcReleaseBCommissionInputFromSnapshot_(snapshot).value,calculationBase:bbcReleaseBCommissionInputFromSnapshot_(snapshot).base,inputCurrency:bbcReleaseBCommissionInputFromSnapshot_(snapshot).currency,confirmedByManager:false,confirmedByApprovedRule:true,amount:roundMoney_(money(result.commissionCalculation && result.commissionCalculation.amountRub || 0))},
    cnyRub:Number(result.cnyRub || 0), usdRub:Number(result.usdRub || 0)
  };
  const paymentPlan = buildCanonicalClientPaymentPlan_(canonical, result);
  context.paymentSchedule = {scheduleId:paymentPlan.scheduleId, schemeId:paymentPlan.schemeId};
  context.paymentRows = paymentPlan.rows;
  return {context, result, settings};
}

function validateReleaseASnapshotBoundQuoteContext_(snapshot, adapter) {
  const context = adapter.context;
  const result = adapter.result;
  const issues = [];
  const integrity = validateSnapshotV2Integrity_(snapshot);
  if (!integrity.ok) issues.push('SNAPSHOT_INTEGRITY');
  if (!context.items.length) issues.push('NO_ITEMS');
  if (!(Number(result.totalRub) > 0) || !(Number(result.totalCny) > 0)) issues.push('TOTAL_NOT_POSITIVE');
  [['quoteNumber',context.dealNumber],['client',context.client],['manager',context.manager],['scheme',context.scheme],['validityDays',context.validityDays],['incoterms',context.deliveryTerms],['route',context.route],['borderCrossing',context.borderCrossing],['destinationCity',context.destinationCity],['transportMode',context.transportMode],['deliveryDays',context.deliveryDays],['productionDays',context.productionDays]].forEach(pair => {
    if (aiIsPlaceholder_(pair[1])) issues.push('MISSING_' + pair[0]);
  });
  context.items.forEach(item => { if (!item.itemId || !item.name || !(Number(item.quantity) > 0) || !item.unit) issues.push('ITEM_INCOMPLETE_' + item.number); });
  if (!Array.isArray(context.paymentRows) || !context.paymentRows.length) issues.push('CLIENT_PAYMENT_MISSING');
  const commission = bbcReleaseBCommissionInputFromSnapshot_(snapshot);
  if (!commission.confirmedByApprovedRule || !(commission.value > 0)) issues.push('COMMISSION_AUTHORITY');
  const source = [buildReleaseASnapshotBoundQuoteContext_, bbcReleaseBResultForRenderer_, bbcReleaseBRestoreItemExpenseMap_].map(fn => String(fn)).join('\n');
  BBC_RELEASE_B_PHASE1.forbiddenAuthorityCalls.forEach(token => { if (source.indexOf(token) >= 0) issues.push('FORBIDDEN_AUTHORITY_CALL_' + token); });
  return {ok: issues.length === 0, issues};
}

function bbcReleaseBXlsxAcceptance_(file) {
  const issues = [];
  let blobs = [];
  try {
    // Google Drive stores exported XLSX with the Office MIME type, while
    // Utilities.unzip requires a Blob explicitly typed as application/zip.
    // The workbook bytes are already ZIP-compatible; only the Blob MIME must
    // be normalized before unzip. This mirrors aiReadOriginalXlsxCachedCells_.
    const sourceBlob = file.getBlob();
    const zipBlob = Utilities.newBlob(
      sourceBlob.getBytes(),
      'application/zip',
      String(file.getName() || 'quote.xlsx')
    );
    blobs = Utilities.unzip(zipBlob);
  } catch (error) {
    return {ok:false, issues:['XLSX_UNZIP_FAILED:' + String(error && error.message || error)]};
  }
  const names = blobs.map(blob => String(blob.getName() || ''));
  if (names.some(name => /^xl\/externalLinks\//i.test(name))) issues.push('EXTERNAL_LINK_PART_PRESENT');
  const errorPattern = /#(?:REF!|DIV\/0!|VALUE!|N\/A|NAME\?|NUM!|NULL!)/i;
  blobs.filter(blob => /\.(?:xml|rels)$/i.test(String(blob.getName() || ''))).forEach(blob => {
    let text = '';
    try { text = blob.getDataAsString(); } catch (error) { return; }
    if (errorPattern.test(text)) issues.push('ERROR_TOKEN:' + blob.getName());
  });
  const worksheetCount = names.filter(name => /^xl\/worksheets\/sheet\d+\.xml$/i.test(name)).length;
  if (worksheetCount !== 5) issues.push('WORKSHEET_COUNT_' + worksheetCount);
  return {ok:issues.length===0, issues, worksheetCount};
}

function bbcReleaseBPdfAcceptance_(file) {
  const issues=[];
  let bytes=[];
  try{bytes=file.getBlob().getBytes().map(function(value){return value<0?value+256:value;});}catch(error){return {ok:false,issues:['PDF_READ_FAILED:'+String(error&&error.message||error)]};}
  if(bytes.length<=1000)issues.push('PDF_TOO_SMALL');
  if(bytes.length<5||bytes.slice(0,5).join(',')!=='37,80,68,70,45')issues.push('PDF_HEADER_INVALID');
  const tail=bytes.slice(Math.max(0,bytes.length-2048)).map(function(value){return String.fromCharCode(value);}).join('');
  if(tail.indexOf('%%EOF')<0)issues.push('PDF_EOF_MISSING');
  return {ok:issues.length===0,issues:issues,size:bytes.length};
}

function bbcReleaseBCleanupFiles_(files) {
  (files || []).forEach(file => {
    try { if (file) file.setTrashed(true); } catch (error) {}
  });
}

function runReleaseBSnapshotBoundQuoteAcceptance() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const dealId = BBC_RELEASE_A_PHASE8.controlDealId;
  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  const created = [];
  let stage = 'START';
  try {
    stage = 'READ_SNAPSHOT_V2';
    const snapshot = readLatestVerifiedSnapshotV2ForDeal_(spreadsheet, dealId);
    if (!snapshot) throw new Error('No VERIFIED Snapshot v2 found for control deal.');

    stage = 'BUILD_SNAPSHOT_BOUND_CONTEXT';
    const adapter = buildReleaseASnapshotBoundQuoteContext_(spreadsheet, snapshot);

    stage = 'VALIDATE_SNAPSHOT_BOUNDARY';
    const validation = validateReleaseASnapshotBoundQuoteContext_(snapshot, adapter);
    if (!validation.ok) throw new Error('Snapshot-bound quote context blocked: ' + JSON.stringify(validation.issues));

    const commissionInput = bbcReleaseBCommissionInputFromSnapshot_(snapshot);
    const canonical = snapshot.canonicalPayload || {};
    const importVatRates = [...new Set((canonical.items || []).map(item => Number(item.importVatRate)).filter(value => Number.isFinite(value) && value >= 0))];
    const model = {
      normalizedItems: (canonical.items || []).map(item => ({dutyRate:Number(item.dutyRate || 0)})),
      commissionInput,
      importVatRateForTemplate: importVatRates.length === 1 ? importVatRates[0] : 0
    };

    stage = 'RESOLVE_ACCEPTANCE_FOLDER';
    const root = getQuoteOutputFolder_(spreadsheet, adapter.settings, dealId);
    const folder = getOrCreateDriveFolder_(root, 'RELEASE_B_SNAPSHOT_ACCEPTANCE');
    const version = 'RB-P1';
    const quoteNumber = 'BBC-RB-P1-' + String(snapshot.snapshotId).slice(-8);
    const baseName = sanitizeFileName_(`ACCEPTANCE ${quoteNumber} ${quoteClientFilePart_(adapter.context.client)} ${version}`);

    stage = 'COPY_APPROVED_MASTER';
    const templateFile = DriveApp.getFileById(BBC_QUOTE_TEMPLATE_ID);
    const quoteFile = templateFile.makeCopy(baseName, folder);
    created.push(quoteFile);
    const quoteSpreadsheet = SpreadsheetApp.openById(quoteFile.getId());

    stage = 'RENDER_FROM_SNAPSHOT';
    writeMasterTemplateQuote_(quoteSpreadsheet, adapter.context, model, adapter.result, quoteNumber, version);
    materializeAndValidateClientSheets_(quoteSpreadsheet);
    removeInternalTemplateSheets_(quoteSpreadsheet);
    materializeAndValidateClientSheets_(quoteSpreadsheet);
    normalizeClientSheetPrintAreas_(quoteSpreadsheet);
    SpreadsheetApp.flush();
    Utilities.sleep(1000);

    stage = 'EXPORT_XLSX';
    const xlsxFile = exportQuoteFile_(quoteSpreadsheet.getId(), 'xlsx', `${baseName}.xlsx`, folder);
    created.push(xlsxFile);

    stage = 'XLSX_ACCEPTANCE';
    const xlsxAcceptance = bbcReleaseBXlsxAcceptance_(xlsxFile);
    if (!xlsxAcceptance.ok) throw new Error('XLSX acceptance failed: ' + JSON.stringify(xlsxAcceptance.issues));

    stage = 'EXPORT_PDF';
    const clientSheet = quoteSpreadsheet.getSheetByName('Расчет сделки ВЭД');
    if (!clientSheet) throw new Error('Approved master client sheet missing.');
    const pdfFile = exportMasterQuotePdf_(quoteSpreadsheet.getId(), clientSheet.getSheetId(), `${baseName}.pdf`, folder);
    created.push(pdfFile);
    const pdfAcceptance=bbcReleaseBPdfAcceptance_(pdfFile);if(!pdfAcceptance.ok)throw new Error('PDF acceptance failed: '+JSON.stringify(pdfAcceptance.issues));

    const output = {
      phase: BBC_RELEASE_B_PHASE1.phase,
      codeVersion: BBC_MVP.version,
      runtimeSwitch: false,
      status: 'PASS',
      dealId,
      snapshotId: snapshot.snapshotId,
      snapshotHash: snapshot.snapshotHash,
      canonicalHash: snapshot.canonicalHash,
      noRawImports: true,
      noSemanticIntake: true,
      noRecalculation: true,
      rendererSource: 'SNAPSHOT_V2_ONLY',
      itemCount: adapter.context.items.length,
      totalRub: adapter.result.totalRub,
      totalCny: adapter.result.totalCny,
      xlsxAcceptance,
      files: {
        googleSheets:{id:quoteFile.getId(),url:quoteFile.getUrl(),name:quoteFile.getName()},
        xlsx:{id:xlsxFile.getId(),url:xlsxFile.getUrl(),name:xlsxFile.getName()},
        pdf:{id:pdfFile.getId(),url:pdfFile.getUrl(),name:pdfFile.getName(),size:pdfFile.getSize()}
      }
    };
    console.log(JSON.stringify(output));
    return output;
  } catch (error) {
    bbcReleaseBCleanupFiles_(created);
    const output = {
      phase: BBC_RELEASE_B_PHASE1.phase,
      codeVersion: BBC_MVP.version,
      runtimeSwitch:false,
      status:'FAIL',
      stage,
      error:String(error && error.message || error),
      cleanupAttempted:true
    };
    console.error(JSON.stringify(output));
    throw error;
  } finally {
    lock.releaseLock();
  }
}

