function writeUnitEconomicsDev015_(sheet, context, model, result) {
  const itemLines = new Map((result.itemLineCalculation && result.itemLineCalculation.rows || []).map(row => [String(row.itemId), row]));
  const itemExpenseMap = result.itemExpenseMap || new Map();
  const convertedItems = result.convertedItems || [];
  const totalGoodsRub = Number(result.goodsRub || 0);
  const totalChinaRub = Number(result.bucketTotals && result.bucketTotals.chinaDelivery && result.bucketTotals.chinaDelivery.rub || 0);
  const totalInvoiceRub = totalGoodsRub + totalChinaRub;
  const commissionRub = Number(result.bucketTotals && result.bucketTotals.bbcCommission && result.bucketTotals.bbcCommission.rub || 0);
  const commissionCny = Number(result.bucketTotals && result.bucketTotals.bbcCommission && result.bucketTotals.bbcCommission.cny || 0);
  const cnyRub = Number(result.cnyRub || 0);

  // В эталонном шаблоне колонки услуг, перевозки и импорта были
  // объединены вертикально F5:F24, G5:G24 и H5:H24. Для многотоварной
  // юнит-экономики каждая позиция должна иметь собственные значения.
  ['F5:F24', 'G5:G24', 'H5:H24'].forEach(a1 => {
    const range = sheet.getRange(a1);
    if (range.isPartOfMerge()) range.breakApart();
  });

  sheet.getRange('A5:J24').clearContent();

  const rows = [];
  let renderedTotalRub = 0;
  context.items.forEach((item, index) => {
    const convertedItem = convertedItems[index];
    const itemId = convertedItem ? String(convertedItem.id || '') : '';
    const line = itemLines.get(itemId) || {};
    const quantity = Number(item.quantity || 0);
    const goodsCny = Number(item.amountCny || 0);
    const goodsRub = Number(item.amountRub || 0);
    const itemExpenses = (itemExpenseMap.get(itemId) || []).slice();

    const bucketRub = bucket => sumNumbers_(itemExpenses.filter(expense => expense.bucket === bucket).map(expense => Number(expense.amountRub || 0)));
    const chinaDeliveryRub = bucketRub('chinaDelivery');
    const goodsWithChinaRub = goodsRub + chinaDeliveryRub;
    const goodsWithChinaCny = cnyRub > 0 ? goodsWithChinaRub / cnyRub : goodsCny;
    const allocationShare = totalInvoiceRub > 0 ? goodsWithChinaRub / totalInvoiceRub : 0;
    const allocatedCommissionRub = commissionRub * allocationShare;
    const allocatedCommissionCny = commissionCny * allocationShare;
    const allocatedSupplierBankRub = Number(result.bucketTotals.supplierBankFees.rub || 0) * allocationShare;
    const allocatedIncomingBankRub = Number(result.bucketTotals.incomingBankFees.rub || 0) * allocationShare;
    const allocatedExportSupportRub = Number(result.bucketTotals.exportSupport.rub || 0) * allocationShare;
    const servicesRub = allocatedCommissionRub + allocatedExportSupportRub + allocatedSupplierBankRub + allocatedIncomingBankRub + bucketRub('other');
    const transportRub = bucketRub('internationalLogistics') + bucketRub('russiaDelivery') + bucketRub('insurance') + bucketRub('partnerCommission');
    const importRub = Number(line.dutyRub || 0) + Number(line.importVatRub || 0) + bucketRub('customsFee') + bucketRub('broker') + bucketRub('temporaryStorage') + bucketRub('customsDelivery') + bucketRub('certification') + bucketRub('marking') + bucketRub('partnerFinancialServices');
    const totalRub = goodsWithChinaRub + servicesRub + transportRub + importRub;
    renderedTotalRub += totalRub;

    rows.push([
      item.number || index + 1,
      item.article ? `${item.name || ''} · ${item.article}` : (item.name || ''),
      item.unit || '',
      quantity,
      quantity ? goodsWithChinaCny / quantity : 0,
      quantity && cnyRub ? servicesRub / cnyRub / quantity : 0,
      quantity && cnyRub ? transportRub / cnyRub / quantity : 0,
      quantity && cnyRub ? importRub / cnyRub / quantity : 0,
      quantity && cnyRub ? totalRub / cnyRub / quantity : 0,
      quantity ? totalRub / quantity : 0
    ]);
  });

  if (Math.abs(roundMoney_(renderedTotalRub) - roundMoney_(Number(result.totalRub || 0))) > 0.01) {
    throw new Error(
      `Юнит-экономика не сходится с итогом сделки: распределено ${roundMoney_(renderedTotalRub)} RUB, ` +
      `ожидается ${roundMoney_(Number(result.totalRub || 0))} RUB. Проверьте распределение расходов.`
    );
  }

  const itemCount = rows.length;
  while (rows.length < 20) rows.push(['', '', '', '', '', '', '', '', '', '']);
  sheet.getRange(5, 1, 20, 10).setValues(rows);

  // Блокирующая проверка: у каждой реальной товарной позиции должны быть
  // записаны отдельные значения услуг, перевозки и импорта.
  if (itemCount > 0) {
    const detailValues = sheet.getRange(5, 6, itemCount, 3).getValues();
    const incompleteRows = [];
    detailValues.forEach((row, index) => {
      if (row.some(value => value === '' || value === null)) incompleteRows.push(index + 1);
    });
    if (incompleteRows.length) {
      throw new Error(
        'Юнит-экономика сформирована неполно: отсутствует детализация услуг/перевозки/импорта для позиций ' +
        incompleteRows.join(', ') + '.'
      );
    }
  }
}

