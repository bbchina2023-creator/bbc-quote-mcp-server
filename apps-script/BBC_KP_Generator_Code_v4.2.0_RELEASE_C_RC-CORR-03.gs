  var g6=(exactR01&&exactR02);
  gates.push(gate('A-G06','Arithmetic parity',g6?'PASS':'PENDING_FIXTURE_EVIDENCE',{archivedBenchmarks:archived,r01CanonicalFixtureParity:exactR01,r02CanonicalFixtureParity:exactR02,note:'R01/R02 exact pure-core canonical parity is the arithmetic authority. Historical current-deal snapshots are diagnostic only when they were created under superseded calculation-rule behavior.'}));
  var g7=states.ok&&bbcReleaseAAllPass_(suites,['A5-LINEAGE-MANAGER-DECISION-REF']);
  gates.push(gate('A-G07','Lineage/state coverage',g7?'PASS':'FAIL',{stateAudit:states}));
  gates.push(gate('A-G08','Legacy isolation',pure.semanticCalls.length===0?'PASS':'FAIL',{semanticCalls:pure.semanticCalls}));
  var g9=liveSmoke&&liveSmoke.ok===true;
