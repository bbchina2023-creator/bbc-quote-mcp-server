    status:blockers.length?'BLOCKED':'PASS',unitTests:{ok:allUnit,total:suites.reduce(function(n,s){return n+(s.results||[]).length;},0),failed:suites.reduce(function(a,s){return a.concat((s.results||[]).filter(function(r){return r.status!=='PASS';}));},[])},
