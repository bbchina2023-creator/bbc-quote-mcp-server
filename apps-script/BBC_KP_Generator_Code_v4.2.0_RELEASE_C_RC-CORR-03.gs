function cp009Serialize_(value) {
  if (value === null || typeof value === 'undefined') return '';
  if (typeof value === 'string') return value;
  try {
    return JSON.stringify(value, function(key, item) {
      if (item instanceof Map) return {type: 'Map', entries: Array.from(item.entries())};
      if (item instanceof Set) return {type: 'Set', values: Array.from(item.values())};
      if (item instanceof Date) return item.toISOString();
      return item;
    });
  } catch (error) {
    return String(value);
  }
}

function cp009Assert_(condition, message, observed) {
  if (!condition) {
    throw new Error(message + (typeof observed === 'undefined' ? '' : '\nObserved: ' + cp009Serialize_(observed)));
  }
}

function cp009Approx_(left, right, tolerance) {
  var tol = typeof tolerance === 'number' ? tolerance : 0.00000001;
  return Math.abs(Number(left) - Number(right)) <= tol;
}

