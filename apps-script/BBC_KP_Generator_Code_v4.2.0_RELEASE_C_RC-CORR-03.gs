function buildModelCompleteness_(dealRecord, items, expenses, allocations, commissionInput) {
  const gaps = [];
  const addGap = (entityType, objectId, field, status, value, required, comment, source) => {
    gaps.push({entityType, objectId, field, status, value, required, comment, source: source || {}});
  };

  items.forEach(item => {
    if (item.quantityStatus === 'UNKNOWN') addGap('ITEM', item.itemId, 'quantity', 'UNKNOWN', '', true, 'Количество отсутствует.', item.source);
    if (!item.unit) addGap('ITEM', item.itemId, 'unit', 'UNKNOWN', '', true, 'Не указана единица количества.', item.source);
    if (!item.priceCurrency) addGap('ITEM', item.itemId, 'priceCurrency', 'UNKNOWN', '', true, 'Не указана валюта цены.', item.source);
    if (item.priceType !== 'PARTNER_TOTAL' && item.unitPrice === null && item.priceExVat === null && item.priceIncVat === null) {
      addGap('ITEM', item.itemId, 'price', 'UNKNOWN', '', true, 'Нет цены для детерминированного расчёта.', item.source);
    }
    if (!item.dutyMethodConfirmed) addGap('ITEM', item.itemId, 'dutyMethodConfirmed', 'UNKNOWN', '', true, 'Нет достаточного детерминированного основания для метода/ставки пошлины.', item.source);
    if (!item.importVatConfirmed) addGap('ITEM', item.itemId, 'importVatConfirmed', 'UNKNOWN', '', true, 'Нет достаточного детерминированного основания для ставки импортного НДС.', item.source);
  });

  expenses.forEach(expense => {
    if (expense.valueStatus === 'UNKNOWN') addGap('EXPENSE', expense.expenseId, 'amount', 'UNKNOWN', '', expense.includeInternal, 'Сумма расхода не определена.', expense.source);
    if (!expense.currency && expense.valueStatus !== 'UNKNOWN') addGap('EXPENSE', expense.expenseId, 'currency', 'UNKNOWN', '', true, 'Не указана валюта расхода.', expense.source);
    if (expense.includeInternal && !expense.businessKey) addGap('EXPENSE', expense.expenseId, 'businessKey', 'UNKNOWN', '', true, 'Нет ключа контроля дублей.', expense.source);
  });

  if (!commissionInput.confirmedByManager) {
    addGap('DEAL', String(dealRecord['deal_id'] || ''), 'bbcCommission', 'UNKNOWN', '', true, 'Комиссия BBC не подтверждена менеджером.', {});
  }

  return {
    gaps,
    blockingGaps: gaps.filter(gap => gap.required),
    summary: {
      items: items.length,
      expenses: expenses.length,
      allocations: allocations.length,
      gaps: gaps.length,
      blockingGaps: gaps.filter(gap => gap.required).length
    }
  };
}

function auditDealCalculationModel() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  try {
    const dealId = resolveDealIdForCalculation_(spreadsheet);
    if (!dealId) return;
    const model = readDealCalculationModel_(spreadsheet, dealId);
    const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.modelAudit);
    const now = new Date();
    const rows = [];

    model.normalizedItems.forEach(item => {
      rows.push([Utilities.getUuid(), dealId, now, 'ITEM', item.itemId, 'record', item.recordStatus, item.name, true,
        item.source.file, item.source.sheet, item.source.cell, item.source.type, item.unresolvedReason]);
    });
    model.normalizedExpenses.forEach(expense => {
      rows.push([Utilities.getUuid(), dealId, now, 'EXPENSE', expense.expenseId, 'amount', expense.valueStatus,
        expense.amount === null ? '' : expense.amount, expense.includeInternal,
        expense.source.file, expense.source.sheet, expense.source.cell, expense.source.type, expense.exclusionReason]);
    });
    model.completeness.gaps.forEach(gap => {
      rows.push([Utilities.getUuid(), dealId, now, gap.entityType, gap.objectId, gap.field, gap.status,
        gap.value, gap.required, gap.source.file || '', gap.source.sheet || '', gap.source.cell || '', gap.source.type || '', gap.comment]);
    });

    replaceDealRowsInSheet_(sheet, 2, dealId, rows, 14);
    SpreadsheetApp.getUi().alert(
      'Проверка полноты модели завершена.\n\n' +
      `Сделка: ${dealId}\n` +
      `Товаров: ${model.completeness.summary.items}\n` +
      `Расходов: ${model.completeness.summary.expenses}\n` +
      `Распределений: ${model.completeness.summary.allocations}\n` +
      `Пробелов: ${model.completeness.summary.gaps}\n` +
      `Блокирующих пробелов: ${model.completeness.summary.blockingGaps}\n\n` +
      'Результат записан на лист «Аудит модели». '
    );
  } catch (error) {
    writeLog_('ERROR', 'AUDIT_MODEL_FAILED', '', String(error && error.message || error));
    SpreadsheetApp.getUi().alert('Проверка модели не выполнена.\n\n' + String(error && error.message || error));
  } finally {
    lock.releaseLock();
  }
}

function readSettingsMap_(spreadsheet) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.settings);
  const map = new Map();
  if (!sheet || sheet.getLastRow() < 2) return map;
  sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getDisplayValues()
    .forEach(row => map.set(String(row[0]).trim(), String(row[1]).trim()));
  return map;
}

function buildCalculationRateBook_(spreadsheet, expenses, dealId) {
  const PURPOSE = 'DEAL_CALCULATION';
  const confirmedCandidates = new Map();
  const sourceDocumentCandidates = new Map();
  const embeddedCandidates = new Map();
  const unconfirmedActive = [];

  const add = (target, code, value, source, purpose, confirmationId) => {
    const numeric = parseFlexibleNumber_(value);
    if (!code || numeric === null || numeric <= 0) return;
    if (!target.has(code)) target.set(code, []);
    target.get(code).push({
      value: numeric,
      source: source || '',
      purpose: purpose || PURPOSE,
      confirmationId: confirmationId || ''
    });
  };

  const rateSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.rates);
  if (rateSheet && rateSheet.getLastRow() > 1) {
    rateSheet.getRange(2, 1, rateSheet.getLastRow() - 1, 14).getValues()
      .filter(row => isTruthy_(row[7]))
      .forEach(row => {
        const from = String(row[2]).trim().toUpperCase();
        const to = String(row[3]).trim().toUpperCase();
        const value = parseFlexibleNumber_(row[4]);
        const purpose = String(row[9] || '').trim().toUpperCase() || PURPOSE;
        const confirmed = isTruthy_(row[10]);
        const confirmationId = String(row[11] || '').trim();
        const rateDealId = String(row[13] || '').trim();
        const source = `Курсы валют: ${row[0]}`;

        // Строки другого назначения не участвуют в расчёте сделки.
        if (![PURPOSE, 'ALL'].includes(purpose)) return;
        // DEV-016.27: в расчёте конкретной сделки запрещены глобальные и чужие
        // курсы. Пустой deal_id поддерживается только в изолированных unit-тестах,
        // где сама функция вызывается без dealId.
        if (dealId && rateDealId !== String(dealId)) return;

        if (!confirmed) {
          unconfirmedActive.push({
            rateId: row[0], from, to, value, purpose, source
          });
          return;
        }

        if (to === 'RUB') {
          add(confirmedCandidates, `${from}_RUB_RATE`, value, source, purpose, confirmationId);
        }
        if (from === 'RUB' && value) {
          add(
            confirmedCandidates,
            `${to}_RUB_RATE`,
            1 / value,
            `${source} (обратный)`,
            purpose,
            confirmationId
          );
        }
      });
  }

  // DEV-016.42: явные курсы из подтверждённых строк текущих вводных документов
  // являются данными сделки. Если по коду найдено ровно одно непротиворечивое
  // значение, отдельное подтверждение менеджера не требуется. Источники других
  // сделок исключаются по deal_id.
  const approvedSourceStatuses = new Set(['Подтверждено', 'Исправлено']);
  const tableSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.tableRows);
  if (dealId && tableSheet && tableSheet.getLastRow() > 1) {
    tableSheet.getRange(2, 1, tableSheet.getLastRow() - 1, 26).getValues()
      .filter(row => String(row[2]) === String(dealId))
      .filter(row => String(row[20]) === 'Курс валют')
      .filter(row => approvedSourceStatuses.has(String(row[24] || '').trim()))
      .forEach(row => {
        const code = String(row[18] || '').trim().toUpperCase();
        const value = parseFlexibleNumber_(row[13]);
        if (!/^(CNY|USD|EUR)_RUB_RATE$/.test(code) || !(value > 0)) return;
        add(
          sourceDocumentCandidates, code, value,
          `${row[4] || 'Источник'}!${row[10] || ''}`, PURPOSE, ''
        );
      });
  }
  const linkedSheet = spreadsheet.getSheetByName(BBC_MVP.sheets.linked);
  if (dealId && linkedSheet && linkedSheet.getLastRow() > 1) {
    linkedSheet.getRange(2, 1, linkedSheet.getLastRow() - 1, 30).getValues()
      .filter(row => String(row[3]) === String(dealId))
      .filter(row => approvedSourceStatuses.has(String(row[28] || '').trim()))
      .forEach(row => {
        const code = String(row[12] || '').trim().toUpperCase();
        const value = parseFlexibleNumber_(row[18]);
        if (!/^(CNY|USD|EUR)_RUB_RATE$/.test(code) || !(value > 0)) return;
        add(
          sourceDocumentCandidates, code, value,
          `${row[5] || 'Источник'}!${row[15] || row[7] || ''}`, PURPOSE, ''
        );
      });
  }

  // Неявные курсы, восстановленные из коэффициентов отдельных расходов, остаются
  // только доказательством/подсказкой и сами по себе не становятся расчётным курсом.
  expenses.forEach(row => {
    const currency = String(row[7]).trim().toUpperCase();
    const rateToRub = parseFlexibleNumber_(row[9]);
    const rateToCny = parseFlexibleNumber_(row[8]);
    if (currency && currency !== 'RUB' && rateToRub && rateToRub > 0) {
      add(embeddedCandidates, `${currency}_RUB_RATE`, rateToRub, `Расход ${row[0]}`, PURPOSE, '');
    }
    if (currency === 'RUB' && rateToCny && rateToCny > 0) {
      add(
        embeddedCandidates,
        'CNY_RUB_RATE',
        1 / rateToCny,
        `Расход ${row[0]} (обратный)`,
        PURPOSE,
        ''
      );
    }
  });

  const selected = new Map();
  const conflicts = new Map();
  const missingConfirmations = new Map();
  const mismatches = new Map();

  const allCodes = new Set([
    ...confirmedCandidates.keys(),
    ...sourceDocumentCandidates.keys(),
    ...embeddedCandidates.keys()
  ]);

  allCodes.forEach(code => {
    const confirmedValues = confirmedCandidates.get(code) || [];
    const sourceDocumentValues = sourceDocumentCandidates.get(code) || [];
    const embeddedValues = embeddedCandidates.get(code) || [];

    const confirmedGroups = new Map();
    confirmedValues.forEach(entry => {
      const key = roundTo_(entry.value, 8).toFixed(8);
      if (!confirmedGroups.has(key)) confirmedGroups.set(key, []);
      confirmedGroups.get(key).push(entry);
    });

    if (confirmedGroups.size > 1) {
      conflicts.set(code, confirmedGroups);
      return;
    }

    if (confirmedGroups.size === 1) {
      const selectedValue = Number([...confirmedGroups.keys()][0]);
      selected.set(code, selectedValue);

      const differentEvidence = sourceDocumentValues.concat(embeddedValues).filter(entry =>
        Math.abs(entry.value - selectedValue) > 0.00000001
      );
      if (differentEvidence.length) mismatches.set(code, {
        selectedValue,
        entries: differentEvidence
      });
      return;
    }

    const sourceGroups = new Map();
    sourceDocumentValues.forEach(entry => {
      const key = roundTo_(entry.value, 8).toFixed(8);
      if (!sourceGroups.has(key)) sourceGroups.set(key, []);
      sourceGroups.get(key).push(entry);
    });
    if (sourceGroups.size > 1) {
      conflicts.set(code, sourceGroups);
      return;
    }
    if (sourceGroups.size === 1) {
      const selectedValue = Number([...sourceGroups.keys()][0]);
      selected.set(code, selectedValue);
      const differentEmbedded = embeddedValues.filter(entry =>
        Math.abs(entry.value - selectedValue) > 0.00000001
      );
      if (differentEmbedded.length) mismatches.set(code, {
        selectedValue,
        entries: differentEmbedded
      });
      return;
    }

    if (embeddedValues.length) {
      const groups = new Map();
      embeddedValues.forEach(entry => {
        const key = roundTo_(entry.value, 8).toFixed(8);
        if (!groups.has(key)) groups.set(key, []);
        groups.get(key).push(entry);
      });
      missingConfirmations.set(code, groups);
    }
  });

  selected.set('RUB_RUB_RATE', 1);
  selected.set('CNY_CNY_RATE', 1);

  return {
    selected,
    confirmedCandidates,
    embeddedCandidates,
    conflicts,
    missingConfirmations,
    mismatches,
    unconfirmedActive,
    purpose: PURPOSE
  };
}


function buildPartnerEvidenceRateMap_(model) {
  const rateBook = model && model.rateBook || {};
  const rates = new Map(rateBook && rateBook.selected || []);
  const evidence = [];
  const sourceGroups = new Map();
  (model && model.sourceRateEvidence || []).forEach(entry => {
    if (!entry.code || !(entry.value > 0)) return;
    if (!sourceGroups.has(entry.code)) sourceGroups.set(entry.code, []);
    sourceGroups.get(entry.code).push(entry);
  });
  sourceGroups.forEach((entries, code) => {
    const distinct = [...new Set(
      entries.map(entry => roundTo_(entry.value, 8).toFixed(8))
    )];
    const confirmedValue = rates.get(code);
    if (distinct.length !== 1 || !(confirmedValue > 0)) return;
    const value = Number(distinct[0]);
    if (Math.abs(value - confirmedValue) <= 0.00000001) return;
    rates.set(code, value);
    evidence.push({
      code,
      partnerValue: value,
      confirmedValue,
      source: entries.map(entry => entry.source).join('; ')
    });
  });
  (rateBook && rateBook.mismatches || new Map()).forEach((data, code) => {
    if (evidence.some(entry => entry.code === code)) return;
    const distinct = [...new Set(
      (data.entries || []).map(entry => roundTo_(entry.value, 8).toFixed(8))
    )];
    if (distinct.length !== 1) return;
    const value = Number(distinct[0]);
    rates.set(code, value);
    evidence.push({
      code,
      partnerValue: value,
      confirmedValue: data.selectedValue
    });
  });
  rates.set('RUB_RUB_RATE', 1);
  return {rates, evidence};
}

function convertSourceAmountToRub_(amount, currency, rates) {
  const numeric = parseFlexibleNumber_(amount);
  const code = String(currency || '').trim().toUpperCase();
  if (numeric === null || !code) return null;
  if (code === 'RUB') return numeric;
  const rate = rates.get(`${code}_RUB_RATE`);
  return rate > 0 ? roundTo_(numeric * rate, 8) : null;
}

function explainVatDeltaByRateReplacement_(
  model, item, convertedItem, convertedExpenses, dutyRub,
  partnerDutyRub, partnerVatRub, currentVatRub, itemCount
) {
  const notExplained = {explained: false};
  if (itemCount !== 1 || !item || !item.importVatConfirmed) return notExplained;
  if (
    dutyRub === null || partnerDutyRub === null ||
    partnerVatRub === null || currentVatRub === null
  ) return notExplained;

  const tolerance = parseFlexibleNumber_(
    model.settings.get('CALCULATION_TOLERANCE_RUB') || '0.01'
  ) || 0.01;
  if (Math.abs(dutyRub - partnerDutyRub) > tolerance) return notExplained;

  const vatRateRaw = parseFlexibleNumber_(item.importVatRate);
  if (vatRateRaw === null || vatRateRaw < 0) return notExplained;
  const vatRate = vatRateRaw > 1 ? vatRateRaw / 100 : vatRateRaw;
  const partnerBook = buildPartnerEvidenceRateMap_(model);
  if (!partnerBook.evidence.length) return notExplained;

  const partnerGoodsRub = convertSourceAmountToRub_(
    convertedItem.amount, convertedItem.currency, partnerBook.rates
  );
  if (partnerGoodsRub === null) return notExplained;

  let partnerInternationalRub = 0;
  const internationalExpenses = (convertedExpenses || []).filter(
    expense => expense.bucket === 'internationalLogistics'
  );
  for (let index = 0; index < internationalExpenses.length; index += 1) {
    const expense = internationalExpenses[index];
    const amountRub = convertSourceAmountToRub_(
      expense.amount, expense.currency, partnerBook.rates
    );
    if (amountRub === null) return notExplained;
    partnerInternationalRub += amountRub;
  }

  const partnerBaseRub = roundTo_(
    partnerGoodsRub + partnerInternationalRub + dutyRub, 8
  );
  const reconstructedPartnerVatRub = roundTo_(partnerBaseRub * vatRate, 8);
  if (Math.abs(reconstructedPartnerVatRub - partnerVatRub) > tolerance) {
    return notExplained;
  }

  const currentInternationalRub = sumNumbers_(
    internationalExpenses
      .filter(expense => expense.amountRub !== null)
      .map(expense => expense.amountRub)
  );
  const currentBaseRub = roundTo_(
    convertedItem.amountRub + currentInternationalRub + dutyRub, 8
  );
  const reconstructedCurrentVatRub = roundTo_(currentBaseRub * vatRate, 8);
  if (Math.abs(reconstructedCurrentVatRub - currentVatRub) > tolerance) {
    return notExplained;
  }

  return {
    explained: true,
    vatRate,
    partnerBaseRub,
    currentBaseRub,
    reconstructedPartnerVatRub,
    reconstructedCurrentVatRub,
    rateEvidence: partnerBook.evidence
  };
}

function calculateItemLevelModel_(model, convertedItems, convertedExpenses) {
  const partnerDutyRub = sumNumbers_(
    convertedExpenses
      .filter(expense => expense.bucket === 'customsDuty' && expense.amountRub !== null)
      .map(expense => expense.amountRub)
  );
  const partnerVatRub = sumNumbers_(
    convertedExpenses
      .filter(expense => expense.bucket === 'vat' && expense.amountRub !== null)
      .map(expense => expense.amountRub)
  );
  const internationalRub = sumNumbers_(
    convertedExpenses
      .filter(expense => expense.bucket === 'internationalLogistics' && expense.amountRub !== null)
      .map(expense => expense.amountRub)
  );

  const rows = [];
  const errors = [];
  const warnings = [];
  const itemCount = convertedItems.length;

  convertedItems.forEach(convertedItem => {
    const item = (model.normalizedItems || []).find(
      candidate => String(candidate.itemId) === String(convertedItem.id)
    );
    if (!item) {
      errors.push({
        itemId: convertedItem.id,
        field: 'Товар',
        message: 'Нормализованная товарная запись не найдена.'
      });
      return;
    }

    const allocatedInternationalRub = itemCount === 1
      ? internationalRub
      : (sumAllocatedExpenseBucketForItem_(
          model, convertedExpenses, 'internationalLogistics', item.itemId, 'rub'
        ) || 0);

    const goodsRub = convertedItem.amountRub;
    const allocatedChinaDeliveryRub = itemCount === 1
      ? sumNumbers_((convertedExpenses || []).filter(expense => expense.bucket === 'chinaDelivery').map(expense => Number(expense.amountRub || 0)))
      : (sumAllocatedExpenseBucketForItem_(model, convertedExpenses, 'chinaDelivery', item.itemId, 'rub') || 0);
    const customsBaseRub = goodsRub === null
      ? null
      : roundTo_(goodsRub + allocatedChinaDeliveryRub + allocatedInternationalRub, 8);

    const allocatedDutyRub = itemCount > 1
      ? sumAllocatedExpenseBucketForItem_(model, convertedExpenses, 'customsDuty', item.itemId, 'rub')
      : null;
    const allocatedVatRub = itemCount > 1
      ? sumAllocatedExpenseBucketForItem_(model, convertedExpenses, 'vat', item.itemId, 'rub')
      : null;
    const partnerDutyForItem = itemCount === 1 && partnerDutyRub !== null
      ? roundTo_(partnerDutyRub, 8)
      : allocatedDutyRub;
    const partnerVatForItem = itemCount === 1 && partnerVatRub !== null
      ? roundTo_(partnerVatRub, 8)
      : allocatedVatRub;

    let dutyRub = null;
    const dutyWeightKg = item.grossWeightKg || item.netWeightKg || null;
    let dutyError = '';
    let dutyComment = '';
    let method = String(item.dutyMethod || '').trim().toUpperCase();

    /*
     * DEV-009:
     * Когда партнёр передал подтверждённую итоговую сумму пошлины, но не раскрыл
     * метод, базу или ставку, эта сумма принимается как PARTNER_TOTAL.
     * Правило безопасно только для одной агрегированной товарной записи.
     */
    const usePartnerDutyTotal =
      partnerDutyForItem !== null &&
      partnerDutyForItem >= 0 &&
      (!item.dutyMethodConfirmed || !method);

    if (usePartnerDutyTotal) {
      method = itemCount > 1 ? 'PARTNER_TOTAL_ALLOCATED' : 'PARTNER_TOTAL';
      dutyRub = partnerDutyForItem;
      dutyComment =
        itemCount > 1
          ? 'Подтверждённая итоговая сумма пошлины партнёра распределена между товарами пропорционально стоимости партий.'
          : 'Использована подтверждённая итоговая сумма пошлины партнёра; детальная формула в исходном файле отсутствует.';
    } else if (!item.dutyMethodConfirmed) {
      dutyError = 'Метод пошлины не подтвержден.';
    } else if (method === 'PERCENT') {
      if (customsBaseRub === null) {
        dutyError = 'Не рассчитана таможенная база.';
      } else if (!(item.dutyRate >= 0)) {
        dutyError = 'Не указана процентная ставка пошлины.';
      } else {
        const rate = item.dutyRate > 1 ? item.dutyRate / 100 : item.dutyRate;
        dutyRub = roundTo_(customsBaseRub * rate, 8);
      }
    } else if (['EUR_PER_KG', 'USD_PER_KG'].includes(method)) {
      const rateCurrency = method.substring(0, 3);
      const fx = model.rateBook.selected.get(`${rateCurrency}_RUB_RATE`);
      if (!(dutyWeightKg > 0)) {
        dutyError = 'Для пошлины за кг отсутствует подтвержденный вес товара.';
      } else if (!(item.dutyRate >= 0)) {
        dutyError = 'Не указана ставка пошлины за кг.';
      } else if (!fx) {
        dutyError = `Нет подтвержденного курса ${rateCurrency}/RUB для расчета пошлины.`;
      } else {
        dutyRub = roundTo_(dutyWeightKg * item.dutyRate * fx, 8);
      }
    } else if (['FIXED', 'PARTNER_TOTAL'].includes(method)) {
      dutyRub = partnerDutyForItem;
      if (dutyRub === null) {
        dutyError = 'Фиксированная пошлина не привязана к товарной позиции.';
      }
    } else {
      dutyError = `Неподдерживаемый метод пошлины: ${method || 'не указан'}.`;
    }

    if (dutyError) {
      errors.push({
        itemId: item.itemId,
        field: 'Таможенная пошлина',
        message: dutyError
      });
    }

    let importVatRub = null;
    let importVatBaseRub = null;
    let vatError = '';
    let vatComment = '';
    let vatBlockedByDuty = false;

    /*
     * DEV-009:
     * Подтверждённая итоговая сумма импортного НДС партнёра принимается без
     * требования одной ставки, когда в партии применены смешанные ставки либо
     * партнёр не раскрыл детальную формулу. Для нескольких товаров необходима
     * явная привязка суммы НДС к каждой позиции.
     */
    const usePartnerVatTotal =
      partnerVatForItem !== null &&
      partnerVatForItem >= 0 &&
      (!item.importVatConfirmed || !(item.importVatRate >= 0));

    if (usePartnerVatTotal) {
      importVatRub = partnerVatForItem;
      vatComment =
        itemCount > 1
          ? 'Подтверждённая итоговая сумма импортного НДС партнёра распределена между товарами пропорционально стоимости партий; ставки не выдумываются.'
          : 'Использована подтверждённая итоговая сумма импортного НДС партнёра; допускаются смешанные ставки по товарным группам.';
    } else if (!item.importVatConfirmed) {
      vatError = 'Ставка импортного НДС не подтверждена.';
    } else if (!(item.importVatRate >= 0)) {
      vatError = 'Не указана ставка импортного НДС.';
    } else if (customsBaseRub === null) {
      vatError = 'НДС не рассчитан: отсутствует таможенная база.';
    } else if (dutyRub === null) {
      vatBlockedByDuty = true;
    } else {
      const vatRate = item.importVatRate > 1 ? item.importVatRate / 100 : item.importVatRate;
      importVatBaseRub = roundTo_(customsBaseRub + dutyRub, 8);
      importVatRub = roundTo_(importVatBaseRub * vatRate, 8);
    }

    if (vatError) {
      errors.push({
        itemId: item.itemId,
        field: 'Импортный НДС',
        message: vatError
      });
    }

    const dutyDelta = dutyRub !== null && partnerDutyForItem !== null
      ? roundTo_(dutyRub - partnerDutyForItem, 8)
      : null;
    const vatDelta = importVatRub !== null && partnerVatForItem !== null
      ? roundTo_(importVatRub - partnerVatForItem, 8)
      : null;
    const vatRateRecalculationTrace = explainVatDeltaByRateReplacement_(
      model,
      item,
      convertedItem,
      convertedExpenses,
      dutyRub,
      partnerDutyForItem,
      partnerVatForItem,
      importVatRub,
      itemCount
    );

    rows.push({
      calculationId: stableId_('LINE_CALC', [model.dealId, item.itemId]),
      dealId: model.dealId,
      itemId: item.itemId,
      date: model.calculatedAt,
      goodsMode: item.priceType || 'PARTNER_TOTAL',
      goodsRub,
      internationalRub: allocatedInternationalRub,
      customsBaseRub,
      dutyMethod: method,
      dutyWeightKg,
      dutyRate: item.dutyRate,
      dutyCurrency: item.dutyCurrency,
      dutyRub,
      partnerDutyRub: partnerDutyForItem,
      dutyDelta,
      importVatRate: item.importVatRate,
      importVatBaseRub,
      importVatRub,
      partnerVatRub: partnerVatForItem,
      vatDelta,
      vatRateRecalculationTrace,
      status: dutyError || vatError || vatBlockedByDuty ? 'ERROR' : 'CALCULATED',
      comment: [
        dutyComment,
        vatComment,
        dutyError,
        vatError,
        vatBlockedByDuty ? 'НДС не рассчитан вследствие ошибки расчета пошлины.' : ''
      ].filter(Boolean).join(' ')
    });
  });

  return {rows, errors, warnings};
}

function writeItemLevelCalculations_(spreadsheet, model, lineCalculation) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.itemLineCalculation);
  const rows = (lineCalculation.rows || []).map(row => [
    row.calculationId,
    row.dealId,
    row.itemId,
    row.date,
    row.goodsMode,
    row.goodsRub,
    row.internationalRub,
    row.customsBaseRub,
    row.dutyMethod,
    row.dutyWeightKg,
    row.dutyRate,
    row.dutyCurrency,
    row.dutyRub,
    row.partnerDutyRub,
    row.dutyDelta,
    row.importVatRate,
    row.importVatBaseRub,
    row.importVatRub,
    row.partnerVatRub,
    row.vatDelta,
    row.status,
    row.comment
  ]);
  replaceDealRowsInSheet_(sheet, 2, model.dealId, rows, 22);
  refreshSheetFilter_(sheet, 22);
}

function auditItemLevelCalculation() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  try {
    const dealId = resolveDealIdForCalculation_(spreadsheet);
    if (!dealId) return;
    const model = readDealCalculationModel_(spreadsheet, dealId);

    const convertedItems = model.items.map(row => {
      const amount = parseFlexibleNumber_(row[14]);
      const currency = String(row[13]).trim().toUpperCase();
      const converted = convertMoneyForCalculation_(amount, currency, model.rateBook.selected);
      return {
        id: String(row[0]),
        row,
        amount,
        currency,
        amountCny: converted.amountCny,
        amountRub: converted.amountRub,
        quantity: parseFlexibleNumber_(row[10])
      };
    });

    const convertedExpenses = model.expenses.map(row => {
      const amount = parseFlexibleNumber_(row[6]);
      const currency = String(row[7]).trim().toUpperCase();
      const converted = convertMoneyForCalculation_(amount, currency, model.rateBook.selected);
      return {
        id: String(row[0]),
        row,
        amount,
        currency,
        amountCny: converted.amountCny,
        amountRub: converted.amountRub,
        bucket: classifyExpenseBucket_(row[4], row[5]),
        itemId: String(row[2] || '')
      };
    });

    const lineCalculation = calculateItemLevelModel_(
      model, convertedItems, convertedExpenses
    );
    writeItemLevelCalculations_(spreadsheet, model, lineCalculation);

    SpreadsheetApp.getUi().alert(
      'Построчный расчет товара завершен.\n\n' +
      `Сделка: ${dealId}\n` +
      `Товарных строк: ${lineCalculation.rows.length}\n` +
      `Ошибок: ${lineCalculation.errors.length}\n\n` +
      'Результат записан на лист «Построчный расчет».'
    );
  } catch (error) {
    writeLog_('ERROR', 'ITEM_LEVEL_CALCULATION_FAILED', '', String(error && error.message || error));
    SpreadsheetApp.getUi().alert(
      'Построчный расчет не выполнен.\n\n' +
      String(error && error.message || error)
    );
  } finally {
    lock.releaseLock();
  }
}


function readDiscrepancyDecisions_(spreadsheet, dealId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.discrepancyDecisions);
  if (!sheet || sheet.getLastRow() < 2) return new Map();

  const headers = readSheetHeaders_(sheet);
  const rows = readDataRows_(sheet, headers.length);
  const map = new Map();

  rows.forEach(row => {
    const record = rowToRecord_(headers, row);
    if (String(record['deal_id'] || '') !== String(dealId)) return;

    const itemId = String(record['item_id'] || '').trim();
    const type = String(record['Тип расхождения'] || '').trim().toUpperCase();
    if (!itemId || !type) return;

    map.set(`${itemId}|${type}`, {
      decisionId: String(record['decision_id'] || '').trim(),
      dealId: String(record['deal_id'] || '').trim(),
      itemId,
      type,
      partnerValueRub: parseFlexibleNumber_(record['Значение партнера RUB']),
      bbcValueRub: parseFlexibleNumber_(record['Расчет BBC RUB']),
      deltaRub: parseFlexibleNumber_(record['Отклонение RUB']),
      decision: String(record['Решение менеджера'] || '').trim().toUpperCase(),
      manualValueRub: parseFlexibleNumber_(record['Ручное значение RUB']),
      currency: String(record['Валюта'] || 'RUB').trim().toUpperCase(),
      confirmed: isTruthy_(record['Подтверждено менеджером']),
      confirmationId: String(record['ID подтверждения'] || '').trim(),
      confirmedAt: record['Дата подтверждения'] || '',
      reason: String(record['Основание решения'] || '').trim(),
      status: String(record['Статус решения'] || '').trim().toUpperCase()
    });
  });

  return map;
}

function resolveDiscrepancyDecisionValue_(decision, partnerValue, bbcValue) {
  if (!decision || !decision.confirmed) {
    return {applied: false, value: partnerValue, source: 'PARTNER', error: ''};
  }

  if (!decision.confirmationId || !decision.confirmedAt || !decision.reason) {
    return {
      applied: false,
      value: partnerValue,
      source: 'PARTNER',
      error: 'Подтвержденное решение не содержит ID, даты или основания.'
    };
  }

  const action = String(decision.decision || '').toUpperCase();
  if (action === 'PARTNER') {
    return {applied: true, value: partnerValue, source: 'PARTNER', error: ''};
  }
  if (action === 'BBC') {
    if (bbcValue === null) {
      return {applied: false, value: partnerValue, source: 'PARTNER', error: 'Расчет BBC отсутствует.'};
    }
    return {applied: true, value: bbcValue, source: 'BBC_CALCULATION', error: ''};
  }
  if (action === 'MANUAL') {
    if (decision.manualValueRub === null || decision.manualValueRub < 0) {
      return {applied: false, value: partnerValue, source: 'PARTNER', error: 'Не указано ручное значение.'};
    }
    return {applied: true, value: decision.manualValueRub, source: 'MANUAL', error: ''};
  }

  return {
    applied: false,
    value: partnerValue,
    source: 'PARTNER',
    error: 'Не выбрано решение PARTNER, BBC или MANUAL.'
  };
}

function prepareDiscrepancyDecisions() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const lock = LockService.getDocumentLock();
  lock.waitLock(30000);
  try {
    const dealId = resolveDealIdForCalculation_(spreadsheet);
    if (!dealId) return;

    const model = readDealCalculationModel_(spreadsheet, dealId);
    const result = calculateDealModel_(model);
    const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.discrepancyDecisions);
    const existing = readDiscrepancyDecisions_(spreadsheet, dealId);
    const tolerance = parseFlexibleNumber_(
      model.settings.get('CALCULATION_TOLERANCE_RUB') || '0.01'
    ) || 0.01;
    const rows = [];

    (result.itemLineCalculation && result.itemLineCalculation.rows || []).forEach(line => {
      [
        {
          type: 'DUTY',
          partnerValue: line.partnerDutyRub,
          bbcValue: line.dutyRub,
          delta: line.dutyDelta
        },
        {
          type: 'IMPORT_VAT',
          partnerValue: line.partnerVatRub,
          bbcValue: line.importVatRub,
          delta: line.vatDelta
        }
      ].forEach(entry => {
        if (entry.partnerValue === null || entry.bbcValue === null) return;
        if (entry.delta === null || Math.abs(entry.delta) <= tolerance) return;
        if (
          entry.type === 'IMPORT_VAT' &&
          line.vatRateRecalculationTrace &&
          line.vatRateRecalculationTrace.explained
        ) return;
        const key = `${line.itemId}|${entry.type}`;
        const preserved = existing.get(key) || {};
        rows.push([
          preserved.decisionId || stableId_('DECISION', [dealId, line.itemId, entry.type]),
          dealId,
          line.itemId,
          entry.type,
          entry.partnerValue,
          entry.bbcValue,
          entry.delta,
          preserved.decision || '',
          preserved.manualValueRub === null || typeof preserved.manualValueRub === 'undefined'
            ? ''
            : preserved.manualValueRub,
          'RUB',
          preserved.confirmed ? true : false,
          preserved.confirmationId || '',
          preserved.confirmedAt || '',
          preserved.reason || '',
          preserved.confirmed ? 'CONFIRMED' : 'AWAITING_MANAGER',
          '',
          '',
          ''
        ]);
      });
    });

    replaceDealRowsInSheet_(sheet, 2, dealId, rows, 18);
    refreshSheetFilter_(sheet, 18);

    SpreadsheetApp.getUi().alert(
      'Решения по расхождениям подготовлены.\n\n' +
      `Сделка: ${dealId}\n` +
      `Строк решений: ${rows.length}\n\n` +
      'Заполните решение менеджера только в созданных строках. ' +
      'Финансовые итоги не изменены.'
    );
  } finally {
    lock.releaseLock();
  }
}

function applyConfirmedDiscrepancyDecisions() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const dealId = resolveDealIdForCalculation_(spreadsheet);
  if (!dealId) return;

  const decisions = readDiscrepancyDecisions_(spreadsheet, dealId);
  const errors = [];
  let confirmedCount = 0;

  decisions.forEach(decision => {
    if (!decision.confirmed) return;
    confirmedCount += 1;
    const resolution = resolveDiscrepancyDecisionValue_(
      decision,
      decision.partnerValueRub,
      decision.bbcValueRub
    );
    if (resolution.error) {
      errors.push(`${decision.type}: ${resolution.error}`);
    }
  });

  if (errors.length) {
    SpreadsheetApp.getUi().alert(
      'Решения не применены.\n\n' + errors.join('\n')
    );
    return;
  }

  if (!confirmedCount) {
    SpreadsheetApp.getUi().alert(
      'Нет подтвержденных решений.\n\n' +
      'Сначала заполните решение менеджера и установите подтверждение TRUE.'
    );
    return;
  }

  calculateAndCheckDeal();

  SpreadsheetApp.getUi().alert(
    'Подтвержденные решения применены.\n\n' +
    `Сделка: ${dealId}\n` +
    `Подтвержденных решений: ${confirmedCount}\n\n` +
    'Результаты пересчитаны и записаны в расчетные листы.'
  );
}

function applyDiscrepancyDecisionsToExpenses_(model, lineCalculation, convertedExpenses) {
  const decisions = model.discrepancyDecisions || new Map();
  const applications = [];
  const errors = [];

  (lineCalculation.rows || []).forEach(line => {
    [
      {
        type: 'DUTY',
        bucket: 'customsDuty',
        partnerValue: line.partnerDutyRub,
        bbcValue: line.dutyRub
      },
      {
        type: 'IMPORT_VAT',
        bucket: 'vat',
        partnerValue: line.partnerVatRub,
        bbcValue: line.importVatRub
      }
    ].forEach(entry => {
      const decision = decisions.get(`${line.itemId}|${entry.type}`);
      const rateDerivedVat =
        entry.type === 'IMPORT_VAT' &&
        line.vatRateRecalculationTrace &&
        line.vatRateRecalculationTrace.explained;
      if (!rateDerivedVat && (!decision || !decision.confirmed)) return;

      const resolution = rateDerivedVat
        ? {
            applied: true,
            value: entry.bbcValue,
            source: 'BBC_RATE_DERIVED_RECALCULATION',
            error: ''
          }
        : resolveDiscrepancyDecisionValue_(
            decision,
            entry.partnerValue,
            entry.bbcValue
          );
      if (resolution.error) {
        errors.push({
          itemId: line.itemId,
          type: entry.type,
          message: resolution.error
        });
        return;
      }

      const matching = convertedExpenses.filter(expense =>
        expense.bucket === entry.bucket &&
        (
          String(expense.itemId || '') === String(line.itemId) ||
          (lineCalculation.rows || []).length === 1
        )
      );

      if (matching.length !== 1) {
        errors.push({
          itemId: line.itemId,
          type: entry.type,
          message: 'Невозможно однозначно определить заменяемую строку расхода.'
        });
        return;
      }

      matching[0].amountRub = roundTo_(resolution.value, 8);
      matching[0].amountCny = convertMoneyForCalculation_(
        resolution.value,
        'RUB',
        model.rateBook.selected
      ).amountCny;
      matching[0].decisionApplied = true;
      matching[0].decisionSource = resolution.source;
      matching[0].decisionId = rateDerivedVat
        ? stableId_('AUTO_RATE_RECALC', [model.dealId, line.itemId, entry.type])
        : decision.decisionId;

      applications.push({
        decisionId: matching[0].decisionId,
        itemId: line.itemId,
        type: entry.type,
        valueRub: resolution.value,
        source: resolution.source
      });
    });
  });

  return {applications, errors};
}

function updateAppliedDecisionRows_(spreadsheet, dealId, applications) {
  if (!applications || !applications.length) return;
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.discrepancyDecisions);
  if (!sheet || sheet.getLastRow() < 2) return;

  const headers = readSheetHeaders_(sheet);
  const idIndex = headers.indexOf('decision_id');
  const dealIndex = headers.indexOf('deal_id');
  const statusIndex = headers.indexOf('Статус решения');
  const valueIndex = headers.indexOf('Примененное значение RUB');
  const sourceIndex = headers.indexOf('Источник примененного значения');
  const dateIndex = headers.indexOf('Дата применения');
  const appMap = new Map(applications.map(item => [item.decisionId, item]));

  const values = sheet.getRange(2, 1, sheet.getLastRow() - 1, headers.length).getValues();
  values.forEach(row => {
    if (String(row[dealIndex]) !== String(dealId)) return;
    const app = appMap.get(String(row[idIndex]));
    if (!app) return;
    row[statusIndex] = 'APPLIED';
    row[valueIndex] = app.valueRub;
    row[sourceIndex] = app.source;
    row[dateIndex] = new Date();
  });
  sheet.getRange(2, 1, values.length, headers.length).setValues(values);
}

function calculateDealModel_(model) {
  const conversionErrors = [];

  const convertedItems = model.items.map(row => {
    const amount = parseFlexibleNumber_(row[14]);
    const currency = String(row[13]).trim().toUpperCase();
    const converted = convertMoneyForCalculation_(
      amount,
      currency,
      model.rateBook.selected
    );

    if (converted.error) {
      conversionErrors.push({
        entity: row[0],
        field: 'Стоимость партии',
        error: converted.error
      });
    }

    return {
      id: String(row[0]),
      row,
      amount,
      currency,
      amountCny: converted.amountCny,
      amountRub: converted.amountRub,
      quantity: parseFlexibleNumber_(row[10])
    };
  });

  const allConvertedExpenses = model.expenses.map(row => {
    const amount = parseFlexibleNumber_(row[6]);
    const currency = String(row[7]).trim().toUpperCase();
    const converted = convertMoneyForCalculation_(
      amount,
      currency,
      model.rateBook.selected
    );

    if (converted.error) {
      conversionErrors.push({
        entity: row[0],
        field: 'Сумма расхода',
        error: converted.error
      });
    }

    return {
      id: String(row[0]),
      row,
      amount,
      currency,
      amountCny: converted.amountCny,
      amountRub: converted.amountRub,
      bucket: classifyExpenseBucket_(row[4], row[5]),
      itemId: String(row[2] || '')
    };
  });

  const itemLineCalculation = calculateItemLevelModel_(
    model,
    convertedItems,
    allConvertedExpenses
  );

  const decisionApplication = applyDiscrepancyDecisionsToExpenses_(
    model,
    itemLineCalculation,
    allConvertedExpenses
  );

  decisionApplication.errors.forEach(error => conversionErrors.push({
    entity: error.itemId,
    field: error.type,
    error: error.message
  }));

  /*
   * Ранее вручную внесённая комиссия BBC исключается,
   * чтобы новая рассчитанная комиссия не учитывалась второй раз.
   */
  // DEV-016.40: партнёрские строки пошлины/НДС — evidence, а не финальная
  // калькуляция BBC. В итог включаются детерминированно рассчитанные значения.
  const convertedExpensesBeforeCommission = allConvertedExpenses.filter(
    expense => !['bbcCommission', 'customsDuty', 'vat'].includes(expense.bucket)
  );
  const calculatedDutyRub = sumNumbers_((itemLineCalculation.rows || []).map(row => Number(row.dutyRub || 0)));
  const calculatedVatRub = sumNumbers_((itemLineCalculation.rows || []).map(row => Number(row.importVatRub || 0)));
  const cnyRubForCustoms = model.rateBook.selected.get('CNY_RUB_RATE') || 0;
  [
    ['customsDuty', 'Таможенная пошлина BBC', calculatedDutyRub],
    ['vat', 'Импортный НДС BBC', calculatedVatRub]
  ].forEach(spec => {
    const rub = roundTo_(spec[2], 8);
    convertedExpensesBeforeCommission.push({
      id: stableId_('EXP_CALCULATED_' + spec[0].toUpperCase(), [model.dealId]),
      row: [], amount: rub, currency: 'RUB',
      amountCny: cnyRubForCustoms > 0 ? roundTo_(rub / cnyRubForCustoms, 8) : null,
      amountRub: rub, bucket: spec[0], itemId: '', calculated: true,
      article: spec[1]
    });
  });

  // Approved benchmark: export declaration is a separate 1 000 CNY expense,
  // configurable in Settings and inserted only when a source row is absent.
  const existingExportSupportCny = sumNumbers_(convertedExpensesBeforeCommission.filter(expense => expense.bucket === 'exportSupport').map(expense => Number(expense.amountCny || 0)));
  if (!(existingExportSupportCny > 0)) {
    const exportDeclarationCny = parseFlexibleNumber_(model.settings.get('EXPORT_DECLARATION_CNY')) ?? 1000;
    const exportRub = cnyRubForCustoms > 0 ? roundTo_(exportDeclarationCny * cnyRubForCustoms, 8) : null;
    convertedExpensesBeforeCommission.push({
      id: stableId_('EXP_EXPORT_DECLARATION', [model.dealId]), row: [],
      amount: exportDeclarationCny, currency: 'CNY', amountCny: exportDeclarationCny,
      amountRub: exportRub, bucket: 'exportSupport', itemId: '', calculated: true,
      article: 'Расход на экспортную декларацию'
    });
  }

  const preCommissionSummary = calculateMoneySummary_(convertedItems, convertedExpensesBeforeCommission);
  const chinaDeliveryRubForCommission = sumNumbers_(convertedExpensesBeforeCommission.filter(expense => expense.bucket === 'chinaDelivery').map(expense => Number(expense.amountRub || 0)));
  preCommissionSummary.commissionBaseRub = roundTo_(preCommissionSummary.goodsRub + chinaDeliveryRubForCommission, 8);

  const commissionCalculation = calculateBbcCommission_(
    model.commissionInput,
    preCommissionSummary,
    model.rateBook.selected
  );

  if (commissionCalculation.error) {
    conversionErrors.push({
      entity: model.dealId,
      field: 'Комиссия BBC',
      error: commissionCalculation.error
    });
  }

  const calculatedCommissionExpense = {
    id: stableId_('EXP_BBC_COMMISSION', [model.dealId]),
    row: [
      stableId_('EXP_BBC_COMMISSION', [model.dealId]),
      model.dealId,
      '',
      '',
      'Комиссия BBC',
      'Комиссия BBC',
      commissionCalculation.amountRub,
      'RUB'
    ],
    amount: commissionCalculation.amountRub,
    currency: 'RUB',
    amountCny: commissionCalculation.amountCny,
    amountRub: commissionCalculation.amountRub,
    bucket: 'bbcCommission',
    itemId: '',
    calculated: true
  };

  const convertedExpenses = convertedExpensesBeforeCommission.slice();

  if (
    commissionCalculation.amountRub !== 0 ||
    commissionCalculation.amountCny !== 0 ||
    String(model.commissionInput.type || '').toUpperCase() === 'ZERO'
  ) {
    convertedExpenses.push(calculatedCommissionExpense);
  }

  // DEV-016.40: bank-payment engine is part of the deterministic deal total.
  // Rates are settings-driven; benchmark defaults are 3% for supplier payments
  // and 2% for the incoming BBC-service payment.
  const cnyRubBank = model.rateBook.selected.get('CNY_RUB_RATE') || 0;
  const goodsInvoiceCny = roundTo_(preCommissionSummary.commissionBaseRub / cnyRubBank, 8);
  const supplierBankPercent = (parseFlexibleNumber_(model.settings.get('BANK_SUPPLIER_PAYMENT_TOTAL_PERCENT')) ?? 3) / 100;
  const incomingServicePercent = (parseFlexibleNumber_(model.settings.get('BANK_INCOMING_SERVICE_PERCENT')) ?? 2) / 100;
  const exportSupportCny = sumNumbers_(convertedExpenses.filter(expense => expense.bucket === 'exportSupport').map(expense => Number(expense.amountCny || 0)));
  const supplierBankCny = roundTo_(goodsInvoiceCny * supplierBankPercent, 8);
  const incomingBankCny = roundTo_((Number(commissionCalculation.amountCny || 0) + exportSupportCny) * incomingServicePercent, 8);
  [
    ['supplierBankFees', 'Банковские комиссии за оплату поставщику', supplierBankCny],
    ['incomingBankFees', 'Банковские комиссии за входящий платеж', incomingBankCny]
  ].forEach(spec => convertedExpenses.push({
    id: stableId_('EXP_' + spec[0].toUpperCase(), [model.dealId]), row: [],
    amount: spec[2], currency: 'CNY', amountCny: spec[2],
    amountRub: cnyRubBank > 0 ? roundTo_(spec[2] * cnyRubBank, 8) : null,
    bucket: spec[0], itemId: '', calculated: true, article: spec[1]
  }));

  const summary = calculateMoneySummary_(convertedItems, convertedExpenses);

  const bucketTotals = emptyExpenseBuckets_();

  convertedExpenses.forEach(expense => {
    if (expense.amountCny === null || expense.amountRub === null) return;

    bucketTotals[expense.bucket].cny += expense.amountCny;
    bucketTotals[expense.bucket].rub += expense.amountRub;
  });

  Object.keys(bucketTotals).forEach(key => {
    bucketTotals[key].cny = roundTo_(bucketTotals[key].cny, 8);
    bucketTotals[key].rub = roundTo_(bucketTotals[key].rub, 8);
  });

  /*
   * Рассчитанная комиссия BBC является расходом всей сделки,
   * поэтому не распределяется между товарами автоматически.
   */
  const itemExpenseMap = buildItemExpenseMap_(
    model,
    convertedItems,
    convertedExpensesBeforeCommission
  );

  return Object.assign(summary, {
    convertedItems,
    convertedExpenses,
    originalConvertedExpenses: allConvertedExpenses,
    itemLineCalculation,
    decisionApplication,
    bucketTotals,
    itemExpenseMap,
    conversionErrors,
    commissionCalculation,
    preCommissionSummary,
    cnyRub: model.rateBook.selected.get('CNY_RUB_RATE') || null,
    usdRub: model.rateBook.selected.get('USD_RUB_RATE') || null,
    eurRub: model.rateBook.selected.get('EUR_RUB_RATE') || null
  });
}

function calculateMoneySummary_(convertedItems, convertedExpenses) {
  const validItems = convertedItems.filter(item =>
    item.amountCny !== null && item.amountRub !== null
  );
  const validExpenses = convertedExpenses.filter(expense =>
    expense.amountCny !== null && expense.amountRub !== null
  );
  const goodsCny = sumNumbers_(validItems.map(item => item.amountCny));
  const goodsRub = sumNumbers_(validItems.map(item => item.amountRub));
  const expensesCny = sumNumbers_(validExpenses.map(expense => expense.amountCny));
  const expensesRub = sumNumbers_(validExpenses.map(expense => expense.amountRub));
  return {
    goodsCny: roundTo_(goodsCny, 8),
    goodsRub: roundTo_(goodsRub, 8),
    expensesCny: roundTo_(expensesCny, 8),
    expensesRub: roundTo_(expensesRub, 8),
    totalCny: roundTo_(goodsCny + expensesCny, 8),
    totalRub: roundTo_(goodsRub + expensesRub, 8)
  };
}

function convertMoneyForCalculation_(amount, currency, rates) {
  if (amount === null || !Number.isFinite(Number(amount))) {
    return {amountCny: null, amountRub: null, error: 'Некорректная сумма'};
  }
  const code = String(currency || '').trim().toUpperCase();
  const cnyRub = rates.get('CNY_RUB_RATE');
  if (code === 'CNY') {
    if (!cnyRub) return {amountCny: null, amountRub: null, error: 'Нет курса CNY/RUB'};
    return {amountCny: Number(amount), amountRub: Number(amount) * cnyRub, error: ''};
  }
  if (code === 'RUB') {
    if (!cnyRub) return {amountCny: null, amountRub: null, error: 'Нет курса CNY/RUB'};
    return {amountCny: Number(amount) / cnyRub, amountRub: Number(amount), error: ''};
  }
  if (['USD', 'EUR'].includes(code)) {
    const foreignRub = rates.get(`${code}_RUB_RATE`);
    if (!foreignRub) {
      return {amountCny: null, amountRub: null, error: `Нет курса ${code}/RUB`};
    }
    if (!cnyRub) return {amountCny: null, amountRub: null, error: 'Нет курса CNY/RUB'};
    return {
      amountCny: Number(amount) * foreignRub / cnyRub,
      amountRub: Number(amount) * foreignRub,
      error: ''
    };
  }
  return {
    amountCny: null, amountRub: null,
    error: `Валюта ${code || 'не указана'} не поддерживается`
  };
}

function calculateBbcCommission_(commissionInput, preCommissionSummary, rates) {
  const commission = commissionInput || {};
  const type = String(commission.type || '').trim().toUpperCase();
  const base = String(commission.base || '').trim().toUpperCase();
  const value = Number(commission.value || 0);

  if (!commission.confirmedByManager) {
    return {
      amountCny: 0,
      amountRub: 0,
      error: 'Комиссия BBC не подтверждена менеджером.'
    };
  }

  if (type === 'ZERO') {
    return {
      amountCny: 0,
      amountRub: 0,
      error: ''
    };
  }

  if (type === 'PERCENT') {
    if (!['TOTAL_BEFORE_BBC_COMMISSION', 'GOODS_WITH_CHINA_DELIVERY'].includes(base)) {
      return {
        amountCny: 0,
        amountRub: 0,
        error: 'Неподдерживаемая база процентной комиссии BBC.'
      };
    }

    if (!(value > 0)) {
      return {
        amountCny: 0,
        amountRub: 0,
        error: 'Процент комиссии BBC должен быть больше нуля.'
      };
    }

    const cnyRub = rates.get('CNY_RUB_RATE');
    if (!(cnyRub > 0)) {
      return {
        amountCny: 0,
        amountRub: 0,
        error: 'Нет подтверждённого курса CNY/RUB для проверки минимальной комиссии BBC.'
      };
    }

    const commissionBaseRub = base === 'GOODS_WITH_CHINA_DELIVERY' ? Number(preCommissionSummary.commissionBaseRub || 0) : preCommissionSummary.totalRub;
    const percentAmountRub = commissionBaseRub * value / 100;
    const percentAmountCny = percentAmountRub / cnyRub;
    const minimumAmountCny = Number(commission.minimumCny || 0);
    const minimumAmountRub = minimumAmountCny * cnyRub;

    const amountRub = Math.max(percentAmountRub, minimumAmountRub);
    const amountCny = amountRub / cnyRub;

    return {
      amountCny: roundTo_(amountCny, 8),
      amountRub: roundTo_(amountRub, 8),
      percentAmountCny: roundTo_(percentAmountCny, 8),
      percentAmountRub: roundTo_(percentAmountRub, 8),
      minimumAmountCny: roundTo_(minimumAmountCny, 8),
      minimumAmountRub: roundTo_(minimumAmountRub, 8),
      appliedRule: percentAmountRub >= minimumAmountRub ? 'PERCENT' : 'MINIMUM_CNY',
      error: ''
    };
  }

  if (type === 'FIXED') {
    if (!(value > 0)) {
      return {
        amountCny: 0,
        amountRub: 0,
        error: 'Фиксированная комиссия BBC должна быть больше нуля.'
      };
    }

    const converted = convertMoneyForCalculation_(
      value,
      commission.currency,
      rates
    );

    return {
      amountCny: converted.amountCny === null
        ? 0
        : roundTo_(converted.amountCny, 8),
      amountRub: converted.amountRub === null
        ? 0
        : roundTo_(converted.amountRub, 8),
      error: converted.error || ''
    };
  }

  return {
    amountCny: 0,
    amountRub: 0,
    error: 'Не указан допустимый тип комиссии BBC.'
  };
}
function emptyExpenseBuckets_() {
  return {
    chinaDelivery: {cny: 0, rub: 0},
    exportSupport: {cny: 0, rub: 0},
    internationalLogistics: {cny: 0, rub: 0},
    russiaDelivery: {cny: 0, rub: 0},
    customsDelivery: {cny: 0, rub: 0},
    customsDuty: {cny: 0, rub: 0},
    vat: {cny: 0, rub: 0},
    customsFee: {cny: 0, rub: 0},
    broker: {cny: 0, rub: 0},
    temporaryStorage: {cny: 0, rub: 0},
    certification: {cny: 0, rub: 0},
    marking: {cny: 0, rub: 0},
    insurance: {cny: 0, rub: 0},
    supplierBankFees: {cny: 0, rub: 0},
    incomingBankFees: {cny: 0, rub: 0},
    partnerFinancialServices: {cny: 0, rub: 0},
    partnerCommission: {cny: 0, rub: 0},
    bbcCommission: {cny: 0, rub: 0},
    other: {cny: 0, rub: 0}
  };
}

function classifyExpenseBucket_(category, article) {
  const text = normalizeRecognitionText_(`${category || ''} ${article || ''}`);
  if (/доставк.*кита|china.*deliver/.test(text)) return 'chinaDelivery';
  if (/экспорт.*(?:документ|декларац)|документооборот.*экспорт/.test(text)) return 'exportSupport';
  if (/международ|фрахт|international/.test(text)) return 'internationalLogistics';
  if (/доставк.*от.*свх.*склад.*клиент/.test(text)) return 'customsDelivery';
  if (/доставк.*росси|забайкальск.*москв|доставк.*до.*свх/.test(text)) return 'russiaDelivery';
  if (/пошлин/.test(text)) return 'customsDuty';
  if (/(?:^|\s)ндс(?:\s|$)/.test(text)) return 'vat';
  if (/таможенн.*сбор/.test(text)) return 'customsFee';
  if (/брокер/.test(text)) return 'broker';
  if (/свх|временн.*хранен/.test(text)) return 'temporaryStorage';
  if (/сертифик|деклараци.*соответств/.test(text)) return 'certification';
  if (/маркиров|честн.*знак/.test(text)) return 'marking';
  if (/страхов/.test(text)) return 'insurance';
  if (/комисси.*bbc|вознагражден.*bbc/.test(text)) return 'bbcCommission';
  if (/документооборот.*(?:перевозчик|импорт)|агентск.*вознагражден/.test(text)) return 'partnerCommission';
  if (/финансов.*услуг/.test(text)) return 'partnerFinancialServices';
  if (/комисси.*партн/.test(text)) return 'partnerCommission';
  return 'other';
}

function buildItemExpenseMap_(model, items, expenses) {
  const map = new Map(items.map(item => [item.id, []]));
  if (items.length === 1) {
    map.set(items[0].id, expenses.slice());
    return map;
  }
  const allocationByExpense = new Map();
  model.allocations.forEach(row => {
    const expenseId = String(row[1]);
    const itemId = String(row[3]);
    if (!allocationByExpense.has(expenseId)) allocationByExpense.set(expenseId, []);
    allocationByExpense.get(expenseId).push({
      itemId,
      amountCny: parseFlexibleNumber_(row[7]),
      amountRub: parseFlexibleNumber_(row[8]),
      row
    });
  });
  expenses.forEach(expense => {
    if (expense.itemId && map.has(expense.itemId)) {
      map.get(expense.itemId).push(expense);
      return;
    }
    (allocationByExpense.get(expense.id) || []).forEach(allocation => {
      if (!map.has(allocation.itemId)) return;
      map.get(allocation.itemId).push(Object.assign({}, expense, {
        amountCny: allocation.amountCny,
        amountRub: allocation.amountRub,
        allocated: true
      }));
    });
  });
  return map;
}


function sourceValueCellFromRange_(cellRange) {
  const text = String(cellRange || '').trim().toUpperCase();
  if (!text) return '';
  const matches = text.match(/[A-Z]+\d+/g) || [];
  return matches.length ? matches[matches.length - 1] : '';
}

function formulaNumber_(raw) {
  const value = Number(String(raw || '').replace(',', '.'));
  return Number.isFinite(value) ? value : null;
}

function extractFormulaFactorForCell_(formula, cellAddress) {
  const formulaText = String(formula || '').toUpperCase().replace(/\s+/g, '');
  const cell = String(cellAddress || '').toUpperCase().replace(/\$/g, '');
  if (!formulaText || !cell) return null;
  const escaped = cell.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  let match = formulaText.match(new RegExp(escaped + '\\*([0-9]+(?:[.,][0-9]+)?)'));
  if (!match) match = formulaText.match(new RegExp('([0-9]+(?:[.,][0-9]+)?)\\*' + escaped));
  return match ? formulaNumber_(match[1]) : null;
}

function extractFormulaPercent_(formula) {
  const formulaText = String(formula || '').replace(/\s+/g, '');
  const matches = [...formulaText.matchAll(/([0-9]+(?:[.,][0-9]+)?)%/g)];
  if (!matches.length) return null;
  const numeric = formulaNumber_(matches[matches.length - 1][1]);
  return numeric === null ? null : numeric / 100;
}

function findFormulaEvidenceForExpenseBucket_(model, bucket) {
  const expense = (model.normalizedExpenses || []).find(entry =>
    entry.includeInternal && classifyExpenseBucket_(entry.category, entry.name) === bucket &&
    entry.source && entry.source.sheet && entry.source.cell
  );
  if (!expense) return null;
  const sourceRowMatch = String(expense.source.cell || '').match(/\d+/);
  const sourceRow = sourceRowMatch ? Number(sourceRowMatch[0]) : null;
  if (!(sourceRow > 0)) return null;
  const sourceFileName = String(expense.source.file || '').split(';')[0].trim();
  const candidates = (model.sourceFormulaEvidence || []).filter(evidence =>
    Number(evidence.rowNumber) === sourceRow &&
    String(evidence.sheetName || '') === String(expense.source.sheet || '') &&
    (!sourceFileName || String(evidence.sourceFile || '') === sourceFileName)
  );
  if (!candidates.length) return null;
  return candidates.find(evidence => String(evidence.formula || '').trim()) || null;
}

function explainCustomsDeltaByEmbeddedSourceRates_(model, result, tolerance) {
  const notExplained = {
    dutyExplained: false,
    vatExplained: false,
    rateEvidence: []
  };
  const cnyRub = Number(result.cnyRub || 0);
  const usdRub = Number(result.usdRub || 0);
  if (!(cnyRub > 0) || !(usdRub > 0)) return notExplained;

  const dutyEvidence = findFormulaEvidenceForExpenseBucket_(model, 'customsDuty');
  const vatEvidence = findFormulaEvidenceForExpenseBucket_(model, 'vat');
  const freightExpense = (model.normalizedExpenses || []).find(entry =>
    entry.includeInternal && classifyExpenseBucket_(entry.category, entry.name) === 'internationalLogistics' &&
    String(entry.currency || '').toUpperCase() === 'USD' && entry.amount !== null
  );
  if (!dutyEvidence || !vatEvidence || !freightExpense) return notExplained;

  const freightCell = sourceValueCellFromRange_(freightExpense.source && freightExpense.source.cell);
  const dutyCell = sourceValueCellFromRange_((model.normalizedExpenses || []).find(entry =>
    entry.includeInternal && classifyExpenseBucket_(entry.category, entry.name) === 'customsDuty'
  )?.source?.cell);
  if (!freightCell || !dutyCell) return notExplained;

  const dutyFormula = String(dutyEvidence.formula || '');
  const vatFormula = String(vatEvidence.formula || '');
  const dutyFreightFactor = extractFormulaFactorForCell_(dutyFormula, freightCell);
  const vatFreightFactor = extractFormulaFactorForCell_(vatFormula, freightCell);
  const dutyRate = extractFormulaPercent_(dutyFormula);
  const vatRate = extractFormulaPercent_(vatFormula);
  if (!(dutyFreightFactor > 0) || !(vatFreightFactor > 0) ||
      !(dutyRate >= 0) || !(vatRate >= 0)) return notExplained;

  const normalizedVatFormula = vatFormula.toUpperCase().replace(/\$/g, '').replace(/\s+/g, '');
  if (!normalizedVatFormula.includes(dutyCell.toUpperCase())) return notExplained;

  const internationalUsdExpenses = (result.originalConvertedExpenses || []).filter(expense =>
    expense.bucket === 'internationalLogistics' && Number(expense.amount || 0) !== 0
  );
  if (!internationalUsdExpenses.length || internationalUsdExpenses.some(expense =>
    String(expense.currency || '').toUpperCase() !== 'USD'
  )) return notExplained;
  const internationalUsd = sumNumbers_(internationalUsdExpenses.map(expense => Number(expense.amount || 0)));
  const goodsCny = Number(result.goodsCny || 0);
  if (!(goodsCny >= 0) || !(internationalUsd > 0)) return notExplained;

  const rows = result.itemLineCalculation && result.itemLineCalculation.rows || [];
  const partnerDutyRub = sumNumbers_(rows.map(row => Number(row.partnerDutyRub || 0)));
  const currentDutyRub = sumNumbers_(rows.map(row => Number(row.dutyRub || 0)));
  const partnerVatRub = sumNumbers_(rows.map(row => Number(row.partnerVatRub || 0)));
  const currentVatRub = sumNumbers_(rows.map(row => Number(row.importVatRub || 0)));
  if (!(partnerDutyRub >= 0) || !(partnerVatRub >= 0)) return notExplained;

  const currentCrossCnyPerUsd = usdRub / cnyRub;
  const sourceDutyExpectedRub = roundTo_(
    (goodsCny + internationalUsd * dutyFreightFactor) * dutyRate * cnyRub, 8
  );
  const sourceVatExpectedRub = roundTo_(
    (goodsCny + internationalUsd * vatFreightFactor + sourceDutyExpectedRub / cnyRub) *
      vatRate * cnyRub,
    8
  );
  const expectedDutyDelta = roundTo_(
    internationalUsd * (currentCrossCnyPerUsd - dutyFreightFactor) * dutyRate * cnyRub,
    8
  );
  const expectedVatDelta = roundTo_(
    (internationalUsd * (currentCrossCnyPerUsd - vatFreightFactor) * cnyRub +
      (currentDutyRub - partnerDutyRub)) * vatRate,
    8
  );
  const actualDutyDelta = roundTo_(currentDutyRub - partnerDutyRub, 8);
  const actualVatDelta = roundTo_(currentVatRub - partnerVatRub, 8);
  const formulaTolerance = Math.max(Number(tolerance || 0.01), 0.05);

  const dutyExplained =
    Math.abs(sourceDutyExpectedRub - partnerDutyRub) <= formulaTolerance &&
    Math.abs(expectedDutyDelta - actualDutyDelta) <= formulaTolerance;
  const vatExplained = dutyExplained &&
    Math.abs(sourceVatExpectedRub - partnerVatRub) <= formulaTolerance &&
    Math.abs(expectedVatDelta - actualVatDelta) <= formulaTolerance;

  return {
    dutyExplained,
    vatExplained,
    dutyFormula,
    vatFormula,
    dutyFreightFactor,
    vatFreightFactor,
    dutyRate,
    vatRate,
    currentCrossCnyPerUsd: roundTo_(currentCrossCnyPerUsd, 8),
    cnyRub,
    usdRub,
    sourceDutyExpectedRub,
    sourceVatExpectedRub,
    actualDutyDelta,
    actualVatDelta,
    expectedDutyDelta,
    expectedVatDelta,
    rateEvidence: [
      {code: 'USD_CNY_EMBEDDED_DUTY', partnerValue: dutyFreightFactor, confirmedValue: roundTo_(currentCrossCnyPerUsd, 8)},
      {code: 'USD_CNY_EMBEDDED_VAT', partnerValue: vatFreightFactor, confirmedValue: roundTo_(currentCrossCnyPerUsd, 8)}
    ]
  };
}

function buildCalculationChecks_(model, result) {
  const checks = [];
  const tolerance = parseFlexibleNumber_(
    model.settings.get('CALCULATION_TOLERANCE_RUB') || '0.01'
  ) || 0.01;
  const add = (type, severity, field, source, calculated, delta, message, itemId) => {
    const issue = severity !== 'Информация';
    checks.push({
      id: stableId_('CHK', [model.dealId, itemId || '', type, field, message]),
      dealId: model.dealId,
      itemId: itemId || '',
      date: model.calculatedAt,
      type,
      severity,
      field,
      source,
      calculated,
      delta: delta === '' || delta === null ? '' : delta,
      status: issue ? 'Открыто' : 'Подтверждено',
      message
    });
  };

  if (model.items.length === 0) {
    add('Обязательные данные', 'Критическая ошибка', 'Товары',
      model.allItems.length, 0, '', 'Нет подтверждённых товарных записей.');
  }
  if (model.allItems.length > model.items.length) {
    add('Подтверждение данных', 'Критическая ошибка', 'Товары',
      model.allItems.length, model.items.length, model.allItems.length - model.items.length,
      'Есть неподтверждённые товарные записи.');
  }
  if (model.activeExpenses.length > model.expenses.length) {
    add('Подтверждение данных', 'Критическая ошибка', 'Расходы',
      model.activeExpenses.length, model.expenses.length,
      model.activeExpenses.length - model.expenses.length,
      'Есть активные неподтверждённые расходы.');
  }

  const duplicateItemIds = findDuplicateValues_(model.allItems.map(row => row[0]));
  const duplicateExpenseIds = findDuplicateValues_(model.allExpenses.map(row => row[0]));
  duplicateItemIds.forEach(id => add(
    'Уникальность', 'Критическая ошибка', 'item_id', id, '', '',
    `Обнаружен дублирующий item_id ${id}.`
  ));
  duplicateExpenseIds.forEach(id => add(
    'Уникальность', 'Критическая ошибка', 'expense_id', id, '', '',
    `Обнаружен дублирующий expense_id ${id}.`
  ));

  model.items.forEach(row => {
    const itemId = String(row[0]);
    if (!String(row[4]).trim()) add(
      'Обязательные данные', 'Предупреждение', 'Наименование товара',
      '', '', '', 'Наименование товара не заполнено.', itemId
    );
    if (!String(row[9]).trim()) add(
      'Обязательные данные', 'Предупреждение', 'Код ТН ВЭД',
      '', '', '', 'Код ТН ВЭД не заполнен.', itemId
    );
    if (parseFlexibleNumber_(row[14]) === null) add(
      'Обязательные данные', 'Критическая ошибка', 'Стоимость партии',
      row[14], '', '', 'Стоимость товарной партии не является числом.', itemId
    );
    if (!String(row[13]).trim()) add(
      'Обязательные данные', 'Критическая ошибка', 'Валюта товара',
      '', '', '', 'Валюта стоимости товара не указана.', itemId
    );
    if (!parseFlexibleNumber_(row[16]) && !parseFlexibleNumber_(row[17])) add(
      'Обязательные данные', 'Предупреждение', 'Вес или объём',
      '', '', '', 'Не указан ни вес брутто, ни объём товара.', itemId
    );
    if (String(row[20]).trim().toUpperCase() === 'MAX_OF_METHODS') add(
      'Правило пошлины', 'Критическая ошибка', 'Тип пошлины',
      row[20], '', '',
      'MAX_OF_METHODS запрещён: необходимо выбрать юридически применимый метод.',
      itemId
    );
  });

  const hasRateConflicts = model.rateBook.conflicts.size > 0;
  const hasMissingRateConfirmations = model.rateBook.missingConfirmations.size > 0;

  // При конфликте или отсутствии подтверждённого курса выводим только корневые
  // ошибки. Зависимые сообщения «Нет курса ...» не дублируем.
  if (!hasRateConflicts && !hasMissingRateConfirmations) {
    result.conversionErrors.forEach(error => add(
      'Валюты и курсы', 'Критическая ошибка', error.field,
      error.entity, '', '', error.error
    ));
  }

  model.rateBook.conflicts.forEach((groups, code) => {
    const details = [...groups.entries()]
      .map(([value, entries]) =>
        `${Number(value)} — ${entries.map(entry => entry.source).join(', ')}`
      )
      .join('; ');
    add(
      'Валюты и курсы', 'Критическая ошибка', code,
      details, '', '',
      `Найдены конфликтующие значения курса ${code}. ` +
      'Автоматический выбор запрещён; менеджер должен подтвердить один курс.'
    );
  });


  model.rateBook.missingConfirmations.forEach((groups, code) => {
    const details = [...groups.entries()]
      .map(([value, entries]) =>
        `${Number(value)} — ${entries.map(entry => entry.source).join(', ')}`
      )
      .join('; ');
    add(
      'Валюты и курсы', 'Критическая ошибка', code,
      details, '', '',
      `Курс ${code} найден в данных сделки, но не закреплён менеджером ` +
      `для назначения ${model.rateBook.purpose}. Добавьте активную строку на лист ` +
      '«Курсы валют» и установите «Подтверждено менеджером» = TRUE.'
    );
  });

  model.rateBook.unconfirmedActive.forEach(entry => add(
    'Валюты и курсы', 'Критическая ошибка', `${entry.from}_${entry.to}_RATE`,
    `${entry.value} — ${entry.source}`, '', '',
    `Активная строка курса ${entry.rateId} не подтверждена менеджером.`
  ));

  model.rateBook.mismatches.forEach((data, code) => {
    const details = data.entries
      .map(entry => `${entry.value} — ${entry.source}`)
      .join('; ');
    add(
      'Валюты и курсы', 'Информация', code,
      details, data.selectedValue, '',
      'Подтверждённый курс отличается от курса, импортированного из файла партнёра. ' +
      'Для расчёта использован только подтверждённый курс; расхождение источника ' +
      'сохранено информационно и не требует решения менеджера.'
    );
  });

  (result.itemLineCalculation && result.itemLineCalculation.errors || [])
    .forEach(error => add(
      'Построчный расчет',
      'Критическая ошибка',
      error.field,
      error.itemId,
      '',
      '',
      error.message,
      error.itemId
    ));

  const lineTolerance = tolerance;
  const sourceFormulaTrace = explainCustomsDeltaByEmbeddedSourceRates_(model, result, tolerance);
  (result.itemLineCalculation && result.itemLineCalculation.rows || [])
    .forEach(row => {
      const dutyDecision = model.discrepancyDecisions &&
        model.discrepancyDecisions.get(`${row.itemId}|DUTY`);
      const vatDecision = model.discrepancyDecisions &&
        model.discrepancyDecisions.get(`${row.itemId}|IMPORT_VAT`);

      if (
        row.dutyDelta !== null &&
        Math.abs(row.dutyDelta) > lineTolerance &&
        !(dutyDecision && dutyDecision.confirmed)
      ) {
        if (sourceFormulaTrace.dutyExplained) {
          add(
            'Сверка пошлины',
            'Информация',
            'Таможенная пошлина',
            row.partnerDutyRub,
            row.dutyRub,
            row.dutyDelta,
            'Расхождение полностью объясняется заменой встроенного курса USD/CNY ' +
            `из формулы партнёра (${sourceFormulaTrace.dutyFreightFactor}) на подтверждённые ` +
            `курсы сделки USD/RUB=${sourceFormulaTrace.usdRub} и CNY/RUB=${sourceFormulaTrace.cnyRub} ` +
            `(кросс-курс ${sourceFormulaTrace.currentCrossCnyPerUsd}). Значение BBC применено ` +
            'автоматически; сумма партнёра сохранена как evidence.',
            row.itemId
          );
        } else {
          add(
            'Сверка пошлины',
            'Предупреждение',
            'Таможенная пошлина',
            row.partnerDutyRub,
            row.dutyRub,
            row.dutyDelta,
            'Самостоятельный расчет пошлины отличается от суммы партнера.',
            row.itemId
          );
        }
      }
      if (
        row.vatDelta !== null &&
        Math.abs(row.vatDelta) > lineTolerance &&
        !(vatDecision && vatDecision.confirmed)
      ) {
        const trace = row.vatRateRecalculationTrace || {};
        if (trace.explained) {
          const rateText = (trace.rateEvidence || [])
            .map(rate =>
              `${rate.code}: ${rate.partnerValue} → ${rate.confirmedValue}`
            )
            .join('; ');
          add(
            'Сверка НДС',
            'Информация',
            'Импортный НДС',
            row.partnerVatRub,
            row.importVatRub,
            row.vatDelta,
            'Расхождение полностью объясняется пересчётом по подтверждённым ' +
            `курсам сделки (${rateText}). Значение BBC применено автоматически; ` +
            'сумма партнёра сохранена как evidence.',
            row.itemId
          );
        } else if (sourceFormulaTrace.vatExplained) {
          add(
            'Сверка НДС',
            'Информация',
            'Импортный НДС',
            row.partnerVatRub,
            row.importVatRub,
            row.vatDelta,
            'Расхождение полностью объясняется формулой партнёра: для фрахта в НДС ' +
            `использован встроенный USD/CNY=${sourceFormulaTrace.vatFreightFactor}, а пошлина ` +
            `сама рассчитана со встроенным USD/CNY=${sourceFormulaTrace.dutyFreightFactor}. BBC ` +
            `использует подтверждённые USD/RUB=${sourceFormulaTrace.usdRub} и ` +
            `CNY/RUB=${sourceFormulaTrace.cnyRub} (кросс-курс ` +
            `${sourceFormulaTrace.currentCrossCnyPerUsd}) и пересчитанную пошлину. ` +
            'Значение BBC применено автоматически; сумма партнёра сохранена как evidence.',
            row.itemId
          );
        } else {
          add(
            'Сверка НДС',
            'Предупреждение',
            'Импортный НДС',
            row.partnerVatRub,
            row.importVatRub,
            row.vatDelta,
            'Самостоятельный расчет импортного НДС отличается от суммы партнера.',
            row.itemId
          );
        }
      }
    });

  model.expenses.forEach(row => {
    const article = String(row[5]);
    if (/итого|всего.*расход|составн.*стат|доставк.*таможенн.*оформ/i.test(article)) {
      add('Двойной учёт', 'Критическая ошибка', 'Статья расхода',
        article, '', '', 'Контрольная или составная строка включена как расход.');
    }
  });

  result.convertedExpenses.forEach(expense => {
    if (expense.decisionSource === 'BBC_RATE_DERIVED_RECALCULATION') return;
    if (expense.amountRub === null) return;
    const storedRub = parseFlexibleNumber_(expense.row[11]);
    if (storedRub === null) return;
    const delta = roundTo_(expense.amountRub - storedRub, 8);
    if (Math.abs(delta) > tolerance) add(
      'Пересчёт расхода', 'Предупреждение', expense.row[5],
      storedRub, expense.amountRub, delta,
      'Сумма RUB в базе отличается от пересчёта по исходной сумме и курсу.'
    );
  });

  if (model.items.length > 1) {
    const allocatedExpenseIds = new Set(model.allocations.map(row => String(row[1])));
    result.convertedExpenses
      .filter(expense =>
  !expense.calculated &&
  !expense.itemId &&
  !allocatedExpenseIds.has(expense.id)
)
      .forEach(expense => add(
        'Распределение расходов', 'Критическая ошибка', expense.row[5],
        expense.amountRub, '', '',
        'Расход сделки не распределён между несколькими товарами.'
      ));
    validateAllocationTotals_(model, result, tolerance).forEach(issue => add(
      'Распределение расходов', 'Критическая ошибка', issue.field,
      issue.source, issue.calculated, issue.delta, issue.message
    ));
  }

  // Контрольные сверки с партнёром требуют рассчитанных сумм.
  // При конфликте курса расчёт намеренно не выполняется, поэтому такие проверки
  // подавляются, чтобы не создавать каскад вторичных ошибок.
  if (!hasRateConflicts && !hasMissingRateConfirmations) {
    buildPartnerControlChecks_(model, result, tolerance).forEach(check => add(
      'Сверка с партнёром', check.severity, check.field,
      check.source, check.calculated, check.delta, check.message
    ));
  }

  const commission = model.commissionInput || {};
  const commissionMode = String(model.deal[11] || '').trim();
  const allowedCommissionTypes = ['PERCENT', 'FIXED', 'ZERO'];
  const allowedCommissionCurrencies = ['RUB', 'CNY', 'USD', 'EUR'];

  if (commissionMode === 'Ручной') {
    if (!commission.confirmedByManager) {
      add(
        'Комиссия BBC',
        'Критическая ошибка',
        'Подтверждение комиссии',
        '',
        '',
        '',
        'Комиссия BBC не подтверждена менеджером.'
      );
    }

    if (!allowedCommissionTypes.includes(commission.type)) {
      add(
        'Комиссия BBC',
        'Критическая ошибка',
        'Тип комиссии BBC',
        commission.type || '',
        '',
        '',
        'Укажите тип комиссии: PERCENT, FIXED или ZERO.'
      );
    }

    if (commission.type === 'PERCENT') {
      if (!(Number(commission.value) > 0)) {
        add(
          'Комиссия BBC',
          'Критическая ошибка',
          'Значение комиссии BBC',
          commission.value,
          '',
          '',
          'Для типа PERCENT укажите процент больше нуля.'
        );
      }

      if (!commission.base) {
        add(
          'Комиссия BBC',
          'Критическая ошибка',
          'База расчета комиссии BBC',
          '',
          '',
          '',
          'Для процентной комиссии необходимо указать базу расчета.'
        );
      }
    }

    if (commission.type === 'FIXED') {
      if (!(Number(commission.value) > 0)) {
        add(
          'Комиссия BBC',
          'Критическая ошибка',
          'Значение комиссии BBC',
          commission.value,
          '',
          '',
          'Для типа FIXED укажите фиксированную сумму больше нуля.'
        );
      }

      if (!allowedCommissionCurrencies.includes(commission.currency)) {
        add(
          'Комиссия BBC',
          'Критическая ошибка',
          'Валюта комиссии BBC',
          commission.currency || '',
          '',
          '',
          'Для фиксированной комиссии укажите валюту RUB, CNY, USD или EUR.'
        );
      }
    }

    if (commission.type === 'ZERO' && Number(commission.value || 0) !== 0) {
      add(
        'Комиссия BBC',
        'Критическая ошибка',
        'Значение комиссии BBC',
        commission.value,
        0,
        '',
        'Для типа ZERO значение комиссии должно быть пустым или равно нулю.'
      );
    }
  }

  if (result.commissionCalculation && !result.commissionCalculation.error) {
    const commissionCalc = result.commissionCalculation;
    add(
      'Комиссия BBC',
      'Информация',
      'Автоматическая комиссия BBC',
      `${commission.value}% от суммы до комиссии; минимум ${commission.minimumCny} CNY`,
      commissionCalc.amountRub,
      0,
      commissionCalc.appliedRule === 'MINIMUM_CNY'
        ? 'Применена минимальная комиссия BBC в CNY.'
        : 'Применена процентная комиссия BBC.'
    );
  }

  add('Арифметика', 'Информация', 'Общий итог RUB',
    `${result.goodsRub} + ${result.expensesRub}`,
    result.totalRub, 0,
    'Общий итог равен стоимости товара и активным подтверждённым расходам, включая комиссию BBC.'
  );
  return checks;
}

function validateAllocationTotals_(model, result, tolerance) {
  const issues = [];
  const byExpense = new Map();
  model.allocations.forEach(row => {
    const expenseId = String(row[1]);
    if (!byExpense.has(expenseId)) byExpense.set(expenseId, []);
    byExpense.get(expenseId).push(row);
  });
  result.convertedExpenses.forEach(expense => {
  if (expense.calculated) return;

    const rows = byExpense.get(expense.id) || [];
    if (rows.length === 0 || expense.itemId) return;
    const sumRub = sumNumbers_(rows.map(row => parseFlexibleNumber_(row[8]) || 0));
    const delta = roundTo_(sumRub - expense.amountRub, 8);
    if (Math.abs(delta) > tolerance) {
      issues.push({
        field: expense.row[5], source: expense.amountRub,
        calculated: sumRub, delta,
        message: 'Сумма распределения не совпадает с суммой расхода.'
      });
    }
  });
  return issues;
}

function buildPartnerControlChecks_(model, result, tolerance) {
  const checks = [];
  const categoryRub = categoryExpenseTotalsRub_(result.convertedExpenses);
  const sourceSectionTotals = buildSourceSectionControlTotalsRub_(
    model.confirmedTableRows || [],
    model.rateBook.selected
  );

  model.controls.forEach(row => {
    const code = String(row[18]);
    if (![
      'TOTAL_LOGISTICS', 'TOTAL_IMPORT', 'TOTAL_GOODS_PAYMENT',
      'COMPOSITE_EXPENSE', 'GRAND_TOTAL', 'TOTAL_PRODUCT_VALUE'
    ].includes(code)) return;

    const sourceAmount = parseFlexibleNumber_(row[13]);
    const currency = String(row[16]).trim().toUpperCase();
    const converted = convertMoneyForCalculation_(
      sourceAmount, currency, model.rateBook.selected
    );

    if (converted.error) {
      checks.push({
        severity: 'Критическая ошибка', field: row[19],
        source: `${sourceAmount} ${currency}`, calculated: '', delta: '',
        message: `Контрольный итог нельзя пересчитать: ${converted.error}`
      });
      return;
    }

    let expected = null;
    const sourceSection = normalizeRecognitionText_(row[7]);
    const sectionTotal = sourceSectionTotals.get(sourceSection);

    /*
     * DEV-009 — контроль промежуточных итогов по структуре источника.
     * Промежуточный итог партнёра сверяется с подтверждёнными строками
     * того же исходного раздела. Это исключает ложные ошибки, когда
     * каноническая категория BBC отличается от раздела в файле партнёра.
     */
    if (
      ['TOTAL_LOGISTICS', 'TOTAL_IMPORT', 'TOTAL_GOODS_PAYMENT'].includes(code) &&
      Number.isFinite(sectionTotal)
    ) {
      expected = sectionTotal;
    } else {
      // Резервная логика для файлов без распознанного исходного раздела.
      if (code === 'TOTAL_LOGISTICS') expected = categoryRub.logistics;
      if (code === 'TOTAL_IMPORT') expected = categoryRub.import;
      if (code === 'TOTAL_GOODS_PAYMENT') {
        expected = result.goodsRub +
          result.bucketTotals.partnerFinancialServices.rub;
      }
    }

    if (code === 'COMPOSITE_EXPENSE') {
      expected = result.preCommissionSummary.expensesRub;
    }
    if (code === 'GRAND_TOTAL') {
      expected = result.preCommissionSummary.totalRub;
    }
    if (code === 'TOTAL_PRODUCT_VALUE') expected = result.goodsRub;

    const delta = roundTo_(expected - converted.amountRub, 8);
    const ok = Math.abs(delta) <= tolerance;

    /*
     * DEV-009 — приоритет математически проверенного итога.
     * GRAND_TOTAL из файла партнёра является только контрольной строкой.
     * Если он расходится с суммой подтверждённых статей, расчёт BBC не
     * блокируется и ошибочный итог источника не рассматривается как вариант.
     */
    if (code === 'GRAND_TOTAL' && !ok) {
      checks.push({
        severity: 'Информация',
        field: row[19],
        source: converted.amountRub,
        calculated: expected,
        delta,
        message:
          'Контрольный итог источника арифметически неверен и исключён из расчёта. ' +
          'Канонический итог равен сумме подтверждённых товаров и расходов BBC.'
      });
      return;
    }

    if (code === 'TOTAL_PRODUCT_VALUE' && !ok && model.items.length > 1 && result.goodsCny > 0) {
      const impliedRate = converted.amountRub / result.goodsCny;
      const selectedRate = result.cnyRub;
      if (impliedRate > 0 && selectedRate > 0 && Math.abs(impliedRate - selectedRate) > 0.000001) {
        checks.push({
          severity: 'Информация',
          field: row[19],
          source: converted.amountRub,
          calculated: expected,
          delta,
          message:
            `Контрольная сумма товара источника рассчитана по курсу CNY/RUB ${roundTo_(impliedRate, 8)}, ` +
            `а канонический расчёт использует подтверждённый курс ${roundTo_(selectedRate, 8)}. ` +
            'Отклонение объяснено курсом и не блокирует расчёт.'
        });
        return;
      }
    }

    checks.push({
      severity: ok ? 'Информация' : 'Критическая ошибка',
      field: row[19], source: converted.amountRub,
      calculated: expected, delta,
      message: ok
        ? `Контрольный итог ${code} совпадает с пересчётом подтверждённых строк исходного раздела.`
        : `Контрольный итог ${code} отличается от пересчёта подтверждённых строк исходного раздела.`
    });
  });

  return checks;
}

/**
 * Суммирует подтверждённые товарные и расходные строки по разделам
 * исходного файла. Контрольные итоги и курсы в сумму не включаются.
 */
function buildSourceSectionControlTotalsRub_(rows, rates) {
  const totals = new Map();

  (rows || []).forEach(row => {
    const recordType = String(row[20] || '').trim();
    if (!['Товар', 'Расход'].includes(recordType)) return;

    const section = normalizeRecognitionText_(row[7]);
    if (!section) return;

    const amount = parseFlexibleNumber_(row[13]);
    const currency = String(row[16] || '').trim().toUpperCase();
    const converted = convertMoneyForCalculation_(amount, currency, rates);
    if (converted.error || !Number.isFinite(converted.amountRub)) return;

    totals.set(
      section,
      roundTo_((totals.get(section) || 0) + converted.amountRub, 8)
    );
  });

  return totals;
}

function categoryExpenseTotalsRub_(expenses) {
  let logistics = 0;
  let importTotal = 0;
  const logisticsBuckets = new Set([
    'chinaDelivery', 'internationalLogistics', 'russiaDelivery'
  ]);
  const importBuckets = new Set([
    'customsDuty', 'vat', 'customsFee', 'broker', 'temporaryStorage',
    'customsDelivery', 'certification', 'marking'
  ]);
  expenses.forEach(expense => {
    if (expense.amountRub === null) return;
    if (logisticsBuckets.has(expense.bucket)) logistics += expense.amountRub;
    if (importBuckets.has(expense.bucket)) importTotal += expense.amountRub;
  });
  return {logistics: roundTo_(logistics, 8), import: roundTo_(importTotal, 8)};
}

function writeCurrentCalculations_(spreadsheet, model, result) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.calculations);
  const rows = [];
  rows.push(buildCalculationOutputRow_(
    model.dealId, '', 'Сделка', result.goodsCny, result.goodsRub,
    result.bucketTotals, result.expensesCny, result.expensesRub,
    result.totalCny, result.totalRub,
    sumNumbers_(result.convertedItems.map(item => item.quantity || 0)),
    model.calculatedAt
  ));

  result.convertedItems.forEach(item => {
    const expenses = result.itemExpenseMap.get(item.id) || [];
    const buckets = emptyExpenseBuckets_();
    expenses.forEach(expense => {
      if (expense.amountCny === null || expense.amountRub === null) return;
      buckets[expense.bucket].cny += expense.amountCny;
      buckets[expense.bucket].rub += expense.amountRub;
    });
    const expenseCny = sumNumbers_(expenses.map(expense => expense.amountCny || 0));
    const expenseRub = sumNumbers_(expenses.map(expense => expense.amountRub || 0));
    rows.push(buildCalculationOutputRow_(
      model.dealId, item.id, 'Товар', item.amountCny || 0, item.amountRub || 0,
      buckets, expenseCny, expenseRub,
      (item.amountCny || 0) + expenseCny,
      (item.amountRub || 0) + expenseRub,
      item.quantity || 0, model.calculatedAt
    ));
  });
  replaceDealRowsInSheet_(sheet, 1, model.dealId, rows, 28);
  refreshSheetFilter_(sheet, 28);
}

function buildCalculationOutputRow_(
  dealId, itemId, level, goodsCny, goodsRub, buckets,
  expenseCny, expenseRub, totalCny, totalRub, quantity, calculatedAt
) {
  const unitCny = quantity > 0 ? totalCny / quantity : '';
  const unitRub = quantity > 0 ? totalRub / quantity : '';
  const bbcCommissionCny = buckets.bbcCommission.cny || 0;
  const profitCny = bbcCommissionCny;
  const margin = totalCny > 0 ? profitCny / totalCny : '';
  const roi = (totalCny - profitCny) > 0 ? profitCny / (totalCny - profitCny) : '';
  return [
    dealId, itemId, level, goodsCny, goodsRub,
    buckets.chinaDelivery.cny,
    buckets.internationalLogistics.cny,
    buckets.russiaDelivery.cny,
    buckets.customsDuty.cny,
    buckets.vat.cny,
    buckets.customsFee.cny,
    buckets.broker.cny + buckets.temporaryStorage.cny + buckets.customsDelivery.cny,
    buckets.certification.cny + buckets.marking.cny,
    buckets.insurance.cny,
    buckets.partnerFinancialServices.cny + buckets.partnerCommission.cny,
    bbcCommissionCny,
    buckets.exportSupport.cny + buckets.other.cny,
    goodsCny + expenseCny,
    totalCny,
    totalRub,
    quantity || '',
    quantity > 0 ? (goodsCny + expenseCny) / quantity : '',
    unitCny,
    unitRub,
    profitCny,
    margin,
    roi,
    calculatedAt
  ];
}

function writeCurrentChecks_(spreadsheet, dealId, checks) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.checks);
  const preserved = new Map();
  if (sheet.getLastRow() > 1) {
    sheet.getRange(2, 1, sheet.getLastRow() - 1, 15).getValues()
      .filter(row => String(row[1]) === String(dealId))
      .forEach(row => preserved.set(String(row[0]), row.slice(10, 15)));
  }
  const rows = checks.map(check => {
    const review = preserved.get(check.id) || [];
    const existingStatus = String(review[0] || '');
    const keepConfirmed = ['Подтверждено', 'Исправлено', 'Отклонено']
      .includes(existingStatus) && check.severity !== 'Критическая ошибка';
    return [
      check.id, check.dealId, check.itemId, check.date,
      check.type, check.severity, check.field,
      safeSpreadsheetValue_(check.source),
      safeSpreadsheetValue_(check.calculated),
      safeSpreadsheetValue_(check.delta),
      keepConfirmed ? existingStatus : check.status,
      review[1] || '', review[2] || '', review[3] || '',
      mergeSystemComment_(review[4], check.message)
    ];
  });
  replaceDealRowsInSheet_(sheet, 2, dealId, rows, 15);
  applyValidations_(spreadsheet);
  refreshSheetFilter_(sheet, 15);
}

function applyPreservedCheckStatuses_(spreadsheet, dealId, checks) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.checks);
  if (!sheet || sheet.getLastRow() < 2) return;
  const approved = new Map();
  sheet.getRange(2, 1, sheet.getLastRow() - 1, 11).getValues()
    .filter(row => String(row[1]) === String(dealId))
    .forEach(row => approved.set(String(row[0]), String(row[10])));
  checks.forEach(check => {
    const status = approved.get(check.id);
    if (
      check.severity !== 'Критическая ошибка' &&
      ['Подтверждено', 'Исправлено', 'Отклонено'].includes(status)
    ) {
      check.status = status;
    }
  });
}

function appendCalculationSnapshot_(spreadsheet, model, result) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.calculationSnapshots);
  const fingerprint = buildCalculationFingerprint_(model, result);
  const snapshotId = `SNP-${Utilities.getUuid()}`;
  appendRows_(sheet, [[
    snapshotId, model.dealId, model.calculatedAt, BBC_MVP.version,
    model.items.length, model.expenses.length,
    result.goodsCny, result.goodsRub,
    result.expensesCny, result.expensesRub,
    result.bucketTotals.bbcCommission.cny,
    result.bucketTotals.bbcCommission.rub,
    result.totalCny, result.totalRub,
    result.cnyRub || '', result.usdRub || '', result.eurRub || '',
    result.criticalCount, result.warningCount, result.status,
    fingerprint, getCurrentUser_(),
    'Автоматический снимок. Не редактировать и не удалять.'
  ]]);
  return snapshotId;
}

function buildCalculationFingerprint_(model, result) {
  const payload = JSON.stringify({
    version: BBC_MVP.version,
    dealId: model.dealId,
    items: result.convertedItems.map(item => [
      item.id, item.amount, item.currency, item.amountCny, item.amountRub
    ]),
    expenses: result.convertedExpenses.map(expense => [
      expense.id, expense.amount, expense.currency,
      expense.amountCny, expense.amountRub, expense.bucket
    ]),
    totalRub: result.totalRub
  });
  const bytes = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256, payload, Utilities.Charset.UTF_8
  );
  return bytes.map(byte =>
    (`0${((byte + 256) % 256).toString(16)}`).slice(-2)
  ).join('');
}

function updateDealCalculationStatus_(spreadsheet, dealId, result) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.deals);
  const rowNumber = findRowByValue_(sheet, 1, dealId);
  if (!rowNumber) return;
  const status = result.criticalCount > 0 || result.warningCount > 0
    ? 'Требует проверки'
    : 'Проверен';
  sheet.getRange(rowNumber, 11).setValue(status);
  sheet.getRange(rowNumber, 17).setValue(new Date());
}

function replaceDealRowsInSheet_(sheet, dealColumn, dealId, newRows, width) {
  const existing = sheet.getLastRow() > 1
    ? sheet.getRange(2, 1, sheet.getLastRow() - 1, width).getValues()
    : [];
  const kept = existing.filter(row =>
    String(row[dealColumn - 1]) !== String(dealId) &&
    row.some(value => value !== '')
  );
  const output = kept.concat(newRows || []);
  if (sheet.getMaxRows() < output.length + 1) {
    sheet.insertRowsAfter(sheet.getMaxRows(), output.length + 1 - sheet.getMaxRows());
  }
  if (sheet.getLastRow() > 1) {
    sheet.getRange(2, 1, sheet.getLastRow() - 1, width).clearContent();
  }
  if (output.length) sheet.getRange(2, 1, output.length, width).setValues(output);
}


const BBC_QUOTE_TEMPLATE_ID = '1JOn1RJ013e6stGWBoqOD3XgnM6tMWizNQZyrLy3ClKw';

function quoteIntakeFieldState_(intake, fieldCode) {
  return ((intake && intake.fieldStates) || []).find(state =>
    state && state.fieldCode === fieldCode
  ) || null;
}

function quoteIntakeValue_(intake, fieldCode) {
  const state = quoteIntakeFieldState_(intake, fieldCode);
  return state ? state.selectedValue : '';
}

function isFinalQuoteScope_(scope) {
  return /FINAL_QUOTE|CALCULATION/i.test(String(scope || ''));
}

function validateFinalQuoteIntake_(intake) {
  if (!intake) throw new Error('Не выполнено сведение данных КП с исходными файлами.');
  if (intake.quoteAllowed) return;

  const questions = (intake.managerQuestions || [])
    .filter(question => isFinalQuoteScope_(question.blockingScope))
    .map(question => String(question.question || '').trim())
    .filter(Boolean);
  const ownerDecisions = (intake.ownerDecisionsPending || [])
    .filter(decision => isFinalQuoteScope_(decision.blockingScope))
    .map(decision => String(decision.requiredAction || '').trim())
    .filter(Boolean);
  const unique = [...new Set(questions.concat(ownerDecisions))];
  throw new Error(
    'Финальное КП заблокировано: в нём нельзя заменять известные данные пробелами или placeholder. ' +
    (unique.length
      ? `Нужны только неразрешённые ответы:\n• ${unique.join('\n• ')}`
      : 'Проверьте неразрешённые поля и решения владельца.')
  );
}

function quoteSequentialPaymentLabel_(label, index) {
  const text = String(label || '').trim();
  const sequentialNumber = index + 1;
  if (!text) return `${sequentialNumber}-й платёж`;

  // DEV-016.35: после исключения нулевых/резервных строк клиент видит непрерывную
  // нумерацию 1..N. Бизнес-смысл, условие и сумма этапа не меняются.
  if (/^\s*\d+\s*-\s*й\s+плат[её]ж/i.test(text)) {
    return text.replace(/^\s*\d+/, String(sequentialNumber));
  }
  return text;
}

function quotePaymentDescription_(row, index) {
  const sourceLabel = String(row && row.label || '').trim();
  const label = quoteSequentialPaymentLabel_(sourceLabel, index);
  const fragments = String(row && row.text || '').split('|')
    .map(value => value.trim())
    .filter(value => value && value !== sourceLabel && value !== label)
    .filter(value => !/(?:RUB|CNY|руб\.?|юан|₽|¥)/i.test(value))
    .filter(value => !/^[-+]?\d[\d\s.,]*%?$/.test(value));
  return {
    label,
    condition: fragments.join(' · ') || 'Согласно подтверждённому графику'
  };
}

function buildCurrentQuotePaymentRows_(schedule, result) {
  const view = aiPaymentScheduleBusinessView_(schedule);
  const active = view.activeRows.slice(0, 9);
  if (!active.length) return [];
  const cnyRub = Number(result.cnyRub || 0);
  const weights = active.map(row => {
    const rub = Number(row.amountRub || 0);
    const cny = Number(row.amountCny || 0);
    return rub > 0 ? rub : (cny > 0 && cnyRub > 0 ? cny * cnyRub : 0);
  });
  const weightTotal = sumNumbers_(weights);
  if (!(weightTotal > 0)) return [];

  const totalRub = roundMoney_(Number(result.totalRub || 0));
  const totalCny = roundMoney_(Number(result.totalCny || 0));
  let assignedRub = 0;
  let assignedCny = 0;
  return active.map((row, index) => {
    const last = index === active.length - 1;
    const ratio = weights[index] / weightTotal;
    const amountRub = last ? roundMoney_(totalRub - assignedRub) : roundMoney_(totalRub * ratio);
    const amountCny = last ? roundMoney_(totalCny - assignedCny) : roundMoney_(totalCny * ratio);
    assignedRub = roundMoney_(assignedRub + amountRub);
    assignedCny = roundMoney_(assignedCny + amountCny);
    return Object.assign(quotePaymentDescription_(row, index), {amountRub, amountCny});
  });
}

function validateMasterQuoteContext_(context, model, result, intake) {
  // Статус «Проверен» и снимок без ошибок уже прошли validateQuoteSource_.
  // Здесь нельзя повторно открывать закрытые расчётные вопросы из intake.
  // Финальный gate проверяет ниже сам контекст клиентского КП.
  if (!context.items.length) {
    throw new Error('В сделке отсутствуют подтвержденные товары.');
  }
  if (context.items.length > 10) {
    throw new Error(
      'Эталонная спецификация рассчитана максимум на 10 товарных позиций. ' +
      `В текущей сделке: ${context.items.length}.`
    );
  }
  context.items.forEach((item, index) => {
    if (!String(item.name || '').trim()) {
      throw new Error(`У товара № ${index + 1} отсутствует наименование.`);
    }
    if (!(Number(item.quantity) > 0)) {
      throw new Error(`У товара «${item.name}» отсутствует подтвержденное количество.`);
    }
    if (!String(item.unit || '').trim()) {
      throw new Error(`У товара «${item.name}» отсутствует единица измерения.`);
    }
  });
  if (!(Number(result.totalRub) > 0)) {
    throw new Error('Итоговая стоимость сделки должна быть больше нуля.');
  }
  if (!context.bbcCommission.confirmedByManager) {
    throw new Error(
      'Комиссия BBC не подтверждена менеджером. ' +
      'Клиентское КП нельзя формировать без подтвержденной комиссии BBC.'
    );
  }
  const required = [
    ['менеджер', context.manager],
    ['срок действия КП', context.validityDays],
    ['Incoterms', context.deliveryTerms],
    ['маршрут', context.route],
    ['погранпереход', context.borderCrossing],
    ['тип транспорта', context.transportMode],
    ['срок доставки', context.deliveryDays],
    ['срок производства', context.productionDays]
  ];
  const empty = required.filter(entry => aiIsPlaceholder_(entry[1])).map(entry => entry[0]);
  if (empty.length) {
    throw new Error(`В финальном КП не определены: ${empty.join(', ')}. Заменять их на «—» или «Согласуется» запрещено.`);
  }
  if (!context.paymentRows.length && !context.items.every(item => parseQuotePaymentSplit_(item.paymentSplit))) {
    throw new Error('В исходных данных не найден применимый график платежей или подтверждённая построчная разбивка оплаты по товарам.');
  }
  const unresolvedSplits = context.items.filter(item => !parseQuotePaymentSplit_(item.paymentSplit));
  if (unresolvedSplits.length) {
    throw new Error(
      'Для финального КП требуется подтверждённая разбивка оплаты товарной части по этапам. ' +
      `Не определена для позиций: ${unresolvedSplits.map(item => item.number).join(', ')}.`
    );
  }
}

function getExternalQuoteNumber_(model, context) {
  const current = String(context.dealNumber || '').trim();
  const isInternalLabel = /(?:DEV[-_ ]?\d+|тест|контрол|многотоварн|отлад|debug)/i.test(current);
  if (
    current &&
    !/^BBC-[0-9a-f]{8}-/i.test(current) &&
    !isInternalLabel
  ) return current;

  const year = Utilities.formatDate(
    new Date(),
    Session.getScriptTimeZone(),
    'yyyy'
  );
  const sequence = String(Math.max(1, Number(model.dealRowNumber || 2) - 1))
    .padStart(3, '0');
  return `BBC-${year}-${sequence}`;
}

function quoteClientFilePart_(client) {
  const value = sanitizeFileName_(client || 'Клиент');
  return value || 'Клиент';
}

function quoteDaysText_(value) {
  const text = String(value || '').trim();
  if (/^(?:NOT_APPLICABLE|N\/A|не\s+применяется|не\s+включается)$/i.test(text)) {
    return 'Не применяется';
  }
  const normalized = text.replace(/–|—/g, '-').replace(/\s+/g, '');
  const range = normalized.match(/^(\d+(?:[.,]\d+)?)-(\d+(?:[.,]\d+)?)$/);
  if (range) return `${range[1].replace('.', ',')}–${range[2].replace('.', ',')} дн.`;
  const days = parseFlexibleNumber_(value);
  return days > 0 ? `${Math.round(days)} дн.` : text;
}

function writeMasterTemplateQuote_(
  quoteSpreadsheet,
  context,
  model,
  result,
  externalQuoteNumber,
  version
) {
  const inputSheet = quoteSpreadsheet.getSheetByName('Лист1');
  const calcSheet = quoteSpreadsheet.getSheetByName('Лист2');
  const quoteSheet = quoteSpreadsheet.getSheetByName('Расчет сделки ВЭД');
  const unitSheet = quoteSpreadsheet.getSheetByName('Юнит-экономика товара(ов)');
  const instructionSheet = quoteSpreadsheet.getSheetByName('Инструкция импортёру');

  if (!inputSheet || !calcSheet || !quoteSheet || !unitSheet || !instructionSheet) {
    throw new Error(
      'Структура DEV-016.40 нарушена. Обязательны 5 листов benchmark: «Лист1», «Лист2», «Расчет сделки ВЭД», «Юнит-экономика товара(ов)», «Инструкция импортёру».'
    );
  }
  if (context.items.length > 20) {
    throw new Error(`Шаблон DEV-015 рассчитан максимум на 20 товаров. Сейчас: ${context.items.length}.`);
  }

  const clientManagerName = resolveClientManagerName_(context.manager, '');
  const clientCompanyName = resolveClientCompanyName_(context.company);
  const firstItem = context.items[0];
  const quantityTotal = context.items.reduce((sum, item) => sum + (Number(item.quantity) || 0), 0);
  const goodsCny = Number(result.goodsCny || 0);
  const goodsRub = Number(result.goodsRub || 0);
  const buckets = result.bucketTotals || emptyExpenseBuckets_();

  // Технический входной лист используется только как совместимый контейнер.
  clearMasterCopyInputValidations_(inputSheet);
  inputSheet.getRange('B4').setValue(clientCompanyName);
  inputSheet.getRange('E4').setValue(externalQuoteNumber);
  inputSheet.getRange('E5').setValue(context.quoteDate);
  inputSheet.getRange('E6').setValue(context.client);
  inputSheet.getRange('B11').setValue(clientManagerName);
  inputSheet.getRange('B13').setValue(context.items.length === 1 ? firstItem.name : `${context.items.length} товарных позиций`);
  inputSheet.getRange('B14').setValue(context.items.length === 1 ? firstItem.article || '' : context.items.map(item => item.article || '').filter(Boolean).join(' / '));
  inputSheet.getRange('B16').setValue(context.productionDays || '');
  inputSheet.getRange('B17').setValue(quantityTotal);
  inputSheet.getRange('B18').setValue(context.items.length === 1 ? firstItem.tnVed || '' : [...new Set(context.items.map(item => item.tnVed || '').filter(Boolean))].join(' / '));
  const commonDutyRates = [...new Set((model.normalizedItems || []).map(item => Number(item.dutyRate)).filter(value => Number.isFinite(value) && value >= 0).map(value => value <= 1 ? value * 100 : value))];
  inputSheet.getRange('B19').setValue(commonDutyRates.length === 1 ? commonDutyRates[0] : '');
  inputSheet.getRange('B28').setValue(sumQuoteItemField_(context.items, 'grossWeight'));
  inputSheet.getRange('B29').setValue(sumQuoteItemField_(context.items, 'volume'));
  inputSheet.getRange('E13').setValue(context.route || '');
  inputSheet.getRange('E19').setValue(context.deliveryTerms || '');
  inputSheet.getRange('E26').setValue(Number(result.cnyRub || 0));
  const displayUsdRub = Number(context.usdRub || result.usdRub || 0);
  inputSheet.getRange('E28').setValue(displayUsdRub > 0 ? displayUsdRub : '');
  inputSheet.getRange('B7').setValue(Number(context.validityDays));
  inputSheet.getRange('E14').setValue(Number(buckets.chinaDelivery.cny || 0));
  inputSheet.getRange('E16').setValue(displayUsdRub > 0 ? Number(buckets.internationalLogistics.rub || 0) / displayUsdRub : '');
  inputSheet.getRange('E17').setValue(Number(buckets.russiaDelivery.rub || 0));
  inputSheet.getRange('E20').setValue(context.deliveryDays || '');
  inputSheet.getRange('E21').setValue(Number(buckets.exportSupport.cny || 0));
  inputSheet.getRange('E23').setValue(context.borderCrossing || '');
  inputSheet.getRange('E24').setValue(aiTransportLabel_(context.transportMode));
  inputSheet.getRange('E30').setValue(model.importVatRateForTemplate == null ? '' : Number(model.importVatRateForTemplate));
  inputSheet.getRange('E32').setValue(Number(model.commissionInput.value || 0) / 100);
  inputSheet.getRange('E33').setValue(Number(model.commissionInput.minimumCny || 0));
  inputSheet.getRange('B35').setValue(Number(buckets.broker.rub || 0));
  inputSheet.getRange('E36').setValue(Number(buckets.partnerCommission.rub || 0));
  inputSheet.getRange('E38').setValue(Number(buckets.partnerFinancialServices.rub || 0));
  calcSheet.getRange('Q2').setValue(Number(buckets.insurance.rub || 0));
  // Current master still has a legacy two-column supplier helper. It is populated
  // only when the authoritative supplier schedule actually has two stages. N-stage
  // schedules remain valid and are rendered from CLIENT_PAYMENT without guessing.
  calcSheet.getRange('J2:L11').clearContent();
  try {
    const splitMap = context.supplierPaymentSplitMap;
    if (!(splitMap instanceof Map)) throw new Error('Legacy two-stage supplier helper is not applicable.');
    context.items.forEach((item, index) => {
      const split = parseQuotePaymentSplit_(splitMap.get(String(item.itemId || '')) || '');
      if (!split) return;
      const row = 2 + index;
      const itemExpenses = (result.itemExpenseMap && result.itemExpenseMap.get(String(item.itemId || item.id || ''))) || [];
      const chinaCny = sumNumbers_(itemExpenses.filter(exp => exp.bucket === 'chinaDelivery').map(exp => Number(exp.amountCny || 0)));
      const invoiceCny = Number(item.amountCny || 0) + chinaCny;
      calcSheet.getRange(row, 10, 1, 3).setValues([[invoiceCny, split.firstPct, split.secondPct]]);
    });
  } catch (compatibilityError) {
    // Deliberately leave the legacy helper blank for N-stage schedules. Client-facing
    // amounts below are snapshot-bound and do not depend on this compatibility block.
  }

  // Шапка клиентского КП.
  quoteSheet.getRange('A3').setValue(
    `Сделка № ${externalQuoteNumber}   ·   ${formatQuoteDate_(context.quoteDate)}   ·   ` +
    `Срок действия КП ${context.validityDays} дн.`
  );
  quoteSheet.getRange('A4').setValue(`КОММЕРЧЕСКОЕ ПРЕДЛОЖЕНИЕ ПО СХЕМЕ: ${quoteSchemeTitle_(context)}`);
  quoteSheet.setRowHeight(4, 60);
  quoteSheet.getRange('A7').setValue(context.client || '—');
  quoteSheet.getRange('D7').setValue(context.items.length === 1 ? firstItem.name : `${context.items.length} товарных позиций`);
  quoteSheet.getRange('F7').setValue(clientManagerName || '—');

  quoteSheet.getRange('B10').setValue(quantityTotal);
  quoteSheet.getRange('D10').setValue(sumQuoteItemField_(context.items, 'volume'));
  quoteSheet.getRange('F10').setValue(context.items.length === 1 ? firstItem.tnVed || '—' : 'См. юнит-экономику');
  quoteSheet.getRange('B11').setValue(quoteDaysText_(context.productionDays));
  quoteSheet.getRange('D11').setValue(sumQuoteItemField_(context.items, 'grossWeight'));
  quoteSheet.getRange('F11').setValue(context.items.length === 1 ? firstItem.name : `${context.items.length} позиции`);
  quoteSheet.getRange('B12').setValue(quoteDaysText_(context.deliveryDays));
  quoteSheet.getRange('D12').setValue(displayUsdRub > 0 ? displayUsdRub : '');
  quoteSheet.getRange('F12').setValue(context.items.length === 1 ? firstItem.category || '—' : 'См. юнит-экономику');
  quoteSheet.getRange('B13').setValue(context.route || '—');
  quoteSheet.getRange('D13').setValue(Number(result.cnyRub || 0));
  quoteSheet.getRange('F13').setValue(quoteDutyDescription_(result));
  quoteSheet.getRange('B14').setValue(context.borderCrossing || '—');
  quoteSheet.getRange('D14').setValue(context.deliveryTerms || '—');
  quoteSheet.getRange('F14').setValue(context.items.length === 1 ? firstItem.article || '—' : 'См. юнит-экономику');
  quoteSheet.getRange('B15').setValue(aiTransportLabel_(context.transportMode));

  // Разделы сделки: только подтвержденные суммы расчётного ядра.
  // Количество и средняя цена записываются напрямую, чтобы клиентский лист
  // не зависел от удаляемых технических листов шаблона.
  // В многотоварном КП значение является средневзвешенной ценой по всей партии,
  // а не ценой каждой из четырёх позиций. Заголовок обязан это объяснять клиенту.
  quoteSheet.getRange('C18').setValue('Общее кол-во');
  quoteSheet.getRange('D18').setValue(context.items.length > 1 ? 'Средняя цена/ед.' : 'Цена/ед.');
  quoteSheet.getRange('A19').setValue(context.items.length > 1 ? 'Стоимость товарной партии' : 'Стоимость товара у поставщика');
  quoteSheet.getRange('C19').setValue(quantityTotal);
  quoteSheet.getRange('D19').setValue(quantityTotal ? goodsCny / quantityTotal : 0);
