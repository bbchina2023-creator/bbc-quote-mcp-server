  return {contourVersion:BBC_DOCUMENT_CONTOUR.version,requestId:requestId||'',dealId:String(canonical.dealId||''),schemaOk:schema.ok,schemaIssues:schema.issues||[],calculationReady:calculationReadiness.ok===true,readinessIssues:calculationReadiness.issues||[],quoteReady:quoteReadiness.ok===true,quoteReadinessIssues:quoteReadiness.issues||[],paymentCalculationOk,paymentCalculationIssues:verification&&verification.paymentCalculationValidation?verification.paymentCalculationValidation.issues:[],verificationOk,verificationIssues:verification?[].concat(verification.criticalErrors||[],verification.warnings||[]):[],preview,readyForSnapshot:schema.ok===true&&calculationReadiness.ok===true&&quoteReadiness.ok===true&&paymentCalculationOk&&verificationOk};
}

