function bbcDocumentContourApprovedTemplateBinding_() {
  const approved = BBC_DOCUMENT_CONTOUR.approvedTemplate;
  const file = DriveApp.getFileById(approved.id);
  const actualName = String(file.getName() || '');
  const actualModifiedAt = file.getLastUpdated().toISOString();
  if (actualName !== approved.name || actualModifiedAt !== approved.modifiedAt) {
    throw new Error('TEMPLATE_REGISTRY_MISMATCH: approved master changed after release verification. Expected ' + approved.name + ' @ ' + approved.modifiedAt + ', actual ' + actualName + ' @ ' + actualModifiedAt + '.');
  }
  return {
    templateId: approved.id,
    templateVersion: approved.version,
    templateName: actualName,
    templateModifiedAt: actualModifiedAt,
    outputProfile: BBC_DOCUMENT_CONTOUR.outputProfile
  };
}

function bbcDocumentContourRuleRegistry_() {
  // Current production-eligible calculation authority is the registry already
  // cross-verified by the 233M benchmark in Release B. Non-production parity
  // rules remain present only so missing deal-scoped financial facts fail closed.
  return bbcReleaseBPhase18RuleRegistry_();
}

function bbcDocumentContourOperationHeaders_() {
  return ['operation_id','operation_type','idempotency_key','request_hash','deal_id','snapshot_id','status','result_json','created_at','updated_at'];
}

function bbcDocumentContourValidateOperationSheet_(sheet) {
  if (!sheet) return null;
  const headers = bbcDocumentContourOperationHeaders_();
  const current = sheet.getRange(1,1,1,headers.length).getValues()[0].map(String);
  headers.forEach((h,i) => { if (current[i] !== h) throw new Error('Document contour operation store schema mismatch at column ' + (i+1) + '.'); });
  return sheet;
}

function bbcDocumentContourEnsureOperationSheet_(spreadsheet) {
  let sheet = spreadsheet.getSheetByName(BBC_DOCUMENT_CONTOUR.operationsSheet);
  const headers = bbcDocumentContourOperationHeaders_();
  if (!sheet) {
    sheet = spreadsheet.insertSheet(BBC_DOCUMENT_CONTOUR.operationsSheet);
    sheet.getRange(1,1,1,headers.length).setValues([headers]);
    sheet.setFrozenRows(1);
  }
  return bbcDocumentContourValidateOperationSheet_(sheet);
}

function bbcDocumentContourRequestHash_(operationType, args) {
  const copy = bbcReleaseADeepClone_(args || {});
  return bbcReleaseASha256Hex_({operationType:String(operationType||''), arguments:copy});
}

function bbcDocumentContourFindOperation_(sheet, operationType, idempotencyKey) {
  if (!sheet || sheet.getLastRow() < 2) return null;
  const rows = sheet.getDataRange().getValues();
  const header = rows[0].map(String);
  const typeIndex = header.indexOf('operation_type');
  const keyIndex = header.indexOf('idempotency_key');
  const hashIndex = header.indexOf('request_hash');
  const statusIndex = header.indexOf('status');
  const resultIndex = header.indexOf('result_json');
  const operationIndex = header.indexOf('operation_id');
  const snapshotIndex = header.indexOf('snapshot_id');
  const dealIndex = header.indexOf('deal_id');
  const createdIndex = header.indexOf('created_at');
  for (let i = rows.length - 1; i >= 1; i--) {
    if (String(rows[i][typeIndex]) !== String(operationType) || String(rows[i][keyIndex]) !== String(idempotencyKey)) continue;
    let result = null;
    if (String(rows[i][resultIndex] || '').trim()) {
      try { result = JSON.parse(String(rows[i][resultIndex])); } catch (error) { result = null; }
    }
    return {row:i+1, operationId:String(rows[i][operationIndex]||''), requestHash:String(rows[i][hashIndex]||''), status:String(rows[i][statusIndex]||''), result, snapshotId:String(rows[i][snapshotIndex]||''), dealId:String(rows[i][dealIndex]||''), createdAt:rows[i][createdIndex]};
  }
  return null;
}

function bbcDocumentContourBeginOperation_(spreadsheet, operationType, idempotencyKey, args, dealId, snapshotId) {
  if (!String(idempotencyKey || '').trim()) throw new Error('idempotencyKey is required.');
  const sheet = bbcDocumentContourEnsureOperationSheet_(spreadsheet);
  const requestHash = bbcDocumentContourRequestHash_(operationType, args);
  const existing = bbcDocumentContourFindOperation_(sheet, operationType, idempotencyKey);
  if (existing) {
    if (existing.requestHash !== requestHash) throw new Error('IDEMPOTENCY_CONFLICT: the same idempotencyKey was already used with a different request.');
    if (existing.status === 'COMPLETED' && existing.result) return {existing:true, result:existing.result, record:existing};
    return {existing:false, resume:true, record:existing, requestHash, sheet};
  }
  const now = new Date();
  const operationId = stableId_('OP',[operationType,idempotencyKey,requestHash]);
  sheet.appendRow([operationId,operationType,idempotencyKey,requestHash,dealId||'',snapshotId||'','STARTED','',now,now]);
  return {existing:false, resume:false, record:{row:sheet.getLastRow(),operationId,createdAt:now}, requestHash, sheet};
}

function bbcDocumentContourOperationCreatedAt_(state) {
  const raw = state && state.record && state.record.createdAt;
  const value = raw instanceof Date ? new Date(raw.getTime()) : new Date(raw || 0);
  if (!Number.isFinite(value.getTime()) || value.getTime() <= 0) throw new Error('OPERATION_CREATED_AT_INVALID');
  return value;
}

function bbcDocumentContourCompleteOperation_(state, result, dealId, snapshotId) {
  const sheet = state.sheet;
  const row = state.record.row;
  if (!sheet || !row) return result;
  sheet.getRange(row,5,1,6).setValues([[dealId||'',snapshotId||'','COMPLETED',JSON.stringify(result),sheet.getRange(row,9).getValue()||new Date(),new Date()]]);
  return result;
}

function bbcDocumentContourFailOperation_(state, error) {
  if (!state || !state.sheet || !state.record || !state.record.row) return;
  state.sheet.getRange(state.record.row,7,1,4).setValues([['FAILED',JSON.stringify({error:String(error && error.message || error)}),state.sheet.getRange(state.record.row,9).getValue()||new Date(),new Date()]]);
}

function bbcDocumentContourQuoteNumberHeaders_() {
  return ['deal_id','quote_number','year','sequence','created_at'];
}

function bbcDocumentContourEnsureQuoteNumberSheet_(spreadsheet) {
  const name = 'BBC Quote Numbers v1';
  const headers = bbcDocumentContourQuoteNumberHeaders_();
  let sheet = spreadsheet.getSheetByName(name);
  if (!sheet) {
    sheet = spreadsheet.insertSheet(name);
    sheet.getRange(1,1,1,headers.length).setValues([headers]);
  } else {
    const actual = sheet.getRange(1,1,1,headers.length).getValues()[0].map(String);
    if (JSON.stringify(actual) !== JSON.stringify(headers)) throw new Error('Quote number registry schema mismatch.');
  }
  return sheet;
}

function bbcDocumentContourExistingLegacyQuoteNumber_(spreadsheet, dealId) {
  const sheet = spreadsheet.getSheetByName(BBC_MVP.sheets.deals);
  if (!sheet || sheet.getLastRow() < 2) return '';
  const values = sheet.getDataRange().getDisplayValues();
  const headers = values[0].map(String), dealI = headers.indexOf('deal_id'), numberI = headers.indexOf('Номер сделки');
  if (dealI < 0 || numberI < 0) return '';
  for (let i = 1; i < values.length; i++) {
    if (String(values[i][dealI]) === String(dealId)) {
      const candidate = String(values[i][numberI] || '').trim();
      if (/^BBC-\d{4}-\d{3,}$/.test(candidate)) return candidate;
    }
  }
  return '';
}

function bbcDocumentContourMaxKnownQuoteSequence_(spreadsheet, year, registrySheet) {
  let max = 0;
  const re = new RegExp('^BBC-' + String(year) + '-(\\d{3,})$');
  function consider(value) { const m = String(value || '').trim().match(re); if (m) max = Math.max(max, Number(m[1])); }
  if (registrySheet && registrySheet.getLastRow() > 1) registrySheet.getRange(2,2,registrySheet.getLastRow()-1,1).getDisplayValues().flat().forEach(consider);
  const deals = spreadsheet.getSheetByName(BBC_MVP.sheets.deals);
  if (deals && deals.getLastRow() > 1) {
    const rows = deals.getDataRange().getDisplayValues(), headers = rows[0].map(String), numberI = headers.indexOf('Номер сделки');
    if (numberI >= 0) rows.slice(1).forEach(row => consider(row[numberI]));
  }
  const docs = spreadsheet.getSheetByName(BBC_MVP.sheets.documents);
  if (docs && docs.getLastRow() > 1) {
    const rows = docs.getDataRange().getDisplayValues(), headers = rows[0].map(String), nameI = headers.indexOf('Название файла');
    if (nameI >= 0) rows.slice(1).forEach(row => { const m = String(row[nameI] || '').match(new RegExp('BBC-' + String(year) + '-\\d{3,}')); if (m) consider(m[0]); });
  }
  return max;
}

function bbcDocumentContourEnsureQuoteNumber_(spreadsheet, dealId, operationCreatedAt) {
  const sheet = bbcDocumentContourEnsureQuoteNumberSheet_(spreadsheet);
  if (sheet.getLastRow() > 1) {
    const rows = sheet.getRange(2,1,sheet.getLastRow()-1,5).getDisplayValues();
    for (let i = 0; i < rows.length; i++) if (String(rows[i][0]) === String(dealId)) return String(rows[i][1]);
  }
  const legacy = bbcDocumentContourExistingLegacyQuoteNumber_(spreadsheet, dealId);
  const date = new Date(operationCreatedAt || new Date());
  if (!Number.isFinite(date.getTime())) throw new Error('Cannot allocate quote number: invalid operation date.');
  const year = Number(Utilities.formatDate(date, Session.getScriptTimeZone(), 'yyyy'));
  let quoteNumber = legacy;
  let sequence;
  if (quoteNumber) sequence = Number(quoteNumber.split('-').pop());
  else {
    sequence = bbcDocumentContourMaxKnownQuoteSequence_(spreadsheet, year, sheet) + 1;
    quoteNumber = 'BBC-' + year + '-' + String(sequence).padStart(3, '0');
  }
  sheet.appendRow([dealId, quoteNumber, year, sequence, new Date(operationCreatedAt || new Date())]);
  return quoteNumber;
}

