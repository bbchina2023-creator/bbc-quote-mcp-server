function cp009ExecuteTest_(definition, runId) {
  var started = new Date();
  try {
    var outcome = definition.testFunction();
    var status = outcome && outcome.status ? outcome.status : 'PASS_RUNTIME_APPS_SCRIPT';
    return {
      runId: runId,
      testId: definition.testId,
      family: definition.family,
      expected: definition.expected,
      status: status,
      observed: outcome && Object.prototype.hasOwnProperty.call(outcome, 'observed') ? outcome.observed : outcome,
      detail: outcome && outcome.detail ? outcome.detail : '',
      durationMs: new Date().getTime() - started.getTime(),
      startedAt: started
    };
  } catch (error) {
    return {
      runId: runId,
      testId: definition.testId,
      family: definition.family,
      expected: definition.expected,
      status: 'FAIL_RUNTIME_APPS_SCRIPT',
      observed: 'EXCEPTION',
      detail: String(error && error.stack || error),
      durationMs: new Date().getTime() - started.getTime(),
      startedAt: started
    };
  }
}

