/** Release A Phase 4 — explicit financial facts and additive persistence contract. */
const BBC_RELEASE_A_PHASE4 = Object.freeze({
  phase:'EXPLICIT_FINANCIAL_FACTS_STORES',
  stores:Object.freeze({
    canonical:'Канонические сделки v1',payments:'Платежи v1',rules:'Правила v1',decisions:'Решения менеджера v1',snapshots:'Снимки расчетов v2'
  })
});

function bbcReleaseAStoreDefinitions_() {
  return {
    canonical:['canonical_id','deal_id','revision','status','canonical_hash','payload_json','created_at','created_by'],
    payments:['schedule_id','deal_id','schedule_type','active_scheme_id','payment_hash','payload_json','created_at'],
    rules:['rule_binding_set_id','deal_id','rule_set_id','rule_set_version','rule_set_hash','bindings_json','created_at'],
    decisions:['decision_id','deal_id','entity_type','entity_id','field_code','decision_type','value_json','reason','decided_at','decided_by','source_question_id'],
    snapshots:['snapshot_id','deal_id','canonical_id','canonical_revision','canonical_hash','payment_hash','rule_set_id','rule_set_version','rule_set_hash','snapshot_hash','status','payload_json','created_at','created_by']
  };
}

function ensureReleaseAStores_(spreadsheet) {
  if (!spreadsheet) throw new Error('Release A store initialization requires spreadsheet.');
  var defs=bbcReleaseAStoreDefinitions_();
  Object.keys(BBC_RELEASE_A_PHASE4.stores).forEach(function(key){
    var name=BBC_RELEASE_A_PHASE4.stores[key], headers=defs[key], sheet=spreadsheet.getSheetByName(name);
    if(!sheet){sheet=spreadsheet.insertSheet(name);sheet.getRange(1,1,1,headers.length).setValues([headers]);}
    else {
      var actual=sheet.getRange(1,1,1,headers.length).getValues()[0].map(String);
      if(JSON.stringify(actual)!==JSON.stringify(headers)) throw new Error('Release A store schema mismatch: '+name);
    }
  });
  return BBC_RELEASE_A_PHASE4.stores;
}

function bbcReleaseAAppendImmutableRow_(sheet, headers, record, uniqueField) {
  var fields = Array.isArray(uniqueField) ? uniqueField.slice() : [uniqueField];
  var indexes = fields.map(function(field){var idx=headers.indexOf(field);if(idx<0)throw new Error('Unknown immutable key '+field);return idx;});
  var key = fields.map(function(field){return String(record[field]===undefined?'':record[field]);}).join('|');
  var last=sheet.getLastRow();
  if(last>1){
    var rows=sheet.getRange(2,1,last-1,headers.length).getValues();
    for(var i=0;i<rows.length;i++){
      var rowKey=indexes.map(function(idx){return String(rows[i][idx]===undefined?'':rows[i][idx]);}).join('|');
      if(rowKey===key)throw new Error('Immutable duplicate '+fields.join('+')+': '+key);
    }
  }
  sheet.appendRow(headers.map(function(h){return record[h]===undefined?'':record[h];}));
}

function persistCanonicalDealV1_(spreadsheet, canonical) {
  var v=validateCanonicalDealV1Object_(canonical);if(!v.ok)throw new Error('Invalid canonical deal: '+JSON.stringify(v.issues));
  ensureReleaseAStores_(spreadsheet);var defs=bbcReleaseAStoreDefinitions_(),sheet=spreadsheet.getSheetByName(BBC_RELEASE_A_PHASE4.stores.canonical);
  var rec={canonical_id:canonical.canonicalId,deal_id:canonical.dealId,revision:canonical.revision,status:canonical.status,canonical_hash:bbcReleaseASha256Hex_(canonical),payload_json:bbcReleaseAStableStringify_(canonical),created_at:canonical.createdAt,created_by:canonical.createdBy};
  bbcReleaseAAppendImmutableRow_(sheet,defs.canonical,rec,['canonical_id','revision']);return rec;
}

function persistVerifiedSnapshotV2_(spreadsheet, snapshot) {
  if(!snapshot||snapshot.immutable!==true||snapshot.status!=='VERIFIED')throw new Error('Only immutable VERIFIED Snapshot v2 may be persisted.');
  ensureReleaseAStores_(spreadsheet);var defs=bbcReleaseAStoreDefinitions_(),sheet=spreadsheet.getSheetByName(BBC_RELEASE_A_PHASE4.stores.snapshots);
  var rec={snapshot_id:snapshot.snapshotId,deal_id:snapshot.dealId,canonical_id:snapshot.canonicalId,canonical_revision:snapshot.canonicalRevision,canonical_hash:snapshot.canonicalHash,payment_hash:snapshot.paymentHash,rule_set_id:snapshot.ruleSetId,rule_set_version:snapshot.ruleSetVersion,rule_set_hash:snapshot.ruleSetHash,snapshot_hash:snapshot.snapshotHash,status:snapshot.status,payload_json:bbcReleaseAStableStringify_(snapshot),created_at:snapshot.createdAt,created_by:snapshot.createdBy};
  bbcReleaseAAppendImmutableRow_(sheet,defs.snapshots,rec,'snapshot_id');return rec;
}

