/**
 * DEV-016.38 — CHAT-FIRST TRANSACTIONAL API / STATELESS MCP ENDPOINT
 *
 * Назначение:
 * - новый чат ChatGPT Projects = новая сделка;
 * - файлы, загруженные менеджером в чат, предварительно сохраняются ChatGPT
 *   через Google Drive app, после чего сюда передаются Drive file IDs/URLs;
 * - backend создаёт сделку, импортирует Excel, распознаёт данные и формирует
 *   только реальные вопросы менеджеру;
 * - ответы менеджера записываются в канонические поля сделки;
 * - когда gates открыты, backend сам выполняет расчёт и создаёт Google/XLSX/PDF;
 * - наружу возвращаются готовые ссылки, deal_id остаётся техническим идентификатором.
 *
 * Ограничение DEV-016.38:
 * автоматический бинарный intake поддерживает XLS/XLSX. Для других типов файлов
 * API сохраняет source reference и возвращает UNSUPPORTED_SOURCE_TYPE, не имитируя
 * успешный импорт. Расширение OCR/PDF/DOCX intake — отдельный последующий слой.
 */

const BBC_CHAT_API = {
  schemaVersion: '1.0',
  mcpProtocolVersion: '2025-06-18',
  spreadsheetProperty: 'BBC_CHAT_API_SPREADSHEET_ID',
  tokenProperty: 'BBC_CHAT_API_TOKEN',
  enabledProperty: 'BBC_CHAT_API_ENABLED',
  autoGenerateQuote: true
};

function configureChatWorkflowApi() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  if (!spreadsheet) {
    throw new Error('Откройте связанную таблицу BBC КП Generator и повторите настройку.');
  }

  const properties = PropertiesService.getScriptProperties();
  let token = String(properties.getProperty(BBC_CHAT_API.tokenProperty) || '').trim();
  if (!token) {
    token = Utilities.base64EncodeWebSafe(
      Utilities.computeDigest(
        Utilities.DigestAlgorithm.SHA_256,
        `${Utilities.getUuid()}|${spreadsheet.getId()}|${Date.now()}`
      )
    ).replace(/=+$/g, '');
  }

  properties.setProperties({
    [BBC_CHAT_API.spreadsheetProperty]: spreadsheet.getId(),
    [BBC_CHAT_API.tokenProperty]: token,
    [BBC_CHAT_API.enabledProperty]: 'TRUE'
  }, false);

  writeLog_(
    'SYSTEM',
    'CONFIGURE_CHAT_API',
    '',
    `Chat API/MCP привязан к spreadsheet_id ${spreadsheet.getId()}; версия ${BBC_MVP.version}`
  );

  SpreadsheetApp.getUi().alert(
    'Chat API / MCP настроен.\n\n' +
    `Spreadsheet ID: ${spreadsheet.getId()}\n` +
    `Код: v${BBC_MVP.version}\n\n` +
    'Следующий шаг администратора: развернуть этот Apps Script как Web app и ' +
    'создать/обновить custom MCP app на URL развертывания. Токен хранится только ' +
    'в Script Properties и проверяется параметром ?token=... .'
  );

  return {
    ok: true,
    version: BBC_MVP.version,
    spreadsheetId: spreadsheet.getId(),
    token
  };
}

