{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bbc.example/contracts/rule-registry-v1.schema.json",
  "title": "BBC Rule Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "ruleSetId", "ruleSetVersion", "rules"],
  "properties": {
    "registryVersion": {"const": "1.0"}, "ruleSetId": {"type": "string", "minLength": 1}, "ruleSetVersion": {"type": "string", "minLength": 1},
    "rules": {"type": "array", "items": {"type": "object", "additionalProperties": true,
      "required": ["ruleId", "version", "status", "productionEligible", "provides", "appliesToFieldCodes", "appliesToSchemes", "parameters"],
      "properties": {
        "ruleId": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["ACTIVE", "INACTIVE", "SUPERSEDED"]}, "productionEligible": {"type": "boolean"},
        "provides": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "appliesToFieldCodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "appliesToSchemes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "parameters": {"type": "object"}
      }}}
  }
}
